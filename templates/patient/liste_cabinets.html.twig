{% extends 'base.html.twig' %}
{% block title %}Cabinets disponibles — MindBloom{% endblock %}

{% block body %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://npmcdn.com/flatpickr/dist/l10n/fr.js"></script>

<style>
.has-creneaux {
    background-color: rgba(74, 144, 226, 0.15) !important;
    border-color: rgba(74, 144, 226, 0.3) !important;
    font-weight: bold;
    color: #4A90E2 !important;
}
</style>


<div style="background:#F5F3EF; min-height:calc(100vh - 80px); padding:40px; display:flex; flex-direction:column; align-items:center;">
    
    <!-- Hero Header (RendezVous.fxml Translation) -->
    <div style="width:100%; max-width:1200px; display:flex; flex-direction:column; align-items:center; gap:5px; margin-bottom:30px;">
        <span style="font-size:32px; font-weight:bold; color:#2D3748;">Prenez rendez-vous avec un</span>
        <span style="font-size:32px; font-weight:bold; color:#4A90E2;">professionnel</span>
        <span style="color:#718096; font-size:16px; margin-top:10px;">Trouvez le psychologue qui vous convient et réservez votre consultation.</span>
    </div>

    <!-- Barre de Recherche et Filtres -->
    <div style="width:100%; max-width:1200px; display:flex; flex-direction:column; align-items:center; gap:20px; margin-bottom:40px;">
        
        <div style="width:100%; max-width:650px; background:white; border-radius:15px; padding:15px 20px; display:flex; align-items:center; gap:15px; box-shadow:0 4px 10px rgba(0,0,0,0.05);">
            <span style="font-size:18px; color:#A0AEC0;">🔍</span>
            <input type="text" id="searchField" placeholder="Rechercher par professionnel ou spécialité..." value="{{ search }}" style="border:none; outline:none; font-size:15px; width:100%; color:#2D3748;" />
        </div>

        <!-- Filtre par Date (Pill) -->
        <div style="display:flex; gap:15px; align-items:center;">
            <div id="dateFilterPill" style="background:white; border:1px solid #E2E8F0; padding:10px 25px; border-radius:50px; display:flex; align-items:center; gap:12px; cursor:pointer; box-shadow:0 2px 5px rgba(0,0,0,0.02); transition: all 0.2s;" onmouseover="this.style.borderColor='#4A90E2'; this.style.boxShadow='0 4px 12px rgba(74,144,226,0.1)'" onmouseout="this.style.borderColor='#E2E8F0'; this.style.boxShadow='0 2px 5px rgba(0,0,0,0.02)'">
                <svg fill="#4A90E2" width="18" height="18" viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z"/></svg>
                <span id="dateLabel" style="font-size:15px; font-weight:600; color:#4A5568;">Filtrer par date</span>
                <input type="date" id="dateInput" style="position:absolute; opacity:0; pointer-events:none; width:1px; height:1px;" />
            </div>

            <button id="clearDateBtn" style="display:none; background:none; border:none; color:#A0AEC0; cursor:pointer; font-size:20px; transition: color 0.2s; line-height: 1; padding: 0 5px;" onmouseover="this.style.color='#718096'" onmouseout="this.style.color='#A0AEC0'" title="Réinitialiser">
                ✕
            </button>
        </div>
    </div>

    {# Grille des Cabinets #}
    <div id="cardsContainer" style="display:flex; flex-wrap:wrap; gap:30px; width:100%; max-width:1200px; justify-content:center;">
        
        {% if cabinets is empty %}
            <div style="width:100%; text-align:center; padding:50px; background:white; border-radius:15px; color:#8E8E8E;">
                Aucun cabinet n'est disponible pour le moment.
            </div>
        {% else %}
            {% for cabinet in cabinets %}
                {# CARD CABINET (Traduction exacte de CardCabinet.fxml) #}
                <div class="psychologist-card" data-nom="{% if cabinet.psychologue %}{{ cabinet.psychologue.fullName|lower }}{% endif %}" data-specialite="{{ cabinet.specialite|lower }}" style="width:350px; background:white; border-radius:25px; overflow:hidden; box-shadow:0 15px 30px rgba(0,0,0,0.08); display:flex; flex-direction:column; transition: transform 0.2s ease-in-out;" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
                    
                    {# Image Placeholder #}
                    <div style="width:350px; height:200px; background:#E2E8F0; display:flex; align-items:center; justify-content:center; overflow:hidden; border-radius:25px 25px 0 0;">
                        {% if cabinet.psychologue and cabinet.psychologue.profileImage %}
                            <img src="{{ asset('uploads/profiles/' ~ cabinet.psychologue.profileImage) }}" style="width:100%; height:100%; object-fit:cover;" />
                        {% else %}
                            <span style="font-size:80px; color:rgba(74,144,226,0.3);">👤</span>
                        {% endif %}
                    </div>

                    {# Contenu #}
                    <div style="padding:20px; display:flex; flex-direction:column; gap:15px; flex:1;">
                        
                        <div style="display:flex; flex-direction:column; gap:5px;">
                            <span style="font-size:18px; font-weight:bold; color:#2C3E50;">{% if cabinet.psychologue %}Dr. {{ cabinet.psychologue.fullName }}{% else %}Sans Nom{% endif %}</span>
                            <span style="color:#718096; font-size:14px;">{{ cabinet.specialite }}</span>
                        </div>

                        <span style="font-size:12px; color:#A0AEC0;">⌂ {{ cabinet.adresse }}</span>
                        
                        {# Bouton Maps #}
                        {# Masqué pour le moment selon la demande du client #}
                        <a href="https://www.google.com/maps/search/?api=1&query={{ cabinet.adresse|url_encode }}" target="_blank" style="display:none; align-self:flex-start; background:rgba(74,144,226,0.2); color:#4A90E2; border-radius:15px; font-weight:bold; padding:6px 15px; font-size:12px; text-decoration:none; transition: background 0.2s;" onmouseover="this.style.background='rgba(74,144,226,0.4)'" onmouseout="this.style.background='rgba(74,144,226,0.2)'">⌂ Maps</a>
                        
                        <div style="flex:1;"></div>

                        {# Bouton Réserver #}
                        <a href="{{ path('app_patient_cabinet_reserver', {id: cabinet.idCabinet}) }}" class="open-modal-creneau" style="display:block; text-align:center; background:#5FBF9F; color:white; font-size:15px; font-weight:bold; padding:12px 0; border-radius:15px; text-decoration:none; width:100%; transition: background 0.2s;" onmouseover="this.style.background='#4DAE8E'" onmouseout="this.style.background='#5FBF9F'">Prenez un Rendez-Vous</a>

                    </div>
                </div>
            {% endfor %}
        {% endif %}

    </div>

    <style>
        .navigation {
            display: flex;
            justify-content: center;
            margin-top: 30px;
            margin-bottom: 20px;
        }
        .pagination {
            display: flex;
            align-items: center;
            gap: 8px;
            list-style: none;
            padding: 0;
            margin: 0;
        }
        /* Hide 'First' and 'Last' labels */
        .pagination .first, 
        .pagination .last {
            display: none;
        }
        /* Style for page numbers (small boxes) */
        .pagination .page a, 
        .pagination .current {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 30px;
            height: 30px;
            background: white;
            color: #4A5568;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            font-size: 13px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            transition: all 0.2s;
        }
        .pagination .page a:hover {
            background: #EDF2F7;
            color: #4A90E2;
            transform: translateY(-1px);
        }
        .pagination .current {
            background: #4A90E2;
            color: white;
            box-shadow: 0 4px 8px rgba(74, 144, 226, 0.2);
        }
        /* Style 'Next' and 'Previous' buttons */
        .pagination .next a, 
        .pagination .previous a {
            background: #4A90E2;
            color: white;
            padding: 6px 18px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: bold;
            font-size: 13px;
            box-shadow: 0 4px 10px rgba(74, 144, 226, 0.2);
            transition: all 0.2s;
        }
        .pagination .previous a {
            margin-right: 10px;
        }
        .pagination .next a {
            margin-left: 10px;
        }
        .pagination .next a:hover, 
        .pagination .previous a:hover {
            background: #357ABD;
            transform: scale(1.05);
        }
        /* Hide if disabled */
        .pagination .disabled {
            display: none;
        }
    </style>

    <div class="navigation">
        {{ knp_pagination_render(cabinets) }}
    </div>

    <!-- Footer Line -->
    <div style="margin-top: auto; padding-top: 50px; padding-bottom: 20px; color: #A0AEC0; font-size: 13px; text-align: center;">
        © 2026 MindBloom. Votre bien-être mental est notre priorité.
    </div>

</div>

<!-- OVERLAY MODAL -->
<div id="reservationModalOverlay" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.6); z-index:9999; align-items:center; justify-content:center; flex-direction:column; backdrop-filter:blur(3px);">
    <div id="modalSpinner" style="display:none; color:white; font-size:24px; font-weight:bold;">Chargement des disponibilités...</div>
    <div id="modalContentWrapper" style="position:relative;"></div>
</div>

<!-- Script de recherche dynamique et de Modal -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    
    // --- LOGIQUE RECHERCHE ---
    const searchField = document.getElementById('searchField');

    if (searchField) {
        // Fonction de debounce pour éviter de recharger à chaque lettre
        function debounce(func, timeout = 500) {
            let timer;
            return (...args) => {
                clearTimeout(timer);
                timer = setTimeout(() => { func.apply(this, args); }, timeout);
            };
        }

        const triggerSearch = debounce((query) => {
            const url = new URL(window.location.href);
            if (query) {
                url.searchParams.set('search', query);
            } else {
                url.searchParams.delete('search');
            }
            url.searchParams.set('page', 1); // Toujours revenir à la page 1
            window.location.href = url.toString();
        });

        searchField.addEventListener('input', (e) => {
            triggerSearch(e.target.value.trim());
        });

        // Garder aussi la recherche sur Entrée (immédiate)
        searchField.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                const query = e.target.value.trim();
                const url = new URL(window.location.href);
                if (query) {
                    url.searchParams.set('search', query);
                } else {
                    url.searchParams.delete('search');
                }
                url.searchParams.set('page', 1);
                window.location.href = url.toString();
            }
        });

        // Remettre le focus et le curseur à la fin si une recherche est active
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('search')) {
            searchField.focus();
            const val = searchField.value;
            searchField.value = '';
            searchField.value = val;
        }
    }

    // --- LOGIQUE MODAL CRENEAU ---
    const overlay = document.getElementById('reservationModalOverlay');
    const content = document.getElementById('modalContentWrapper');
    const spinner = document.getElementById('modalSpinner');

    // Fermer si clic sur l'overlay (en dehors du contenu)
    overlay.addEventListener('click', function(e) {
        if (e.target === overlay) {
            overlay.style.display = 'none';
            content.innerHTML = '';
            if (typeof window.resetDateFilter === 'function') {
                window.resetDateFilter();
            }
        }
    });

    document.querySelectorAll('.open-modal-creneau').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const url = this.href;

            // Afficher l'overlay
            overlay.style.display = 'flex';
            spinner.style.display = 'block';
            content.innerHTML = '';

            fetch(url)
                .then(r => r.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    
                    // On cherche le conteneur principal de la modal (450px de largeur)
                    const modalUI = doc.querySelector('div[style*="width:450px"]');
                    
                    if (modalUI) {
                        content.appendChild(modalUI);
                        
                        // Ré-exécuter les scripts de la modal pour rattacher les events de clics
                        const scripts = doc.querySelectorAll('script');
                        scripts.forEach(s => {
                            const newScript = document.createElement('script');
                            newScript.text = s.text;
                            document.body.appendChild(newScript);
                        });

                        // Surcharger la fermeture pour juste fermer la modal
                        const closeBtn = modalUI.querySelector('a[title="Fermer"]');
                        if(closeBtn) {
                            closeBtn.addEventListener('click', function(ev) {
                                ev.preventDefault();
                                overlay.style.display = 'none';
                                content.innerHTML = ''; // Clean up
                            });
                        }
                    } else {
                        // En cas d'erreur de parsing, fallback classique
                        window.location.href = url;
                    }
                })
                .catch(err => {
                    console.error("Erreur de chargement modal:", err);
                    window.location.href = url;
                })
                .finally(() => {
                    spinner.style.display = 'none';
                });
        });
    });

    // --- LOGIQUE FILTRE PAR DATE (FLATPICKR) ---
    const dateFilterPill = document.getElementById('dateFilterPill');
    const dateInput = document.getElementById('dateInput');
    const dateLabel = document.getElementById('dateLabel');
    const availableDates = {{ availableDates|default([])|json_encode|raw }};

    if (dateFilterPill && dateInput) {
        
        flatpickr.localize(flatpickr.l10ns.fr);
        const fp = flatpickr(dateInput, {
            dateFormat: "Y-m-d",
            minDate: "today",
            onDayCreate: function(dObj, dStr, fp, dayElem) {
                // dayElem is the DOM node for the day
                // Formater la date en "Y-m-d" pour comparer a availableDates
                const dateParts = [
                    dayElem.dateObj.getFullYear(),
                    String(dayElem.dateObj.getMonth() + 1).padStart(2, '0'),
                    String(dayElem.dateObj.getDate()).padStart(2, '0')
                ];
                const dateStrFormatted = dateParts.join('-');

                if (availableDates.includes(dateStrFormatted)) {
                    dayElem.classList.add('has-creneaux');
                }
            },
            onChange: function(selectedDates, dateStr, instance) {
                if (!dateStr) return;

                // Mettre à jour le label avec la date en français
                const dateObj = selectedDates[0];
                const options = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' };
                dateLabel.textContent = dateObj.toLocaleDateString('fr-FR', options);
                document.getElementById('clearDateBtn').style.display = 'block';

                // Afficher le chargement
                overlay.style.display = 'flex';
                spinner.style.display = 'block';
                content.innerHTML = '';

                const url = "/patient/availability/" + dateStr;

                fetch(url)
                    .then(r => r.text())
                    .then(html => {
                        content.innerHTML = html;
                        
                        // Exécuter les scripts de la modal chargée
                        const scripts = content.querySelectorAll('script');
                        scripts.forEach(s => {
                            const newScript = document.createElement('script');
                            newScript.text = s.text;
                            document.body.appendChild(newScript);
                        });
                    })
                    .catch(err => {
                        console.error("Erreur de chargement disponibilités:", err);
                        overlay.style.display = 'none';
                    })
                    .finally(() => {
                        spinner.style.display = 'none';
                    });
            }
        });

        window.resetDateFilter = function() {
            fp.clear();
            dateLabel.textContent = 'Filtrer par date';
            document.getElementById('clearDateBtn').style.display = 'none';
        };

        dateFilterPill.addEventListener('click', () => {
            fp.open();
        });

        document.getElementById('clearDateBtn').addEventListener('click', () => {
            window.resetDateFilter();
        });
    }

});
</script>


{% endblock %}
