{% extends 'base.html.twig' %}

{% block title %}Tests Psychologiques — MindBloom{% endblock %}

{% block body %}

<style>
    @keyframes fadeUpPage {
        0% { opacity: 0; transform: translateY(20px); }
        100% { opacity: 1; transform: translateY(0); }
    }
    .animate-entry {
        opacity: 0;
        animation: fadeUpPage 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .btn-interactive {
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        position: relative;
        overflow: hidden;
    }
    .btn-interactive::after {
        content: '';
        position: absolute;
        top: 50%; left: 50%;
        width: 0; height: 0;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        transform: translate(-50%, -50%);
        transition: width 0.4s ease-out, height 0.4s ease-out;
    }
    .btn-interactive:hover {
        transform: translateY(-3px) scale(1.05);
        box-shadow: 0 10px 20px rgba(74, 144, 226, 0.3);
    }
    .btn-interactive:hover::after {
        width: 150%; height: 150%;
        opacity: 0;
    }
    .btn-interactive:active {
        transform: translateY(1px) scale(0.95);
    }
    /* Pagination Premium Styling */
    .navigation {
        margin-top: 40px;
    }
    .pagination {
        display: flex;
        justify-content: center;
        gap: 8px;
        list-style: none;
        padding: 0;
    }
    .pagination li a, .pagination li span {
        display: inline-block;
        padding: 10px 18px;
        border-radius: 12px;
        background: white;
        color: #4A90E2;
        text-decoration: none;
        font-weight: 700;
        font-size: 14px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.03);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        border: 1px solid #F0F0F0;
    }
    .pagination li.active span {
        background: #4A90E2;
        color: white;
        border-color: #4A90E2;
        box-shadow: 0 6px 15px rgba(74, 144, 226, 0.3);
    }
    .pagination li a:hover {
        background: #F4F8FF;
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.06);
        border-color: #4A90E2;
    }
    .pagination li.disabled span {
        color: #BDC3C7;
        background: #FAFAFA;
        cursor: not-allowed;
    }
</style>

{# ── MAIN CONTENT ── #}
<div class="animate-entry" style="background:#FAFAF8; min-height: calc(100vh - 80px); padding: 50px; animation-delay: 0s;">
    <div style="max-width: 1200px; margin: 0 auto;">
        
        <div class="animate-entry" style="text-align: center; margin-bottom: 50px; animation-delay: 0.1s;">
            <div style="display:flex;justify-content:center;align-items:center;gap:15px;margin-bottom:15px;">
                <span style="display:inline-block;background:#E8F1FC;color:#4A90E2;border-radius:20px;padding:6px 15px;font-size:13px;font-weight:600;">
                    🧠 Évaluation Personnalisée
                </span>
                {% if is_granted('ROLE_PSYCHOLOGUE') %}
                    <a href="{{ path('app_test_new') }}" 
                       style="background:#4A90E2;color:white;border-radius:20px;padding:8px 18px;font-size:11px;font-weight:700;text-decoration:none;
                              box-shadow: 0 4px 10px rgba(74, 144, 226, 0.3);">
                        Créer Test +
                    </a>
                {% endif %}
            </div>
            <h1 style="font-size:40px;font-weight:900;color:#2C3E50;margin-bottom:15px;">Tests Psychologiques</h1>
            <p style="font-size:16px;color:#7F8C8D;max-width:600px;margin:0 auto;line-height:1.6;">
                Découvrez nos tests validés scientifiquement pour mieux comprendre vos émotions, votre personnalité et votre bien-être mental.
            </p>
            {% if app.user %}
                <div style="margin-top: 25px;">
                    <a href="{{ path('app_resultat_test_mes_resultats') }}" style="background: #5FBF9F; color: white; padding: 12px 30px; border-radius: 12px; font-weight: 700; text-decoration: none; box-shadow: 0 4px 10px rgba(95, 191, 159, 0.3); transition: transform 0.2s; display: inline-block;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='none'">
                        📊 Voir mes résultats
                    </a>
                </div>
            {% endif %}
        </div>

        <div class="animate-entry" style="background: white; max-width: 800px; margin: 0 auto 40px auto; padding: 20px 30px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.04); display: flex; gap: 20px; align-items: center; flex-wrap: wrap; animation-delay: 0.2s;">
            <div style="flex: 2; min-width: 200px; position: relative;">
                <span style="position: absolute; left: 15px; top: 12px; font-size: 18px; color: #95A5A6;">🔍</span>
                <input type="text" id="searchInput" placeholder="Rechercher un test (ex: Humeur, Personnalité...)" 
                       style="width: 100%; padding: 12px 15px 12px 45px; border: 2px solid #E0E4E8; border-radius: 12px; font-size: 15px; font-family: 'Inter', sans-serif; outline: none; transition: border-color 0.2s;" onfocus="this.style.borderColor='#4A90E2'" onblur="this.style.borderColor='#E0E4E8'">
            </div>
            
            <div style="flex: 1; min-width: 200px;">
                <select id="categoryFilter" style="width: 100%; padding: 12px 15px; border: 2px solid #E0E4E8; border-radius: 12px; font-size: 15px; font-family: 'Inter', sans-serif; outline: none; background: white; cursor: pointer; transition: border-color 0.2s;" onfocus="this.style.borderColor='#4A90E2'" onblur="this.style.borderColor='#E0E4E8'">
                    <option value="all">Toutes les catégories</option>
                    {% set categories = [] %}
                    {% for test in tests %}
                        {% if test.categorie not in categories %}
                            {% set categories = categories|merge([test.categorie]) %}
                            <option value="{{ test.categorie|lower }}">{{ test.categorie }}</option>
                        {% endif %}
                    {% endfor %}
                </select>
            </div>
        </div>

        <div id="testContainer" style="display: flex; flex-wrap: wrap; gap: 30px; justify-content: center; margin-bottom: 40px;">
            <div id="noResults" style="display: none; width: 100%; text-align: center; padding: 60px; background: white; border-radius: 20px; box-shadow: 0 5px 15px rgba(0,0,0,0.03);">
                <div style="font-size: 40px; margin-bottom: 20px;">🕵️</div>
                <h4 style="font-size: 20px; font-weight: 700; color: #2C3E50; margin-bottom: 10px;">Aucun test ne correspond à votre recherche</h4>
                <p style="color: #7F8C8D;">Essayez un autre mot-clé ou modifiez la catégorie.</p>
            </div>

            {% for test in tests %}
                <div class="test-card animate-entry" data-title="{{ test.nomTest|lower }}" data-category="{{ test.categorie|lower }}"
                     style="width: 350px; background: white; border-radius: 20px; padding: 30px; box-shadow: 0 10px 25px rgba(0,0,0,0.04); transition: transform 0.3s ease, box-shadow 0.3s ease; position: relative; overflow: hidden; animation-delay: {{ 0.3 + (loop.index0 * 0.1) }}s;"
                     onmouseover="this.style.transform='translateY(-8px)'; this.style.boxShadow='0 20px 40px rgba(0,0,0,0.1)'"
                     onmouseout="this.style.transform='none'; this.style.boxShadow='0 10px 25px rgba(0,0,0,0.04)'">
                    
                    <div style="position: absolute; top: 0; left: 0; right: 0; height: 6px; background: linear-gradient(90deg, #4A90E2, #5FBF9F);"></div>
                    
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
                        <div style="background: #E8F1FC; color: #4A90E2; padding: 6px 12px; border-radius: 8px; font-size: 13px; font-weight: 700;">
                            {{ test.categorie }}
                        </div>
                        <div style="display: flex; gap: 5px; color: #95A5A6; font-size: 13px; align-items: center;">
                            ⏱️ {{ test.duree }} min
                        </div>
                    </div>
                    
                    <h3 style="font-size: 22px; font-weight: 800; color: #2C3E50; margin-bottom: 15px; line-height: 1.3;">{{ test.nomTest }}</h3>
                    
                    <p style="color: #7F8C8D; font-size: 14px; margin-bottom: 25px; line-height: 1.6; min-height: 65px;">
                        Évaluez votre état actuel et identifiez les pistes de développement personnel avec ce test spécifique.
                    </p>
                    
                    <hr style="border:none; border-top: 1px solid #F0F0F0; margin-bottom: 20px;">
                    
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-size: 12px; color: #BDC3C7;">Mis à jour le {{ test.dateTest ? test.dateTest|date('d/m/Y') : '' }}</span>
                        
                        <div style="display: flex; gap: 10px; align-items: center;">
                            {% if is_granted('ROLE_PSYCHOLOGUE') %}
                                <a href="{{ path('app_test_edit', {'id': test.id}) }}" style="color:#F39C12;text-decoration:none;font-size:18px;" title="Modifier">✏️</a>
                                {{ include('test/_delete_form.html.twig', {'test': test}) }}
                            {% endif %}
                            
                            <a href="{{ path('app_test_show', {'id': test.id}) }}" class="btn-interactive" style="background: #4A90E2; color: white; border-radius: 12px; padding: 10px 20px; font-size: 14px; font-weight: 700; text-decoration: none; display: inline-block;">
                                {{ is_granted('ROLE_PSYCHOLOGUE') ? '👁️ Voir le test' : '🚀 Passer le test' }}
                            </a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div style="width: 100%; text-align: center; padding: 60px; background: white; border-radius: 20px; box-shadow: 0 5px 15px rgba(0,0,0,0.03);">
                    <div style="font-size: 40px; margin-bottom: 20px;">🏜️</div>
                    <h4 style="font-size: 20px; font-weight: 700; color: #2C3E50; margin-bottom: 10px;">Aucun test disponible</h4>
                    <p style="color: #7F8C8D;">Revenez plus tard pour découvrir nos nouveaux tests psychologiques.</p>
                </div>
            {% endfor %}
        </div>

        {# Pagination Navigation #}
        <div class="navigation animate-entry" style="display: flex; justify-content: center; margin-top: 20px; animation-delay: 0.8s;">
            {{ knp_pagination_render(tests) }}
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        const categoryFilter = document.getElementById('categoryFilter');
        const cards = document.querySelectorAll('.test-card');
        const noResults = document.getElementById('noResults');

        function filterTests() {
            const searchTerm = searchInput.value.toLowerCase().trim();
            const categorySelect = categoryFilter.value;
            let visibleCount = 0;

            cards.forEach(card => {
                const title = card.getAttribute('data-title');
                const category = card.getAttribute('data-category');
                
                const matchesSearch = title.includes(searchTerm);
                const matchesCategory = categorySelect === 'all' || category === categorySelect;

                if (matchesSearch && matchesCategory) {
                    card.style.display = 'block';
                    // Optional small animation
                    card.style.animation = 'fadeUp 0.3s ease-out forwards';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            if (visibleCount === 0 && cards.length > 0) {
                noResults.style.display = 'block';
            } else {
                noResults.style.display = 'none';
            }
        }

        if (searchInput) searchInput.addEventListener('input', filterTests);
        if (categoryFilter) categoryFilter.addEventListener('change', filterTests);
    });
</script>
<style>
    @keyframes fadeUp {
        0% { opacity: 0; transform: translateY(10px); }
        100% { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}