{% extends 'base.html.twig' %}

{% block title %}Mes Réservations — MindBloom{% endblock %}

{% block body %}
{# ── NAVBAR ── #}
<header style="background:white;height:80px;padding:0 50px;display:flex;align-items:center;
               gap:30px;box-shadow:0 5px 10px rgba(0,0,0,0.05);position:sticky;top:0;z-index:1000;">

    {# Logo + brand name #}
    <div style="display:flex;align-items:center;gap:10px;flex-shrink:0;">
        <img src="{{ asset('images/mindbloom_logo.png') }}" alt="MindBloom"
             style="height:50px;width:50px;object-fit:contain;">
        <span style="font-size:22px;font-weight:700;color:#2C3E50;">MindBloom</span>
    </div>

    {# Navigation links — centered, takes all available space #}
    <nav style="flex:1;display:flex;justify-content:center;gap:25px;align-items:center;">
        <a href="{{ path('app_patient_dashboard') }}"
           style="font-size:14px;color:#2C3E50;text-decoration:none;">Accueil</a>
        <a href="#" style="font-size:14px;color:#2C3E50;text-decoration:none;">Produits</a>
        <a href="{{ path('app_patient_cabinets_index') }}" style="font-size:14px;color:#2C3E50;text-decoration:none;">Rendez-vous</a>
        <a href="#" style="font-size:14px;color:#2C3E50;text-decoration:none;">Tests</a>
        <a href="#" style="font-size:14px;color:#2C3E50;text-decoration:none;">Événements</a>
        <a href="{{ path('app_patient_reservations') }}" style="font-size:14px;color:#4A90E2;text-decoration:none;font-weight:500;
                  border-bottom:2px solid #4A90E2;padding-bottom:2px;">Mes Réservations</a>
    </nav>

    {# Right actions #}
    <div style="display:flex;align-items:center;gap:20px;flex-shrink:0;">

        {# Cart #}
        <button style="background:#E8E8E8;border:none;border-radius:10px;padding:10px 15px;
                       font-size:20px;cursor:pointer;line-height:1;">🛒</button>

        {# Wallet badge #}
        <div style="display:flex;align-items:center;gap:8px;background:#EDF9F5;
                    border-radius:20px;padding:8px 15px;">
            <span style="font-size:16px;">💳</span>
            <span style="font-size:14px;font-weight:700;color:#5FBF9F;">0.00 TND</span>
            <a href="{{ path('app_wallet') }}"
               style="background:#5FBF9F;color:white;border-radius:15px;padding:5px 12px;
                      text-decoration:none;font-size:12px;font-weight:700;line-height:1;">+</a>
        </div>

        {# Profile pill #}
        <div style="display:flex;align-items:center;gap:10px;background:#F8F9FA;
                    border-radius:25px;padding:6px 15px 6px 8px;">
            <div style="width:40px;height:40px;border-radius:50%;border:2px solid #4A90E2;
                        background:white;display:flex;align-items:center;justify-content:center;
                        overflow:hidden;flex-shrink:0;">
                {% if app.user.profileImage %}
                    <img src="{{ asset('uploads/profiles/' ~ app.user.profileImage) }}"
                         style="width:100%;height:100%;object-fit:cover;" alt="">
                {% else %}
                    <span style="font-size:20px;color:#4A90E2;">👤</span>
                {% endif %}
            </div>
            <div style="display:flex;flex-direction:column;">
                <span style="font-size:9px;color:#999;">Bonjour,</span>
                <span style="font-size:12px;font-weight:700;color:#2C3E50;">{% if app.user %}{{ app.user.fullName|split(' ')|first }}{% else %}Invité{% endif %}</span>
            </div>
        </div>

        {# Modifier button #}
        <a href="{{ path('app_profile') }}"
           style="background:#4A90E2;color:white;border-radius:20px;padding:8px 18px;
                  font-size:11px;font-weight:600;text-decoration:none;">Modifier</a>

        {# Déconnexion button #}
        <form method="post" action="{{ path('app_logout') }}" style="display:inline;">
            <button type="submit" style="background:#e74c3c;color:white;border:none;border-radius:20px;padding:8px 18px;
                      font-size:11px;font-weight:600;cursor:pointer;">Déconnexion</button>
        </form>
    </div>
</header>

<div style="background:#FAFAF8; min-height:calc(100vh - 80px); padding:40px 0; display:flex; flex-direction:column; align-items:center;">
    
    <!-- TITRE ET FILTRAGE -->
    <div style="text-align:center; margin-bottom:30px;">
        <h1 style="margin:0; font-size:28px; font-weight:bold; color:#333333; display:inline-block;">Mes </h1>
        <h1 style="margin:0; font-size:28px; font-weight:bold; color:#4A90E2; display:inline-block;">Réservations</h1>
        <p style="color:#777777; font-size:14px; margin-top:10px;">Retrouvez l'ensemble de vos rendez-vous.</p>

        <!-- BOUTONS DE FILTRAGE -->
        <div style="display:flex; justify-content:center; gap:10px; margin-top:20px;" id="filterButtons">
            <button class="filter-btn active" data-filter="tous" style="background:#4A90E2; color:white; border:none; border-radius:20px; font-size:13px; padding:8px 20px; cursor:pointer; transition:0.2s;">Tous</button>
            <button class="filter-btn" data-filter="passees" style="background:#E0E0E0; color:#333333; border:none; border-radius:20px; font-size:13px; padding:8px 20px; cursor:pointer; transition:0.2s;">Passés</button>
            <button class="filter-btn" data-filter="confirmes" style="background:#E0E0E0; color:#333333; border:none; border-radius:20px; font-size:13px; padding:8px 20px; cursor:pointer; transition:0.2s;">Confirmés</button>
            <button class="filter-btn" data-filter="annules" style="background:#E0E0E0; color:#333333; border:none; border-radius:20px; font-size:13px; padding:8px 20px; cursor:pointer; transition:0.2s;">Annulés</button>
        </div>
    </div>

    <!-- MESSAGES FLASH (CENTRED) -->
    <div style="position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:9999; display:flex; flex-direction:column; gap:15px; pointer-events:none;">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div style="padding:25px 40px; border-radius:15px; box-shadow:0 20px 50px rgba(0,0,0,0.2); {% if label == 'success' %}background:#E8F5E9; border:2px solid #5FBF9F; color:#2E7D32;{% else %}background:#FFF5F5; border:2px solid #FF4D4D; color:#C53030;{% endif %} font-weight:bold; font-size:18px; text-align:center; animation: fadeoutmsg 4s forwards;">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
    </div>
    <style>
        @keyframes fadeoutmsg {
            0% { opacity: 0; transform: translateY(20px); }
            10% { opacity: 1; transform: translateY(0); }
            80% { opacity: 1; transform: translateY(0); }
            100% { opacity: 0; transform: translateY(-20px); }
        }
    </style>

    <!-- LISTE DES RESERVATIONS -->
    <div id="reservationsContainer" style="display:flex; flex-direction:column; gap:20px; width:100%; max-width:850px;">
        {% if reservations is empty %}
            <div style="text-align:center; color:#999; font-size:16px; padding:50px;">
                Aucune réservation trouvée.
            </div>
        {% else %}
            {% set now = date() %}
            {% for r in reservations %}
                
                {% set dateCreneau = r.creneau.dateCreneau|date('Y-m-d') %}
                {% set today = now|date('Y-m-d') %}
                {% set timeCreneau = r.creneau.heureDebut|date('H:i') %}
                {% set currTime = now|date('H:i') %}

                {% set isPast = (dateCreneau < today) or (dateCreneau == today and timeCreneau < currTime) %}
                
                {% set statusCat = 'tous ' %}
                {% if isPast %}
                    {% set statusCat = statusCat ~ 'passees ' %}
                {% elseif r.status.value == 'Confirmé' %}
                    {% set statusCat = statusCat ~ 'confirmes ' %}
                {% else %}
                    {% set statusCat = statusCat ~ 'annules ' %}
                {% endif %}

                <div class="reservation-card {{ statusCat }}" style="background:white; border-radius:10px; box-shadow:0 4px 8px rgba(0,0,0,0.05); padding:10px 15px; display:flex; align-items:center; gap:15px; transition:transform 0.2s;">
                    
                    {# Photo Psychologue #}
                    <div style="width:60px; height:60px; border-radius:50%; background:#E2E8F0; overflow:hidden; flex-shrink:0;">
                        {% if r.creneau.cabinet.psychologue and r.creneau.cabinet.psychologue.profileImage %}
                            <img src="{{ asset('uploads/profiles/' ~ r.creneau.cabinet.psychologue.profileImage) }}" style="width:100%; height:100%; object-fit:cover;" />
                        {% else %}
                            <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:22px; color:rgba(74,144,226,0.3);">👤</div>
                        {% endif %}
                    </div>

                    {# Infos #}
                    <div style="flex:1; display:flex; flex-direction:column; gap:4px;">
                        
                        {# Header info #}
                        <div style="display:flex; align-items:center; gap:10px;">
                            <span style="font-size:16px; font-weight:bold; color:#333;">Dr. {{ r.creneau.cabinet.psychologue.fullName|default('Inconnu') }}</span>
                            
                            {% if isPast %}
                                <span style="font-size:11px; color:#666; background:#E0E0E0; padding:2px 8px; border-radius:10px;">📅 Passée</span>
                            {% elseif r.status.value == 'Confirmé' %}
                                <span style="font-size:11px; color:#5FBF9F; background:#E8F5E9; padding:2px 8px; border-radius:10px;">Confirmé</span>
                            {% else %}
                                <span style="font-size:11px; color:#FF4D4D; background:#FFE5E5; padding:2px 8px; border-radius:10px;">Annulé</span>
                            {% endif %}
                        </div>

                        {# Details #}
                        <span style="color:#888; font-size:13px;">{{ r.creneau.cabinet.specialite|default('Spécialité non définie') }}</span>
                        <span style="color:#666; font-size:12px;">🏥 {{ r.creneau.cabinet.adresse|default('Adresse non définie') }}</span>
                        
                        {# Date & Heure #}
                        <div style="display:flex; gap:8px; margin-top:2px;">
                            <span style="background:#F0F7FF; color:#4A90E2; padding:3px 8px; border-radius:5px; font-size:12px;">📅 {{ r.creneau.dateCreneau|date('d/m/Y') }}</span>
                            <span style="background:#F0F7FF; color:#4A90E2; padding:3px 8px; border-radius:5px; font-size:12px;">🕒 {{ r.creneau.heureDebut|date('H:i') }}</span>
                        </div>
                    </div>

                    {# Actions #}
                    <div style="display:flex; align-items:center; gap:6px;">
                        
                        {# Boutons Toggle (Reconfirmer/Annuler) - seulement si ce n'est pas passé #}
                        {% if not isPast %}
                            <form action="{{ path('app_patient_reservations_toggle', {id: r.idReservation}) }}" method="post" style="margin:0;">
                                {% if r.status.value == 'Confirmé' %}
                                    <button type="submit" onclick="return confirm('Êtes-vous sûr de vouloir annuler cette réservation ? Le créneau deviendra disponible pour d\'autres patients.');" style="background:#FF4D4D; color:white; border-radius:8px; font-weight:600; font-size:12px; padding:6px 12px; border:none; cursor:pointer; min-width:85px; transition:0.2s;" onmouseover="this.style.opacity=0.8" onmouseout="this.style.opacity=1">Annuler</button>
                                {% else %}
                                    <button type="submit" style="background:#5FBF9F; color:white; border-radius:8px; font-weight:600; font-size:12px; padding:6px 12px; border:none; cursor:pointer; min-width:85px; transition:0.2s;" onmouseover="this.style.opacity=0.8" onmouseout="this.style.opacity=1">Reconfirmer</button>
                                {% endif %}
                            </form>
                        {% endif %}

                        {# Bouton Supprimer (Corbeille) - seulement si annulé #}
                        {% if r.status.value == 'Annulé' %}
                            <form action="{{ path('app_patient_reservations_delete', {id: r.idReservation}) }}" method="post" style="margin:0;" title="Supprimer de l'historique">
                                <button type="submit" onclick="return confirm('Voulez-vous supprimer définitivement cette réservation de votre historique ?');" style="background:transparent; color:#EF4444; border-radius:5px; display:flex; align-items:center; justify-content:center; width:26px; height:26px; border:1px solid #EF4444; cursor:pointer; transition:0.2s;" onmouseover="this.style.background='#FFE5E5'" onmouseout="this.style.background='transparent'">
                                    <span style="font-size:14px; font-weight:bold;">✕</span>
                                </button>
                            </form>
                        {% endif %}

                    </div>

                </div>
            {% endfor %}
        {% endif %}
    </div>
</div>

<style>
    .reservation-card:hover {
        transform: scale(1.02);
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.reservation-card');

    // Mettre à jour les compteurs sur les boutons
    const countTotal = cards.length;
    let countPassees = 0;
    let countConfirmes = 0;
    let countAnnules = 0;

    cards.forEach(card => {
        if (card.classList.contains('passees')) countPassees++;
        if (card.classList.contains('confirmes')) countConfirmes++;
        if (card.classList.contains('annules')) countAnnules++;
    });

    document.querySelector('[data-filter="tous"]').innerText = `Tous (${countTotal})`;
    document.querySelector('[data-filter="passees"]').innerText = `Passés (${countPassees})`;
    document.querySelector('[data-filter="confirmes"]').innerText = `Confirmés (${countConfirmes})`;
    document.querySelector('[data-filter="annules"]').innerText = `Annulés (${countAnnules})`;

    filterBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            // Styling actif/inactif
            filterBtns.forEach(b => {
                b.style.background = '#E0E0E0';
                b.style.color = '#333333';
                b.classList.remove('active');
            });
            this.style.background = '#4A90E2';
            this.style.color = 'white';
            this.classList.add('active');

            const filter = this.getAttribute('data-filter');

            // Filtrage des cartes
            cards.forEach(card => {
                if (filter === 'tous') {
                    card.style.display = 'flex';
                } else {
                    if (card.classList.contains(filter)) {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                }
            });
        });
    });
});
</script>
{% endblock %}
