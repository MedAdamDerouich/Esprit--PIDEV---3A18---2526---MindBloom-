            <span class="stat-counter" data-target="50" data-format="N+">50+</span>
            <span class="stat-label">Psychologues</span>
        </div>
        <div class="ptdash-stat">
            <span class="stat-counter" data-target="10" data-format="Nk+">10k+</span>
