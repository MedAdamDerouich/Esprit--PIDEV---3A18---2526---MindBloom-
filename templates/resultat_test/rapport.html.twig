{% extends 'base.html.twig' %}

{% block title %}Rapport Analytique — MindBloom{% endblock %}

{% block body %}
<style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Inter:wght@400;500;600&display=swap');

    .ai-report-container {
        font-family: 'Outfit', sans-serif;
        background: linear-gradient(145deg, #f3f5f9 0%, #e2eaf5 100%);
        min-height: calc(100vh - 85px);
        padding: 60px 20px;
    }

    .report-card {
        max-width: 900px;
        margin: 0 auto;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0,0,0,0.03);
        overflow: hidden;
        animation: fadeUp 0.8s ease-out forwards;
    }

    @keyframes fadeUp {
        0% { opacity: 0; transform: translateY(30px); }
        100% { opacity: 1; transform: translateY(0); }
    }

    .report-header {
        position: relative;
        padding: 50px 50px 30px 50px;
        background: url('data:image/svg+xml;utf8,<svg width="100" height="100" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><path fill="%238E2DE2" fill-opacity="0.03" d="M38.5,85.5C21.7,78.2,14.6,58.8,19,41.5S41.6,12.5,58.4,19.8C75.2,27.1,82.3,46.5,77.9,63.8S55.3,92.8,38.5,85.5z"/></svg>') right -50px top -50px no-repeat;
        background-size: 300px;
    }

    .header-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, #E8D5FA 0%, #E3EDFB 100%);
        color: #7b2cbf;
        padding: 8px 18px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        margin-bottom: 20px;
        box-shadow: 0 4px 10px rgba(123, 44, 191, 0.1);
    }

    .report-title-text {
        font-size: 42px;
        font-weight: 800;
        background: linear-gradient(135deg, #10002b 0%, #3c096c 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin: 0 0 5px 0;
        letter-spacing: -1px;
    }

    .report-buttons {
        display: flex;
        gap: 15px;
        margin-top: 25px;
    }

    .btn-email {
        background: linear-gradient(135deg, #0ba360 0%, #3cb043 100%);
        color: white !important;
        padding: 14px 28px;
        border-radius: 14px;
        font-weight: 600;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 10px 20px rgba(11, 163, 96, 0.25);
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    .btn-email:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 25px rgba(11, 163, 96, 0.35);
    }

    .btn-pdf {
        background: linear-gradient(135deg, #7b2cbf 0%, #3c096c 100%);
        color: white !important;
        padding: 14px 28px;
        border-radius: 14px;
        font-weight: 600;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 10px 20px rgba(123, 44, 191, 0.25);
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    .btn-pdf:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 25px rgba(123, 44, 191, 0.35);
    }

    .btn-back {
        background: white;
        color: #5c677d !important;
        padding: 14px 28px;
        border-radius: 14px;
        font-weight: 600;
        text-decoration: none;
        border: 2px solid #e1e5eb;
        transition: all 0.3s ease;
    }

    .btn-back:hover {
        background: #f8f9fa;
        border-color: #ced4da;
    }

    .report-body {
        padding: 0 50px 50px 50px;
    }

    .ai-analysis-header {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 25px 0;
        border-bottom: 2px solid #f1f3f5;
        margin-bottom: 30px;
    }

    .ai-icon-box {
        background: linear-gradient(135deg, #f72585, #7209b7);
        width: 60px;
        height: 60px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        color: white;
        box-shadow: 0 10px 20px rgba(114, 9, 183, 0.3);
        animation: pulseHeart 2s infinite ease-in-out alternate;
    }

    @keyframes pulseHeart {
        from { transform: scale(1); }
        to { transform: scale(1.05); }
    }

    .ai-content {
        font-family: 'Inter', sans-serif;
        font-size: 16px;
        line-height: 1.8;
        color: #3f3d56;
    }

    /* Target Markdown Bold generated by AI */
    .ai-content strong {
        color: #240046;
        font-weight: 600;
        background: linear-gradient(120deg, rgba(232, 213, 250, 0.5) 0%, rgba(200, 230, 255, 0.5) 100%);
        background-repeat: no-repeat;
        background-size: 100% 40%;
        background-position: 0 85%;
        padding: 0 2px;
    }

    .disclaimer-box {
        margin-top: 50px;
        padding: 25px;
        background: linear-gradient(to right, #FFFaf0, #fffcf5);
        border-radius: 16px;
        border-left: 5px solid #ffb703;
        display: flex;
        gap: 20px;
        box-shadow: 0 5px 15px rgba(255, 183, 3, 0.05);
    }
    
    .disclaimer-icon {
        font-size: 24px;
    }

    .disclaimer-text h4 {
        color: #fb8500;
        font-family: 'Outfit', sans-serif;
        font-size: 18px;
        font-weight: 700;
        margin: 0 0 8px 0;
    }

    .disclaimer-text p {
        color: #7d8597;
        font-size: 14px;
        margin: 0;
        line-height: 1.6;
        font-family: 'Inter', sans-serif;
    }
</style>

<div class="ai-report-container">
    <div class="report-card">
        
        <div class="report-header">
            <div class="header-badge">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zM4.5 7.5a.5.5 0 0 1 0-1h7a.5.5 0 0 1 0 1h-7z"/>
                </svg>
                Rapport d'Intelligence Artificielle
            </div>
            
            <h1 class="report-title-text">Aperçu Analytique</h1>
            <p style="color: #6c757d; font-size: 16px; margin: 0; font-family: 'Inter', sans-serif;">
                Généré exclusivement pour <b style="color: #495057;">{{ patient.fullName }}</b> le {{ "now"|date("d/m/Y") }}
            </p>

            <div class="report-buttons">
                <a href="{{ path('app_resultat_test_rapport_email') }}" class="btn-email">
                    <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414.05 3.555ZM0 4.697v7.104l5.803-3.558L0 4.697ZM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586l-1.239-.757Zm3.436-.586L16 11.801V4.697l-5.803 3.546Z"/>
                    </svg>
                    Recevoir par Email
                </a>
                <a href="{{ path('app_resultat_test_rapport_pdf') }}" class="btn-pdf">
                    <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
                        <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/>
                    </svg>
                    Télécharger en PDF
                </a>
                <a href="{{ path('app_resultat_test_mes_resultats') }}" class="btn-back">
                    Retour aux résultats
                </a>
            </div>
        </div>

        <div class="report-body">
            <div class="ai-analysis-header">
                <div class="ai-icon-box">✨</div>
                <div>
                    <h2 style="font-size: 26px; font-weight: 800; color: #10002b; margin: 0 0 5px 0;">Analyse par Gemini Pro</h2>
                    <p style="color: #8b8c8d; font-family: 'Inter', sans-serif; font-size: 15px; margin: 0;">Synthèse personnalisée de votre état émotionnel et cognitif</p>
                </div>
            </div>

            <div class="ai-content">
                {{ rapport|replace({'**': ''})|nl2br }}
            </div>
            
            <div class="disclaimer-box">
                <div class="disclaimer-icon">🛡️</div>
                <div class="disclaimer-text">
                    <h4>Clause de non-responsabilité médicale</h4>
                    <p>Ce document est généré par un modèle probabiliste (IA) à titre informatif et de réflexion personnelle. Il <strong>ne remplace en aucun cas un diagnostic</strong>, avis, ou traitement médical professionnel. Si vous traversez une période difficile, nous vous encourageons vivement à consulter l'un de nos psychologues.</p>
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}
