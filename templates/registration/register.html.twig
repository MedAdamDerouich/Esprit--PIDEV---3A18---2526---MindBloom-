{% extends 'base.html.twig' %}
{% block title %}Inscription — MindBloom{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}?v=2">
    <style>
    /* ── Override global body background ── */
    html, body { background: #0a0f0d !important; background-color: #0a0f0d !important; }

    .auth-panel-left__content > * {
      opacity: 0;
      transform: translateY(20px);
    }
    body.auth-ready .auth-brand-block {
      animation: authReveal 0.7s cubic-bezier(0.22,1,0.36,1) 0.1s forwards;
    }
    body.auth-ready .auth-botanical {
      animation: authReveal 0.9s cubic-bezier(0.22,1,0.36,1) 0.25s forwards;
    }
    body.auth-ready .auth-metrics {
      animation: authReveal 0.7s cubic-bezier(0.22,1,0.36,1) 0.45s forwards;
    }
    @keyframes authReveal {
      to { opacity: 1; transform: translateY(0); }
    }

    .auth-card {
      opacity: 0;
      transform: translateY(28px) scale(0.98);
    }
    body.auth-ready .auth-card {
      animation: cardReveal 0.75s cubic-bezier(0.22,1,0.36,1) 0.15s forwards;
    }
    @keyframes cardReveal {
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .auth-card__header,
    .auth-field,
    .auth-btn,
    .auth-divider,
    .auth-footer {
      opacity: 0;
      transform: translateY(12px);
    }
    body.auth-ready .auth-card__header    { animation: fieldReveal 0.45s ease 0.28s forwards; }
    body.auth-ready .auth-field:nth-of-type(1)  { animation: fieldReveal 0.45s ease 0.36s forwards; }
    body.auth-ready .auth-field:nth-of-type(2)  { animation: fieldReveal 0.45s ease 0.42s forwards; }
    body.auth-ready .auth-field:nth-of-type(3)  { animation: fieldReveal 0.45s ease 0.48s forwards; }
    body.auth-ready .auth-field:nth-of-type(4)  { animation: fieldReveal 0.45s ease 0.54s forwards; }
    body.auth-ready .auth-field:nth-of-type(5)  { animation: fieldReveal 0.45s ease 0.60s forwards; }
    body.auth-ready .auth-field:nth-of-type(6)  { animation: fieldReveal 0.45s ease 0.65s forwards; }
    body.auth-ready .auth-field:nth-of-type(7)  { animation: fieldReveal 0.45s ease 0.70s forwards; }
    body.auth-ready .auth-btn             { animation: fieldReveal 0.45s ease 0.76s forwards; }
    body.auth-ready .auth-divider         { animation: fieldReveal 0.45s ease 0.82s forwards; }
    body.auth-ready .auth-footer          { animation: fieldReveal 0.45s ease 0.86s forwards; }
    @keyframes fieldReveal {
      to { opacity: 1; transform: translateY(0); }
    }

    .auth-input:focus {
      animation: inputGlow 2s ease-in-out infinite;
    }
    @keyframes inputGlow {
      0%, 100% { box-shadow: 0 0 0 3px rgba(74,180,100,0.12), 0 0 20px rgba(74,180,100,0.06); }
      50%       { box-shadow: 0 0 0 3px rgba(74,180,100,0.22), 0 0 30px rgba(74,180,100,0.12); }
    }

    /* Role selector 3D tilt */
    .auth-role {
      transform-style: preserve-3d;
      transition: all 0.22s, transform 0.22s;
    }
    .auth-role:hover {
      transform: perspective(400px) rotateY(-5deg) translateY(-2px);
    }
    .auth-role.selected {
      transform: perspective(400px) rotateY(0deg) translateY(-1px);
    }

    @media (prefers-reduced-motion: reduce) {
      .auth-panel-left__content > *,
      .auth-card,
      .auth-card__header,
      .auth-field,
      .auth-btn,
      .auth-divider,
      .auth-footer {
        opacity: 1 !important;
        transform: none !important;
        animation: none !important;
      }
      .auth-input:focus { animation: none; }
      .auth-role:hover, .auth-role.selected { transform: none; }
    }
    </style>
{% endblock %}

{% block body %}
<div class="auth-page">

    {# ── LEFT PANEL ── #}
    <div class="auth-panel-left">
        <div class="auth-panel-left__content">

            <div class="auth-brand-block">
                <img src="{{ asset('images/mindbloom_logo.png') }}" alt="MindBloom">
                <div class="auth-brand-name">Mind<em>Bloom</em></div>
                <p class="auth-brand-tagline">Rejoignez notre communauté</p>
            </div>

            {# Botanical SVG — slightly different composition for register #}
            <div class="auth-botanical">
                <svg viewBox="0 0 300 320" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <radialGradient id="rGlowGrad" cx="50%" cy="50%" r="50%">
                      <stop offset="0%"   stop-color="#c8b4f0" stop-opacity="0.25"/>
                      <stop offset="100%" stop-color="#4ab464"  stop-opacity="0"/>
                    </radialGradient>
                    <linearGradient id="rStemGrad" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%"   stop-color="#6dbf84"/>
                      <stop offset="100%" stop-color="#2d6b3e"/>
                    </linearGradient>
                    <linearGradient id="rLeafA" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%"   stop-color="#7fcf95"/>
                      <stop offset="100%" stop-color="#3a8c52"/>
                    </linearGradient>
                    <linearGradient id="rLeafB" x1="1" y1="0" x2="0" y2="1">
                      <stop offset="0%"   stop-color="#5db876"/>
                      <stop offset="100%" stop-color="#2d6b3e"/>
                    </linearGradient>
