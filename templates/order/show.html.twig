{% extends 'base.html.twig' %}

{% block title %}Facture #{{ facture.id }} - MindBloom{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_admin_order_index') }}" class="btn btn-link text-muted p-0 text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i> Retour à la gestion admin
                    </a>
                {% else %}
                    <a href="{{ path('app_order_history') }}" class="btn btn-link text-muted p-0 text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i> Retour à mes commandes
                    </a>
                {% endif %}
                </div>
                <div>
                    <a href="{{ path('app_order_pdf', {'id': facture.id}) }}" class="btn btn-primary rounded-pill shadow-sm px-4">
                        <i class="bi bi-file-earmark-pdf-fill me-2"></i> Télécharger PDF
                    </a>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
                <div class="card-body p-4 p-md-5">
                    <div class="row mb-5 align-items-center">
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center">
                                <img src="{{ asset('images/mindbloom_logo.png') }}" alt="MindBloom" style="height: 60px; object-fit: contain;" onerror="this.style.display='none';">
                                <h1 class="h3 fw-bold mb-0 ms-3" style="color: #4A90E2;">MindBloom</h1>
                            </div>
                        </div>
                        <div class="col-sm-6 text-sm-end mt-4 mt-sm-0">
                            <h1 class="h2 fw-bold mb-2">FACTURE</h1>
                            <p class="text-muted mb-0">Réf: #{{ facture.id|default('0000') }}</p>
                            <p class="text-muted mb-0">Date: {{ facture.dateFacture|date('d/m/Y') }}</p>
                        </div>
                    </div>

                    <div class="row mb-5">
                        <div class="col-sm-6">
                            <div class="bg-light p-4 rounded-4 h-100 position-relative">
                                <h6 class="fw-bold mb-3 small text-uppercase" style="color: #adb5bd; letter-spacing: 1px;">Informations de Facturation</h6>
                                <p class="mb-2">
                                    <strong>Statut:</strong> 
                                    <span class="badge 
                                        {% if facture.statutLivraison == 'ENVOYE' %}bg-success
                                        {% elseif facture.statutLivraison == 'ANNULE' or facture.statutLivraison is empty %}bg-danger
                                        {% else %}bg-warning text-dark{% endif %} 
                                        rounded-pill px-3 py-1 text-uppercase small" style="font-size: 11px;">
                                        {% if facture.statutLivraison == 'ENVOYE' %}EXPÉDIÉE
                                        {% elseif facture.statutLivraison == 'ANNULE' or facture.statutLivraison is empty %}ANNULÉE
                                        {% else %}EN PRÉPARATION{% endif %}
                                    </span>
                                </p>
                                <p class="mb-3"><strong>Paiement:</strong> {{ facture.typePaiement|default('') }}</p>
                                <p class="text-muted small mb-0 lh-lg">
                                    <strong>MindBloom Boutique</strong><br>
                                    Avenue de l'indépendance<br>
                                    Tunis, Tunisie<br>
                                    contact@mindbloom.tn - +216 71 000 000
                                </p>
                            </div>
                        </div>
                        <div class="col-sm-6 mt-4 mt-sm-0">
                            <div class="border p-4 rounded-4 h-100 position-relative">
                                {% if facture.user and facture.user.profileImage %}
                                    <img src="{{ asset('uploads/profiles/' ~ facture.user.profileImage) }}" class="rounded-circle border position-absolute bg-white" style="width: 55px; height: 55px; object-fit: cover; top: 1.5rem; right: 1.5rem;" alt="Profil">
                                {% endif %}
                                <h6 class="fw-bold mb-3 small text-uppercase" style="color: #adb5bd; letter-spacing: 1px;">Client & Livraison</h6>
                                {% if facture.user %}
                                    <p class="fw-bold mb-1 fs-5">{{ facture.user.fullName }}</p>
                                    <p class="text-muted mb-3">{{ facture.user.email }}</p>
                                {% else %}
                                    <p class="fw-bold mb-3 text-muted">Utilisateur supprimé</p>
                                {% endif %}
                                <p class="fw-bold mb-1 small">Adresse de Livraison :</p>
                                <p class="text-muted mb-0 lh-lg">{{ facture.adresseLivraison|nl2br }}</p>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive mb-5">
                        <table class="table align-middle">
                            <thead style="background-color: #4A90E2; color: white;">
                                <tr>
                                    <th class="ps-3 py-3 border-0">Produit</th>
                                    <th class="py-3 border-0 text-center" style="width: 100px;">Qté</th>
                                    <th class="py-3 border-0 text-end">Prix Unitaire</th>
                                    <th class="py-3 border-0 text-end pe-3" style="width: 130px;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for cmd in commandes %}
                                    <tr>
                                        <td class="ps-3 py-3 border-0">
                                            <div class="d-flex align-items-center">
                                                {% if cmd.produit.image %}
                                                    <img src="{{ asset('uploads/produits/' ~ cmd.produit.image) }}" class="rounded me-3" style="width: 40px; height: 40px; object-fit: cover;" alt="{{ cmd.produit.nom }}">
                                                {% endif %}
                                                <span class="fw-bold">{{ cmd.produit.nom }}</span>
                                            </div>
                                        </td>
                                        <td class="py-3 border-0 text-center">{{ cmd.quantite }}</td>
                                        <td class="py-3 border-0 text-end text-muted">{{ cmd.produit.prix|number_format(2, ',', ' ') }} DT</td>
                                        <td class="py-3 border-0 text-end pe-3 fw-bold">{{ (cmd.produit.prix * cmd.quantite)|number_format(2, ',', ' ') }} DT</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <div class="row justify-content-end">
                        <div class="col-sm-6 col-md-5">
                            <div class="bg-light p-4 rounded-4">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted small">Sous-total</span>
                                    <span class="fw-bold">{{ subtotal|number_format(2, ',', ' ') }} DT</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted small">TVA (7%)</span>
                                    <span class="fw-bold">{{ tva|number_format(2, ',', ' ') }} DT</span>
                                </div>
                                <div class="d-flex justify-content-between mb-4 pb-4 border-bottom">
                                    <span class="text-muted small">Livraison</span>
                                    <span class="text-primary fw-bold small">{{ shipping|number_format(2, ',', ' ') }} DT</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="h5 fw-bold mb-0">Total</span>
                                    <span class="h5 fw-bold mb-0 text-primary">{{ facture.montantTotal|number_format(2, ',', ' ') }} DT</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light border-0 p-4 text-center">
                    <p class="small text-muted mb-0">Merci de votre confiance en MindBloom pour votre parcours de bien-être.</p>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
