{% extends 'base.html.twig' %}

{% block title %}Mon Panier - MindBloom{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 fw-bold mb-0">Mon Panier</h1>
                <span class="badge bg-light text-dark rounded-pill px-3 py-2 border shadow-sm">
                    {{ items|length }} article(s)
                </span>
            </div>

            {% if items|length > 0 %}
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4 py-3 border-0">Produit</th>
                                        <th class="py-3 border-0">Prix</th>
                                        <th class="py-3 border-0 text-center" style="width: 150px;">Quantité</th>
                                        <th class="py-3 border-0">Total</th>
                                        <th class="py-3 border-0 pe-4"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in items %}
                                        <tr>
                                            <td class="ps-4 py-4 border-0">
                                                <div class="d-flex align-items-center">
                                                    <div class="me-3" style="width: 60px; height: 60px;">
                                                        {% if item.produit.image %}
                                                            <img src="{{ asset('uploads/produits/' ~ item.produit.image) }}" class="img-fluid rounded-3 h-100 w-100" style="object-fit: cover;" alt="{{ item.produit.nom }}">
                                                        {% else %}
                                                            <div class="bg-light d-flex align-items-center justify-content-center h-100 w-100 rounded-3 text-muted small">
                                                                <i class="bi bi-box"></i>
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                    <div>
                                                        <h6 class="mb-0 fw-bold">{{ item.produit.nom }}</h6>
                                                        <a href="{{ path('app_produit_show', {id: item.produit.id}) }}" class="text-primary small text-decoration-none">Détails</a>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-4 border-0">
                                                {{ item.produit.prix|number_format(2, ',', ' ') }} DT
                                            </td>
                                            <td class="py-4 border-0">
                                                <form action="{{ path('app_cart_update_quantity', {id: item.id}) }}" method="POST" class="d-flex justify-content-center">
                                                    <div class="input-group input-group-sm" style="width: 100px;">
                                                        <input type="number" name="quantite" value="{{ item.quantite }}" min="1" max="{{ item.produit.quantite }}" class="form-control text-center rounded-3 bg-light border-0" onchange="this.form.submit()">
                                                    </div>
                                                </form>
                                            </td>
                                            <td class="py-4 border-0 fw-bold">
                                                {{ item.total|number_format(2, ',', ' ') }} DT
                                            </td>
                                            <td class="pe-4 py-4 border-0 text-end">
                                                <form action="{{ path('app_cart_remove', {id: item.id}) }}" method="POST" class="d-inline" onsubmit="return confirm('Retirer ce produit ?');">
                                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0 text-decoration-none">
                                                        <i class="bi bi-trash fs-5"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                
                <div class="mb-4">
                    <a href="{{ path('app_produit_index') }}" class="btn btn-link text-muted p-0 text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i> Continuer mes achats
                    </a>
                </div>
            {% else %}
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center mb-4">
                    <div class="mb-4">
                        <i class="bi bi-cart3 display-1 text-muted opacity-25"></i>
                    </div>
                    <h2 class="h4 fw-bold">Votre panier est vide</h2>
                    <p class="text-muted mb-4">Prenez le temps de parcourir notre boutique et trouvez ce qu'il vous faut.</p>
                    <a href="{{ path('app_produit_index') }}" class="btn btn-primary rounded-pill px-5">
                        Découvrir la boutique
                    </a>
                </div>
            {% endif %}
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 2rem;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">Récapitulatif</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Sous-total</span>
                        <span class="fw-bold text-dark">{{ subtotal|number_format(2, ',', ' ') }} DT</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">TVA (7%)</span>
                        <span class="fw-bold text-dark">{{ tva|number_format(2, ',', ' ') }} DT</span>
                    </div>
                    <div class="d-flex justify-content-between mb-4 pb-4 border-bottom">
                        <span class="text-muted">Livraison</span>
                        <span class="text-primary fw-bold">{{ shipping|number_format(2, ',', ' ') }} DT</span>
                    </div>
                    <div class="d-flex justify-content-between mb-4">
                        <span class="h5 fw-bold">Total</span>
                        <span class="h5 fw-bold text-primary">{{ total|number_format(2, ',', ' ') }} DT</span>
                    </div>
                    
                    {% if items|length > 0 %}
                        <a href="{{ path('app_order_checkout') }}" class="btn btn-primary btn-lg w-100 rounded-pill shadow-sm mb-3">
                            Passer à la caisse
                        </a>
                    {% endif %}
                    
                    <div class="bg-light p-3 rounded-3 mt-3">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-shield-check text-success fs-5 me-2"></i>
                            <span class="small fw-bold">Paiement 100% sécurisé</span>
                        </div>
                        <p class="small text-muted mb-0">Vos données personnelles et bancaires sont protégées.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
