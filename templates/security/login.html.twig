{% extends 'base.html.twig' %}
{% block title %}Connexion — MindBloom{% endblock %}

{% block body %}
<div class="auth-wrapper">

    {# ── LEFT PANEL ── #}
    <div class="auth-left">
        <div class="auth-left-inner">
            <div class="auth-brand">
                <img src="{{ asset('images/mindbloom_logo.png') }}" alt="MindBloom">
                <p class="auth-brand-tagline">Votre plateforme de bien-être mental</p>
            </div>

            <div class="auth-features">
                <div class="feature-item">
                    <div class="feature-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2a8 8 0 0 1 8 8c0 5.25-8 13-8 13S4 15.25 4 10a8 8 0 0 1 8-8z"/>
                            <circle cx="12" cy="10" r="3"/>
                        </svg>
                    </div>
                    <div class="feature-text">
                        <h4>Tests Psychologiques</h4>
                        <p>Évaluez votre bien-être mental avec nos tests certifiés.</p>
                    </div>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                            <line x1="16" y1="2" x2="16" y2="6"/>
                            <line x1="8" y1="2" x2="8" y2="6"/>
                            <line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                    </div>
                    <div class="feature-text">
                        <h4>Rendez-vous en ligne</h4>
                        <p>Réservez facilement avec un psychologue qualifié.</p>
                    </div>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                        </svg>
                    </div>
                    <div class="feature-text">
                        <h4>Suivi personnalisé</h4>
                        <p>Un accompagnement adapté à votre parcours de santé.</p>
                    </div>
                </div>
            </div>

            <div class="auth-stats">
                <div class="stat">
                    <div class="stat-num">500+</div>
                    <div class="stat-lbl">Patients</div>
                </div>
                <div class="auth-stat-divider"></div>
                <div class="stat">
                    <div class="stat-num">50+</div>
                    <div class="stat-lbl">Psychologues</div>
                </div>
                <div class="auth-stat-divider"></div>
                <div class="stat">
                    <div class="stat-num">98%</div>
                    <div class="stat-lbl">Satisfaction</div>
                </div>
            </div>
        </div>
    </div>

    {# ── RIGHT PANEL ── #}
    <div class="auth-right">
        <div class="auth-form-box">

            <div class="auth-form-header">
                <h2>Bon retour</h2>
                <p class="auth-sub">Connectez-vous à votre espace MindBloom</p>
            </div>

            {% if error %}
                <div class="flash-error mb-3">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="mb-form-group">
                    <label for="email">Adresse email</label>
                    <div class="mb-input-icon-wrap">
                        <span class="input-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                <polyline points="22,6 12,13 2,6"/>
                            </svg>
                        </span>
                        <input type="email" id="email" name="_username" class="mb-input"
                               placeholder="votre@email.com"
                               value="{{ last_username }}" autocomplete="email" required>
                    </div>
                </div>

                <div class="mb-form-group">
                    <label for="password">Mot de passe</label>
                    <div class="mb-input-icon-wrap">
                        <span class="input-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            </svg>
                        </span>
                        <input type="password" id="password" name="_password" class="mb-input"
                               placeholder="••••••••" autocomplete="current-password" required>
                    </div>
                </div>

                <div class="auth-form-options">
                    <label class="auth-remember">
                        <input type="checkbox" name="_remember_me">
                        <span>Se souvenir de moi</span>
                    </label>
                    <a href="#" class="auth-forgot-link">Mot de passe oublié ?</a>
                </div>

                <button type="submit" class="btn-mb-primary w-100 btn-login-submit">
                    Se connecter
                </button>
            </form>

            <hr class="mb-divider mt-4">

            <p class="auth-signup-prompt">
                Pas encore de compte ?
                <a href="{{ path('app_register') }}">Créer un compte</a>
            </p>
        </div>
    </div>

</div>
{% endblock %}
