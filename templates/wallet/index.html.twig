{% extends 'base.html.twig' %}
{% block title %}Mon Wallet — MindBloom{% endblock %}

{% block body %}

<div style="padding:30px 40px;background:var(--bg-warm);min-height:calc(100vh - 70px);">

    <div class="mb-page-header">
        <h1><i class="bi bi-wallet2" style="margin-right:10px;"></i>Mon Wallet</h1>
        <p>Gérez votre solde et vos transactions</p>
    </div>

    <div class="row g-4">

        {# Balance Card #}
        <div class="col-md-5">
            <div class="wallet-balance-card mb-4">
                <div class="balance-label">Solde disponible</div>
                <div class="balance-amount">
                    {{ wallet.balance|number_format(2, '.', ' ') }} <small style="font-size:22px;">DT</small>
                </div>
                <div class="balance-status">
                    {% if wallet.status == 'ACTIVE' %}
                        <i class="bi bi-shield-check" style="color:#4ade80;margin-right:5px;"></i>Wallet actif
                    {% else %}
                        <i class="bi bi-slash-circle" style="color:#f87171;margin-right:5px;"></i>Wallet suspendu
                    {% endif %}
                </div>
                {% if wallet.lastRechargeDate %}
                <div style="margin-top:12px;font-size:12px;opacity:0.7;">
                    <i class="bi bi-clock-history" style="margin-right:4px;"></i>
                    Dernière recharge : {{ wallet.lastRechargeDate|date('d/m/Y à H:i') }}
                </div>
                {% endif %}
            </div>

            {# Recharge form #}
            {% if wallet.status == 'ACTIVE' %}
            <div class="mb-card">
                <h6 style="font-weight:700;margin-bottom:16px;">
                    <i class="bi bi-lightning-charge-fill" style="color:#f59e0b;margin-right:6px;"></i>Recharger le wallet
                </h6>

                {# Quick amount buttons #}
                <div class="d-flex gap-2 mb-3 flex-wrap">
                    {% for amount in [10, 25, 50, 100] %}
                    <button type="button" class="btn-mb-outline"
                            style="padding:8px 16px;font-size:13px;"
                            onclick="setAmount({{ amount }})">
                        {{ amount }} DT
                    </button>
                    {% endfor %}
                </div>

                <form method="post" action="{{ path('app_wallet_recharge') }}" id="rechargeForm" novalidate>
                    <input type="hidden" name="_token" value="{{ csrf_token('wallet-recharge') }}">

                    {# Amount #}
                    <div class="mb-form-group">
                        <label>Montant (DT)</label>
                        <div class="mb-input-icon-wrap">
                            <span class="input-icon"><i class="bi bi-currency-exchange"></i></span>
                            <input type="number" name="amount" id="amountInput" class="mb-input"
                                   min="2" max="10000" step="0.01" placeholder="Ex: 50.00" required>
                        </div>
                    </div>

                    {# Card separator #}
                    <div style="display:flex;align-items:center;gap:10px;margin:18px 0 14px;">
                        <div style="flex:1;height:1px;background:var(--border-soft);"></div>
                        <span style="font-size:11px;color:var(--text-mid);font-weight:700;letter-spacing:.08em;text-transform:uppercase;">
                            <i class="bi bi-credit-card-2-front" style="margin-right:5px;font-size:13px;"></i>Informations carte
                        </span>
                        <div style="flex:1;height:1px;background:var(--border-soft);"></div>
                    </div>

                    {# Cardholder name #}
                    <div class="mb-form-group">
                        <label for="card_name">Titulaire de la carte</label>
                        <div class="mb-input-icon-wrap">
                            <span class="input-icon"><i class="bi bi-person"></i></span>
                            <input type="text" name="card_name" id="card_name" class="mb-input"
                                   placeholder="Prénom NOM" autocomplete="cc-name" required>
                        </div>
                        <div class="field-error" id="err_name"></div>
                    </div>

                    {# Card number + brand #}
                    <div class="mb-form-group">
                        <label for="card_number">Numéro de carte</label>
                        <div class="mb-input-icon-wrap" style="position:relative;">
                            <span class="input-icon"><i class="bi bi-credit-card"></i></span>
                            <input type="text" name="card_number" id="card_number" class="mb-input"
                                   placeholder="0000 0000 0000 0000" maxlength="19"
                                   inputmode="numeric" autocomplete="cc-number" required
                                   style="padding-right:64px;">
                            <span id="cardBrand" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);transition:opacity .2s;opacity:0.25;line-height:1;">
                                <i class="bi bi-credit-card-2-back" style="font-size:20px;color:var(--text-mid);"></i>
                            </span>
                        </div>
                        <div class="field-error" id="err_number"></div>
                    </div>

                    {# Expiry + CVC on same row #}
                    <div class="row g-2">
                        <div class="col-7">
                            <div class="mb-form-group">
                                <label for="card_expiry">Expiration</label>
                                <div class="mb-input-icon-wrap">
                                    <span class="input-icon"><i class="bi bi-calendar3"></i></span>
                                    <input type="text" name="card_expiry" id="card_expiry" class="mb-input"
                                           placeholder="MM/AA" maxlength="5"
                                           inputmode="numeric" autocomplete="cc-exp" required>
                                </div>
                                <div class="field-error" id="err_expiry"></div>
                            </div>
                        </div>
                        <div class="col-5">
                            <div class="mb-form-group">
                                <label for="card_cvc">CVC</label>
                                <div class="mb-input-icon-wrap">
                                    <span class="input-icon"><i class="bi bi-shield-lock"></i></span>
                                    <input type="text" name="card_cvc" id="card_cvc" class="mb-input"
                                           placeholder="123" maxlength="3"
                                           inputmode="numeric" autocomplete="cc-csc" required>
                                </div>
                                <div class="field-error" id="err_cvc"></div>
                            </div>
                        </div>
                    </div>

                    <div id="formError" style="display:none;color:#e74c3c;font-size:13px;margin-bottom:10px;padding:10px 12px;background:rgba(231,76,60,.08);border-radius:8px;border-left:3px solid #e74c3c;"></div>

                    <button type="submit" class="btn-mb-teal w-100" style="padding:12px;margin-top:6px;">
                        <i class="bi bi-lock-fill" style="margin-right:7px;"></i>Payer &amp; Recharger
                    </button>

                    <div style="text-align:center;margin-top:10px;font-size:11px;color:var(--text-mid);">
                        <i class="bi bi-shield-check" style="margin-right:4px;"></i>Paiement sécurisé via Stripe · Mode test
                    </div>
                </form>
            </div>
            {% endif %}
        </div>

        {# Transaction History #}
        <div class="col-md-7">
            <div class="mb-card" style="height:100%;">

                {# Header + count #}
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 style="font-weight:700;margin:0;">
                        <i class="bi bi-clock-history" style="margin-right:7px;color:var(--teal-mid);"></i>Historique des transactions
                    </h6>
                    <span class="mb-badge mb-badge-gray" id="txCount">{{ transactions|length }} opération(s)</span>
                </div>

                {# ── Search + filter bar ── #}
                {% if transactions is not empty %}
                <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
                    {# Text search #}
                    <div style="flex:1;min-width:160px;position:relative;">
                        <i class="bi bi-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--text-mid);font-size:13px;pointer-events:none;"></i>
                        <input type="text" id="txSearch" placeholder="Rechercher..."
                               style="width:100%;padding:8px 10px 8px 32px;border:1.5px solid var(--border-soft);border-radius:8px;font-size:13px;outline:none;background:var(--bg-warm);"
                               oninput="filterTx()">
                    </div>
                    {# Type filter #}
                    <select id="txType" onchange="filterTx()"
                            style="padding:8px 12px;border:1.5px solid var(--border-soft);border-radius:8px;font-size:13px;background:var(--bg-warm);cursor:pointer;outline:none;">
                        <option value="">Tous les types</option>
                        <option value="RECHARGE">Rechargements</option>
                        <option value="PAYMENT">Paiements</option>
                        <option value="WITHDRAWAL">Retraits</option>
                    </select>
                </div>
                {% endif %}

                {# Transaction list #}
                {% if transactions is empty %}
                    <div style="text-align:center;padding:40px;color:var(--text-mid);">
                        <i class="bi bi-inbox" style="font-size:48px;display:block;margin-bottom:12px;opacity:0.4;"></i>
                        <p>Aucune transaction pour le moment</p>
                    </div>
                {% else %}
                    <div id="txList">
                    {% for tx in transactions %}
                    <div class="transaction-row tx-item"
                         data-type="{{ tx.type }}"
                         data-desc="{{ (tx.description ?? tx.type)|lower }}"
                         data-date="{{ tx.transactionDate|date('d/m/Y') }}">
                        <div class="transaction-icon {{ tx.type == 'RECHARGE' ? 'credit' : 'debit' }}">
                            {% if tx.type == 'RECHARGE' %}
                                <i class="bi bi-arrow-down-circle-fill"></i>
                            {% elseif tx.type == 'PAYMENT' %}
                                <i class="bi bi-bag-check-fill"></i>
                            {% else %}
                                <i class="bi bi-arrow-up-circle-fill"></i>
                            {% endif %}
                        </div>
                        <div class="flex-fill" style="min-width:0;">
                            {% set desc = tx.description ?? tx.type %}
                            {% if tx.type == 'PAYMENT' and '|' in desc %}
                                {# ── Detailed order breakdown ── #}
                                {% set parts = desc|split(' | ') %}
                                {# First part: "Commande N article(s)" #}
                                <div class="tx-desc" style="font-weight:700;margin-bottom:4px;">
                                    <i class="bi bi-bag-check" style="margin-right:5px;color:#008c91;"></i>{{ parts[0] }}
                                </div>
                                {# Product lines (everything between first and last 3 parts) #}
                                {% set totalParts = parts|length %}
                                {% for i in 1..(totalParts - 4) %}
                                    {% set line = parts[i] %}
                                    <div style="font-size:12px;color:var(--text-mid);padding:2px 0 2px 18px;border-left:2px solid #e0e7ef;margin-left:4px;margin-bottom:1px;">
                                        <i class="bi bi-dot" style="font-size:14px;vertical-align:middle;"></i>{{ line }}
                                    </div>
                                {% endfor %}
                                {# TVA + shipping + total #}
                                <div style="display:flex;gap:10px;margin-top:5px;padding-top:5px;border-top:1px dashed #e0e7ef;flex-wrap:wrap;">
                                    <span style="font-size:11px;color:var(--text-mid);">
                                        <i class="bi bi-percent" style="margin-right:2px;"></i>{{ parts[totalParts - 3] }}
                                    </span>
                                    <span style="font-size:11px;color:var(--text-mid);">
                                        <i class="bi bi-truck" style="margin-right:2px;"></i>{{ parts[totalParts - 2] }}
                                    </span>
                                    <span style="font-size:11px;font-weight:700;color:#1B3A6B;">
                                        <i class="bi bi-receipt" style="margin-right:2px;"></i>{{ parts[totalParts - 1] }}
                                    </span>
                                </div>
                            {% else %}
                                <div class="tx-desc">{{ desc }}</div>
                            {% endif %}
                            <div class="tx-date" style="margin-top:4px;">
                                <i class="bi bi-clock" style="margin-right:3px;font-size:10px;"></i>
                                {{ tx.transactionDate|date('d/m/Y à H:i') }}
                            </div>
                        </div>
                        <div class="tx-amount {{ tx.type == 'RECHARGE' ? 'credit' : 'debit' }}" style="white-space:nowrap;align-self:flex-start;">
                            {{ tx.type == 'RECHARGE' ? '+' : '-' }}{{ tx.amount|number_format(2, '.', ' ') }} DT
                        </div>
                    </div>
                    {% endfor %}
                    </div>
                    <div id="txEmpty" style="display:none;text-align:center;padding:30px;color:var(--text-mid);">
                        <i class="bi bi-funnel" style="font-size:32px;display:block;margin-bottom:8px;opacity:0.4;"></i>
                        <p style="font-size:14px;">Aucun résultat pour ce filtre</p>
                    </div>
                {% endif %}

            </div>
        </div>

    </div>
</div>
{% endblock %}

{% block javascripts %}
<style>
.field-error { color: #e74c3c; font-size: 12px; margin-top: 4px; min-height: 16px; }
.mb-input.is-invalid { border-color: #e74c3c !important; background: rgba(231,76,60,.04); }
.mb-input.is-valid   { border-color: #27ae60 !important; }
</style>
<script>
/* ── Transaction search/filter ── */
function filterTx() {
    const search = (document.getElementById('txSearch')?.value || '').toLowerCase();
    const type   = document.getElementById('txType')?.value || '';
    const items  = document.querySelectorAll('.tx-item');
    let visible  = 0;

    items.forEach(function(row) {
        const matchType = !type || row.dataset.type === type;
        const matchText = !search ||
            row.dataset.desc.includes(search) ||
            row.dataset.date.includes(search);
        const show = matchType && matchText;
        row.style.display = show ? '' : 'none';
        if (show) visible++;
    });

    const emptyEl = document.getElementById('txEmpty');
    if (emptyEl) emptyEl.style.display = visible === 0 ? 'block' : 'none';

    const countEl = document.getElementById('txCount');
    if (countEl) countEl.textContent = visible + ' opération(s)';
}

/* ── Quick amount buttons ── */
function setAmount(val) {
    document.getElementById('amountInput').value = val;
}

/* ── Card number: auto-space + brand detection (mirrors Java real-time validation) ── */
const cardNumberInput = document.getElementById('card_number');
const cardBrandEl    = document.getElementById('cardBrand');

cardNumberInput.addEventListener('input', function () {
    let raw = this.value.replace(/\D/g, '').slice(0, 16);
    this.value = raw.match(/.{1,4}/g)?.join(' ') || '';

    // Brand detection: 4 = Visa, 5 = Mastercard (same as Java)
    if (raw.startsWith('4')) {
        cardBrandEl.innerHTML = '<svg width="38" height="24" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="38" height="24" rx="4" fill="#1A1F71"/><path d="M15.5 16.5h-2.1l1.3-8h2.1l-1.3 8zm7.1-7.8c-.4-.2-1.1-.4-1.9-.4-2.1 0-3.6 1.1-3.6 2.7 0 1.2 1.1 1.9 1.9 2.3.8.4 1.1.7 1.1 1.1 0 .6-.7.9-1.3.9-.9 0-1.3-.1-2-.4l-.3-.1-.3 1.8c.5.2 1.4.5 2.4.5 2.3 0 3.7-1.1 3.7-2.8 0-.9-.6-1.6-1.9-2.2-.8-.4-1.3-.6-1.3-1 0-.3.4-.7 1.3-.7.7 0 1.3.2 1.7.3l.2.1.3-1.7-.3-.1zM27 8.5h-1.6c-.5 0-.9.1-1.1.7l-3.1 7.3h2.2l.4-1.2h2.7l.2 1.2H29L27 8.5zm-2.6 5.3l.8-2.3.5 2.3h-1.3zM13.3 8.5l-2.1 5.5-.2-1.1c-.4-1.3-1.6-2.7-3-3.4l1.9 6.5h2.3l3.4-7.5h-2.3z" fill="white"/><path d="M9.7 8.5H6.3l-.1.2c2.6.7 4.4 2.3 5.1 4.2l-.7-3.7c-.1-.6-.5-.7-1-.7z" fill="#F9A533"/></svg>';
        cardBrandEl.style.opacity = '1';
        cardBrandEl.title = 'Visa';
    } else if (raw.startsWith('5')) {
        cardBrandEl.innerHTML = '<svg width="38" height="24" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="38" height="24" rx="4" fill="#252525"/><circle cx="15" cy="12" r="7" fill="#EB001B"/><circle cx="23" cy="12" r="7" fill="#F79E1B"/><path d="M19 6.8a7 7 0 0 1 0 10.4A7 7 0 0 1 19 6.8z" fill="#FF5F00"/></svg>';
        cardBrandEl.style.opacity = '1';
        cardBrandEl.title = 'Mastercard';
    } else {
        cardBrandEl.innerHTML = '<i class="bi bi-credit-card-2-back" style="font-size:20px;color:var(--text-mid);"></i>';
        cardBrandEl.style.opacity = raw.length > 0 ? '0.5' : '0.25';
        cardBrandEl.title = '';
    }

    validateField(this, /^\d{16}$/.test(raw), document.getElementById('err_number'),
        'Numéro de carte invalide (16 chiffres requis)');
});

/* ── Expiry: auto-insert "/" after 2 digits (mirrors Java) ── */
const expiryInput = document.getElementById('card_expiry');
expiryInput.addEventListener('input', function () {
    let raw = this.value.replace(/\D/g, '').slice(0, 4);
    if (raw.length > 2) {
        this.value = raw.slice(0, 2) + '/' + raw.slice(2);
    } else {
        this.value = raw;
    }
    validateField(this, /^(0[1-9]|1[0-2])\/\d{2}$/.test(this.value), document.getElementById('err_expiry'),
        'Format invalide (MM/AA requis)');
});

/* ── CVC: digits only, max 3 ── */
const cvcInput = document.getElementById('card_cvc');
cvcInput.addEventListener('input', function () {
    this.value = this.value.replace(/\D/g, '').slice(0, 3);
    validateField(this, /^\d{3}$/.test(this.value), document.getElementById('err_cvc'),
        'CVC invalide (3 chiffres requis)');
});

/* ── Cardholder name ── */
const nameInput = document.getElementById('card_name');
nameInput.addEventListener('blur', function () {
    validateField(this, this.value.trim() !== '', document.getElementById('err_name'),
        'Le nom du titulaire est requis');
});

/* ── Helper ── */
function validateField(input, isValid, errorEl, message) {
    if (isValid) {
        input.classList.add('is-valid');
        input.classList.remove('is-invalid');
        errorEl.textContent = '';
    } else {
        input.classList.add('is-invalid');
        input.classList.remove('is-valid');
        errorEl.textContent = message;
    }
}

/* ── Form submit guard ── */
document.getElementById('rechargeForm').addEventListener('submit', function (e) {
    const name   = nameInput.value.trim();
    const number = cardNumberInput.value.replace(/\s/g, '');
    const expiry = expiryInput.value.trim();
    const cvc    = cvcInput.value.trim();
    const amount = parseFloat(document.getElementById('amountInput').value);
    const errors = [];

    if (!name)                                     errors.push('Nom du titulaire requis.');
    if (!/^\d{16}$/.test(number))                  errors.push('Numéro de carte invalide (16 chiffres).');
    if (!/^(0[1-9]|1[0-2])\/\d{2}$/.test(expiry)) errors.push('Date d\'expiration invalide (MM/AA).');
    if (!/^\d{3}$/.test(cvc))                      errors.push('CVC invalide (3 chiffres).');
    if (!amount || amount < 2)                     errors.push('Montant minimum : 2 DT.');

    if (errors.length > 0) {
        e.preventDefault();
        const box = document.getElementById('formError');
        box.innerHTML = errors.map(e => '<i class="bi bi-exclamation-circle" style="margin-right:5px;"></i>' + e).join('<br>');
        box.style.display = 'block';
        box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
});
</script>
{% endblock %}
