{% extends 'base.html.twig' %}
{% block title %}Inscription — MindBloom{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
{% endblock %}

{% block body %}
<div class="auth-page">

    {# ── LEFT PANEL ── #}
    <div class="auth-panel-left">
        <div class="auth-panel-left__content">

            <div class="auth-brand-block">
                <img src="{{ asset('images/mindbloom_logo.png') }}" alt="MindBloom">
                <p class="auth-brand-tagline">Rejoignez notre communauté</p>
            </div>

            <div class="auth-feature-list">
                <div class="auth-feature">
                    <div class="auth-feature__icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                            <polyline points="22 4 12 14.01 9 11.01"/>
                        </svg>
                    </div>
                    <div>
                        <h4>Inscription gratuite</h4>
                        <p>Créez votre compte en moins de 2 minutes</p>
                    </div>
                </div>

                <div class="auth-feature">
                    <div class="auth-feature__icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                    </div>
                    <div>
                        <h4>Données sécurisées</h4>
                        <p>Vos informations personnelles sont protégées</p>
                    </div>
                </div>

                <div class="auth-feature">
                    <div class="auth-feature__icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                        </svg>
                    </div>
                    <div>
                        <h4>Accompagnement continu</h4>
                        <p>Un suivi personnalisé tout au long de votre parcours</p>
                    </div>
                </div>
            </div>

            <div class="auth-metrics">
                <div class="auth-metric">
                    <span class="auth-metric__value">500+</span>
                    <span class="auth-metric__label">Patients</span>
                </div>
                <div class="auth-metric__sep"></div>
                <div class="auth-metric">
                    <span class="auth-metric__value">50+</span>
                    <span class="auth-metric__label">Psychologues</span>
                </div>
                <div class="auth-metric__sep"></div>
                <div class="auth-metric">
                    <span class="auth-metric__value">98%</span>
                    <span class="auth-metric__label">Satisfaction</span>
                </div>
            </div>

        </div>
    </div>

    {# ── RIGHT PANEL ── #}
    <div class="auth-panel-right" style="padding:30px 40px;">
        <div class="auth-card auth-card--wide">

            <div class="auth-card__header">
                <h2>Créer un compte</h2>
                <p>Rejoignez MindBloom et prenez soin de vous</p>
            </div>

            {{ form_errors(registrationForm) }}

            {{ form_start(registrationForm, {action: path('app_register'), method: 'post', attr: {class: 'auth-form'}}) }}
                {{ form_widget(registrationForm.roles, {attr: {id: 'roleInput', value: 'PATIENT'}}) }}

                {# Role selector - inside form #}
                <div class="auth-field" style="margin-bottom: 16px;">
                    <label>Je suis un(e)</label>
                    <div class="auth-role-selector" id="roleSelector">
                        <div class="auth-role selected" onclick="selectRole('PATIENT', this)">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                            <span>Patient</span>
                        </div>
                        <div class="auth-role" onclick="selectRole('PSYCHOLOGUE', this)">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                            </svg>
                            <span>Psychologue</span>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <div class="auth-field" style="margin-bottom:0;">
                            <label>Nom complet <span class="text-danger">*</span></label>
                            <div class="auth-input-wrap">
                                <svg class="auth-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                                {{ form_widget(registrationForm.fullName, {
                                    'attr': {'class': 'auth-input', 'placeholder': 'Prénom Nom'}
                                }) }}
                            </div>
                            {{ form_errors(registrationForm.fullName) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="auth-field" style="margin-bottom:0;">
                            <label>Nom d'utilisateur <span class="text-danger">*</span></label>
                            {{ form_widget(registrationForm.username, {
                                'attr': {'class': 'auth-input', 'placeholder': 'username'}
                            }) }}
                            {{ form_errors(registrationForm.username) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="auth-field" style="margin-bottom:0;">
                            <label>Email <span class="text-danger">*</span></label>
                            {{ form_widget(registrationForm.email, {
                                'attr': {'class': 'auth-input', 'placeholder': 'email@exemple.com'}
                            }) }}
                            {{ form_errors(registrationForm.email) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="auth-field" style="margin-bottom:0;">
                            <label>Téléphone</label>
                            {{ form_widget(registrationForm.phone, {
                                'attr': {'class': 'auth-input', 'placeholder': '+216'}
                            }) }}
                            {{ form_errors(registrationForm.phone) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="auth-field" style="margin-bottom:0;">
                            <label>Date de naissance <span class="text-danger">*</span></label>
                            {{ form_widget(registrationForm.dateOfBirth, {
                                'attr': {'class': 'auth-input'}
                            }) }}
                            {{ form_errors(registrationForm.dateOfBirth) }}
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="auth-field" style="margin-bottom:0;">
                            <label>Adresse</label>
                            {{ form_widget(registrationForm.address, {
                                'attr': {'class': 'auth-input', 'placeholder': 'Votre adresse'}
                            }) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="auth-field" style="margin-bottom:0;">
                            <label>Mot de passe <span class="text-danger">*</span></label>
                            {{ form_widget(registrationForm.plainPassword.first, {
                                'attr': {'class': 'auth-input', 'placeholder': 'Min. 8 caractères', 'id': 'password-field'}
                            }) }}
                            <div class="password-strength-container mt-2">
                                <div class="password-strength-bar" id="password-strength-bar"></div>
                            </div>
                            <small class="password-strength-text" id="password-strength-text"></small>
                            {{ form_errors(registrationForm.plainPassword) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="auth-field" style="margin-bottom:0;">
                            <label>Confirmer <span class="text-danger">*</span></label>
                            {{ form_widget(registrationForm.plainPassword.second, {
                                'attr': {'class': 'auth-input', 'placeholder': 'Confirmez le mot de passe', 'id': 'password-confirm-field'}
                            }) }}
                            <small class="password-match-text" id="password-match-text"></small>
                        </div>
                    </div>
                </div>

                <button type="submit" class="auth-btn" style="margin-top:24px;">
                    Créer mon compte
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                        <polyline points="12 5 19 12 12 19"/>
                    </svg>
                </button>
            {{ form_end(registrationForm) }}

            <div class="auth-divider">
                <span>ou</span>
            </div>

            <p class="auth-footer">
                Déjà inscrit ?
                <a href="{{ path('app_login') }}">Se connecter</a>
            </p>
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function selectRole(role, el) {
    document.querySelectorAll('.auth-role').forEach(o => o.classList.remove('selected'));
    el.classList.add('selected');
    // Target by name to be safe regardless of rendered id
    var roleField = document.getElementById('roleInput')
        || document.querySelector('input[name="registration_form[roles]"]');
    if (roleField) roleField.value = role;
}

// Password strength checker
document.addEventListener('DOMContentLoaded', function() {
    // Find password fields by name attribute (more reliable than ID)
    const passwordField = document.querySelector('input[name="registration_form[plainPassword][first]"]');
    const confirmField = document.querySelector('input[name="registration_form[plainPassword][second]"]');
    const strengthBar = document.getElementById('password-strength-bar');
    const strengthText = document.getElementById('password-strength-text');
    const matchText = document.getElementById('password-match-text');

    console.log('Password field found:', passwordField);
    console.log('Confirm field found:', confirmField);

    function checkPasswordStrength(password) {
        let score = 0;
        const checks = {
            length: password.length >= 8,
            lowercase: /[a-z]/.test(password),
            uppercase: /[A-Z]/.test(password),
            numbers: /\d/.test(password),
            special: /[!@#$%^&*(),.?":{}|<>]/.test(password),
            longLength: password.length >= 12
        };

        if (checks.length) score++;
        if (checks.lowercase) score++;
        if (checks.uppercase) score++;
        if (checks.numbers) score++;
        if (checks.special) score++;
        if (checks.longLength) score++;

        return { score, checks };
    }

    function updateStrengthIndicator(password) {
        if (!strengthBar || !strengthText) return;
        
        if (!password) {
            strengthBar.style.width = '0%';
            strengthBar.style.backgroundColor = '#e0e0e0';
            strengthText.textContent = '';
            return;
        }

        const { score, checks } = checkPasswordStrength(password);
        let width, color, text;

        if (score <= 2) {
            width = '33%';
            color = '#dc3545'; // Red - Faible
            text = 'Faible - Ajoutez majuscules, chiffres et caractères spéciaux';
        } else if (score <= 4) {
            width = '66%';
            color = '#fd7e14'; // Orange - Moyen
            text = 'Moyen - Ajoutez des caractères spéciaux pour plus de sécurité';
        } else {
            width = '100%';
            color = '#28a745'; // Green - Fort
            text = 'Fort - Excellent mot de passe !';
        }

        strengthBar.style.width = width;
        strengthBar.style.backgroundColor = color;
        strengthText.textContent = text;
        strengthText.style.color = color;

        // Show tips
        let tips = [];
        if (!checks.length) tips.push('au moins 8 caractères');
        if (!checks.uppercase) tips.push('une majuscule');
        if (!checks.lowercase) tips.push('une minuscule');
        if (!checks.numbers) tips.push('un chiffre');
        if (!checks.special) tips.push('un caractère spécial (!@#$...)');

        if (tips.length > 0 && score < 5) {
            strengthText.textContent = text + ' - Manque: ' + tips.slice(0, 2).join(', ');
        }
    }

    function checkPasswordMatch() {
        if (!passwordField || !confirmField || !matchText) return;
        
        const password = passwordField.value;
        const confirm = confirmField.value;

        if (!confirm) {
            matchText.textContent = '';
            return;
        }

        if (password === confirm) {
            matchText.textContent = '✓ Les mots de passe correspondent';
            matchText.style.color = '#28a745';
        } else {
            matchText.textContent = '✗ Les mots de passe ne correspondent pas';
            matchText.style.color = '#dc3545';
        }
    }

    if (passwordField) {
        passwordField.addEventListener('input', function() {
            updateStrengthIndicator(this.value);
            checkPasswordMatch();
        });
        passwordField.addEventListener('keyup', function() {
            updateStrengthIndicator(this.value);
            checkPasswordMatch();
        });
    }

    if (confirmField) {
        confirmField.addEventListener('input', checkPasswordMatch);
        confirmField.addEventListener('keyup', checkPasswordMatch);
    }
});
</script>

<style>
.password-strength-container {
    height: 8px;
    background-color: #e0e0e0;
    border-radius: 4px;
    overflow: hidden;
    margin-top: 8px;
}

.password-strength-bar {
    height: 100%;
    width: 0%;
    transition: width 0.3s ease, background-color 0.3s ease;
    border-radius: 4px;
}

.password-strength-text,
.password-match-text {
    display: block;
    font-size: 12px;
    margin-top: 6px;
    min-height: 18px;
    font-weight: 500;
}
</style>
{% endblock %}
