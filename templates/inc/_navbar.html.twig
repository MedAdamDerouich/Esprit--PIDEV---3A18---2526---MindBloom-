{# Main Patient Navbar - Used by base.html.twig #}
<style>
@keyframes nav-ripple {
    0%   { transform: scale(0); opacity: 0.4; }
    100% { transform: scale(3); opacity: 0; }
}
.mnav-link {
    position: relative;
    font-size: 14px;
    color: #2C3E50;
    text-decoration: none !important;
    padding: 8px 14px !important;
    border-radius: 10px;
    overflow: hidden;
    font-weight: 500;
    transition: color 0.2s ease, background 0.2s ease, transform 0.22s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.2s ease;
    display: inline-block;
}
/* ANIMATION 1 — color change + lift on hover */
.mnav-link:hover {
    color: #4A90E2 !important;
    background: transparent !important;
    transform: translateY(-3px);
    box-shadow: none;
    border-bottom: none !important;
}
/* ANIMATION 2 — underline bar scales in from center */
.mnav-link::after {
    content: '';
    position: absolute;
    bottom: 3px;
    left: 14px;
    right: 14px;
    height: 2.5px;
    background: #4A90E2;
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1);
}
.mnav-link:hover::after,
.mnav-link.mnav-active::after {
    transform: scaleX(1);
}
/* ANIMATION 3 — ripple burst on click */
.mnav-link::before {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    width: 20px; height: 20px;
    margin: -10px 0 0 -10px;
    border-radius: 50%;
    background: rgba(74,144,226,0.3);
    transform: scale(0);
    opacity: 0;
    pointer-events: none;
}
.mnav-link:active::before {
    animation: nav-ripple 0.5s ease-out forwards;
}
.mnav-link.mnav-active {
    color: #4A90E2 !important;
    font-weight: 700;
    background: transparent !important;
}

/* ══════════════════════════════════════════
   DARK MODE — surgical, no wildcard div rule
   ══════════════════════════════════════════ */

/* ── Smooth transitions (applies light AND dark) — unified timing so page & navbar swap together ── */
body,
body header,
body .mnav-link,
body .mnav-wallet,
body .mnav-profile-inner,
body .mnav-logout,
body .service-card-3d,
body .wallet-balance-card,
body .mb-card,
body .card,
body .transaction-row,
body input, body textarea, body select,
body .modal-content,
body .form-control,
body .btn {
    transition: background-color 0.25s ease, background 0.25s ease,
                color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
}

/* ── Body & page background ── */
body.dark-mode {
    background: #0F1117 !important;
    color: #D8DCE8;
}

/* ── Wider coverage: generic pages ── */
body.dark-mode main,
body.dark-mode section:not(#hero-section):not(#services-section),
body.dark-mode .container,
body.dark-mode .container-fluid {
    color: #D8DCE8;
}

/* ── Cards / generic containers ── */
body.dark-mode .card,
body.dark-mode .mb-card,
body.dark-mode .wallet-balance-card,
body.dark-mode .panel,
body.dark-mode .box {
    background: #161A26 !important;
    color: #D8DCE8 !important;
    border-color: #252B3E !important;
    box-shadow: 0 10px 30px rgba(0,0,0,0.35) !important;
}
body.dark-mode .card-header,
body.dark-mode .card-footer {
    background: #1A1F2E !important;
    border-color: #252B3E !important;
    color: #D8DCE8 !important;
}
body.dark-mode .card-title,
body.dark-mode h1, body.dark-mode h2,
body.dark-mode h3, body.dark-mode h4,
body.dark-mode h5, body.dark-mode h6 {
    color: #E8EAF0 !important;
}
body.dark-mode p, body.dark-mode span, body.dark-mode li,
body.dark-mode td, body.dark-mode label {
    color: inherit;
}
body.dark-mode .text-muted,
body.dark-mode small {
    color: #6A7385 !important;
}

/* ── Tables ── */
body.dark-mode table,
body.dark-mode .table {
    color: #D8DCE8 !important;
    background: transparent !important;
}
body.dark-mode .table thead th {
    background: #1A1F2E !important;
    color: #E8EAF0 !important;
    border-color: #252B3E !important;
}
body.dark-mode .table tbody tr {
    border-color: #252B3E !important;
}
body.dark-mode .table tbody tr:hover,
body.dark-mode .transaction-row:hover {
    background: #1A1F2E !important;
}
body.dark-mode .table-striped tbody tr:nth-of-type(odd) {
    background: #141824 !important;
}

/* ── Forms ── */
body.dark-mode input,
body.dark-mode textarea,
body.dark-mode select,
body.dark-mode .form-control,
body.dark-mode .form-select {
    background: #1A1F2E !important;
    color: #E8EAF0 !important;
    border-color: #2A3147 !important;
}
body.dark-mode input::placeholder,
body.dark-mode textarea::placeholder {
    color: #5A6275 !important;
}
body.dark-mode input:focus,
body.dark-mode textarea:focus,
body.dark-mode select:focus,
body.dark-mode .form-control:focus {
    background: #1E2333 !important;
    border-color: #4A90E2 !important;
    box-shadow: 0 0 0 3px rgba(74,144,226,0.15) !important;
    color: #E8EAF0 !important;
}

/* ── Buttons (neutral only, keep colored buttons as-is) ── */
body.dark-mode .btn-light,
body.dark-mode .btn-secondary,
body.dark-mode .btn-outline-secondary {
    background: #1E2333 !important;
    color: #D8DCE8 !important;
    border-color: #2A3147 !important;
}

/* ── Modals ── */
body.dark-mode .modal-content {
    background: #161A26 !important;
    color: #D8DCE8 !important;
    border-color: #252B3E !important;
}
body.dark-mode .modal-header,
body.dark-mode .modal-footer {
    border-color: #252B3E !important;
}

/* ── Wallet page specific ── */
body.dark-mode .wallet-balance-card {
    background: linear-gradient(135deg, #152B22 0%, #1A3529 100%) !important;
    border-color: #1E4434 !important;
}
body.dark-mode .transaction-row {
    background: #161A26 !important;
    border-color: #252B3E !important;
}

/* ── Links inside content ── */
body.dark-mode a:not(.mnav-link):not(.mnav-logout):not(.mnav-wallet):not(.btn) {
    color: #7BB8F5;
}

/* ── Navbar ── */
body.dark-mode header {
    background: #161A26 !important;
    box-shadow: 0 4px 24px rgba(0,0,0,0.5) !important;
}
/* Brand name */
body.dark-mode header a > span {
    color: #E8EAF0 !important;
}

/* ── Nav links ── */
body.dark-mode .mnav-link {
    color: #A8B0C4 !important;
}
body.dark-mode .mnav-link:hover,
body.dark-mode .mnav-link.mnav-active {
    color: #7BB8F5 !important;
}
body.dark-mode .mnav-link::after {
    background: #7BB8F5;
}


/* ── Wallet ── */
body.dark-mode .mnav-wallet {
    background: #152B22 !important;
    border-color: #1E4434 !important;
}
body.dark-mode .mnav-wallet:hover {
    background: #1A3529 !important;
}
body.dark-mode .mnav-wallet-amount {
    color: #5FBF9F !important;
}

/* ── Divider ── */
body.dark-mode .dm-divider {
    background: #252B3E !important;
}

/* ── Profile pill ── */
body.dark-mode .mnav-profile-inner {
    background: #1E2333 !important;
    border-color: transparent !important;
}
body.dark-mode .mnav-profile-greeting {
    color: #4A5268 !important;
}
body.dark-mode .mnav-profile-name {
    color: #D8DCE8 !important;
}

/* ── Logout ── */
body.dark-mode .mnav-logout {
    background: #221518 !important;
    color: #E07070 !important;
    border-color: #3D2020 !important;
}

/* ── Hero section ── */
body.dark-mode #hero-section {
    background: #0F1117 !important;
}
body.dark-mode #hero-title {
    color: #E8EAF0 !important;
}
body.dark-mode #hero-desc {
    color: #6A7385 !important;
}
body.dark-mode #hero-badge {
    background: #1A2540 !important;
    color: #7BB8F5 !important;
}

/* ── Main wrappers ── */
body.dark-mode #main-wrapper {
    background: #0F1117 !important;
}
body.dark-mode #services-section {
    background: #0F1117 !important;
}
body.dark-mode #services-title {
    color: #E8EAF0 !important;
}
body.dark-mode #services-subtitle {
    color: #6A7385 !important;
}

/* ── Stats bar ── */
body.dark-mode #stats-bar {
    background: #161A26 !important;
    border-color: #1E2333 !important;
}
body.dark-mode #stats-bar .stat-label {
    color: #5A6275 !important;
}

/* ── Service cards ── */
body.dark-mode .service-card-3d {
    background: #161A26 !important;
    box-shadow: 0 10px 30px rgba(0,0,0,0.4) !important;
}
body.dark-mode .service-card-3d .card-title {
    color: #D8DCE8 !important;
}
body.dark-mode .service-card-3d .card-desc {
    color: #5A6275 !important;
}
body.dark-mode .service-card-3d .card-icon-box-blue {
    background: #1A2540 !important;
}
body.dark-mode .service-card-3d .card-icon-box-green {
    background: #152B22 !important;
}

/* Dark-mode toggle button (desk lamp) */
body.dark-mode #dm-toggle {
    background: #1E2333 !important;
    border-color: #2A3147 !important;
}
body.dark-mode #dm-toggle:hover {
    background: #252B3E !important;
    border-color: #5EDDE1 !important;
    box-shadow: 0 6px 16px rgba(94,221,225,0.25) !important;
}

/* ── Icon action buttons (factures, cart) ── */
.mnav-icon-btn {
    background: #F0F4FF;
    border: 1.5px solid rgba(74,144,226,0.14);
    border-radius: 14px;
    width: 44px; height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    position: relative;
    flex-shrink: 0;
    transition: background 0.2s ease, border-color 0.2s ease,
                transform 0.22s cubic-bezier(0.34,1.56,0.64,1),
                box-shadow 0.2s ease;
}
.mnav-icon-btn:hover {
    background: #E2ECFF;
    border-color: rgba(74,144,226,0.4);
    transform: translateY(-3px) scale(1.07);
    box-shadow: 0 6px 18px rgba(74,144,226,0.22);
}
.mnav-icon-btn svg {
    display: block;
    stroke: #4A90E2;
    transition: transform 0.22s cubic-bezier(0.34,1.56,0.64,1);
}
.mnav-icon-btn:hover svg { transform: scale(1.12); }
.mnav-icon-btn .mnav-badge {
    position: absolute;
    top: -7px; right: -7px;
    background: linear-gradient(135deg, #ff5252, #e74c3c);
    color: white;
    border-radius: 50%;
    min-width: 19px; height: 19px;
    padding: 0 4px;
    font-size: 10px;
    font-weight: 800;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 3px 8px rgba(231,76,60,0.55);
    border: 2px solid white;
    letter-spacing: -0.3px;
}

/* ── Logout button ── */
.mnav-logout {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #FEF0EF;
    color: #e74c3c !important;
    border: 1.5px solid #FBCFCC;
    border-radius: 22px;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none !important;
    white-space: nowrap;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease,
                transform 0.18s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.18s ease;
}
.mnav-logout:hover {
    background: #e74c3c !important;
    color: white !important;
    border-color: #e74c3c !important;
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(231,76,60,0.3);
}
.mnav-logout svg { transition: stroke 0.18s ease; }
.mnav-logout:hover svg { stroke: white; }

/* Dark mode icon buttons */
body.dark-mode .mnav-icon-btn {
    background: #1A1F2E !important;
    border-color: rgba(123,184,245,0.18) !important;
}
body.dark-mode .mnav-icon-btn:hover {
    background: #212840 !important;
    border-color: rgba(123,184,245,0.45) !important;
    box-shadow: 0 6px 18px rgba(0,0,0,0.4) !important;
}
body.dark-mode .mnav-icon-btn svg { stroke: #7BB8F5; }
body.dark-mode .mnav-badge { border-color: #0F1117 !important; }

/* Dark mode logout */
body.dark-mode .mnav-logout {
    background: #221518 !important;
    color: #E07070 !important;
    border-color: #3D2020 !important;
}
body.dark-mode .mnav-logout:hover {
    background: #c0392b !important;
    color: white !important;
    border-color: #c0392b !important;
}
body.dark-mode .mnav-logout svg { stroke: #E07070; }
body.dark-mode .mnav-logout:hover svg { stroke: white; }

/* ── Wallet animation ── */
@keyframes wallet-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(95,191,159,0.5); }
    70%  { box-shadow: 0 0 0 8px rgba(95,191,159,0); }
    100% { box-shadow: 0 0 0 0 rgba(95,191,159,0); }
}
.mnav-wallet {
    display: flex;
    align-items: center;
    gap: 6px;
    border-radius: 22px;
    padding: 7px 14px;
    text-decoration: none;
    transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1),
                background 0.2s ease,
                box-shadow 0.2s ease;
}
.mnav-wallet:hover {
    transform: translateY(-3px) scale(1.05);
    background: #D4F1E8 !important;
    box-shadow: 0 6px 18px rgba(95,191,159,0.35);
    animation: wallet-pulse 0.8s ease-out;
}
.mnav-wallet:hover .mnav-wallet-amount {
    color: #3DA07A !important;
}
</style>
{% if is_granted('ROLE_PATIENT') %}
<header style="background:white;height:85px;padding:0 50px;display:flex;align-items:center;
               gap:30px;box-shadow:0 4px 18px rgba(0,0,0,0.07);position:sticky;top:0;z-index:1000;">

    {# Logo + brand name #}
    <a href="{{ path('app_patient_dashboard') }}" style="display:flex;align-items:center;gap:12px;flex-shrink:0;text-decoration:none;">
        <img src="{{ asset('images/mindbloom_logo2.png') }}" alt="MindBloom"
             style="height:70px;width:70px;object-fit:contain;">
        <span style="font-size:24px;font-weight:800;color:#2C3E50;">MindBloom</span>
    </a>

    {# Navigation links — centered #}
    <nav style="flex:1;display:flex;justify-content:center;gap:6px;align-items:center;">
        <a href="{{ path('app_produit_index') }}"
           class="mnav-link {{ app.request.attributes.get('_route') starts with 'app_produit' ? 'mnav-active' : '' }}">Produits</a>

        <a href="{{ path('app_patient_cabinets_index') }}"
           class="mnav-link {{ app.request.attributes.get('_route') == 'app_patient_cabinets_index' ? 'mnav-active' : '' }}">Rendez-vous</a>

        <a href="{{ path('app_test_index') }}"
           class="mnav-link {{ app.request.attributes.get('_route') starts with 'app_test' ? 'mnav-active' : '' }}">Tests</a>

        <a href="{{ path('app_patient_event_index') }}"
           class="mnav-link {{ app.request.attributes.get('_route') starts with 'app_patient_event' ? 'mnav-active' : '' }}">Événements</a>

        <a href="{{ path('app_patient_reservations') }}"
           class="mnav-link {{ app.request.attributes.get('_route') == 'app_patient_reservations' ? 'mnav-active' : '' }}">Mes Réservations</a>
    </nav>

    {# Right actions #}
    <div style="display:flex;align-items:center;gap:12px;flex-shrink:0;">

        {# Factures #}
        <a href="{{ path('app_order_history') }}" class="mnav-icon-btn" title="Mes Factures">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4A90E2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
            </svg>
        </a>

        {# Cart #}
        <a href="{{ path('app_cart_index') }}" class="mnav-icon-btn" title="Mon Panier">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4A90E2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
            <span class="mnav-badge">{{ render(controller('App\\Controller\\CartController::cartCount')) }}</span>
        </a>

        {# Wallet badge #}
        <a href="{{ path('app_wallet') }}"
           class="mnav-wallet"
           style="background:{{ app.request.attributes.get('_route') == 'app_wallet' ? '#D4F1E8' : '#EDF9F5' }};
                  border:1.5px solid {{ app.request.attributes.get('_route') == 'app_wallet' ? '#5FBF9F' : 'transparent' }};">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5FBF9F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>
            </svg>
            <span class="mnav-wallet-amount" style="font-size:13px;font-weight:700;color:#5FBF9F;transition:color 0.2s ease;">{{ wallet_balance(app.user) }} DT</span>
        </a>

        {# Divider #}
        <div class="dm-divider" style="width:1px;height:36px;background:#EBEBEB;"></div>

        {# Profile pill — clickable, links to profile #}
        <a href="{{ path('app_profile') }}" style="text-decoration:none;" title="Modifier mon profil">
            <div class="mnav-profile-inner" style="display:flex;align-items:center;gap:10px;
                        background:{{ app.request.attributes.get('_route') starts with 'app_profile' ? '#EAF2FB' : '#F8F9FA' }};
                        border:1.5px solid {{ app.request.attributes.get('_route') starts with 'app_profile' ? '#4A90E2' : 'transparent' }};
                        border-radius:30px;padding:5px 14px 5px 5px;
                        transition:all 0.15s;cursor:pointer;"
                 onmouseover="this.style.background='#EAF2FB';this.style.border='1.5px solid #4A90E2';"
                 onmouseout="this.style.background='{{ app.request.attributes.get('_route') starts with 'app_profile' ? '#EAF2FB' : '#F8F9FA' }}';this.style.border='1.5px solid {{ app.request.attributes.get('_route') starts with 'app_profile' ? '#4A90E2' : 'transparent' }}';">

                {# Avatar #}
                <div style="position:relative;width:40px;height:40px;flex-shrink:0;">
                    <div style="width:40px;height:40px;border-radius:50%;border:2px solid #4A90E2;
                                background:white;overflow:hidden;display:flex;align-items:center;justify-content:center;">
                        {% if app.user.profileImage %}
                            <img src="{{ asset('uploads/profiles/' ~ app.user.profileImage) }}"
                                 style="width:100%;height:100%;object-fit:cover;" alt="">
                        {% else %}
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4A90E2" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                            </svg>
                        {% endif %}
                    </div>
                    {# Edit pencil badge #}
                    <div style="position:absolute;bottom:-1px;right:-2px;width:16px;height:16px;
                                background:#4A90E2;border-radius:50%;border:2px solid white;
                                display:flex;align-items:center;justify-content:center;">
                        <svg width="8" height="8" viewBox="0 0 10 10" fill="none">
                            <path d="M7 1.5L8.5 3 3.5 8H2V6.5L7 1.5Z" fill="white" stroke="white" stroke-width="0.3"/>
                        </svg>
                    </div>
                </div>

                {# Name #}
                <div>
                    <div class="mnav-profile-greeting" style="font-size:11px;color:#aaa;line-height:1.1;">Bonjour,</div>
                    <div class="mnav-profile-name" style="font-size:13px;font-weight:700;color:#2C3E50;line-height:1.2;">
                        {{ app.user.fullName|split(' ')|first }}
                    </div>
                </div>
            </div>
        </a>

        {# Dark mode toggle — desk lamp (pull the cord) #}
        <button id="dm-toggle" type="button" title="Basculer le mode sombre"
                style="width:44px;height:44px;border:1.5px solid transparent;background:#EAF2FB;border-radius:12px;
                       cursor:pointer;display:flex;align-items:center;justify-content:center;
                       flex-shrink:0;transition:background 0.18s ease, border-color 0.18s ease, transform 0.2s ease, box-shadow 0.2s ease;padding:0;"
                onmouseover="this.style.background='#DCE8F7';this.style.borderColor='#4A90E2';this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 14px rgba(74,144,226,0.25)';"
                onmouseout="this.style.background='#EAF2FB';this.style.borderColor='transparent';this.style.transform='translateY(0)';this.style.boxShadow='none';">
            <svg id="dm-lamp" width="36" height="36" viewBox="0 0 40 40"
                 xmlns="http://www.w3.org/2000/svg">
                <defs>
                    {# Shade — brand navy/cyan gradient #}
                    <linearGradient id="dm-shade" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%"  stop-color="#4A90E2"/>
                        <stop offset="100%" stop-color="#1B3A6B"/>
                    </linearGradient>
                    {# Shade highlight #}
                    <linearGradient id="dm-shade-hi" x1="0%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%"  stop-color="#FFFFFF" stop-opacity="0.35"/>
                        <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0"/>
                    </linearGradient>
                    {# Stem/base — cool grey #}
                    <linearGradient id="dm-metal" x1="0%" y1="0%" x2="100%" y2="0%">
                        <stop offset="0%"   stop-color="#B8C2D4"/>
                        <stop offset="50%"  stop-color="#E5EAF2"/>
                        <stop offset="100%" stop-color="#B8C2D4"/>
                    </linearGradient>
                </defs>

                {# Mushroom shade — inset to fit the button frame #}
                <path d="M10 17 Q10 8 20 8 Q30 8 30 17 Z"
                      fill="url(#dm-shade)" stroke="#14294A" stroke-width="0.6"/>
                {# Shade highlight sheen #}
                <path d="M12 15 Q13 10 20 9.5 Q27 10 28 15 Z"
                      fill="url(#dm-shade-hi)"/>
                {# Shade rim #}
                <line x1="10" y1="17" x2="30" y2="17" stroke="#0E1F3A" stroke-width="0.8" stroke-linecap="round"/>

                {# Stem #}
                <rect x="18.8" y="17" width="2.4" height="13" fill="url(#dm-metal)"/>
                {# Base plate #}
                <rect x="13.5" y="29.5" width="13" height="2.8" rx="1" fill="url(#dm-metal)" stroke="#8A94A8" stroke-width="0.4"/>
                {# Base shadow #}
                <ellipse cx="20" cy="33" rx="7.5" ry="1" fill="#000" opacity="0.15"/>

                {# Pull cord + bead — anchored to the shade rim, hanging straight down #}
                <g id="dm-lamp-pull" style="transform-origin: 27px 17px; transition: transform 0.28s cubic-bezier(0.34,1.56,0.64,1);">
                    <line x1="27" y1="17" x2="27" y2="23.5" stroke="#7A8299" stroke-width="0.9" stroke-linecap="round"/>
                    <circle id="dm-lamp-bead" cx="27" cy="24.7" r="1.5" fill="#F5C842" stroke="#B8891F" stroke-width="0.35"/>
                    <circle cx="26.6" cy="24.3" r="0.45" fill="#FFF3B8" opacity="0.9"/>
                </g>
            </svg>
        </button>

        {# Déconnexion #}
        <a href="{{ path('app_logout') }}" class="mnav-logout">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#e74c3c" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
            Déconnexion
        </a>
    </div>
</header>


<script>/* dm-toggle-v5-lamp */
(function () {
    var btn = document.getElementById('dm-toggle');
    if (!btn) return;

    var STORAGE_KEY = 'mindbloom-theme';
    var mql = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;

    function apply(dark) {
        document.body.classList.toggle('dark-mode', dark);
    }

    // Initial theme: user preference wins; otherwise follow OS
    var stored = localStorage.getItem(STORAGE_KEY);
    var initialDark = stored ? (stored === 'dark') : (mql && mql.matches);
    apply(initialDark);

    // Follow system changes ONLY when user hasn't made a manual choice
    if (mql) {
        var sysListener = function (e) {
            if (!localStorage.getItem(STORAGE_KEY)) apply(e.matches);
        };
        if (mql.addEventListener) mql.addEventListener('change', sysListener);
        else if (mql.addListener) mql.addListener(sysListener);
    }

    var pull = document.getElementById('dm-lamp-pull');

    btn.addEventListener('click', function () {
        var dark = !document.body.classList.contains('dark-mode');
        localStorage.setItem(STORAGE_KEY, dark ? 'dark' : 'light');

        // Pull the cord down, then release (spring back)
        if (pull) {
            pull.style.transform = 'translateY(4.5px)';
            setTimeout(function () { pull.style.transform = 'translateY(0)'; }, 240);
        }

        // Brief fade veil for a smooth theme swap
        var veil = document.createElement('div');
        veil.style.cssText = 'position:fixed;inset:0;background:' +
            (dark ? '#0F1117' : '#ffffff') +
            ';opacity:0;pointer-events:none;z-index:99999;transition:opacity 0.25s ease;';
        document.body.appendChild(veil);
        requestAnimationFrame(function () { veil.style.opacity = '0.35'; });

        setTimeout(function () {
            apply(dark);
            veil.style.opacity = '0';
            setTimeout(function () { veil.remove(); }, 280);
        }, 140);
    });
})();
</script>

