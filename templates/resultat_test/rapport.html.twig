{% extends 'base.html.twig' %}

{% block title %}Rapport Analytique — MindBloom{% endblock %}

{% block body %}
<div style="background:#FAFAF8; min-height: calc(100vh - 85px); padding: 50px;">
    <div style="max-width: 900px; margin: 0 auto;">
        
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px;">
            <div>
                <span style="display:inline-block;background:#E8F1FC;color:#4A90E2;border-radius:20px;padding:6px 15px;font-size:13px;margin-bottom:10px;font-weight:600;">
                    🧠 IA & Santé Mentale
                </span>
                <h1 style="font-size:36px;font-weight:900;color:#2C3E50;">Rapport Analytique</h1>
                <p style="color: #7F8C8D; font-size: 16px; margin-top: 5px;">Généré pour {{ patient.fullName }} le {{ "now"|date("d/m/Y") }}</p>
            </div>
            
            <a href="{{ path('app_resultat_test_mes_resultats') }}" style="background: white; color: #7F8C8D; padding: 12px 25px; border-radius: 12px; font-weight: 700; text-decoration: none; border: 2px solid #E0E4E8; transition: all 0.2s;" onmouseover="this.style.background='#F4F6F6'" onmouseout="this.style.background='white'">
                ← Retour
            </a>
        </div>

        <div style="background: white; border-radius: 20px; padding: 40px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border-top: 6px solid #8E2DE2;">
            <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 30px; border-bottom: 2px solid #F4F6F6; padding-bottom: 20px;">
                <div style="background: linear-gradient(135deg, #8E2DE2, #4A00E0); color: white; width: 50px; height: 50px; border-radius: 15px; display: flex; align-items: center; justify-content: center; font-size: 24px;">
                    ✨
                </div>
                <div>
                    <h2 style="font-size: 24px; font-weight: 800; color: #2C3E50; margin: 0;">Analyse par Gemini</h2>
                    <p style="color: #95A5A6; font-size: 14px; margin: 5px 0 0 0;">Basé sur vos derniers résultats de tests d'autoévaluation.</p>
                </div>
            </div>

            <div style="font-size: 16px; line-height: 1.8; color: #34495E; white-space: pre-wrap; font-family: 'Inter', system-ui, sans-serif;">
                {{ rapport }}
            </div>
            
            <div style="margin-top: 40px; padding: 20px; background: #FFF9E6; border-radius: 12px; border-left: 4px solid #F1C40F;">
                <h4 style="font-size: 16px; font-weight: 700; color: #D4AC0D; margin: 0 0 10px 0;">⚠️ Clause de non-responsabilité</h4>
                <p style="font-size: 14px; color: #7F8C8D; margin: 0; line-height: 1.6;">Ce rapport est généré par intelligence artificielle pour vous aider à mieux comprendre votre état. Il ne remplace en aucun cas un diagnostic ou un conseil médical professionnel. En cas de détresse, veuillez consulter un professionnel de la santé.</p>
            </div>
        </div>

    </div>
</div>
{% endblock %}
