{# ═══ MODAL : Mot de passe oublié (3 étapes, port de ForgotPassword.fxml) ═══ #}
<div id="fpModal" class="fp-modal" aria-hidden="true">
  <div class="fp-backdrop" data-fp-close></div>
  <div class="fp-dialog" role="dialog" aria-modal="true" aria-labelledby="fpTitle">
    <button type="button" class="fp-close" data-fp-close aria-label="Fermer">×</button>
    <div class="fp-header">
      <h2 id="fpTitle">Mot de passe oublié</h2>
      <div class="fp-steps">
        <span class="fp-step-dot active" data-dot="1">1</span>
        <span class="fp-step-line"></span>
        <span class="fp-step-dot" data-dot="2">2</span>
        <span class="fp-step-line"></span>
        <span class="fp-step-dot" data-dot="3">3</span>
      </div>
    </div>

    {# Étape 1 #}
    <div class="fp-step" data-step="1">
      <p class="fp-lead">Entrez l'adresse email associée à votre compte. Nous vous enverrons un code à 6 chiffres.</p>
      <label for="fpEmail" class="fp-label">Email</label>
      <input type="email" id="fpEmail" class="fp-input" placeholder="vous@exemple.com" autocomplete="email">
      <div class="fp-msg" id="fpMsg1" hidden></div>
      <button type="button" class="fp-btn fp-btn-primary" id="fpSendBtn">Envoyer le code</button>
    </div>

    {# Étape 2 #}
    <div class="fp-step" data-step="2" hidden>
      <p class="fp-lead" id="fpSentLabel">Un code a été envoyé.</p>
      <label for="fpCode" class="fp-label">Code de vérification (6 chiffres)</label>
      <input type="text" id="fpCode" class="fp-input fp-input-code" maxlength="6" inputmode="numeric" placeholder="••••••">
      <div class="fp-msg" id="fpMsg2" hidden></div>
      <div class="fp-row">
        <button type="button" class="fp-btn fp-btn-ghost" id="fpResendBtn">Renvoyer</button>
        <button type="button" class="fp-btn fp-btn-primary" id="fpVerifyBtn">Vérifier</button>
      </div>
    </div>

    {# Étape 3 #}
    <div class="fp-step" data-step="3" hidden>
      <p class="fp-lead">Créez un nouveau mot de passe sécurisé.</p>
      <label for="fpNew" class="fp-label">Nouveau mot de passe</label>
      <input type="password" id="fpNew" class="fp-input" autocomplete="new-password">
      <div class="fp-strength" id="fpStrength" hidden></div>
      <label for="fpConfirm" class="fp-label">Confirmer le mot de passe</label>
      <input type="password" id="fpConfirm" class="fp-input" autocomplete="new-password">
      <div class="fp-msg" id="fpMsg3" hidden></div>
      <button type="button" class="fp-btn fp-btn-primary" id="fpResetBtn">Réinitialiser</button>
    </div>
  </div>
</div>

<style>
.fp-modal{position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;font-family:'Nunito','Segoe UI',sans-serif;}
.fp-modal.open{display:flex;}
.fp-backdrop{position:absolute;inset:0;background:rgba(20,30,50,0.55);backdrop-filter:blur(4px);}
.fp-dialog{position:relative;background:#fff;width:100%;max-width:440px;border-radius:20px;padding:32px 30px 26px;box-shadow:0 30px 80px rgba(0,0,0,0.25);animation:fpIn .28s cubic-bezier(0.34,1.56,0.64,1);}
@keyframes fpIn{from{opacity:0;transform:translateY(20px) scale(0.96);}to{opacity:1;transform:translateY(0) scale(1);}}
.fp-close{position:absolute;top:14px;right:16px;background:none;border:0;font-size:26px;line-height:1;color:#95a5a6;cursor:pointer;}
.fp-close:hover{color:#2c3e50;}
.fp-header{text-align:center;margin-bottom:22px;}
.fp-header h2{margin:0 0 14px;font-size:22px;font-weight:800;color:#1B3A6B;letter-spacing:-0.01em;}
.fp-steps{display:flex;align-items:center;justify-content:center;gap:6px;}
.fp-step-dot{width:28px;height:28px;border-radius:50%;background:#e8edf2;color:#8a94a6;font-size:13px;font-weight:700;display:flex;align-items:center;justify-content:center;transition:all .25s;}
.fp-step-dot.active{background:linear-gradient(135deg,#4A90E2 0%,#2563EB 100%);color:#fff;box-shadow:0 4px 12px rgba(74,144,226,0.35);}
.fp-step-dot.done{background:#4ECB71;color:#fff;}
.fp-step-line{width:36px;height:2px;background:#e8edf2;}
.fp-lead{color:#55606e;font-size:14px;line-height:1.6;margin:0 0 18px;}
.fp-label{display:block;font-size:12px;font-weight:700;color:#1B3A6B;margin:0 0 6px;text-transform:uppercase;letter-spacing:0.04em;}
.fp-input{width:100%;padding:12px 14px;border:1.5px solid #e1e7ef;border-radius:10px;font-size:15px;color:#2c3e50;background:#fafbfc;transition:all .2s;box-sizing:border-box;margin-bottom:14px;}
.fp-input:focus{outline:none;border-color:#4A90E2;background:#fff;box-shadow:0 0 0 3px rgba(74,144,226,0.15);}
.fp-input-code{text-align:center;font-size:24px;font-weight:800;letter-spacing:10px;font-family:monospace;}
.fp-msg{padding:10px 14px;border-radius:10px;font-size:13px;margin-bottom:14px;line-height:1.5;}
.fp-msg.error{background:#fdecea;color:#c0392b;}
.fp-msg.success{background:#eafaf1;color:#1e8449;}
.fp-msg.warn{background:#fff8cd;color:#7d6608;}
.fp-msg.info{background:#ebf5fb;color:#1a5276;}
.fp-row{display:flex;gap:10px;}
.fp-btn{padding:12px 20px;border-radius:10px;border:0;font-size:14px;font-weight:700;cursor:pointer;transition:all .2s;font-family:inherit;}
.fp-btn-primary{flex:1;width:100%;background:linear-gradient(135deg,#4A90E2 0%,#2563EB 100%);color:#fff;box-shadow:0 4px 14px rgba(74,144,226,0.35);}
.fp-btn-primary:hover{background:linear-gradient(135deg,#5aa0ec 0%,#4A90E2 100%);transform:translateY(-1px);box-shadow:0 6px 18px rgba(74,144,226,0.45);}
.fp-btn-primary:disabled{opacity:0.6;cursor:not-allowed;transform:none;}
.fp-btn-ghost{flex:0 0 auto;background:#f4f6f9;color:#55606e;}
.fp-btn-ghost:hover{background:#e8edf2;}
.fp-strength{font-size:12px;font-weight:600;margin:-8px 0 12px;}
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
<script>
(function () {
  'use strict';
  var root    = document.getElementById('authRoot');
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function disableTransitions() {
    document.querySelectorAll('.auth-form-card,.auth-left').forEach(function(el){
      el.style.transition = 'none';
    });
  }
  function restoreTransitions() {
    requestAnimationFrame(function(){ requestAnimationFrame(function(){
      document.querySelectorAll('.auth-form-card,.auth-left').forEach(function(el){
        el.style.transition = '';
      });
    }); });
  }

  function showRegister(animate) {
    if (!animate) disableTransitions();
    root.classList.add('show-register');
    history.pushState({mode:'register'}, '', '/login?mode=register');
    if (!animate) restoreTransitions();
  }

  function showLogin(animate) {
    if (!animate) disableTransitions();
    root.classList.remove('show-register');
    history.pushState({mode:'login'}, '', '/login');
    if (!animate) restoreTransitions();
  }

  document.getElementById('btn-to-register').addEventListener('click', function(e){ e.preventDefault(); showRegister(true); });
  document.getElementById('btn-to-login').addEventListener('click',    function(e){ e.preventDefault(); showLogin(true);    });

  window.addEventListener('popstate', function(e){
    if (e.state && e.state.mode === 'register') showRegister(false);
    else showLogin(false);
  });

  {% if mode == 'register' %}
  showRegister(false);
  {% endif %}

  document.body.classList.add('auth-ready');
  if (reduced) return;

  /* Botanical parallax */
  var panel = document.querySelector('.auth-left');
  var grp   = panel && panel.querySelector('.plant-group');
  if (grp) {
    panel.addEventListener('mousemove', function(e){
      var r  = panel.getBoundingClientRect();
      var nx = ((e.clientX - r.left) / r.width)  * 2 - 1;
      var ny = ((e.clientY - r.top)  / r.height) * 2 - 1;
      grp.style.transform  = 'rotate('+(nx*2)+'deg) translateY('+(ny*-6)+'px)';
      grp.style.transition = 'transform 0.3s ease-out';
    });
    panel.addEventListener('mouseleave', function(){
      grp.style.transform  = '';
      grp.style.transition = 'transform 0.8s cubic-bezier(0.22,1,0.36,1)';
    });
  }

/* Password visibility toggle */
  var pwdInput = document.getElementById('password');
  var pwdToggle = document.getElementById('togglePassword');
  if (pwdInput && pwdToggle) {
    var iconShow = pwdToggle.querySelector('.auth-pwd-icon--show');
    var iconHide = pwdToggle.querySelector('.auth-pwd-icon--hide');
    pwdToggle.addEventListener('click', function(){
      var visible = pwdInput.type === 'text';
      pwdInput.type = visible ? 'password' : 'text';
      pwdToggle.setAttribute('aria-pressed', visible ? 'false' : 'true');
      pwdToggle.setAttribute('aria-label', visible ? 'Afficher le mot de passe' : 'Masquer le mot de passe');
      iconShow.style.display = visible ? '' : 'none';
      iconHide.style.display = visible ? 'none' : '';
    });
  }

  /* Input icon brightens when filled */
  document.querySelectorAll('.auth-input').forEach(function(input){
    input.addEventListener('input', function(){
      var wrap = this.closest('.auth-input-wrap');
      var icon = wrap && wrap.querySelector('.auth-input-icon');
      if (icon) icon.style.color = this.value.length > 0 ? 'rgba(74,144,226,0.8)' : '';
    });
  });
})();

function selectRole(role, el) {
  document.querySelectorAll('.auth-role').forEach(function(o){ o.classList.remove('selected'); });
  el.classList.add('selected');
  var f = document.getElementById('roleInput') || document.querySelector('input[name="registration_form[roles]"]');
  if (f) f.value = role;
}

document.addEventListener('DOMContentLoaded', function(){
  var pw  = document.querySelector('input[name="registration_form[plainPassword][first]"]');
  var pw2 = document.querySelector('input[name="registration_form[plainPassword][second]"]');
  var bar = document.getElementById('password-strength-bar');
  var txt = document.getElementById('password-strength-text');
  var mtx = document.getElementById('password-match-text');

  function strength(p){
    var s=0,c={len:p.length>=8,lower:/[a-z]/.test(p),upper:/[A-Z]/.test(p),num:/\d/.test(p),special:/[!@#$%^&*(),.?":{}|<>]/.test(p),long:p.length>=12};
    Object.values(c).forEach(function(v){if(v)s++;});
    return {score:s,checks:c};
  }
  var ICON_WARN = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
  var ICON_SHIELD = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>';
  var ICON_CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
  var ICON_X = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';

  function updateBar(p){
    if(!bar||!txt) return;
    if(!p){ bar.style.width='0%'; txt.innerHTML=''; return; }
    var r=strength(p), w, c, label, icon;
    if(r.score<=2)       { w='33%';  c='#ef4444'; label='Mot de passe faible';  icon=ICON_WARN; }
    else if(r.score<=4)  { w='66%';  c='#f59e0b'; label='Sécurité moyenne';     icon=ICON_SHIELD; }
    else                 { w='100%'; c='#10b981'; label='Mot de passe robuste'; icon=ICON_CHECK; }
    bar.style.width=w; bar.style.backgroundColor=c; txt.style.color=c;
    var tips=[];
    if(!r.checks.len)     tips.push('8 caractères minimum');
    if(!r.checks.upper)   tips.push('une majuscule');
    if(!r.checks.num)     tips.push('un chiffre');
    if(!r.checks.special) tips.push('un caractère spécial');
    var hint = (tips.length && r.score<5) ? '<span class="pf-hint">· Ajoutez ' + tips.slice(0,2).join(', ') + '</span>' : '';
    txt.innerHTML = icon + '<span class="pf-label">' + label + '</span>' + hint;
  }
  function checkMatch(){
    if(!pw||!pw2||!mtx) return;
    if(!pw2.value){ mtx.innerHTML=''; return; }
    if(pw.value===pw2.value){ mtx.style.color='#10b981'; mtx.innerHTML = ICON_CHECK + '<span class="pf-label">Mots de passe identiques</span>'; }
    else                    { mtx.style.color='#ef4444'; mtx.innerHTML = ICON_X     + '<span class="pf-label">Mots de passe différents</span>'; }
  }
  if(pw) pw.addEventListener('input',function(){updateBar(this.value);checkMatch();});
  if(pw2) pw2.addEventListener('input',checkMatch);

  /* Eye toggles — find the sibling input inside the same .auth-input-wrap */
  document.querySelectorAll('.auth-pwd-toggle[data-pwd-toggle]').forEach(function(btn){
    var wrap  = btn.closest('.auth-input-wrap');
    var input = wrap && wrap.querySelector('input[type="password"], input[type="text"]');
    if(!input) return;
    var iconShow = btn.querySelector('.auth-pwd-icon--show');
    var iconHide = btn.querySelector('.auth-pwd-icon--hide');
    btn.addEventListener('click', function(){
      var visible = input.type === 'text';
      input.type = visible ? 'password' : 'text';
      btn.setAttribute('aria-pressed', visible ? 'false' : 'true');
      btn.setAttribute('aria-label', visible ? 'Afficher le mot de passe' : 'Masquer le mot de passe');
      iconShow.style.display = visible ? '' : 'none';
      iconHide.style.display = visible ? 'none' : '';
    });
  });
});
</script>

{# ═══ Forgot-password modal logic (port de ForgotPasswordController.java) ═══ #}
<script>
(function(){
  'use strict';
  const modal = document.getElementById('fpModal');
  const open  = document.getElementById('openForgotPwd');
  if(!modal || !open) return;

  const dots = modal.querySelectorAll('.fp-step-dot');
  const steps = modal.querySelectorAll('.fp-step');
  const msg1 = document.getElementById('fpMsg1');
  const msg2 = document.getElementById('fpMsg2');
  const msg3 = document.getElementById('fpMsg3');
  const sentLabel = document.getElementById('fpSentLabel');

  const emailInput   = document.getElementById('fpEmail');
  const codeInput    = document.getElementById('fpCode');
  const newInput     = document.getElementById('fpNew');
  const confirmInput = document.getElementById('fpConfirm');
  const strength     = document.getElementById('fpStrength');

  const sendBtn   = document.getElementById('fpSendBtn');
  const verifyBtn = document.getElementById('fpVerifyBtn');
  const resendBtn = document.getElementById('fpResendBtn');
  const resetBtn  = document.getElementById('fpResetBtn');

  let verifiedEmail = null;

  function showMsg(el, text, type){
    el.textContent = text;
    el.className = 'fp-msg ' + type;
    el.hidden = false;
  }
  function hideMsg(el){ el.hidden = true; el.textContent = ''; }

  function showStep(n){
    steps.forEach(s => s.hidden = (+s.dataset.step !== n));
    dots.forEach(d => {
      const i = +d.dataset.dot;
      d.classList.toggle('active', i === n);
      d.classList.toggle('done',  i < n);
    });
    hideMsg(msg1); hideMsg(msg2); hideMsg(msg3);
  }

  function openModal(){
    modal.classList.add('open');
    modal.setAttribute('aria-hidden','false');
    verifiedEmail = null;
    emailInput.value = ''; codeInput.value = '';
    newInput.value = ''; confirmInput.value = '';
    strength.hidden = true;
    showStep(1);
    setTimeout(() => emailInput.focus(), 100);
  }
  function closeModal(){
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden','true');
  }

  open.addEventListener('click', e => { e.preventDefault(); openModal(); });
  modal.querySelectorAll('[data-fp-close]').forEach(el => el.addEventListener('click', closeModal));
  document.addEventListener('keydown', e => { if(e.key === 'Escape' && modal.classList.contains('open')) closeModal(); });

  async function post(url, data){
    const body = new URLSearchParams(data);
    const res = await fetch(url, { method: 'POST', body, headers: {'Accept': 'application/json'} });
    let json = {};
    try { json = await res.json(); } catch(e){}
    return { ok: res.ok && json.ok, data: json };
  }

  // ── Étape 1 : envoi du code ──
  sendBtn.addEventListener('click', async () => {
    const email = emailInput.value.trim().toLowerCase();
    if(!email){ showMsg(msg1, 'Veuillez entrer votre adresse email.', 'warn'); return; }
    if(!/^[\w.+-]+@[\w.-]+\.[a-zA-Z]{2,}$/.test(email)){
      showMsg(msg1, 'Adresse email invalide.', 'warn'); return;
    }
    sendBtn.disabled = true;
    showMsg(msg1, 'Vérification en cours...', 'info');

    const r = await post('{{ path('app_pwd_send_code') }}', { email });
    sendBtn.disabled = false;
    if(!r.ok){ showMsg(msg1, (r.data.message || 'Erreur.').replace(/[^\w\s.,!?:;@'\-àâäéèêëïîôöùûüÿçÀÂÄÉÈÊËÏÎÔÖÙÛÜŸÇ]/g,'').trim(), 'error'); return; }

    verifiedEmail = email;
    sentLabel.textContent = 'Un code a été envoyé à : ' + (r.data.masked || email);
    showStep(2);
    setTimeout(() => codeInput.focus(), 100);
  });

  // ── Étape 2 : vérification du code ──
  codeInput.addEventListener('input', function(){
    this.value = this.value.replace(/\D/g, '').slice(0, 6);
  });
  verifyBtn.addEventListener('click', async () => {
    const code = codeInput.value.trim();
    if(code.length !== 6){
      showMsg(msg2, 'Le code doit contenir exactement 6 chiffres.', 'warn'); return;
    }
    verifyBtn.disabled = true;
    const r = await post('{{ path('app_pwd_verify_code') }}', { email: verifiedEmail, code });
    verifyBtn.disabled = false;
    if(!r.ok){
      showMsg(msg2, (r.data.message || 'Code incorrect ou expiré. Renvoyez un nouveau code.').replace(/[^\w\s.,!?:;@'\-àâäéèêëïîôöùûüÿçÀÂÄÉÈÊËÏÎÔÖÙÛÜŸÇ]/g,'').trim(), 'error');
      codeInput.value = ''; codeInput.focus(); return;
    }
    showStep(3);
    setTimeout(() => newInput.focus(), 100);
  });

  resendBtn.addEventListener('click', async () => {
    if(!verifiedEmail){ showStep(1); return; }
    showMsg(msg2, 'Renvoi en cours...', 'info');
    const r = await post('{{ path('app_pwd_send_code') }}', { email: verifiedEmail });
    if(!r.ok){ showMsg(msg2, (r.data.message || 'Erreur.').replace(/[^\w\s.,!?:;@'\-àâäéèêëïîôöùûüÿçÀÂÄÉÈÊËÏÎÔÖÙÛÜŸÇ]/g,'').trim(), 'error'); return; }
    codeInput.value = '';
    showMsg(msg2, 'Nouveau code envoyé.', 'success');
  });

  // ── Étape 3 : nouveau mot de passe ──
  newInput.addEventListener('input', function(){
    const v = this.value;
    if(!v){ strength.hidden = true; return; }
    strength.hidden = false;
    let score = 0;
    if(v.length >= 8) score++;
    if(/[A-Z]/.test(v)) score++;
    if(/[0-9]/.test(v)) score++;
    if(/[!@#$%^&*()_+\-=\[\]]/.test(v)) score++;
    const labels = [
      {t:'Très faible', c:'#e74c3c'},
      {t:'Très faible', c:'#e74c3c'},
      {t:'Faible',      c:'#e67e22'},
      {t:'Moyen',       c:'#f39c12'},
      {t:'Fort',        c:'#27ae60'}
    ];
    const s = labels[score];
    strength.textContent = s.t;
    strength.style.color = s.c;
  });

  resetBtn.addEventListener('click', async () => {
    const p = newInput.value, c = confirmInput.value;
    if(!p || !c){ showMsg(msg3, 'Veuillez remplir les deux champs.', 'warn'); return; }
    if(p.length < 6){ showMsg(msg3, 'Le mot de passe doit contenir au moins 6 caractères.', 'warn'); return; }
    if(p !== c){
      showMsg(msg3, 'Les mots de passe ne correspondent pas.', 'error');
      confirmInput.value = ''; confirmInput.focus(); return;
    }
    resetBtn.disabled = true;
    const r = await post('{{ path('app_pwd_reset') }}', {
      email: verifiedEmail, code: codeInput.value.trim(), password: p, confirm: c
    });
    resetBtn.disabled = false;
    if(!r.ok){ showMsg(msg3, (r.data.message || 'Erreur.').replace(/[^\w\s.,!?:;@'\-àâäéèêëïîôöùûüÿçÀÂÄÉÈÊËÏÎÔÖÙÛÜŸÇ]/g,'').trim(), 'error'); return; }

    showMsg(msg3, 'Mot de passe réinitialisé avec succès.', 'success');
    setTimeout(closeModal, 2000);
  });
})();
</script>
{% endblock %}
