{% extends 'base.html.twig' %}

{% block title %}Résultats - {{ resultat_test.test.nomTest }} — MindBloom{% endblock %}

{% block body %}


<div style="background:#F5F3EF; min-height: calc(100vh - 80px); padding: 50px;">
    <div style="max-width: 700px; margin: 0 auto;">

        <div style="text-align: center; margin-bottom: 40px;">
            <span style="display:inline-block;background:#EDF9F5;color:#5FBF9F;border-radius:20px;padding:6px 15px;font-size:13px;margin-bottom:15px;font-weight:700;">
                ✓ Test Terminé
            </span>
            <h1 style="font-size:36px;font-weight:900;color:#2C3E50;margin-bottom:10px;">Vos Résultats</h1>
            <p style="font-size:16px;color:#7F8C8D;">Pour le test: <strong>{{ resultat_test.test.nomTest }}</strong></p>
        </div>

        <div style="background: white; border-radius: 25px; padding: 40px; box-shadow: 0 15px 35px rgba(0,0,0,0.05); text-align: center; position: relative; overflow: hidden;">
            <div style="position: absolute; top: 0; left: 0; right: 0; height: 10px; background: linear-gradient(90deg, #5FBF9F, #4A90E2);"></div>
            
            <div style="width: 150px; height: 150px; border-radius: 50%; border: 8px solid #F0F3F4; margin: 0 auto 30px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                <span style="font-size: 42px; font-weight: 900; color: #2C3E50; line-height: 1;">{{ resultat_test.score }}</span>
                <span style="font-size: 14px; color: #95A5A6; font-weight: 600;">/ 100</span>
            </div>

            <div style="margin-bottom: 30px;">
                <div style="display: inline-block; background: #F8FAFD; border: 1px solid #E8F1FC; border-radius: 12px; padding: 10px 20px; margin-bottom: 20px;">
                    <span style="color: #7F8C8D; font-size: 14px;">État global :</span>
                    <strong style="color: #4A90E2; font-size: 16px; margin-left: 5px;">{{ resultat_test.etat }}</strong>
                </div>
                
                <h3 style="font-size: 20px; font-weight: 700; color: #2C3E50; margin-bottom: 15px;">Interprétation</h3>
                <p style="color: #34495E; font-size: 16px; line-height: 1.6; background: #F5F3EF; padding: 20px; border-radius: 15px;">
                    "{{ resultat_test.commentaire }}"
                </p>
            </div>

            <hr style="border: none; border-top: 1px solid #F0F0F0; margin: 30px 0;">

            <div style="display: flex; gap: 15px; justify-content: center;">
                <a href="{{ path('app_test_index') }}" style="background: #E8F1FC; color: #4A90E2; padding: 12px 25px; border-radius: 12px; font-weight: 700; text-decoration: none; transition: background 0.2s;" onmouseover="this.style.background='#D4E6FA'" onmouseout="this.style.background='#E8F1FC'">
                    Faire un autre test
                </a>
                <a href="{{ path('app_patient_dashboard') }}" style="background: #4A90E2; color: white; padding: 12px 25px; border-radius: 12px; font-weight: 700; text-decoration: none; transition: background 0.2s;" onmouseover="this.style.background='#357ABD'" onmouseout="this.style.background='#4A90E2'">
                    Retour à l'accueil
                </a>
            </div>
            
        </div>
    </div>
</div>
{% endblock %}