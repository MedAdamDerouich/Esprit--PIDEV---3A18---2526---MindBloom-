}
body.dark-mode #coachRecharged { color: #6EE095 !important; }
body.dark-mode #coachScoreBar { background: linear-gradient(90deg,#5EDDE1,#6EE095) !important; }
body.dark-mode #aiCoachCard [style*="background:#e1ecf4"] { background: #2A3147 !important; }

/* Chart card inner bg + donut slice borders */
body.dark-mode #coachChart path { stroke: #161A26 !important; }

/* Legend rows */
