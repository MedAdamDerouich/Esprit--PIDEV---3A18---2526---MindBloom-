{% block javascripts %}
{{ parent() }}
<script>
(function () {
  'use strict';

  /* ── ANIMATION 1: Stat bars slide in ── */
  var bars = document.querySelectorAll('.pd-stat__bar');
  var statsEl = document.querySelector('.pd-stats');
  if (statsEl && 'IntersectionObserver' in window) {
    new IntersectionObserver(function(entries, obs) {
      if (entries[0].isIntersecting) {
        bars.forEach(function(b, i) {
          setTimeout(function() { b.classList.add('animated'); }, i * 150 + 300);
        });
        obs.disconnect();
      }
    }, { threshold: 0.5 }).observe(statsEl);
  }

  /* ── ANIMATION 2: Counter roll-up ── */
  function easeOutExpo(t) { return t === 1 ? 1 : 1 - Math.pow(2, -10 * t); }
  function runCount(el) {
    var target = parseInt(el.dataset.target, 10);
    if (!target) return;
    var dur = 1600, start = null;
    (function step(ts) {
      if (!start) start = ts;
      var p = Math.min((ts - start) / dur, 1);
      el.textContent = Math.round(easeOutExpo(p) * target);
      if (p < 1) requestAnimationFrame(step);
      else el.textContent = target;
    })(performance.now());
  }
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries, obs) {
      entries.forEach(function(e) {
        if (e.isIntersecting) { runCount(e.target); obs.unobserve(e.target); }
      });
    }, { threshold: 0.6 });
    document.querySelectorAll('.js-count').forEach(function(el) { io.observe(el); });
  }

  /* ── ANIMATION 3: Magnetic tilt on cards ── */
  document.querySelectorAll('.pd-card').forEach(function(card) {
    card.addEventListener('mousemove', function(e) {
      var r  = card.getBoundingClientRect();
      var nx = ((e.clientX - r.left) / r.width  - 0.5) * 2;
      var ny = ((e.clientY - r.top)  / r.height - 0.5) * 2;
      card.style.transition = 'transform 0.06s linear, box-shadow 0.4s ease';
      card.style.transform =
        'translateY(-5px) perspective(900px) rotateX(' + (-ny * 5) + 'deg) rotateY(' + (nx * 5) + 'deg) scale(1.005)';
    });
    card.addEventListener('mouseleave', function() {
      card.style.transition = 'transform 0.55s cubic-bezier(0.22,1,0.36,1), box-shadow 0.4s ease';
      card.style.transform = '';
    });
  });
})();
</script>
