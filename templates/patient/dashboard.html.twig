{% extends 'base.html.twig' %}
{% block title %}Mon Espace — MindBloom{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ── Logo palette ──────────────────────────────────────────────── */
:root {
    --mb-navy:    #1B3A6B;
    --mb-cyan:    #00C2C7;
    --mb-green:   #4ECB71;
    --mb-yellow:  #F5C842;
    --mb-orange:  #F47B20;
    --mb-pink:    #E63F8C;
    --mb-purple:  #9B59B6;
}

/* ── Patient Dashboard ─────────────────────────────────────────── */
.ptdash-page {
    background: linear-gradient(175deg, #F0F6FF 0%, #E8F4F8 45%, #EEF5F0 100%);
    min-height: 100vh;
    overflow-x: hidden;
}

/* ── Hero Section ── */
.ptdash-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 60px;
    padding: 70px 100px;
    min-height: 510px;
    overflow: hidden;
}

/* ── Morphing orb background ── */
.mb-orbs {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
}
.mb-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    will-change: transform;
    --px: 0px; --py: 0px;
    animation: orbDrift ease-in-out infinite alternate;
}
@keyframes orbDrift {
    0%   { transform: translate(calc(var(--px) + 0px),   calc(var(--py) + 0px))   scale(1); }
    33%  { transform: translate(calc(var(--px) + 40px),  calc(var(--py) + 25px))  scale(1.08); }
    66%  { transform: translate(calc(var(--px) - 25px),  calc(var(--py) + 45px))  scale(0.94); }
    100% { transform: translate(calc(var(--px) + 20px),  calc(var(--py) - 30px))  scale(1.05); }
}
.mb-orb-1 {
    width: 700px; height: 700px;
    background: radial-gradient(circle, rgba(0,194,199,0.28) 0%, transparent 65%);
    top: 30%; left: -200px;
    animation-duration: 18s;
    animation-delay: 0s;
}
.mb-orb-2 {
    width: 560px; height: 560px;
    background: radial-gradient(circle, rgba(78,203,113,0.28) 0%, transparent 65%);
    bottom: -150px; right: -80px;
    animation-duration: 24s;
    animation-delay: -6s;
}
.mb-orb-3 {
    width: 460px; height: 460px;
    background: radial-gradient(circle, rgba(27,58,107,0.22) 0%, transparent 65%);
    top: 55%; left: 55%;
    animation-duration: 30s;
    animation-delay: -12s;
}
.mb-orb-4 {
    width: 320px; height: 320px;
    background: radial-gradient(circle, rgba(245,200,66,0.22) 0%, transparent 65%);
    top: 70%; left: 8%;
    animation-duration: 22s;
    animation-delay: -4s;
}
@media (prefers-reduced-motion: reduce) { .mb-orbs { display: none; } }

/* Hero text content */
.ptdash-hero-content {
    max-width: 600px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    position: relative;
    z-index: 2;
}

.ptdash-badge {
    display: inline-block;
    background: rgba(0,194,199,0.12);
    color: var(--mb-cyan);
    border-radius: 24px;
    padding: 6px 18px;
    font-size: 13px;
    font-weight: 700;
    width: fit-content;
    letter-spacing: 0.3px;
    opacity: 0;
    transform: translateY(28px);
}

.ptdash-title {
    font-size: 48px;
    font-weight: 900;
    color: var(--mb-navy);
    line-height: 1.08;
    letter-spacing: -1.5px;
    opacity: 0;
    transform: translateY(28px);
}
.ptdash-title em {
    font-style: normal;
    background: linear-gradient(135deg, var(--mb-cyan) 0%, var(--mb-green) 50%, var(--mb-yellow) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.ptdash-desc {
    font-size: 17px;
    color: #8E8E8E;
    line-height: 1.65;
    opacity: 0;
    transform: translateY(28px);
}

.ptdash-cta-wrap {
    margin-top: 8px;
    opacity: 0;
    transform: translateY(28px);
}

.ptdash-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, var(--mb-cyan) 0%, var(--mb-green) 100%);
    color: white;
    padding: 16px 36px;
    border-radius: 14px;
    font-weight: 700;
    text-decoration: none;
    font-size: 15px;
    transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.25s ease;
    box-shadow: 0 4px 18px rgba(0,194,199,0.35);
}
.ptdash-cta:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 10px 30px rgba(0,194,199,0.45);
    color: white;
}

/* Hero logo */
.ptdash-logo-dark { display: none; }
body.dark-mode .ptdash-logo-light { display: none; }
body.dark-mode .ptdash-logo-dark  { display: block; mix-blend-mode: screen; }

.ptdash-logo-wrap {
    position: relative;
    z-index: 2;
    flex-shrink: 0;
    perspective: 900px;
}
.ptdash-logo {
    width: 360px;
    height: 360px;
    object-fit: contain;
    animation: ptLogoFloat 5s ease-in-out infinite;
    filter: drop-shadow(0 20px 50px rgba(0,0,0,0.07));
    will-change: transform;
}
@keyframes ptLogoFloat {
    0%   { transform: translateY(0)    rotateY(0deg); }
    25%  { transform: translateY(-12px) rotateY(3deg); }
    50%  { transform: translateY(-16px) rotateY(0deg); }
    75%  { transform: translateY(-12px) rotateY(-3deg); }
    100% { transform: translateY(0)    rotateY(0deg); }
}

/* ── Entrance animations ── */
body.anim-ready .ptdash-badge    { animation: ptFadeUp 0.7s cubic-bezier(0.22,1,0.36,1) 0.1s forwards; }
body.anim-ready .ptdash-title    { animation: ptFadeUp 0.7s cubic-bezier(0.22,1,0.36,1) 0.22s forwards; }
body.anim-ready .ptdash-desc     { animation: ptFadeUp 0.7s cubic-bezier(0.22,1,0.36,1) 0.36s forwards; }
body.anim-ready .ptdash-cta-wrap { animation: ptFadeUp 0.7s cubic-bezier(0.22,1,0.36,1) 0.48s forwards; }

@keyframes ptFadeUp {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
}

/* ── Stats Bar ── */
.ptdash-stats {
    background: rgba(255,255,255,0.65);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-top: 1px solid rgba(255,255,255,0.85);
    border-bottom: 1px solid rgba(0,0,0,0.04);
    padding: 44px 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 80px;
}

.ptdash-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    opacity: 0;
    transform: translateY(18px);
}

.stat-counter {
    font-size: 34px;
    font-weight: 800;
    background: linear-gradient(135deg, var(--mb-cyan), var(--mb-navy));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.5px;
}

.stat-label {
    color: #9A9A9A;
    font-size: 14px;
    font-weight: 500;
}

/* ── Services Section ── */
.ptdash-services {
    padding: 80px 40px 100px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
}

.ptdash-services-title {
    font-size: 38px;
    font-weight: 800;
    color: var(--mb-navy);
    letter-spacing: -0.8px;
    opacity: 0;
    transform: translateY(24px);
}

.ptdash-services-sub {
    font-size: 16px;
    color: #9A9A9A;
    text-align: center;
    max-width: 580px;
    line-height: 1.65;
    opacity: 0;
    transform: translateY(20px);
}

.ptdash-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
    margin-top: 44px;
    max-width: 1100px;
    width: 100%;
    padding: 0 20px;
}

/* ── Service Card Wrapper ── */
.ptdash-card-wrap {
    perspective: 800px;
    text-decoration: none;
    color: inherit;
    display: block;
    opacity: 0;
    transform: translateY(44px) scale(0.95);
}

/* ── Service Card ── */
.ptdash-card {
    background: rgba(255,255,255,0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255,255,255,0.9);
    border-radius: 22px;
    padding: 28px 22px;
    min-height: 280px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
    transform-style: preserve-3d;
    transform: rotateX(0deg) rotateY(0deg) translateZ(0);
    transition: transform 0.12s ease-out, box-shadow 0.2s ease;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04), 0 1px 3px rgba(0,0,0,0.03);
    will-change: transform;
}

/* Shine overlay */
.ptdash-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.6) 0%, rgba(255,255,255,0) 55%);
    border-radius: 22px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
    z-index: 1;
}
.ptdash-card-wrap:hover .ptdash-card::before { opacity: 1; }

/* Decorative corner glow */
.ptdash-card::after {
    content: '';
    position: absolute;
    bottom: -35px;
    right: -35px;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    pointer-events: none;
    transition: transform 0.45s ease, opacity 0.45s ease;
    opacity: 0.35;
}
.ptdash-card-wrap:hover .ptdash-card::after {
    transform: scale(1.7);
    opacity: 0.8;
}

/* Hover shadow lift */
.ptdash-card-wrap:hover .ptdash-card {
    box-shadow:
        0 24px 48px rgba(0,0,0,0.1),
        0 8px 18px rgba(0,0,0,0.06);
}

/* ── Color variants — mapped to MindBloom logo palette ── */
/* blue  → navy  #1B3A6B */
/* teal  → cyan  #00C2C7 */
/* purple→ pink  #E63F8C */
/* amber → orange #F47B20 */
/* rose  → green #4ECB71 */
.ptdash-card--blue::after   { background: radial-gradient(circle, rgba(27,58,107,0.14) 0%, transparent 70%); }
.ptdash-card--teal::after   { background: radial-gradient(circle, rgba(0,194,199,0.15) 0%, transparent 70%); }
.ptdash-card--purple::after { background: radial-gradient(circle, rgba(230,63,140,0.14) 0%, transparent 70%); }
.ptdash-card--amber::after  { background: radial-gradient(circle, rgba(244,123,32,0.15) 0%, transparent 70%); }
.ptdash-card--rose::after   { background: radial-gradient(circle, rgba(78,203,113,0.15) 0%, transparent 70%); }

/* ── Icon box ── */
.ptdash-icon {
    width: 50px;
    height: 50px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transform: translateZ(20px);
    transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1), background 0.2s ease;
    position: relative;
    z-index: 2;
    color: #2c3e50;
    overflow: hidden;
}
.ptdash-card-wrap:hover .ptdash-icon {
    transform: translateZ(38px) scale(1.15) rotate(-4deg);
}

.ptdash-icon svg {
    width: 24px;
    height: 24px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.ptdash-icon--blue   { background: rgba(27,58,107,0.10);  color: var(--mb-navy); }
.ptdash-icon--teal   { background: rgba(0,194,199,0.12);  color: #008c91; }
.ptdash-icon--purple { background: rgba(230,63,140,0.11); color: #c22274; }
.ptdash-icon--amber  { background: rgba(244,123,32,0.12); color: #c55e0c; }
.ptdash-icon--rose   { background: rgba(78,203,113,0.12); color: #2ea255; }

/* ── Card title ── */
.ptdash-card-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--mb-navy);
    transform: translateZ(12px);
    transition: transform 0.15s ease, color 0.15s ease;
    position: relative;
    z-index: 2;
}
.ptdash-card-wrap:hover .ptdash-card-title {
    transform: translateZ(24px);
    color: var(--mb-navy);
}

/* ── Card description ── */
.ptdash-card-desc {
    color: #9A9A9A;
    font-size: 14px;
    line-height: 1.55;
    transform: translateZ(6px);
    transition: transform 0.15s ease;
    position: relative;
    z-index: 2;
}
.ptdash-card-wrap:hover .ptdash-card-desc {
    transform: translateZ(14px);
}

/* ── Card link / arrow ── */
.ptdash-card-link {
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    margin-top: auto;
    transform: translateZ(8px);
    transition: transform 0.15s ease;
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}
.ptdash-card-link svg {
    transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1);
}
.ptdash-card-wrap:hover .ptdash-card-link {
    transform: translateZ(18px);
}
.ptdash-card-wrap:hover .ptdash-card-link svg {
    transform: translateX(4px);
}

.ptdash-card-link--blue   { color: var(--mb-navy); }
.ptdash-card-link--teal   { color: #008c91; }
.ptdash-card-link--purple { color: #c22274; }
.ptdash-card-link--amber  { color: #c55e0c; }
.ptdash-card-link--rose   { color: #2ea255; }

/* ── Responsive ── */
@media (max-width: 1100px) {
    .ptdash-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 900px) {
    .ptdash-hero { flex-direction: column; padding: 50px 30px; gap: 30px; }
    .ptdash-logo { width: 240px; height: 240px; }
    .ptdash-title { font-size: 36px; }
    .ptdash-grid { grid-template-columns: repeat(2, 1fr); }
    .ptdash-stats { flex-wrap: wrap; gap: 40px; padding: 30px 20px; }
}
@media (max-width: 600px) {
    .ptdash-grid { grid-template-columns: 1fr; }
}

/* ── Reduced motion ── */
@media (prefers-reduced-motion: reduce) {
    .ptdash-badge, .ptdash-title, .ptdash-desc, .ptdash-cta-wrap,
    .ptdash-services-title, .ptdash-services-sub {
        opacity: 1 !important; transform: none !important; animation: none !important;
    }
    .ptdash-logo { animation: none !important; }
    .ptdash-card, .ptdash-icon { transition: none !important; }
    .ptdash-card-wrap, .ptdash-stat { opacity: 1 !important; transform: none !important; }
}

/* ══════════════════════════════════════════
   DARK MODE — Patient Dashboard
   ══════════════════════════════════════════ */
body.dark-mode .ptdash-page {
    background: linear-gradient(175deg, #0F1117 0%, #121826 45%, #101A18 100%) !important;
}
body.dark-mode .ptdash-hero-kicker {
    background: rgba(0,194,199,0.15) !important;
    color: #5EDDE1 !important;
}
body.dark-mode .ptdash-hero-title {
    color: #E8EAF0 !important;
}
body.dark-mode .ptdash-hero-subtitle,
body.dark-mode .ptdash-hero-desc,
body.dark-mode .ptdash-hero-tagline {
    color: #A8B0C4 !important;
}
body.dark-mode .ptdash-hero-content * {
    color: inherit;
}
body.dark-mode .ptdash-section-title {
    color: #E8EAF0 !important;
}
body.dark-mode .ptdash-section-subtitle {
    color: #7A8299 !important;
}
body.dark-mode .ptdash-stat {
    background: rgba(22,26,38,0.85) !important;
    border-color: #252B3E !important;
    color: #D8DCE8 !important;
}
body.dark-mode .ptdash-stat-value {
    color: #E8EAF0 !important;
}
body.dark-mode .ptdash-stat-label {
    color: #7A8299 !important;
}
body.dark-mode .ptdash-card {
    background: #161A26 !important;
    border-color: #252B3E !important;
    box-shadow: 0 12px 28px rgba(0,0,0,0.5) !important;
    color: #D8DCE8 !important;
}
body.dark-mode .ptdash-card-title {
    color: #E8EAF0 !important;
}
body.dark-mode .ptdash-card-desc {
    color: #A8B0C4 !important;
}
body.dark-mode .ptdash-card-meta {
    color: #6A7385 !important;
}
body.dark-mode .ptdash-icon--blue   { background: rgba(123,184,245,0.15) !important; color: #7BB8F5 !important; }
body.dark-mode .ptdash-icon--teal   { background: rgba(0,194,199,0.18)  !important; color: #5EDDE1 !important; }
body.dark-mode .ptdash-icon--purple { background: rgba(230,63,140,0.18) !important; color: #F17AB4 !important; }
body.dark-mode .ptdash-icon--amber  { background: rgba(244,123,32,0.18) !important; color: #FFAD6B !important; }
body.dark-mode .ptdash-icon--rose   { background: rgba(78,203,113,0.18) !important; color: #6EE095 !important; }
body.dark-mode .ptdash-card-link--blue   { color: #7BB8F5 !important; }
body.dark-mode .ptdash-card-link--teal   { color: #5EDDE1 !important; }
body.dark-mode .ptdash-card-link--purple { color: #F17AB4 !important; }
body.dark-mode .ptdash-card-link--amber  { color: #FFAD6B !important; }
body.dark-mode .ptdash-card-link--rose   { color: #6EE095 !important; }
body.dark-mode .ptdash-card::before,
body.dark-mode .ptdash-card::after {
    background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0) 55%) !important;
}
body.dark-mode .ptdash-cta,
body.dark-mode .ptdash-cta:hover {
    color: #ffffff !important;
    background: linear-gradient(135deg, var(--mb-cyan) 0%, var(--mb-green) 100%) !important;
    box-shadow: 0 6px 22px rgba(0,194,199,0.35) !important;
}
body.dark-mode .mb-event-reminder {
    background: #1A1F2E !important;
    color: #E8EAF0 !important;
    border-color: #252B3E !important;
}

/* ── Dark mode: orbs shift to darker tones ── */
body.dark-mode .mb-orb-1 { background: radial-gradient(circle, rgba(0,194,199,0.18) 0%, transparent 65%); }
body.dark-mode .mb-orb-2 { background: radial-gradient(circle, rgba(78,203,113,0.15) 0%, transparent 65%); }
body.dark-mode .mb-orb-3 { background: radial-gradient(circle, rgba(74,144,226,0.15) 0%, transparent 65%); }
body.dark-mode .mb-orb-4 { background: radial-gradient(circle, rgba(245,200,66,0.12) 0%, transparent 65%); }

/* ── Dark mode: stats bar ── */
body.dark-mode .ptdash-stats {
    background: rgba(22,26,38,0.75) !important;
    border-color: #252B3E !important;
}
body.dark-mode .ptdash-stat-value { color: #E8EAF0 !important; }
body.dark-mode .ptdash-stat-label { color: #5A6275 !important; }
body.dark-mode .stat-counter      { color: #E8EAF0 !important; }
body.dark-mode .stat-label        { color: #5A6275 !important; }

/* ── Dark mode: hero text ── */
body.dark-mode .ptdash-title { color: #E8EAF0 !important; }
body.dark-mode .ptdash-desc  { color: #8A92AA !important; }
body.dark-mode .ptdash-badge { background: rgba(0,194,199,0.15) !important; color: #5EDDE1 !important; }

/* ── Dark mode: services section ── */
body.dark-mode .ptdash-services { background: transparent !important; }
body.dark-mode .ptdash-services-title { color: #E8EAF0 !important; }
body.dark-mode .ptdash-services-sub   { color: #5A6275 !important; }
body.dark-mode .ptdash-card {
    background: #161A26 !important;
    border-color: #252B3E !important;
    box-shadow: 0 12px 28px rgba(0,0,0,0.45) !important;
}
body.dark-mode .ptdash-card-title { color: #E8EAF0 !important; }
body.dark-mode .ptdash-card-desc  { color: #8A92AA !important; }
body.dark-mode .ptdash-card-meta  { color: #5A6275 !important; }

/* ── Dark mode: how-it-works section ── */
body.dark-mode .ptdash-how { background: transparent !important; }
body.dark-mode .ptdash-how-head h2 { color: #E8EAF0 !important; }
body.dark-mode .ptdash-how-head p  { color: #5A6275 !important; }
body.dark-mode .ptdash-step-title  { color: #E8EAF0 !important; }
body.dark-mode .ptdash-step-desc   { color: #8A92AA !important; }

/* ── Dark mode: CTA banner ── */
body.dark-mode .ptdash-cta-banner,
body.dark-mode #ctaRotator { background: #161A26 !important; border-color: #252B3E !important; }
body.dark-mode .cta-slide h3 { color: #E8EAF0 !important; }
body.dark-mode .cta-slide p  { color: #8A92AA !important; }

/* Keep content above the fixed orb background */
.ptdash-page { position: relative; z-index: 1; }
.ptdash-hero,
.ptdash-stats,
.ptdash-services,
.ptdash-how,
.ptdash-testi,
.ptdash-cta-banner { position: relative; z-index: 1; }

/* ═══════════════════════════════════════════════════
   HOW IT WORKS — 3-step animated timeline
═══════════════════════════════════════════════════ */
.ptdash-how {
    position: relative;
    padding: 90px 40px 110px;
    background: linear-gradient(180deg, transparent 0%, rgba(255,255,255,0.55) 45%, transparent 100%);
}
.ptdash-how-head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 60px;
}
.ptdash-how-kicker {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mb-cyan);
    background: rgba(0,194,199,0.1);
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 16px;
}
.ptdash-how-title {
    font-size: 36px;
    font-weight: 900;
    color: var(--mb-navy);
    margin: 0 0 12px;
    letter-spacing: -0.02em;
}
.ptdash-how-sub {
    font-size: 16px;
    color: #7a8a9a;
    line-height: 1.7;
}
.ptdash-how-grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    position: relative;
}
.ptdash-how-grid::before {
    content: '';
    position: absolute;
    top: 48px; left: 16%; right: 16%;
    height: 2px;
    background: linear-gradient(90deg, var(--mb-cyan), var(--mb-green), var(--mb-yellow));
    opacity: 0.25;
    z-index: 0;
}
.ptdash-step {
    position: relative;
    text-align: center;
    padding: 20px;
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.6s cubic-bezier(0.22,1,0.36,1), transform 0.6s cubic-bezier(0.22,1,0.36,1);
}
.ptdash-step.reveal { opacity: 1; transform: translateY(0); }
.ptdash-step-num {
    width: 72px; height: 72px;
    margin: 0 auto 22px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid var(--mb-cyan);
    display: flex; align-items: center; justify-content: center;
    font-size: 28px; font-weight: 900;
    color: var(--mb-navy);
    position: relative; z-index: 2;
    box-shadow: 0 10px 24px rgba(0,194,199,0.25);
    transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1);
}
.ptdash-step:hover .ptdash-step-num {
    transform: scale(1.1) rotate(-8deg);
}
.ptdash-step:nth-child(2) .ptdash-step-num { border-color: var(--mb-green); box-shadow: 0 10px 24px rgba(78,203,113,0.25); }
.ptdash-step:nth-child(3) .ptdash-step-num { border-color: var(--mb-yellow); box-shadow: 0 10px 24px rgba(245,200,66,0.25); }
.ptdash-step-title {
    font-size: 18px; font-weight: 800;
    color: var(--mb-navy);
    margin-bottom: 10px;
}
.ptdash-step-desc {
    font-size: 14.5px;
    color: #6a7385;
    line-height: 1.65;
}

/* ═══════════════════════════════════════════════════
   TESTIMONIALS — infinite marquee
═══════════════════════════════════════════════════ */
.ptdash-testi {
    padding: 90px 0 100px;
    overflow: hidden;
    position: relative;
}
.ptdash-testi-head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 50px;
    padding: 0 20px;
}
.ptdash-testi-kicker {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mb-pink);
    background: rgba(230,63,140,0.1);
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 16px;
}
.ptdash-testi-title {
    font-size: 36px;
    font-weight: 900;
    color: var(--mb-navy);
    margin: 0 0 12px;
    letter-spacing: -0.02em;
}
.ptdash-marquee {
    display: flex;
    gap: 24px;
    width: max-content;
    animation: marquee 40s linear infinite;
}
.ptdash-marquee:hover { animation-play-state: paused; }
@keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
}
.ptdash-testi-card {
    width: 340px;
    flex-shrink: 0;
    background: rgba(255,255,255,0.9);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.9);
    border-radius: 20px;
    padding: 26px 24px;
    box-shadow: 0 10px 30px rgba(27,58,107,0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.ptdash-testi-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 40px rgba(27,58,107,0.15);
}
.ptdash-testi-stars {
    color: #F5C842;
    font-size: 16px;
    letter-spacing: 2px;
    margin-bottom: 12px;
}
.ptdash-testi-quote {
    font-size: 14.5px;
    color: #333;
    line-height: 1.65;
    font-style: italic;
    margin-bottom: 18px;
}
.ptdash-testi-user {
    display: flex; align-items: center; gap: 12px;
}
.ptdash-testi-avatar {
    width: 42px; height: 42px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--mb-cyan), var(--mb-green));
    display: flex; align-items: center; justify-content: center;
    color: white; font-weight: 800; font-size: 16px;
}
.ptdash-testi-name {
    font-weight: 700;
    color: var(--mb-navy);
    font-size: 14px;
}
.ptdash-testi-role {
    font-size: 12px;
    color: #8e9aa8;
}

/* Fade edges */
.ptdash-testi::before, .ptdash-testi::after {
    content: '';
    position: absolute;
    top: 0; bottom: 0; width: 80px;
    z-index: 3;
    pointer-events: none;
}
.ptdash-testi::before { left: 0;  background: linear-gradient(90deg, #F0F6FF, transparent); }
.ptdash-testi::after  { right: 0; background: linear-gradient(-90deg, #F0F6FF, transparent); }

/* ═══════════════════════════════════════════════════
   CTA BANNER — final scroll stop
═══════════════════════════════════════════════════ */
.ptdash-cta-banner {
    max-width: 1100px;
    margin: 0 auto 90px;
    padding: 50px 60px 70px;
    border-radius: 28px;
    background: linear-gradient(135deg, #1B3A6B 0%, #00C2C7 100%);
    position: relative; overflow: hidden;
    box-shadow: 0 20px 50px rgba(0,194,199,0.25);
    opacity: 0; transform: translateY(40px);
    transition: opacity 0.7s ease, transform 0.7s ease,
                background 0.7s ease, box-shadow 0.7s ease;
    min-height: 180px;
}
.ptdash-cta-banner.reveal { opacity: 1; transform: translateY(0); }
.ptdash-cta-banner::before {
    content: '';
    position: absolute; top: -80px; right: -80px;
    width: 280px; height: 280px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,0.2), transparent 70%);
    animation: pulseOrb 4s ease-in-out infinite;
    pointer-events: none;
}
@keyframes pulseOrb {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50%      { transform: scale(1.15); opacity: 0.8; }
}

/* Slides */
.cta-slide {
    position: absolute;
    inset: 50px 60px auto 60px;
    display: flex; align-items: center; justify-content: space-between;
    gap: 30px; flex-wrap: wrap;
    opacity: 0;
    transform: translateY(16px);
    pointer-events: none;
    transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.22,1,0.36,1);
}
.cta-slide.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    position: relative;
    inset: auto;
}
.cta-slide.is-leaving {
    opacity: 0;
    transform: translateY(-16px);
}
.cta-text h3 {
    font-size: 26px; font-weight: 900; color: #fff;
    margin: 0 0 8px; letter-spacing: -0.01em;
}
.cta-text p {
    color: rgba(255,255,255,0.85);
    font-size: 15px;
    margin: 0;
}
.cta-btn {
    background: #fff;
    color: var(--mb-navy);
    padding: 16px 32px;
    border-radius: 14px;
    font-weight: 800;
    text-decoration: none;
    font-size: 14.5px;
    display: inline-flex; align-items: center; gap: 10px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    transition: transform 0.2s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.2s ease;
    position: relative; z-index: 2;
    white-space: nowrap;
}
.cta-btn:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 14px 28px rgba(0,0,0,0.22);
    color: var(--mb-navy);
}

/* Dots */
.cta-dots {
    position: absolute;
    bottom: 22px;
    left: 50%;
    transform: translateX(-50%);
    display: flex; gap: 8px;
    z-index: 3;
}
.cta-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    border: none;
    background: rgba(255,255,255,0.4);
    cursor: pointer;
    padding: 0;
    transition: background 0.25s ease, width 0.25s ease;
}
.cta-dot.is-active {
    background: #fff;
    width: 24px;
    border-radius: 4px;
}

/* Progress bar */
.cta-progress {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 3px;
    background: rgba(255,255,255,0.12);
    z-index: 3;
}
.cta-progress-bar {
    height: 100%;
    width: 0%;
    background: rgba(255,255,255,0.85);
    transition: width 0.1s linear;
}

/* Dark mode for the new sections */
body.dark-mode .ptdash-how {
    background: linear-gradient(180deg, transparent 0%, rgba(22,26,38,0.6) 45%, transparent 100%);
}
body.dark-mode .ptdash-how-title,
body.dark-mode .ptdash-testi-title { color: #E8EAF0 !important; }
body.dark-mode .ptdash-how-sub,
body.dark-mode .ptdash-step-desc { color: #A8B0C4 !important; }
body.dark-mode .ptdash-step-num {
    background: #161A26 !important;
    color: #E8EAF0 !important;
}
body.dark-mode .ptdash-step-title { color: #E8EAF0 !important; }
body.dark-mode .ptdash-testi-card {
    background: #161A26 !important;
    border-color: #252B3E !important;
    color: #D8DCE8 !important;
}
body.dark-mode .ptdash-testi-quote { color: #D8DCE8 !important; }
body.dark-mode .ptdash-testi-name { color: #E8EAF0 !important; }
body.dark-mode .ptdash-testi-role { color: #7A8299 !important; }
body.dark-mode .ptdash-testi::before { background: linear-gradient(90deg, #0F1117, transparent) !important; }
body.dark-mode .ptdash-testi::after  { background: linear-gradient(-90deg, #0F1117, transparent) !important; }

@media (max-width: 768px) {
    .ptdash-how-grid { grid-template-columns: 1fr; gap: 20px; }
    .ptdash-how-grid::before { display: none; }
    .ptdash-cta-banner { padding: 36px 28px; text-align: center; }
    .ptdash-cta-banner h3 { font-size: 22px; }
}
</style>
{% endblock %}

{% block body %}
<div class="ptdash-page">

    {# ── Upcoming Event Notification (10 seconds) ── #}
    {% if next_event %}
        <div id="mb-event-reminder" class="mb-event-reminder">
            <div class="mb-er-content">
                <span class="mb-er-icon">📅</span>
                <div class="mb-er-text">
                    <strong>Rappel :</strong> Votre prochain événement <em>"{{ next_event.titre }}"</em> 
                    est prévu pour le {{ next_event.dateDebut|date('d/m/Y à H:i') }} 
                    (dans {{ next_event_jours_restants }} jour{{ next_event_jours_restants > 1 ? 's' : '' }}).
                </div>
            </div>
            <button class="mb-er-close" onclick="document.getElementById('mb-event-reminder').style.display='none'">&times;</button>
        </div>
        <style>
            .mb-event-reminder {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                background: linear-gradient(135deg, #FFB75E, #ED8F03);
                color: #fff;
                z-index: 9999;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 14px 20px;
                box-shadow: 0 4px 15px rgba(237, 143, 3, 0.3);
                animation: slideDown 0.5s cubic-bezier(0.22,1,0.36,1) forwards;
                transform: translateY(-100%);
            }
            .mb-er-content {
                display: flex;
                align-items: center;
                gap: 12px;
                max-width: 800px;
                width: 100%;
                font-size: 14px;
            }
            .mb-er-icon { font-size: 20px; }
            .mb-er-text strong { font-weight: 800; letter-spacing: 0.5px; }
            .mb-er-close {
                background: none;
                border: none;
                color: #fff;
                font-size: 24px;
                cursor: pointer;
                opacity: 0.8;
                transition: opacity 0.2s;
                margin-left: 20px;
            }
            .mb-er-close:hover { opacity: 1; }
            @keyframes slideDown { to { transform: translateY(0); } }
            @keyframes slideUpFade { to { transform: translateY(-100%); opacity: 0; visibility: hidden; } }
            .mb-event-reminder.hiding {
                animation: slideUpFade 0.6s cubic-bezier(0.22,1,0.36,1) forwards;
            }
        </style>
        <script>
            // Disparition automatique après 10 secondes
            setTimeout(function() {
                var el = document.getElementById('mb-event-reminder');
                if(el) { el.classList.add('hiding'); }
            }, 10000);
        </script>
    {% endif %}

    {# ── Morphing orb background ── #}
    <div class="mb-orbs" id="mb-orbs" aria-hidden="true">
        <div class="mb-orb mb-orb-1" id="orb1"></div>
        <div class="mb-orb mb-orb-2" id="orb2"></div>
        <div class="mb-orb mb-orb-3" id="orb3"></div>
        <div class="mb-orb mb-orb-4" id="orb4"></div>
