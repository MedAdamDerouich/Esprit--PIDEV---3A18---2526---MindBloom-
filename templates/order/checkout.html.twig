{% extends 'base.html.twig' %}

{% block title %}Finaliser ma commande - MindBloom{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
body.dark-mode .order-checkout-page {
    color: #D8DCE8;
}
body.dark-mode .order-checkout-page .card,
body.dark-mode .order-checkout-page .card-body,
body.dark-mode .order-checkout-page .bg-light,
body.dark-mode .order-checkout-page .bg-primary.bg-opacity-10,
body.dark-mode .order-checkout-page .sticky-top {
    background: #161A26 !important;
    border-color: #252B3E !important;
}
body.dark-mode .order-checkout-page h4,
body.dark-mode .order-checkout-page h5,
body.dark-mode .order-checkout-page .h5,
body.dark-mode .order-checkout-page .form-label,
body.dark-mode .order-checkout-page .fw-bold {
    color: #E8EAF0 !important;
}
body.dark-mode .order-checkout-page .text-muted,
body.dark-mode .order-checkout-page small,
body.dark-mode .order-checkout-page p,
body.dark-mode .order-checkout-page span {
    color: #7A8299 !important;
}
body.dark-mode .order-checkout-page .form-control,
body.dark-mode .order-checkout-page .form-select,
body.dark-mode .order-checkout-page textarea,
body.dark-mode .order-checkout-page input[type="text"] {
    background: #1A1F2E !important;
    color: #E8EAF0 !important;
    border-color: #2A3147 !important;
}
body.dark-mode .order-checkout-page .btn-link {
    color: #AEB5C8 !important;
}
body.dark-mode .order-checkout-page .btn-outline-secondary {
    background: #1E2333 !important;
    border-color: #2A3147 !important;
    color: #D8DCE8 !important;
}
body.dark-mode .order-checkout-page .alert-warning {
    background: #2C2618 !important;
    border-color: #5B4A25 !important;
    color: #E8EAF0 !important;
}
</style>
{% endblock %}

{% block body %}
<!-- Leaflet CSS & JS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<!-- Leaflet Geocoder (Search plugin) -->
<link rel="stylesheet" href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css" />
<script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>

<div class="container py-5 order-checkout-page">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="mb-4">
                <a href="{{ path('app_cart_index') }}" class="btn btn-link text-muted p-0 text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Retour au panier
                </a>
            </div>

            <div class="row g-4">
                <div class="col-md-7">
                    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-4">
                        <h4 class="fw-bold mb-4">Informations de livraison</h4>
                        <form action="{{ path('app_order_checkout') }}" method="POST" id="checkoutForm" onsubmit="return validateCheckout();">
                             <div class="mb-4">
                                <label class="form-label fw-bold small text-uppercase">Point de livraison</label>
                                <p class="small text-muted mb-2"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Cliquez sur la carte pour choisir votre adresse exacte</p>
                                <div id="map" style="height: 250px; width: 100%; border-radius: 12px; margin-bottom: 10px; z-index: 1;"></div>
                                <div class="position-relative">
                                    <textarea name="adresse" id="checkoutAdresse" class="form-control rounded-3 border bg-light py-3 pt-4 shadow-none mt-2" rows="2" required placeholder="L'adresse sélectionnée s'affichera ici (min 10 caractères)..." minlength="10" oninput="validateField(this, 10)"></textarea>
                                    <small id="adresseError" class="text-danger d-none position-absolute" style="bottom: -20px; left: 0; font-size: 11px;">L'adresse doit faire au moins 10 caractères et être précise.</small>
                                </div>
                            </div>

                            <div class="mb-5">
                                <label class="form-label fw-bold small text-uppercase">Mode de paiement</label>
                                <div class="row g-3">

                                    {# ── Wallet ── #}
                                    <div class="col-sm-6">
                                        <input type="radio" class="btn-check" name="paiement" id="wallet" value="WALLET"
                                               {{ (walletActive and walletBalance >= total) ? 'checked' : 'disabled' }}>
                                        <label class="btn btn-outline-secondary w-100 rounded-3 py-3 {{ (not walletActive or walletBalance < total) ? 'opacity-50' : '' }}" for="wallet">
                                            <i class="bi bi-wallet2" style="font-size:1.5rem;display:block;margin-bottom:4px;"></i>
                                            <span class="d-block fw-bold" style="font-size:13px;">Wallet MindBloom</span>
                                            {% if not walletActive %}
                                                <span class="d-block mt-1" style="font-size:11px;color:#dc3545;">
                                                    <i class="bi bi-slash-circle" style="margin-right:3px;"></i>Wallet suspendu
                                                </span>
                                            {% else %}
                                                <span class="d-block mt-1" style="font-size:12px;color:{{ walletBalance >= total ? '#10b981' : '#dc3545' }};">
                                                    Solde : {{ walletBalance|number_format(2, '.', ' ') }} DT
                                                    {% if walletBalance < total %}
                                                        <br><small>(insuffisant)</small>
                                                    {% endif %}
                                                </span>
                                            {% endif %}
                                        </label>
                                    </div>

                                    {# ── Paiement à la livraison ── #}
                                    <div class="col-sm-6">
                                        <input type="radio" class="btn-check" name="paiement" id="cash" value="ESPECES"
                                               {{ (not walletActive or walletBalance < total) ? 'checked' : '' }}>
                                        <label class="btn btn-outline-secondary w-100 rounded-3 py-3" for="cash">
                                            <i class="bi bi-cash-stack fs-4 d-block mb-1"></i>
                                            <span class="d-block fw-bold" style="font-size:13px;">Paiement à la livraison</span>
                                            <span class="d-block mt-1 text-muted" style="font-size:12px;">Payer en espèces</span>
                                        </label>
                                    </div>

                                </div>

                                {% if walletBalance < total and walletActive %}
                                <div class="alert alert-warning mt-3 py-2 px-3 rounded-3 d-flex align-items-center gap-2" style="font-size:13px;">
                                    <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                                    Solde insuffisant pour payer par wallet.
                                    <a href="{{ path('app_wallet') }}" class="ms-1 fw-bold text-decoration-none">Recharger →</a>
                                </div>
                                {% endif %}
                            </div>

                            <div class="card bg-primary bg-opacity-10 border-0 rounded-4 p-4 mb-4">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                        <i class="bi bi-info-circle"></i>
                                    </div>
                                    <p class="mb-0 small text-primary fw-medium">En cliquant sur confirmer, vous acceptez nos conditions générales de vente et confirmez votre engagement d'achat.</p>
                                </div>
                            </div>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 2rem;">
                        <h5 class="fw-bold mb-4">Résumé de la commande</h5>
                        <div class="mb-4 max-height-300 overflow-auto pe-2">
                            {% for item in items %}
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="d-flex align-items-center">
                                        <span class="badge bg-secondary rounded-pill me-2">{{ item.quantite }}</span>
                                        <h6 class="mb-0 fw-bold small text-truncate" style="max-width: 150px;">{{ item.produit.nom }}</h6>
                                    </div>
                                    <div class="text-end">
                                        <span class="fw-bold small">{{ item.total|number_format(2, ',', ' ') }} DT</span>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                        
                        <div class="pt-4 border-top">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">Sous-total</span>
                                <span class="fw-bold text-dark">{{ subtotal|number_format(2, ',', ' ') }} DT</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">TVA (7%)</span>
                                <span class="fw-bold text-dark">{{ tva|number_format(2, ',', ' ') }} DT</span>
                            </div>
                            <div class="d-flex justify-content-between mb-4 pb-4 border-bottom">
                                <span class="text-muted small">Livraison</span>
                                <span class="text-primary fw-bold small">{{ shipping|number_format(2, ',', ' ') }} DT</span>
                            </div>
                            <div class="d-flex justify-content-between mb-4">
                                <span class="h5 fw-bold">Total</span>
                                <span class="h5 fw-bold text-primary">{{ total|number_format(2, ',', ' ') }} DT</span>
                            </div>
                            
                            <button type="submit" id="submitOrderBtn" class="btn btn-primary btn-lg w-100 rounded-pill shadow-sm mb-3" disabled style="opacity:0.5;">
                                Confirmer la commande
                            </button>
                        </form>
                            <div class="text-center">
                                <small class="text-muted">Transaction 100% sécurisée</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function validateField(el, minLen) {
    const errorEl = document.getElementById(el.id + 'Error');
    if (el.value.length < minLen) {
        el.classList.add('is-invalid');
        errorEl?.classList.remove('d-none');
    } else {
        el.classList.remove('is-invalid');
        el.classList.add('is-valid');
        errorEl?.classList.add('d-none');
    }
    checkFormValidity();
}

function checkFormValidity() {
    const btn = document.getElementById('submitOrderBtn');
    const addr = document.getElementById('checkoutAdresse').value.trim();
    
    const isValid = addr.length >= 10;
    btn.disabled = !isValid;
    btn.style.opacity = isValid ? '1' : '0.5';
}

function validateCheckout() {
    const addr = document.getElementById('checkoutAdresse').value.trim();
    
    if (addr.length < 10) {
        alert("L'adresse est trop courte.");
        return false;
    }
    return true;
}

document.addEventListener("DOMContentLoaded", function() {
    // Check if map container exists
    var mapContainer = document.getElementById('map');
    if (!mapContainer) return;

    // Default to Tunis center
    var map = L.map('map').setView([36.8065, 10.1815], 13);
    
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap'
    }).addTo(map);

    var marker = L.marker([36.8065, 10.1815], {draggable: true}).addTo(map);

    // Add Geocoder Search bar
    var geocoder = L.Control.geocoder({
        defaultMarkGeocode: false,
        placeholder: "Rechercher une adresse...",
        errorMessage: "Adresse non trouvée."
    })
    .on('markgeocode', function(e) {
        var bbox = e.geocode.bbox;
        var poly = L.polygon([
            bbox.getSouthEast(),
            bbox.getNorthEast(),
            bbox.getNorthWest(),
            bbox.getSouthWest()
        ]);
        map.fitBounds(poly.getBounds());
        
        var latlng = e.geocode.center;
        marker.setLatLng(latlng);
        document.getElementById('checkoutAdresse').value = e.geocode.name;
    })
    .addTo(map);

    function updateAddress(lat, lng) {
        document.getElementById('checkoutAdresse').value = 'Recherche de l\'adresse en cours...';
        fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`)
            .then(r => r.json())
            .then(data => {
                if (data && data.display_name) {
                    document.getElementById('checkoutAdresse').value = data.display_name;
                    checkFormValidity();
                } else {
                    document.getElementById('checkoutAdresse').value = `${lat}, ${lng}`;
                    checkFormValidity();
                }
            })
            .catch(() => {
                document.getElementById('checkoutAdresse').value = `${lat}, ${lng}`;
            });
    }

    map.on('click', function(e) {
        marker.setLatLng(e.latlng);
        updateAddress(e.latlng.lat, e.latlng.lng);
    });

    marker.on('dragend', function(e) {
        var pos = marker.getLatLng();
        updateAddress(pos.lat, pos.lng);
    });
});
</script>
{% endblock %}
