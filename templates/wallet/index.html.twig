    border-color: #4A90E2 !important;
    color: #7BB8F5 !important;
}

/* Divider text in recharge form */
body.dark-mode .mb-card div[style*="background:var(--border-soft)"],
body.dark-mode .mb-card div[style*="background: var(--border-soft)"] {
