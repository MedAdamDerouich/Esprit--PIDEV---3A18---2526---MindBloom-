{% extends 'base.html.twig' %}

{% block title %}Laisser un avis - {{ produit.nom }} - MindBloom{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="mb-4">
                <a href="{{ path('app_produit_show', {'id': produit.id}) }}" class="btn btn-link text-muted p-0 text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Retour aux détails
                </a>
                <h1 class="h3 font-weight-bold mt-3">Laisser un avis pour {{ produit.nom }}</h1>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex align-items-center mb-4">
                        {% if produit.image %}
                            <img src="{{ asset('uploads/produits/' ~ produit.image) }}" class="rounded-3 me-3" style="width: 80px; height: 80px; object-fit: cover;" alt="{{ produit.nom }}">
                        {% endif %}
                        <div>
                            <h5 class="mb-1 fw-bold">{{ produit.nom }}</h5>
                            <p class="text-muted small mb-0">{{ produit.prix|number_format(2, ',', ' ') }} €</p>
                        </div>
                    </div>

                    <hr class="my-4">

                    {{ form_start(form) }}
                        <div class="mb-4">
                            <label class="form-label fw-bold">Votre note</label>
                            {{ form_widget(form.note) }}
                            {{ form_errors(form.note) }}
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Votre commentaire</label>
                            {{ form_widget(form.commentaire) }}
                            {{ form_errors(form.commentaire) }}
                        </div>
                        <div class="d-grid mt-4">
                            <button class="btn btn-primary btn-lg rounded-pill shadow-sm">
                                <i class="bi bi-send me-2"></i> Publier mon avis
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
            
            <div class="text-center mt-4">
                <p class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i> Votre avis aide les autres membres de la communauté MindBloom. Merci !
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
