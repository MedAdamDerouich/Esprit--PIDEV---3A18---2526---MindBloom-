</style>
<script>
/* ── Transaction search/filter ── */
function filterTx() {
    const search = (document.getElementById('txSearch')?.value || '').toLowerCase();
    const type   = document.getElementById('txType')?.value || '';
    const items  = document.querySelectorAll('.tx-item');
    let visible  = 0;

    items.forEach(function(row) {
        const matchType = !type || row.dataset.type === type;
        const matchText = !search ||
            row.dataset.desc.includes(search) ||
            row.dataset.date.includes(search);
        const show = matchType && matchText;
        row.style.display = show ? '' : 'none';
        if (show) visible++;
    });

    const emptyEl = document.getElementById('txEmpty');
    if (emptyEl) emptyEl.style.display = visible === 0 ? 'block' : 'none';

    const countEl = document.getElementById('txCount');
    if (countEl) countEl.textContent = visible + ' opération(s)';
}

/* ── Quick amount buttons ── */
function setAmount(val) {
    document.getElementById('amountInput').value = val;
}

/* ── Card number: auto-space + brand detection (mirrors Java real-time validation) ── */
const cardNumberInput = document.getElementById('card_number');
const cardBrandEl    = document.getElementById('cardBrand');

cardNumberInput.addEventListener('input', function () {
    let raw = this.value.replace(/\D/g, '').slice(0, 16);
    this.value = raw.match(/.{1,4}/g)?.join(' ') || '';

    // Brand detection: 4 = Visa, 5 = Mastercard (same as Java)
    if (raw.startsWith('4')) {
        cardBrandEl.innerHTML = '<svg width="38" height="24" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="38" height="24" rx="4" fill="#1A1F71"/><path d="M15.5 16.5h-2.1l1.3-8h2.1l-1.3 8zm7.1-7.8c-.4-.2-1.1-.4-1.9-.4-2.1 0-3.6 1.1-3.6 2.7 0 1.2 1.1 1.9 1.9 2.3.8.4 1.1.7 1.1 1.1 0 .6-.7.9-1.3.9-.9 0-1.3-.1-2-.4l-.3-.1-.3 1.8c.5.2 1.4.5 2.4.5 2.3 0 3.7-1.1 3.7-2.8 0-.9-.6-1.6-1.9-2.2-.8-.4-1.3-.6-1.3-1 0-.3.4-.7 1.3-.7.7 0 1.3.2 1.7.3l.2.1.3-1.7-.3-.1zM27 8.5h-1.6c-.5 0-.9.1-1.1.7l-3.1 7.3h2.2l.4-1.2h2.7l.2 1.2H29L27 8.5zm-2.6 5.3l.8-2.3.5 2.3h-1.3zM13.3 8.5l-2.1 5.5-.2-1.1c-.4-1.3-1.6-2.7-3-3.4l1.9 6.5h2.3l3.4-7.5h-2.3z" fill="white"/><path d="M9.7 8.5H6.3l-.1.2c2.6.7 4.4 2.3 5.1 4.2l-.7-3.7c-.1-.6-.5-.7-1-.7z" fill="#F9A533"/></svg>';
        cardBrandEl.style.opacity = '1';
        cardBrandEl.title = 'Visa';
    } else if (raw.startsWith('5')) {
        cardBrandEl.innerHTML = '<svg width="38" height="24" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="38" height="24" rx="4" fill="#252525"/><circle cx="15" cy="12" r="7" fill="#EB001B"/><circle cx="23" cy="12" r="7" fill="#F79E1B"/><path d="M19 6.8a7 7 0 0 1 0 10.4A7 7 0 0 1 19 6.8z" fill="#FF5F00"/></svg>';
        cardBrandEl.style.opacity = '1';
        cardBrandEl.title = 'Mastercard';
    } else {
        cardBrandEl.innerHTML = '<i class="bi bi-credit-card-2-back" style="font-size:20px;color:var(--text-mid);"></i>';
        cardBrandEl.style.opacity = raw.length > 0 ? '0.5' : '0.25';
        cardBrandEl.title = '';
    }

    validateField(this, /^\d{16}$/.test(raw), document.getElementById('err_number'),
        'Numéro de carte invalide (16 chiffres requis)');
});

/* ── Expiry: auto-insert "/" after 2 digits (mirrors Java) ── */
const expiryInput = document.getElementById('card_expiry');
expiryInput.addEventListener('input', function () {
    let raw = this.value.replace(/\D/g, '').slice(0, 4);
    if (raw.length > 2) {
        this.value = raw.slice(0, 2) + '/' + raw.slice(2);
    } else {
        this.value = raw;
    }
    validateField(this, /^(0[1-9]|1[0-2])\/\d{2}$/.test(this.value), document.getElementById('err_expiry'),
        'Format invalide (MM/AA requis)');
});

/* ── CVC: digits only, max 3 ── */
const cvcInput = document.getElementById('card_cvc');
cvcInput.addEventListener('input', function () {
    this.value = this.value.replace(/\D/g, '').slice(0, 3);
    validateField(this, /^\d{3}$/.test(this.value), document.getElementById('err_cvc'),
        'CVC invalide (3 chiffres requis)');
});

/* ── Cardholder name ── */
const nameInput = document.getElementById('card_name');
nameInput.addEventListener('blur', function () {
    validateField(this, this.value.trim() !== '', document.getElementById('err_name'),
        'Le nom du titulaire est requis');
});

/* ── Helper ── */
function validateField(input, isValid, errorEl, message) {
    if (isValid) {
        input.classList.add('is-valid');
        input.classList.remove('is-invalid');
        errorEl.textContent = '';
    } else {
        input.classList.add('is-invalid');
        input.classList.remove('is-valid');
        errorEl.textContent = message;
    }
}

/* ── Collapsible sections ── */
function toggleSection(bodyId, btnId) {
    const body = document.getElementById(bodyId);
    const btn  = document.getElementById(btnId);
    if (!body || !btn) return;
    const caret = btn.querySelector('.toggle-caret');
    const isOpen = body.style.display !== 'none';
    body.style.display = isOpen ? 'none' : 'block';
    if (caret) caret.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
}

/* ── AI Budget Coach (categorizer + recommendations) ── */
document.getElementById('btnCoach')?.addEventListener('click', runCoach);

async function runCoach() {
    const btn     = document.getElementById('btnCoach');
    const loading = document.getElementById('coachLoading');
    const result  = document.getElementById('coachResult');
    const errBox  = document.getElementById('coachError');

    result.style.display  = 'none';
    errBox.style.display  = 'none';
    loading.style.display = 'block';
    btn.disabled = true;
    btn.style.opacity = '.6';

    try {
        const resp = await fetch('{{ path('app_wallet_ai_coach') }}', { method: 'POST' });
        const data = await resp.json();

        if (data.error) {
            errBox.textContent = data.error;
            errBox.style.display = 'block';
        } else {
            renderCoach(data);
            result.style.display = 'block';
        }
    } catch (e) {
        errBox.textContent = 'Erreur de connexion à l\'IA. Réessayez.';
        errBox.style.display = 'block';
    }

    loading.style.display = 'none';
    btn.disabled = false;
    btn.style.opacity = '1';
}

function renderCoach(data) {
    // Stats
    document.getElementById('coachSpent').textContent     = (data.totalSpending ?? 0).toFixed(2) + ' DT';
    document.getElementById('coachRecharged').textContent = (data.totalRecharges ?? 0).toFixed(2) + ' DT';
    document.getElementById('coachTopCat').textContent    = data.topCategory ?? '—';
    document.getElementById('coachScore').textContent     = (data.healthScore ?? 0) + '/100';
    document.getElementById('coachScoreBar').style.width  = (data.healthScore ?? 0) + '%';

    // Donut chart
    drawDonut(data.categories || []);

    // Legend
    const legend = document.getElementById('coachLegend');
    legend.innerHTML = (data.categories || []).map(c => `
        <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f0f4f8;">
            <div style="display:flex;align-items:center;gap:10px;">
                <span style="width:12px;height:12px;border-radius:3px;background:${c.color};display:inline-block;"></span>
                <span style="font-size:13px;color:#1B3A6B;font-weight:600;">${escapeHtml(c.name)}</span>
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
                <span style="font-size:12px;color:#7a8a9a;">${c.percent}%</span>
                <span style="font-size:13px;font-weight:700;color:#1B3A6B;">${c.amount.toFixed(2)} DT</span>
            </div>
        </div>
    `).join('') || '<div style="color:#7a8a9a;font-size:13px;">Aucune catégorie.</div>';

    // Summary
    document.getElementById('coachSummary').textContent = data.summary || '—';

    // Recommendations
    const recs = document.getElementById('coachRecs');
    recs.innerHTML = (data.recommendations || []).map(r => `
        <li style="display:flex;gap:10px;padding:8px 0;font-size:13.5px;color:#1B3A6B;line-height:1.6;">
            <i class="bi bi-check-circle-fill" style="color:#4ECB71;flex-shrink:0;margin-top:2px;"></i>
            <span>${escapeHtml(r)}</span>
        </li>
    `).join('') || '<li style="color:#7a8a9a;font-size:13px;">Aucune recommandation.</li>';
}

function drawDonut(categories) {
    const svg = document.getElementById('coachChart');
    svg.innerHTML = '';
    const total = categories.reduce((s, c) => s + c.amount, 0);
    if (total <= 0) {
        svg.innerHTML = '<text x="0" y="0" text-anchor="middle" dominant-baseline="middle" fill="#7a8a9a" font-size="13">Aucune dépense</text>';
        return;
    }

    const R_OUTER = 95, R_INNER = 58;
    let angle = -Math.PI / 2; // start at top

    categories.forEach(c => {
        const slice = (c.amount / total) * Math.PI * 2;
        const a2 = angle + slice;
        const large = slice > Math.PI ? 1 : 0;

        const x1 = Math.cos(angle) * R_OUTER, y1 = Math.sin(angle) * R_OUTER;
        const x2 = Math.cos(a2)    * R_OUTER, y2 = Math.sin(a2)    * R_OUTER;
        const x3 = Math.cos(a2)    * R_INNER, y3 = Math.sin(a2)    * R_INNER;
        const x4 = Math.cos(angle) * R_INNER, y4 = Math.sin(angle) * R_INNER;

        const d = `M ${x1} ${y1} A ${R_OUTER} ${R_OUTER} 0 ${large} 1 ${x2} ${y2} L ${x3} ${y3} A ${R_INNER} ${R_INNER} 0 ${large} 0 ${x4} ${y4} Z`;
        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        path.setAttribute('d', d);
        path.setAttribute('fill', c.color);
        path.setAttribute('stroke', '#fff');
        path.setAttribute('stroke-width', '2');
        svg.appendChild(path);
        angle = a2;
    });

    // Center text
    const total2 = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    total2.setAttribute('text-anchor', 'middle');
    total2.setAttribute('dominant-baseline', 'middle');
    total2.setAttribute('y', '-6');
    total2.setAttribute('fill', '#7a8a9a');
    total2.setAttribute('font-size', '11');
    total2.setAttribute('font-weight', '600');
    total2.textContent = 'Total';
    svg.appendChild(total2);

    const totalVal = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    totalVal.setAttribute('text-anchor', 'middle');
    totalVal.setAttribute('dominant-baseline', 'middle');
    totalVal.setAttribute('y', '14');
    totalVal.setAttribute('fill', '#1B3A6B');
    totalVal.setAttribute('font-size', '18');
    totalVal.setAttribute('font-weight', '800');
    totalVal.textContent = total.toFixed(0) + ' DT';
    svg.appendChild(totalVal);
}

function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, m => ({
        '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
    }[m]));
}

/* ── Form submit guard ── */
document.getElementById('rechargeForm').addEventListener('submit', function (e) {
    const name   = nameInput.value.trim();
    const number = cardNumberInput.value.replace(/\s/g, '');
    const expiry = expiryInput.value.trim();
    const cvc    = cvcInput.value.trim();
    const amount = parseFloat(document.getElementById('amountInput').value);
    const errors = [];

    if (!name)                                     errors.push('Nom du titulaire requis.');
    if (!/^\d{16}$/.test(number))                  errors.push('Numéro de carte invalide (16 chiffres).');
    if (!/^(0[1-9]|1[0-2])\/\d{2}$/.test(expiry)) errors.push('Date d\'expiration invalide (MM/AA).');
    if (!/^\d{3}$/.test(cvc))                      errors.push('CVC invalide (3 chiffres).');
    if (!amount || amount < 2)                     errors.push('Montant minimum : 2 DT.');

    if (errors.length > 0) {
        e.preventDefault();
        const box = document.getElementById('formError');
        box.innerHTML = errors.map(e => '<i class="bi bi-exclamation-circle" style="margin-right:5px;"></i>' + e).join('<br>');
        box.style.display = 'block';
        box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
});
</script>
{% endblock %}
