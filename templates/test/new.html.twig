{% extends 'base.html.twig' %}

{% block title %}Nouveau Test — MindBloom{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
body.dark-mode .test-page {
    background: #0F1117 !important;
}
body.dark-mode .test-page [style*="background:#F5F3EF"],
body.dark-mode .test-page [style*="background:#FAFAF8"] {
    background: #0F1117 !important;
}
body.dark-mode .test-page [style*="background: white"],
body.dark-mode .test-page [style*="background:white"] {
    background: #161A26 !important;
    border-color: #252B3E !important;
    box-shadow: 0 12px 28px rgba(0,0,0,0.45) !important;
}
body.dark-mode .test-page [style*="background:#EDF9F5"] {
    background: #1A1F2E !important;
}
body.dark-mode .test-page [style*="color: #2C3E50"],
body.dark-mode .test-page [style*="color:#2C3E50"] {
    color: #E8EAF0 !important;
}
body.dark-mode .test-page [style*="color: #7F8C8D"],
body.dark-mode .test-page [style*="color:#7F8C8D"] {
    color: #7A8299 !important;
}
body.dark-mode .test-page a[style*="color: #7F8C8D"] {
    color: #AEB5C8 !important;
}
</style>
{% endblock %}

{% block body %}
<div class="test-page" style="background:#F5F3EF; min-height: calc(100vh - 85px); padding: 50px;">
    <div style="max-width: 800px; margin: 0 auto;">
        
        <a href="{{ path('app_test_manage') }}" style="display:inline-block; margin-bottom: 20px; color: #7F8C8D; text-decoration: none; font-size: 14px; font-weight: 500;">
            ← Retour à mes tests
        </a>

        <div style="background: white; border-radius: 20px; padding: 40px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); margin-bottom: 30px;">
            <div style="text-align: center; margin-bottom: 30px;">
                <span style="display:inline-block;background:#EDF9F5;color:#5FBF9F;border-radius:20px;padding:6px 15px;font-size:13px;margin-bottom:15px;font-weight:700;">
                    ✨ Création
                </span>
                <h1 style="font-size: 32px; font-weight: 800; color: #2C3E50;">Ajouter un Test</h1>
                <p style="color: #7F8C8D; margin-top: 10px;">Configurez les détails du nouveau test d'autoévaluation.</p>
            </div>

            {{ include('test/_form.html.twig', {'button_label': 'Créer le test'}) }}
        </div>
    </div>
</div>
{% endblock %}