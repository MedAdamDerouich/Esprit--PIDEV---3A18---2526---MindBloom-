                               fill="url(#rPetalA)" transform="rotate(0 150 110)"/>
                      <ellipse class="petal" cx="150" cy="96" rx="13" ry="25"
                               fill="url(#rPetalB)" transform="rotate(60 150 110)"/>
                      <ellipse class="petal" cx="150" cy="96" rx="13" ry="25"
                               fill="url(#rPetalA)" transform="rotate(120 150 110)"/>
                      <ellipse class="petal" cx="150" cy="96" rx="13" ry="25"
                               fill="url(#rPetalB)" transform="rotate(180 150 110)"/>
                      <ellipse class="petal" cx="150" cy="96" rx="13" ry="25"
