{% extends 'base.html.twig' %}

{% block title %}Boutique MindBloom - Votre bien-être au naturel{% endblock %}

{% block body %}
<div class="container py-5">
    <!-- Hero Header (Matched with Cabinet list style) -->
    <div style="width:100%; display:flex; flex-direction:column; align-items:center; gap:5px; margin-bottom:40px;">
        <span style="font-size:32px; font-weight:bold; color:#2D3748;">Découvrez notre boutique</span>
        <span style="font-size:32px; font-weight:bold; color:#4A90E2;">MindBloom</span>
        <span style="color:#718096; font-size:16px; margin-top:10px; max-width:700px; text-align:center;">Une sélection de produits naturels et d'articles de bien-être pour vous accompagner sereinement.</span>
        
        <!-- Search & Sort Bar -->
        <div class="mt-4 w-100" style="max-width: 700px;">
            <div class="search-sort-wrapper">
                <select id="liveSortSelect" class="premium-select form-select">
                    <option value="default">Trier par défaut</option>
                    <option value="prix_asc">Prix : Croissant</option>
                    <option value="prix_desc">Prix : Décroissant</option>
                </select>
                
                <input type="text" id="liveSearchInput" class="premium-input form-control" placeholder="Rechercher un article, un produit de bien-être...">
                
                <button type="button" class="premium-icon-btn">
                    <i class="bi bi-search"></i>
                </button>
            </div>
            
            <div id="searchValidationMessage" class="text-danger mt-2 small fw-bold" style="display: none; text-align: center;"></div>
     <div id="searchNoResults" class="text-muted mt-2 small" style="display: none; text-align: center;">Aucun produit trouvé pour cette recherche.</div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5" id="productGrid">
        {% for produit in produits %}
            <div class="col product-item" data-price="{{ produit.prix }}">
                <div class="android-cardview h-100" style="cursor: pointer;" onclick="window.location.href='{{ path('app_produit_show', {'id': produit.id}) }}'">
                    <div class="image-wrapper">
                        {% if produit.image %}
                            <img src="{{ asset('uploads/produits/' ~ produit.image) }}" class="product-image" alt="{{ produit.nom }}">
                        {% else %}
                            <div class="image-placeholder">
                                <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                            </div>
                        {% endif %}
                        <div class="price-chip">
                             {{ produit.prix|number_format(2, ',', ' ') }} DT
                        </div>
                    </div>

                    <div class="card-content">
                        <h2 class="product-title">{{ produit.nom }}</h2>
                        
                        <div class="rating-bar">
                            <div class="stars">
                                {% set avg = produit.averageRating %}
                                {% for i in 1..5 %}
                                    <i class="bi bi-star{{ i <= avg ? '-fill' : (i - 0.5 <= avg ? '-half' : '') }}"></i>
                                {% endfor %}
                            </div>
                            <span class="review-count">({{ produit.feedbacks|length }})</span>
                        </div>
                        
                        <p class="product-description">
                            {{ produit.description|slice(0, 80) }}...
                        </p>
                    </div>
                    
                    <div class="card-actions">
                        <a href="{{ path('app_produit_feedback_new', {'id': produit.id}) }}" class="btn-android-raised" onclick="event.stopPropagation();">AVIS</a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <p class="text-muted">Aucun produit n'est disponible pour le moment.</p>
            </div>
        {% endfor %}
    </div>

    <!-- Pagination -->
    {% if maxPages > 1 %}
    <div class="d-flex justify-content-center mt-4">
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-md">
                <li class="page-item {{ currentPage == 1 ? 'disabled' : '' }}">
                    <a class="page-link border-0 shadow-sm rounded-pill px-4 mx-1" 
                       href="{{ path('app_produit_index', {page: currentPage - 1, q: searchTerm}) }}"
                       style="color: #4A90E2; background-color: white;">
                        <i class="bi bi-chevron-left me-1"></i> Précédent
                    </a>
                </li>
                
                {% for i in 1..maxPages %}
                    {% if i >= currentPage - 2 and i <= currentPage + 2 %}
                        <li class="page-item {{ i == currentPage ? 'active' : '' }}">
                            <a class="page-link border-0 shadow-sm rounded-circle mx-1 {{ i == currentPage ? 'text-white' : 'text-muted' }}" 
                               href="{{ path('app_produit_index', {page: i, q: searchTerm}) }}"
                               style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; {{ i == currentPage ? 'background-color: #4A90E2;' : 'background-color: white;' }}">
                                {{ i }}
                            </a>
                        </li>
                    {% endif %}
                {% endfor %}
                
                <li class="page-item {{ currentPage == maxPages ? 'disabled' : '' }}">
                    <a class="page-link border-0 shadow-sm rounded-pill px-4 mx-1" 
                       href="{{ path('app_produit_index', {page: currentPage + 1, q: searchTerm}) }}"
                       style="color: #4A90E2; background-color: white;">
                        Suivant <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
    {% endif %}
</div>

<style>
/* Android XML CardView Style Simulation */
.android-cardview {
    background-color: #ffffff;
    border-radius: 12px;
    box-shadow: 0 2px 1px -1px rgba(0,0,0,.2), 0 1px 1px 0 rgba(0,0,0,.14), 0 1px 3px 0 rgba(0,0,0,.12);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
    transition: box-shadow 0.2s ease-in-out, transform 0.2s ease-in-out;
}

.android-cardview:hover {
    box-shadow: 0 8px 10px -5px rgba(0,0,0,.2), 0 16px 24px 2px rgba(0,0,0,.14), 0 6px 30px 5px rgba(0,0,0,.12);
    transform: translateY(-2px);
}

.image-wrapper {
    position: relative;
    height: 200px;
    background-color: #f5f5f5;
    overflow: hidden;
}

.product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.price-chip {
    position: absolute;
    top: 12px;
    right: 12px;
    background-color: rgba(0, 0, 0, 0.6);
    color: white;
    padding: 6px 12px;
    border-radius: 16px;
    font-size: 14px;
    font-weight: 500;
    backdrop-filter: blur(4px);
}

.card-content {
    padding: 16px;
    flex-grow: 1;
}

.product-title {
    font-size: 20px;
    font-weight: 500;
    color: #212121;
    margin: 0 0 8px 0;
    line-height: 1.2;
}

.rating-bar {
    display: flex;
    align-items: center;
    margin-bottom: 12px;
}

.stars {
    color: #FFB300;
    font-size: 14px;
    margin-right: 6px;
}

.review-count {
    font-size: 12px;
    color: #757575;
}

.product-description {
    font-size: 14px;
    color: #757575;
    margin: 0;
    line-height: 1.5;
}

.card-actions {
    padding: 8px 16px 16px 16px;
    display: flex;
    justify-content: flex-end;
    gap: 8px;
}

.btn-android-flat {
    background: transparent;
    color: #4A90E2;
    border: none;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    border-radius: 4px;
    text-decoration: none;
    transition: background-color 0.2s;
}

.btn-android-flat:hover {
    background-color: rgba(74, 144, 226, 0.1);
    color: #4A90E2;
}

.btn-android-raised {
    background-color: #4A90E2;
    color: white;
    border: none;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    border-radius: 4px;
    text-decoration: none;
    box-shadow: 0 3px 1px -2px rgba(0,0,0,.2), 0 2px 2px 0 rgba(0,0,0,.14), 0 1px 5px 0 rgba(0,0,0,.12);
    transition: background-color 0.2s, box-shadow 0.2s;
}

.btn-android-raised:hover {
    background-color: #357ABD;
    color: white;
    box-shadow: 0 2px 4px -1px rgba(0,0,0,.2), 0 4px 5px 0 rgba(0,0,0,.14), 0 1px 10px 0 rgba(0,0,0,.12);
}

.pagination .page-link:hover {
    background-color: #f8f9fa !important;
    transform: translateY(-1px);
    transition: all 0.2s;
}
.pagination .active .page-link:hover {
    background-color: #357ABD !important;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('liveSearchInput');
    const sortSelect = document.getElementById('liveSortSelect');
    const productGrid = document.getElementById('productGrid');
    const validationMessage = document.getElementById('searchValidationMessage');
    const noResultsMessage = document.getElementById('searchNoResults');
    
    // Search on Enter
    if (searchInput) {
        searchInput.value = "{{ searchTerm }}";
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                window.location.href = "{{ path('app_produit_index') }}?q=" + encodeURIComponent(this.value);
            }
        });
    }

    // Store original order
    let originalItems = Array.from(productGrid.querySelectorAll('.col.product-item'));

    function applyFilters() {
        let rawValue = searchInput ? searchInput.value : '';
        const forbiddenChars = /[<>{}]/;
        let hasError = false;

        if (forbiddenChars.test(rawValue)) {
            validationMessage.textContent = "Les caractères spéciaux <, >, {, } ne sont pas autorisés.";
            validationMessage.style.display = 'block';
            hasError = true;
        } else if (rawValue.length > 50) {
            validationMessage.textContent = "La recherche ne doit pas dépasser 50 caractères.";
            validationMessage.style.display = 'block';
            hasError = true;
        } else {
            validationMessage.style.display = 'none';
        }

        if (hasError) return;

        let searchQuery = rawValue.toLowerCase().trim();
        let sortValue = sortSelect ? sortSelect.value : 'default';
        let visibleCount = 0;
        let hasRealItems = originalItems.length > 0;

        // Apply sort
        let sortedItems = [...originalItems];
        if (sortValue === 'prix_asc') {
            sortedItems.sort((a, b) => parseFloat(a.dataset.price) - parseFloat(b.dataset.price));
        } else if (sortValue === 'prix_desc') {
            sortedItems.sort((a, b) => parseFloat(b.dataset.price) - parseFloat(a.dataset.price));
        }

        // Apply filter (only for items on current page)
        sortedItems.forEach(col => {
            const titleEl = col.querySelector('.product-title');
            const descEl = col.querySelector('.product-description');
            
            let titleText = titleEl ? titleEl.textContent.toLowerCase() : '';
            let descText = descEl ? descEl.textContent.toLowerCase() : '';

            if (titleText.includes(searchQuery) || descText.includes(searchQuery)) {
                col.style.display = 'block';
                visibleCount++;
            } else {
                col.style.display = 'none';
            }
            productGrid.appendChild(col);
        });

        if (hasRealItems && visibleCount === 0 && searchQuery !== '') {
            noResultsMessage.style.display = 'block';
        } else {
            noResultsMessage.style.display = 'none';
        }
    }

    if (searchInput) searchInput.addEventListener('input', applyFilters);
    if (sortSelect) sortSelect.addEventListener('change', applyFilters);
});
</script>
{% endblock %}
