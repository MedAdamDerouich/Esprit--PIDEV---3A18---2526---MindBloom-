{% extends 'base.html.twig' %}
{% block title %}Espace Psychologue — MindBloom{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════════════════
   TOKENS
═══════════════════════════════════════════════════ */
:root {
  --forest:   #1C3A2F;
  --moss:     #2D5A47;
  --sage:     #4E8C6E;
  --mint:     #7EC8A4;
  --lime:     #C8E6A0;
  --sand:     #F2EDE4;
  --parchment:#FBF8F2;
  --charcoal: #1A1F2E;
  --slate:    #3D4A5C;
  --mist:     #8A97A6;
  --rust:     #C4522A;
  --amber:    #E8963A;
  --plum:     #6B3FA0;
  --ink:      #0F1419;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body { background: var(--parchment); }

.pd-root {
  font-family: 'Syne', sans-serif;
  min-height: calc(100vh - 70px);
  background: var(--parchment);
  position: relative;
  overflow-x: hidden;
}

/* ── Fixed texture layer ── */
.pd-root::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image:
    radial-gradient(ellipse 70% 50% at 90% 5%, rgba(78,140,110,0.08) 0%, transparent 60%),
    radial-gradient(ellipse 50% 60% at 5% 95%, rgba(196,82,42,0.05) 0%, transparent 55%),
    radial-gradient(ellipse 40% 40% at 50% 50%, rgba(107,63,160,0.03) 0%, transparent 60%);
  pointer-events: none;
  z-index: 0;
}

/* ═══════════════════════════════════════════════════
   LAYOUT SHELL — ASYMMETRIC SPLIT
═══════════════════════════════════════════════════ */
.pd-shell {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 280px 1fr;
  grid-template-rows: auto 1fr;
  min-height: calc(100vh - 70px);
}

/* ── Left rail — dark, narrow ── */
.pd-rail {
  grid-row: 1 / -1;
  background: var(--forest);
  padding: 48px 0 40px;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  opacity: 0;
  transform: translateX(-30px);
  animation: railIn 0.8s cubic-bezier(0.22,1,0.36,1) 0.05s forwards;
}

/* Rail decorative arc */
.pd-rail::after {
  content: '';
  position: absolute;
  right: -60px;
  top: 50%;
  transform: translateY(-50%);
  width: 120px;
  height: 400px;
  background: rgba(78,140,110,0.12);
  border-radius: 50%;
  pointer-events: none;
}

.pd-rail__brand {
  padding: 0 32px 40px;
  border-bottom: 1px solid rgba(255,255,255,0.07);
}

.pd-rail__eyebrow {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--mint);
  margin-bottom: 8px;
}

.pd-rail__name {
  font-family: 'Playfair Display', serif;
  font-size: 22px;
  font-weight: 900;
  color: #fff;
  line-height: 1.1;
}

.pd-rail__name em {
  font-style: italic;
  color: var(--mint);
}

/* Rail nav links */
.pd-rail__nav {
  padding: 32px 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.pd-rail__link {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 13px 32px;
  text-decoration: none;
  color: rgba(255,255,255,0.55);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.2px;
  transition: color 0.2s, background 0.2s;
  position: relative;
  border-left: 3px solid transparent;
}

.pd-rail__link:hover {
  color: #fff;
  background: rgba(255,255,255,0.05);
  border-left-color: var(--mint);
}

.pd-rail__link--active {
  color: #fff;
  background: rgba(78,140,110,0.18);
  border-left-color: var(--mint);
}

.pd-rail__link-icon {
  width: 34px;
  height: 34px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  flex-shrink: 0;
  background: rgba(255,255,255,0.06);
  transition: background 0.2s, transform 0.25s cubic-bezier(0.34,1.56,0.64,1);
}
.pd-rail__link:hover .pd-rail__link-icon {
  background: rgba(126,200,164,0.2);
  transform: scale(1.1);
}

/* Rail status pill */
.pd-rail__status {
  margin: 0 24px;
  padding: 14px 16px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 12px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.pd-rail__status-dot {
  width: 8px; height: 8px;
  background: #4ade80;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 0 3px rgba(74,222,128,0.25);
  animation: statusPulse 2.5s ease-in-out infinite;
}
@keyframes statusPulse {
  0%,100% { box-shadow: 0 0 0 3px rgba(74,222,128,0.25); }
  50%      { box-shadow: 0 0 0 6px rgba(74,222,128,0.1); }
}
.pd-rail__status-text {
  font-size: 11px;
  color: rgba(255,255,255,0.6);
  font-weight: 500;
  line-height: 1.3;
}
.pd-rail__status-text strong {
  display: block;
  color: #fff;
  font-size: 12px;
}

/* ── Main area ── */
.pd-main {
  display: flex;
  flex-direction: column;
  padding: 0;
  overflow: hidden;
}

/* ═══════════════════════════════════════════════════
   HEADER BAND — full-bleed dark strip
═══════════════════════════════════════════════════ */
.pd-header {
  background: var(--charcoal);
  padding: 40px 52px 44px;
  position: relative;
  overflow: hidden;
  opacity: 0;
  animation: fadeDown 0.7s cubic-bezier(0.22,1,0.36,1) 0.2s forwards;
}

/* Decorative slash */
.pd-header::before {
  content: '';
  position: absolute;
  right: -40px;
  bottom: -60px;
  width: 300px;
  height: 300px;
  background: linear-gradient(135deg, rgba(78,140,110,0.15), transparent 60%);
  border-radius: 50%;
}
.pd-header::after {
  content: '';
  position: absolute;
  right: 200px;
  top: -80px;
  width: 200px;
  height: 200px;
  background: rgba(107,63,160,0.08);
  border-radius: 50%;
}

.pd-header__tag {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: rgba(126,200,164,0.12);
  border: 1px solid rgba(126,200,164,0.25);
  border-radius: 4px;
  padding: 5px 12px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--mint);
  margin-bottom: 20px;
}
.pd-header__tag-dot {
  width: 5px; height: 5px;
  background: var(--mint);
  border-radius: 50%;
}

.pd-header__h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(32px, 4vw, 50px);
  font-weight: 900;
  color: #fff;
  line-height: 1.05;
  letter-spacing: -0.5px;
  max-width: 520px;
  position: relative;
  z-index: 1;
}
.pd-header__h1 em {
  font-style: italic;
  color: var(--mint);
}

.pd-header__sub {
  font-size: 14px;
  color: rgba(255,255,255,0.45);
  margin-top: 12px;
  font-weight: 400;
  letter-spacing: 0.1px;
  position: relative;
  z-index: 1;
}

/* ═══════════════════════════════════════════════════
   CONTENT AREA
═══════════════════════════════════════════════════ */
.pd-content {
  padding: 40px 52px 60px;
  display: flex;
  flex-direction: column;
  gap: 40px;
  flex: 1;
}

/* ── Stats strip — left-aligned, not centered ── */
.pd-stats {
  display: grid;
  grid-template-columns: repeat(3, auto);
  justify-content: start;
  gap: 0;
  opacity: 0;
  transform: translateY(16px);
  animation: fadeUp 0.6s ease 0.45s forwards;
}

.pd-stat {
  padding: 0 40px 0 0;
  margin-right: 40px;
  border-right: 1px solid rgba(0,0,0,0.08);
  position: relative;
}
.pd-stat:last-child {
  border-right: none;
  margin-right: 0;
  padding-right: 0;
}

.pd-stat__val {
  font-family: 'Playfair Display', serif;
  font-size: 48px;
  font-weight: 900;
  line-height: 1;
  color: var(--ink);
  letter-spacing: -2px;
  display: flex;
  align-items: baseline;
  gap: 3px;
}
.pd-stat__val sup {
  font-family: 'Syne', sans-serif;
  font-size: 18px;
  font-weight: 700;
  color: var(--sage);
  letter-spacing: 0;
}
.pd-stat__label {
  font-size: 11px;
  font-weight: 600;
  color: var(--mist);
  letter-spacing: 1.5px;
  text-transform: uppercase;
  margin-top: 6px;
}
.pd-stat__bar {
  height: 2px;
  margin-top: 10px;
  border-radius: 2px;
  width: 0;
  transition: width 1.2s cubic-bezier(0.22,1,0.36,1);
}
.pd-stat:nth-child(1) .pd-stat__bar { background: var(--sage); }
.pd-stat:nth-child(2) .pd-stat__bar { background: var(--rust); }
.pd-stat:nth-child(3) .pd-stat__bar { background: var(--plum); }
.pd-stat__bar.animated { width: 100%; }

/* ── Section divider ── */
.pd-divider {
  display: flex;
  align-items: center;
  gap: 16px;
  opacity: 0;
  animation: fadeUp 0.5s ease 0.55s forwards;
}
.pd-divider__label {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--mist);
  white-space: nowrap;
}
.pd-divider__line {
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, rgba(0,0,0,0.1), transparent);
}
.pd-divider__num {
  font-size: 10px;
  font-weight: 700;
  color: var(--mist);
  background: rgba(0,0,0,0.05);
  border-radius: 4px;
  padding: 2px 7px;
}

/* ═══════════════════════════════════════════════════
   CARD GRID — INTENTIONALLY ASYMMETRIC
═══════════════════════════════════════════════════ */
.pd-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto auto;
  gap: 16px;
}

/* Base card */
.pd-card {
  border-radius: 0;
  text-decoration: none;
  display: block;
  position: relative;
  overflow: hidden;
  cursor: pointer;
  opacity: 0;
  transform: translateY(28px);
  transition:
    transform 0.4s cubic-bezier(0.22,1,0.36,1),
    box-shadow 0.4s ease;
}

.pd-card:nth-child(1) { animation: fadeUp 0.55s ease 0.62s forwards; border-radius: 20px 4px 20px 20px; }
.pd-card:nth-child(2) { animation: fadeUp 0.55s ease 0.70s forwards; border-radius: 4px 20px 4px 4px; }
.pd-card:nth-child(3) { animation: fadeUp 0.55s ease 0.78s forwards; border-radius: 4px 4px 20px 4px; }
.pd-card:nth-child(4) { animation: fadeUp 0.55s ease 0.86s forwards; border-radius: 4px 20px 20px 20px; }

/* Card 1 — Cabinet — dark forest */
.pd-card--1 {
  background: var(--forest);
  color: #fff;
  box-shadow: 0 4px 24px rgba(28,58,47,0.25);
}
.pd-card--1:hover {
  transform: translateY(-5px) scale(1.005);
  box-shadow: 0 16px 48px rgba(28,58,47,0.35);
}

/* Card 2 — Créneaux — sand/warm */
.pd-card--2 {
  background: var(--sand);
  color: var(--ink);
  box-shadow: 0 4px 24px rgba(0,0,0,0.06);
  border: 1px solid rgba(0,0,0,0.07);
}
.pd-card--2:hover {
  transform: translateY(-5px) scale(1.005);
  box-shadow: 0 16px 40px rgba(0,0,0,0.12);
}

/* Card 3 — Réservations — rust accent */
.pd-card--3 {
  background: var(--parchment);
  color: var(--ink);
  box-shadow: 0 4px 24px rgba(0,0,0,0.06);
  border: 1px solid rgba(0,0,0,0.07);
}
.pd-card--3:hover {
  transform: translateY(-5px) scale(1.005);
  box-shadow: 0 16px 40px rgba(0,0,0,0.1);
}

/* Card 4 — Tests — plum/dark */
.pd-card--4 {
  background: var(--charcoal);
  color: #fff;
  box-shadow: 0 4px 24px rgba(15,20,30,0.3);
}
.pd-card--4:hover {
  transform: translateY(-5px) scale(1.005);
  box-shadow: 0 16px 48px rgba(15,20,30,0.4);
}

/* ── Card inner layout ── */
.pd-card__inner {
  padding: 32px 32px 28px;
  height: 100%;
  display: flex;
  flex-direction: column;
  min-height: 220px;
}

.pd-card__top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28px;
}

.pd-card__num {
  font-family: 'Playfair Display', serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  opacity: 0.35;
}
.pd-card--1 .pd-card__num,
.pd-card--4 .pd-card__num { color: #fff; }
.pd-card--2 .pd-card__num,
.pd-card--3 .pd-card__num { color: var(--ink); }

.pd-card__chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 5px 10px;
  border-radius: 4px;
}
.pd-card--1 .pd-card__chip {
  background: rgba(126,200,164,0.15);
  color: var(--mint);
}
.pd-card--2 .pd-card__chip {
  background: rgba(196,82,42,0.1);
  color: var(--rust);
}
.pd-card--3 .pd-card__chip {
  background: rgba(232,150,58,0.12);
  color: var(--amber);
}
.pd-card--4 .pd-card__chip {
  background: rgba(107,63,160,0.25);
  color: #c4a8f0;
}

.pd-card__icon-wrap {
  font-size: 28px;
  line-height: 1;
  transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1);
}
.pd-card:hover .pd-card__icon-wrap { transform: scale(1.2) rotate(-8deg); }

.pd-card__title {
  font-family: 'Playfair Display', serif;
  font-size: 24px;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -0.3px;
  margin-bottom: 10px;
}
.pd-card--1 .pd-card__title,
.pd-card--4 .pd-card__title { color: #fff; }
.pd-card--2 .pd-card__title,
.pd-card--3 .pd-card__title { color: var(--ink); }

.pd-card__desc {
  font-size: 13px;
  line-height: 1.65;
  font-weight: 400;
  flex: 1;
}
.pd-card--1 .pd-card__desc { color: rgba(255,255,255,0.55); }
.pd-card--4 .pd-card__desc { color: rgba(255,255,255,0.5); }
.pd-card--2 .pd-card__desc { color: var(--slate); }
.pd-card--3 .pd-card__desc { color: var(--slate); }

.pd-card__footer {
  margin-top: 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18px;
}
.pd-card--1 .pd-card__footer,
.pd-card--4 .pd-card__footer { border-top: 1px solid rgba(255,255,255,0.1); }
.pd-card--2 .pd-card__footer,
.pd-card--3 .pd-card__footer { border-top: 1px solid rgba(0,0,0,0.07); }

.pd-card__cta {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
}
.pd-card--1 .pd-card__cta { color: var(--mint); }
.pd-card--2 .pd-card__cta { color: var(--rust); }
.pd-card--3 .pd-card__cta { color: var(--amber); }
.pd-card--4 .pd-card__cta { color: #c4a8f0; }

.pd-card__arrow {
  width: 32px; height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1), background 0.25s;
}
.pd-card--1 .pd-card__arrow { background: rgba(255,255,255,0.1); color: #fff; }
.pd-card--2 .pd-card__arrow { background: rgba(196,82,42,0.1); color: var(--rust); }
.pd-card--3 .pd-card__arrow { background: rgba(232,150,58,0.1); color: var(--amber); }
.pd-card--4 .pd-card__arrow { background: rgba(107,63,160,0.3); color: #c4a8f0; }
.pd-card:hover .pd-card__arrow { transform: translate(4px, -4px); }
.pd-card--1:hover .pd-card__arrow { background: rgba(126,200,164,0.2); }

/* Card 1 decorative orb */
.pd-card--1 .pd-card__orb {
  position: absolute;
  right: -30px;
  bottom: -30px;
  width: 130px;
  height: 130px;
  background: radial-gradient(circle, rgba(78,140,110,0.35) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
  transition: transform 0.5s ease;
}
.pd-card--1:hover .pd-card__orb { transform: scale(1.4); }

/* Card 4 decorative orb */
.pd-card--4 .pd-card__orb {
  position: absolute;
  left: -20px;
  top: -20px;
  width: 120px;
  height: 120px;
  background: radial-gradient(circle, rgba(107,63,160,0.2) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
  transition: transform 0.5s ease;
}
.pd-card--4:hover .pd-card__orb { transform: scale(1.5); }

/* ═══════════════════════════════════════════════════
   KEYFRAMES
═══════════════════════════════════════════════════ */
@keyframes railIn {
  to { opacity: 1; transform: translateX(0); }
}
@keyframes fadeDown {
  from { opacity: 0; transform: translateY(-16px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fadeUp {
  to { opacity: 1; transform: translateY(0); }
}

/* ═══════════════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════════════ */
@media (max-width: 1024px) {
  .pd-shell { grid-template-columns: 220px 1fr; }
  .pd-header, .pd-content { padding-left: 36px; padding-right: 36px; }
}
@media (max-width: 768px) {
  .pd-shell { grid-template-columns: 1fr; }
  .pd-rail  { display: none; }
  .pd-grid  { grid-template-columns: 1fr; }
  .pd-stats { grid-template-columns: 1fr 1fr; }
  .pd-stat  { border-right: none; margin-right: 0; padding-right: 0; }
  .pd-header, .pd-content { padding-left: 24px; padding-right: 24px; }
}
</style>
{% endblock %}

{% block body %}
<div class="pd-root">
<div class="pd-shell">

  {# ── LEFT RAIL ── #}
  <aside class="pd-rail">
    <div class="pd-rail__brand">
      <div class="pd-rail__eyebrow">Espace Pro</div>
      <div class="pd-rail__name">Mind<em>Bloom</em></div>
    </div>

    <nav class="pd-rail__nav">
      <a href="{{ path('app_dashboard') }}" class="pd-rail__link pd-rail__link--active">
        <div class="pd-rail__link-icon">⌂</div>
        Tableau de bord
      </a>
      <a href="{{ path('app_cabinet') }}" class="pd-rail__link">
        <div class="pd-rail__link-icon">🏢</div>
        Mon Cabinet
      </a>
      <a href="{{ path('app_creneau_index') }}" class="pd-rail__link">
        <div class="pd-rail__link-icon">📅</div>
        Créneaux
      </a>
      <a href="{{ path('app_reservation_index') }}" class="pd-rail__link">
        <div class="pd-rail__link-icon">📋</div>
        Réservations
      </a>
      <a href="{{ path('app_test_manage') }}" class="pd-rail__link">
        <div class="pd-rail__link-icon">📝</div>
        Tests
      </a>
    </nav>

    <div class="pd-rail__status">
      <div class="pd-rail__status-dot"></div>
      <div class="pd-rail__status-text">
        <strong>Session active</strong>
        Connecté en tant que psychologue
      </div>
    </div>
  </aside>

  {# ── MAIN ── #}
  <main class="pd-main">

    {# Header band #}
    <div class="pd-header">
      <div class="pd-header__tag">
        <div class="pd-header__tag-dot"></div>
        Tableau de bord psychologue
      </div>
      <h1 class="pd-header__h1">
        Bienvenue sur<br>votre <em>espace</em> pro
      </h1>
      <p class="pd-header__sub">Gérez votre activité, vos patients et vos disponibilités en un seul endroit.</p>
    </div>

    {# Content #}
    <div class="pd-content">

      {# Stats — left-aligned, not centered #}
      <div class="pd-stats">
        <div class="pd-stat">
          <div class="pd-stat__val">
            <span class="js-count" data-target="0">0</span>
          </div>
          <div class="pd-stat__label">Réservations</div>
          <div class="pd-stat__bar"></div>
        </div>
        <div class="pd-stat">
          <div class="pd-stat__val">
            <span class="js-count" data-target="0">0</span>
          </div>
          <div class="pd-stat__label">Tests créés</div>
          <div class="pd-stat__bar"></div>
        </div>
        <div class="pd-stat">
          <div class="pd-stat__val">
            <span class="js-count" data-target="98">0</span><sup>%</sup>
          </div>
          <div class="pd-stat__label">Satisfaction</div>
          <div class="pd-stat__bar"></div>
        </div>
      </div>

