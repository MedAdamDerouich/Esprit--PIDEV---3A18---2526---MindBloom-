{% extends 'base.html.twig' %}

{% block title %}Mes Commandes - MindBloom{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
body.dark-mode .order-history-page {
    background: #0F1117 !important;
}
body.dark-mode .order-history-page [style*="background:#F5F3EF"] {
    background: #0F1117 !important;
}
body.dark-mode .order-history-page .card,
body.dark-mode .order-history-page .card-header,
body.dark-mode .order-history-page .card-body,
body.dark-mode .order-history-page .bg-white,
body.dark-mode .order-history-page .bg-light,
body.dark-mode .order-history-page .order-card,
body.dark-mode .order-history-page #historyFilterForm {
    background: #161A26 !important;
    border-color: #252B3E !important;
}
body.dark-mode .order-history-page .form-control,
body.dark-mode .order-history-page .form-select {
    background: #1A1F2E !important;
    color: #E8EAF0 !important;
    border-color: #2A3147 !important;
}
body.dark-mode .order-history-page [style*="color:#2D3748"],
body.dark-mode .order-history-page h4,
body.dark-mode .order-history-page h5,
body.dark-mode .order-history-page .fw-bold {
    color: #E8EAF0 !important;
}
body.dark-mode .order-history-page [style*="color:#718096"],
body.dark-mode .order-history-page .text-muted,
body.dark-mode .order-history-page .small,
body.dark-mode .order-history-page p,
body.dark-mode .order-history-page span {
    color: #7A8299 !important;
}
body.dark-mode .order-history-page .btn-outline-primary {
    border-color: #4A90E2 !important;
    color: #7DB4FF !important;
}
body.dark-mode .order-history-page .btn-outline-danger {
    border-color: #E57373 !important;
    color: #F2A4A4 !important;
}
body.dark-mode .order-history-page .bg-success-subtle {
    background-color: rgba(34, 197, 94, 0.18) !important;
}
body.dark-mode .order-history-page .bg-warning-subtle {
    background-color: rgba(245, 158, 11, 0.2) !important;
}
body.dark-mode .order-history-page .bg-danger-subtle {
    background-color: rgba(239, 68, 68, 0.2) !important;
}
</style>
{% endblock %}

{% block body %}
<div class="order-history-page" style="background:#F5F3EF; min-height:calc(100vh - 70px); padding:40px; display:flex; flex-direction:column; align-items:center;">
    
    <!-- Hero Header (Matched with Cabinet style) -->
    <div style="width:100%; max-width:1200px; display:flex; flex-direction:column; align-items:center; gap:5px; margin-bottom:40px;">
        <span style="font-size:32px; font-weight:bold; color:#2D3748;">Votre historique de</span>
        <span style="font-size:32px; font-weight:bold; color:#4A90E2;">commandes</span>
        <span style="color:#718096; font-size:16px; margin-top:10px; text-align:center;">Suivez l'état de vos livraisons et gérez vos factures MindBloom.</span>

        <!-- Barre de Filtres & Recherche -->
        <div class="mt-4 w-100" style="max-width: 1000px;">
            <form action="{{ path('app_order_history') }}" method="GET" id="historyFilterForm" class="row g-3 justify-content-center bg-white p-3 rounded-4 shadow-sm border-0">
                <!-- Recherche par mot-clé -->
                <div class="col-md-5">
                    <div class="position-relative">
                        <input type="text" name="q" value="{{ search }}" class="form-control rounded-pill border-0 bg-light px-4" placeholder="Rechercher par N° ou Adresse..." style="height: 48px;">
                        <i class="bi bi-search position-absolute top-50 end-0 translate-middle-y me-3 text-muted"></i>
                    </div>
                </div>

                <!-- Filtre par Statut -->
                <div class="col-md-3">
                    <select name="statut" class="form-select rounded-pill border-0 bg-light px-3" style="height: 48px;" onchange="this.form.submit()">
                        <option value="">Tous les statuts</option>
                        <option value="{{ STATUS_PENDING }}" {% if statut == STATUS_PENDING %}selected{% endif %}>En préparation</option>
                        <option value="{{ STATUS_SHIPPED }}" {% if statut == STATUS_SHIPPED %}selected{% endif %}>Expédiée</option>
                        <option value="{{ STATUS_CANCELLED }}" {% if statut == STATUS_CANCELLED %}selected{% endif %}>Annulée</option>
                    </select>
                </div>

                <!-- Tri -->
                <div class="col-md-4">
                    <select name="tri" class="form-select rounded-pill border-0 bg-light px-3" style="height: 48px;" onchange="this.form.submit()">
                        <option value="date_desc" {% if tri == 'date_desc' %}selected{% endif %}>Les plus récentes</option>
                        <option value="date_asc" {% if tri == 'date_asc' %}selected{% endif %}>Les plus anciennes</option>
                        <option value="prix_desc" {% if tri == 'prix_desc' %}selected{% endif %}>Prix Décroissant</option>
                        <option value="prix_asc" {% if tri == 'prix_asc' %}selected{% endif %}>Prix Croissant</option>
                    </select>
                </div>
            </form>
        </div>
    </div>

    <div style="width:100%; max-width:1200px;">

    <div class="row g-4">
        {% for facture in factures %}
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden order-card transition-hover">
                    <div class="card-header bg-white border-0 p-4 pb-0 d-flex justify-content-between align-items-center">
                        <span class="badge 
                            {% if facture.statutLivraison == STATUS_SHIPPED %}bg-success-subtle text-success
                            {% elseif facture.statutLivraison == STATUS_CANCELLED or facture.statutLivraison is empty %}bg-danger-subtle text-danger
                            {% else %}bg-warning-subtle text-warning{% endif %} 
                            rounded-pill px-3 py-2 fw-bold" style="font-size: 11px;">
                            {% if facture.statutLivraison == STATUS_SHIPPED %}EXPÉDIÉE
                            {% elseif facture.statutLivraison == STATUS_CANCELLED or facture.statutLivraison is empty %}ANNULÉE
                            {% else %}EN PRÉPARATION{% endif %}
                        </span>
                        <span class="small text-muted fw-bold">#{{ facture.id }}</span>
                    </div>
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">{{ facture.montantTotal|number_format(2, ',', ' ') }} DT</h5>
                        <div class="text-muted small mb-3">
                            <p class="mb-1"><i class="bi bi-calendar2-check me-2"></i> Date: <strong>{{ facture.dateFacture|date('d F Y') }}</strong></p>
                            <p class="mb-0"><i class="bi bi-wallet2 me-2"></i> Paiement: <strong>{{ facture.typePaiement }}</strong></p>
                        </div>
                        
                        <div class="mb-4">
                            {% for cmd in facture.commandes|slice(0, 3) %}
                                <div class="d-flex align-items-center mb-2">
                                    <div class="bg-light rounded p-1 me-2" style="width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;">
                                        <span style="font-size: 10px; font-weight: bold;">{{ cmd.quantite }}</span>
                                    </div>
                                    <span class="small text-truncate" style="max-width: 180px;">{{ cmd.produit.nom }}</span>
                                </div>
                            {% endfor %}
                            {% if facture.commandes|length > 3 %}
                                <div class="small text-primary fw-bold">+ {{ facture.commandes|length - 3 }} autres articles</div>
                            {% endif %}
                        </div>

                        <div class="d-flex gap-2">
                            <a href="{{ path('app_order_show', {id: facture.id}) }}" class="btn btn-outline-primary flex-grow-1 rounded-pill py-2 fw-bold small">
                                <i class="bi bi-file-earmark-text me-1"></i> Détails
                            </a>
                            {% if facture.statutLivraison == STATUS_PENDING %}
                                <form action="{{ path('app_order_cancel', {id: facture.id}) }}" method="POST" class="flex-grow-1" onsubmit="return confirm('Êtes-vous sûr de vouloir annuler cette commande ?')">
                                    <button type="submit" class="btn btn-outline-danger w-100 rounded-pill py-2 fw-bold small">
                                        <i class="bi bi-x-circle me-1"></i> Annuler
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="text-center py-5 bg-white shadow-sm rounded-4">
                    <i class="bi bi-bag-x text-muted display-1 mb-3"></i>
                    <h4 class="fw-bold">Vous n'avez pas encore de commande</h4>
                    <p class="text-muted mb-4 pb-2">Dès que vous passez votre première commande, elle apparaîtra ici.</p>
                    <a href="{{ path('app_produit_index') }}" class="btn btn-primary rounded-pill px-5">Aller au catalogue</a>
                </div>
            </div>
        {% endfor %}
    </div>
    
</div>


<style>
.order-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.order-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important;
}
.bg-success-subtle { background-color: #d1e7dd; }
.bg-warning-subtle { background-color: #fff3cd; }
.bg-danger-subtle { background-color: #f8d7da; }
</style>
{% endblock %}
