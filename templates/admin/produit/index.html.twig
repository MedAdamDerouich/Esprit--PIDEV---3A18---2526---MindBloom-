{% extends 'base.html.twig' %}

{% block title %}Gestion des Produits - MindBloomAdmin{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1 class="h2 text-dark font-weight-bold">Catalogue des Produits</h1>
            <p class="text-muted">Gérez votre inventaire et visualisez les stocks en temps réel.</p>
        </div>
        <div class="col-md-6 text-end">
            <a href="{{ path('app_admin_produit_new') }}" class="btn btn-primary px-4 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Nouveau Produit
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-uppercase small font-weight-bold text-muted">
                        <tr>
                            <th class="ps-4 py-3">Produit</th>
                            <th class="py-3">Stock</th>
                            <th class="py-3">Prix</th>
                            <th class="py-3">Date Ajout</th>
                            <th class="py-3 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for produit in produits %}
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    {% if produit.image %}
                                        <img src="{{ asset('uploads/produits/' ~ produit.image) }}" alt="{{ produit.nom }}" class="rounded-3 me-3" style="width: 50px; height: 50px; object-fit: cover;">
                                    {% else %}
                                        <div class="bg-light rounded-3 me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                            <i class="bi bi-box text-muted"></i>
                                        </div>
                                    {% endif %}
                                    <div>
                                        <h6 class="mb-0 fw-bold">{{ produit.nom }}</h6>
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 200px;">{{ produit.description|slice(0, 50) }}...</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge {{ produit.quantite > 10 ? 'bg-success-subtle text-success' : (produit.quantite > 0 ? 'bg-warning-subtle text-warning' : 'bg-danger-subtle text-danger') }} px-2 py-1 rounded-pill">
                                    {{ produit.quantite }} en stock
                                </span>
                            </td>
                            <td class="fw-bold text-dark">
                                {{ produit.prix|number_format(2, ',', ' ') }} €
                            </td>
                            <td class="text-muted small">
                                {{ produit.dateAjout ? produit.dateAjout|date('d/m/Y') : '' }}
                            </td>
                            <td class="text-center pe-4">
                                <div class="d-inline-flex gap-2">
                                    <a href="{{ path('app_admin_produit_edit', {'id': produit.id}) }}" class="btn btn-sm btn-outline-primary border-0 rounded-circle" title="Modifier">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form action="{{ path('app_admin_produit_delete', {'id': produit.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce produit ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
                                        <button class="btn btn-sm btn-outline-danger border-0 rounded-circle" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="py-5 text-center text-muted"> Aucun produit trouvé dans le catalogue. </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
