{% extends 'base.html.twig' %}

{% block title %}Mes Résultats de Tests — MindBloom{% endblock %}

{% block body %}
<style>
    @keyframes fadeUpPage {
        0% { opacity: 0; transform: translateY(20px); }
        100% { opacity: 1; transform: translateY(0); }
    }
    .animate-entry {
        opacity: 0;
        animation: fadeUpPage 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
</style>

<div class="animate-entry" style="background:#FAFAF8; min-height: calc(100vh - 85px); padding: 50px; animation-delay: 0s;">
    <div style="max-width: 1000px; margin: 0 auto;">
        
        <div class="animate-entry" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; animation-delay: 0.1s;">
            <div>
                <span style="display:inline-block;background:#E8F1FC;color:#4A90E2;border-radius:20px;padding:6px 15px;font-size:13px;margin-bottom:10px;font-weight:600;">
                    📊 Historique
                </span>
                <h1 style="font-size:36px;font-weight:900;color:#2C3E50;">Mes Résultats de Tests</h1>
            </div>
            
            <div style="display: flex; gap: 15px;">
                {% if resultat_tests|length > 0 %}
                <a href="{{ path('app_resultat_test_generer_rapport') }}" style="background: linear-gradient(135deg, #8E2DE2, #4A00E0); color: white; padding: 12px 25px; border-radius: 12px; font-weight: 700; text-decoration: none; border: none; transition: all 0.2s; box-shadow: 0 4px 15px rgba(74, 0, 224, 0.3);" onmouseover="this.style.opacity='0.9'; this.style.transform='translateY(-2px)'" onmouseout="this.style.opacity='1'; this.style.transform='translateY(0)'">
                    ✨ Générer Rapport Analytique
                </a>
                {% endif %}
                <a href="{{ path('app_test_index') }}" style="background: white; color: #4A90E2; padding: 12px 25px; border-radius: 12px; font-weight: 700; text-decoration: none; border: 2px solid #4A90E2; transition: all 0.2s;" onmouseover="this.style.background='#4A90E2'; this.style.color='white'" onmouseout="this.style.background='white'; this.style.color='#4A90E2'">
                    Passer un nouveau test
                </a>
            </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 20px;">
            {% for resultat in resultat_tests %}
                <div class="animate-entry" style="background: white; border-radius: 15px; padding: 25px; box-shadow: 0 5px 15px rgba(0,0,0,0.03); display: flex; justify-content: space-between; align-items: center; border-left: 6px solid {% if resultat.score > 80 %}#27AE60{% elseif resultat.score > 50 %}#F39C12{% else %}#E74C3C{% endif %}; animation-delay: {{ 0.2 + (loop.index0 * 0.1) }}s;">
                    
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        <h3 style="font-size: 20px; font-weight: 800; color: #34495E; margin: 0;">{{ resultat.test ? resultat.test.nomTest : 'Test supprimé' }}</h3>
                        <div style="display: flex; gap: 15px; font-size: 13px; color: #7F8C8D;">
                            <span>Catégorie: <b>{{ resultat.test ? resultat.test.categorie : 'N/A' }}</b></span>
                        </div>
                    </div>
                    
                    <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 5px;">
                        <span style="font-size: 24px; font-weight: 900; color: {% if resultat.score > 80 %}#27AE60{% elseif resultat.score > 50 %}#F39C12{% else %}#E74C3C{% endif %};">
                            {{ resultat.score }} pts
                        </span>
                        <span style="font-size: 13px; font-weight: 700; color: #95A5A6; background: #F4F6F6; padding: 4px 10px; border-radius: 6px;">
                            {{ resultat.etat }}
                        </span>
                    </div>

                    <a href="{{ path('app_resultat_test_show', {'id': resultat.id}) }}" style="background:#EDF9F5; color:#5FBF9F; border-radius:10px; padding:10px 20px; text-decoration:none; font-weight:700; font-size:14px; transition:0.2s;"
                       onmouseover="this.style.background='#5FBF9F'; this.style.color='white'" onmouseout="this.style.background='#EDF9F5'; this.style.color='#5FBF9F'">
                        Voir détails →
                    </a>
                </div>
            {% else %}
                <div style="text-align: center; padding: 60px; background: white; border-radius: 20px; box-shadow: 0 5px 15px rgba(0,0,0,0.03);">
                    <div style="font-size: 40px; margin-bottom: 20px;">🏜️</div>
                    <h4 style="font-size: 20px; font-weight: 700; color: #2C3E50; margin-bottom: 10px;">Vous n'avez passé aucun test</h4>
                    <p style="color: #7F8C8D;">Passez votre premier test pour suivre l'évolution de votre bien-être.</p>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
