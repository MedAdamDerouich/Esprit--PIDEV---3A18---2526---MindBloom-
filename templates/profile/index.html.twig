{% extends 'base.html.twig' %}
{% block title %}Mon Profil — MindBloom{% endblock %}

{% block body %}



<div style="padding:30px 40px;background:var(--bg-warm);min-height:calc(100vh - 70px);">

    <div class="mb-page-header">
        <h1><i class="bi bi-person-circle me-2"></i>Mon Profil</h1>
        <p>Gérez vos informations personnelles</p>
    </div>

    <div class="row g-4">

        {# Avatar + info #}
        <div class="col-md-3">
            <div class="mb-card" style="text-align:center;padding:30px 20px;">

                {# Avatar — clickable to trigger file input #}
                <div id="avatarClickable"
                     style="position:relative;width:110px;height:110px;margin:0 auto 16px;cursor:pointer;"
                     onclick="document.getElementById('photoInput').click()" title="Changer la photo">
                    <div class="mb-avatar mb-avatar-xl" id="avatarPreview"
                         style="width:110px;height:110px;font-size:38px;border:3px solid var(--teal);">
                        {% if app.user.profileImage %}
                            <img src="{{ asset('uploads/profiles/' ~ app.user.profileImage) }}" alt="" id="avatarImg">
                        {% else %}
                            <span id="avatarInitial">{{ app.user.fullName|first|upper }}</span>
                        {% endif %}
                    </div>
                    {# Hover overlay #}
                    <div style="position:absolute;inset:0;border-radius:50%;background:rgba(0,0,0,0.35);
                                display:flex;align-items:center;justify-content:center;
                                opacity:0;transition:opacity 0.2s;font-size:22px;color:white;"
                         id="avatarOverlay"><i class="bi bi-camera"></i></div>
                </div>

                {# Hidden upload form #}
                <form id="photoForm" method="post"
                      action="{{ path('app_profile_photo') }}"
                      enctype="multipart/form-data" style="display:none;">
                    <input type="hidden" name="_token" value="{{ csrf_token('upload-photo') }}">
                    <input type="file" id="photoInput" name="photo"
                           accept="image/jpeg,image/png,image/webp">
                </form>

                <div style="font-weight:800;font-size:17px;">{{ app.user.fullName }}</div>
                <div style="color:var(--text-mid);font-size:13px;margin-top:4px;">
                    @{{ app.user.username }}
                </div>
                <div class="mt-2">
                    {% if 'ROLE_ADMIN' in app.user.roles %}
                        <span class="mb-badge mb-badge-red">Admin</span>
                    {% elseif 'ROLE_PSYCHOLOGUE' in app.user.roles %}
                        <span class="mb-badge mb-badge-primary">Psychologue</span>
                    {% else %}
                        <span class="mb-badge mb-badge-teal">Patient</span>
                    {% endif %}
                </div>

                <label for="photoInput"
                       class="btn-mb-outline mt-3"
                       style="font-size:12px;padding:8px 16px;width:100%;display:block;
                              text-align:center;cursor:pointer;">
                    Changer la photo
                </label>
                <div style="font-size:10px;color:#bbb;margin-top:6px;">JPG, PNG, WebP — max 3 Mo</div>
            </div>
        </div>

        {# Edit form #}
        <div class="col-md-9">
            <div class="mb-card">
                <h6 style="font-weight:700;margin-bottom:20px;"><i class="bi bi-pencil-square me-2"></i>Modifier mes informations</h6>

                {{ form_start(profileForm) }}

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="mb-form-group">
                            <label>Nom complet <span class="text-danger">*</span></label>
                            {{ form_widget(profileForm.fullName, {attr: {class: 'mb-input', placeholder: 'Prénom Nom', maxlength: 100}}) }}
                            {{ form_errors(profileForm.fullName) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-form-group">
                            <label>Téléphone</label>
                            {{ form_widget(profileForm.phone, {attr: {class: 'mb-input', placeholder: '12345678', maxlength: 8, pattern: '[0-9]{8}'}}) }}
                            <small class="text-muted">8 chiffres uniquement</small>
                            {{ form_errors(profileForm.phone) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-form-group">
                            <label>Date de naissance <span class="text-danger">*</span></label>
                            {{ form_widget(profileForm.dateOfBirth, {attr: {class: 'mb-input'}}) }}
                            {{ form_errors(profileForm.dateOfBirth) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-form-group">
                            <label>Email</label>
                            <input type="text" class="mb-input"
                                   value="{{ app.user.email }}" disabled
                                   style="opacity:0.6;cursor:not-allowed;">
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="mb-form-group">
                            {{ form_label(profileForm.address, 'Adresse') }}
                            {{ form_widget(profileForm.address, {attr: {class: 'mb-input', placeholder: 'Votre adresse', maxlength: 255}}) }}
                            {{ form_errors(profileForm.address) }}
                        </div>
                    </div>
                </div>

                <hr class="mb-divider">

                <div class="d-flex justify-content-end gap-3">
                    <a href="{{ is_granted('ROLE_PSYCHOLOGUE') ? path('app_psychologue_dashboard') : path('app_patient_dashboard') }}" 
                       class="btn btn-outline-secondary rounded-pill px-4" style="font-size:14px; font-weight:600; display:flex; align-items:center;">
                        <i class="bi bi-arrow-left me-2"></i>Retour
                    </a>
                    <button type="submit" class="btn-mb-primary">
                        <i class="bi bi-floppy me-2"></i>Enregistrer les modifications
                    </button>
                </div>

                {{ form_end(profileForm) }}
            </div>

            {# Change password #}
            <div class="mb-card mt-3">
                <h6 style="font-weight:700;margin-bottom:16px;"><i class="bi bi-lock me-2"></i>Changer le mot de passe</h6>
                <form method="post" action="{{ path('app_change_password') }}" id="changePasswordForm">
                    <input type="hidden" name="_token" value="{{ csrf_token('change-password') }}">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="mb-form-group" style="margin-bottom:0;">
                                <label>Mot de passe actuel <span class="text-danger">*</span></label>
                                <input type="password" name="current_password" class="mb-input"
                                       placeholder="••••••••" required>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-form-group" style="margin-bottom:0;">
                                <label>Nouveau mot de passe <span class="text-danger">*</span></label>
                                <input type="password" name="new_password" id="new_password" class="mb-input"
                                       placeholder="Min. 8 caractères" required>
                                <div class="password-strength-container mt-2">
                                    <div class="password-strength-bar" id="password-strength-bar"></div>
                                </div>
                                <small class="password-strength-text" id="password-strength-text"></small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-form-group" style="margin-bottom:0;">
                                <label>Confirmer <span class="text-danger">*</span></label>
                                <input type="password" name="confirm_password" id="confirm_password" class="mb-input"
                                       placeholder="••••••••" required>
                                <small class="password-match-text" id="password-match-text"></small>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn-mb-secondary mt-3">
                        Mettre à jour le mot de passe
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
// Avatar upload preview
const overlay    = document.getElementById('avatarOverlay');
const photoInput = document.getElementById('photoInput');
const avatarWrap = document.getElementById('avatarClickable');

avatarWrap.addEventListener('mouseenter', () => overlay.style.opacity = '1');
avatarWrap.addEventListener('mouseleave', () => overlay.style.opacity = '0');

photoInput.addEventListener('change', function () {
    const file = this.files[0];
    if (!file) return;

    // Show local preview instantly
    const reader = new FileReader();
    reader.onload = e => {
        document.getElementById('avatarPreview').innerHTML =
            `<img src="${e.target.result}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">`;
    };
    reader.readAsDataURL(file);

    // Submit the form to upload
    document.getElementById('photoForm').submit();
});

// Password strength checker
document.addEventListener('DOMContentLoaded', function() {
    const passwordField = document.getElementById('new_password');
    const confirmField = document.getElementById('confirm_password');
    const strengthBar = document.getElementById('password-strength-bar');
    const strengthText = document.getElementById('password-strength-text');
    const matchText = document.getElementById('password-match-text');

    function checkPasswordStrength(password) {
        let score = 0;
        const checks = {
            length: password.length >= 8,
            lowercase: /[a-z]/.test(password),
            uppercase: /[A-Z]/.test(password),
            numbers: /\d/.test(password),
            special: /[!@#$%^&*(),.?":{}|<>]/.test(password),
            longLength: password.length >= 12
        };

        if (checks.length) score++;
        if (checks.lowercase) score++;
        if (checks.uppercase) score++;
        if (checks.numbers) score++;
        if (checks.special) score++;
        if (checks.longLength) score++;

        return { score, checks };
    }

    function updateStrengthIndicator(password) {
        if (!strengthBar || !strengthText) return;
        
        if (!password) {
            strengthBar.style.width = '0%';
            strengthBar.style.backgroundColor = '#e0e0e0';
            strengthText.textContent = '';
            return;
        }

        const { score, checks } = checkPasswordStrength(password);
        let width, color, text;

        if (score <= 2) {
            width = '33%';
            color = '#dc3545'; // Red - Faible
            text = 'Faible - Ajoutez majuscules, chiffres et caractères spéciaux';
        } else if (score <= 4) {
            width = '66%';
            color = '#fd7e14'; // Orange - Moyen
            text = 'Moyen - Ajoutez des caractères spéciaux pour plus de sécurité';
        } else {
            width = '100%';
            color = '#28a745'; // Green - Fort
            text = 'Fort - Excellent mot de passe !';
        }

        strengthBar.style.width = width;
        strengthBar.style.backgroundColor = color;
        strengthText.textContent = text;
        strengthText.style.color = color;

        // Show tips
        let tips = [];
        if (!checks.length) tips.push('au moins 8 caractères');
        if (!checks.uppercase) tips.push('une majuscule');
        if (!checks.lowercase) tips.push('une minuscule');
        if (!checks.numbers) tips.push('un chiffre');
        if (!checks.special) tips.push('un caractère spécial (!@#$...)');

        if (tips.length > 0 && score < 5) {
            strengthText.textContent = text + ' - Manque: ' + tips.slice(0, 2).join(', ');
        }
    }

    function checkPasswordMatch() {
        if (!passwordField || !confirmField || !matchText) return;
        
        const password = passwordField.value;
        const confirm = confirmField.value;

        if (!confirm) {
            matchText.textContent = '';
            return;
        }

        if (password === confirm) {
            matchText.textContent = '✓ Les mots de passe correspondent';
            matchText.style.color = '#28a745';
        } else {
            matchText.textContent = '✗ Les mots de passe ne correspondent pas';
            matchText.style.color = '#dc3545';
        }
    }

    if (passwordField) {
        passwordField.addEventListener('input', function() {
            updateStrengthIndicator(this.value);
            checkPasswordMatch();
        });
        passwordField.addEventListener('keyup', function() {
            updateStrengthIndicator(this.value);
            checkPasswordMatch();
        });
    }

    if (confirmField) {
        confirmField.addEventListener('input', checkPasswordMatch);
        confirmField.addEventListener('keyup', checkPasswordMatch);
    }
});
</script>

<style>
.password-strength-container {
    height: 8px;
    background-color: #e0e0e0;
    border-radius: 4px;
    overflow: hidden;
}

.password-strength-bar {
    height: 100%;
    width: 0%;
    transition: width 0.3s ease, background-color 0.3s ease;
    border-radius: 4px;
}

.password-strength-text,
.password-match-text {
    display: block;
    font-size: 12px;
    margin-top: 6px;
    min-height: 18px;
    font-weight: 500;
}

/* ══════════════════════════════════════════
   DARK MODE — Profile edit page
   ══════════════════════════════════════════ */
body.dark-mode > div[style*="var(--bg-warm)"] {
    background: #0F1117 !important;
}
body.dark-mode .mb-page-header h1 { color: #E8EAF0 !important; }
body.dark-mode .mb-page-header p,
body.dark-mode .mb-page-header .text-muted { color: #A8B0C4 !important; }

body.dark-mode .mb-card {
    background: #161A26 !important;
    color: #D8DCE8 !important;
    border-color: #252B3E !important;
    box-shadow: 0 10px 28px rgba(0,0,0,0.45) !important;
}
body.dark-mode .mb-card h6,
body.dark-mode .mb-card h5 { color: #E8EAF0 !important; }

/* Avatar card */
body.dark-mode .mb-avatar,
body.dark-mode .mb-avatar-xl {
    border-color: #4A90E2 !important;
    background: #1E2333 !important;
}

/* Badges */
body.dark-mode .mb-badge-teal    { background:#152B22 !important; color:#6EE095 !important; border-color:#1E4434 !important; }
body.dark-mode .mb-badge-primary { background:#1A2540 !important; color:#7BB8F5 !important; border-color:#2A3E66 !important; }
body.dark-mode .mb-badge-red     { background:#2A1519 !important; color:#F59493 !important; border-color:#4A2024 !important; }

/* Labels + inputs */
body.dark-mode .mb-form-group label { color: #A8B0C4 !important; }
body.dark-mode .mb-input {
    background: #1A1F2E !important;
    color: #E8EAF0 !important;
    border-color: #2A3147 !important;
}
body.dark-mode .mb-input::placeholder { color: #5A6275 !important; }
body.dark-mode .mb-input:focus {
    background: #1E2333 !important;
    border-color: #4A90E2 !important;
    box-shadow: 0 0 0 3px rgba(74,144,226,.18) !important;
}
body.dark-mode .mb-input:disabled,
body.dark-mode .mb-input[readonly] {
    background: #141824 !important;
    color: #7A8299 !important;
}

/* Hints + small text */
body.dark-mode .text-muted,
body.dark-mode small { color: #7A8299 !important; }

/* Divider */
body.dark-mode .mb-divider,
body.dark-mode hr { border-color: #252B3E !important; background: #252B3E !important; }

/* Retour button (bootstrap outline-secondary) */
body.dark-mode .btn-outline-secondary {
    background: #1E2333 !important;
    color: #D8DCE8 !important;
    border-color: #2A3147 !important;
}
body.dark-mode .btn-outline-secondary:hover {
    background: #252B3E !important;
    border-color: #4A90E2 !important;
    color: #7BB8F5 !important;
}

/* Upload button */
body.dark-mode .btn-mb-outline {
    background: #1E2333 !important;
    color: #D8DCE8 !important;
    border-color: #2A3147 !important;
}
body.dark-mode .btn-mb-outline:hover {
    background: #252B3E !important;
    color: #7BB8F5 !important;
    border-color: #4A90E2 !important;
}

/* Password strength bar track */
body.dark-mode .password-strength-container { background-color: #2A3147 !important; }
body.dark-mode .password-strength-text,
body.dark-mode .password-match-text { color: #A8B0C4 !important; }

/* Avatar overlay hover icon still works */
body.dark-mode #avatarOverlay { background: rgba(0,0,0,0.5) !important; }
</style>
{% endblock %}
