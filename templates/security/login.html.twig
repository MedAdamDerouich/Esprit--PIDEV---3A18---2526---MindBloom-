{% extends 'base.html.twig' %}
{% block title %}MindBloom — Authentification{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}?v=5">
    <style>
    html, body {
      background: #F9F7F2 !important;
      overflow: hidden !important;
      width: 100vw !important;
      height: 100vh !important;
    }

    /* ═══ LAYOUT ═══════════════════════════════════════════ */
    .auth-root {
      position: relative;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      font-family: 'Nunito', 'Segoe UI', sans-serif;
    }

    /* ── Left botanical panel — slides across the viewport ── */
    .auth-left {
      position: absolute;
      top: 0; left: 0;
      width: 50%;
      height: 100vh;
      z-index: 5;
      background: linear-gradient(160deg, #EEF4FF 0%, #E8F5F0 45%, #F0EEFF 100%);
      display: flex;
      align-items: stretch;
      justify-content: center;
      overflow: hidden;
      transition: transform 0.9s cubic-bezier(0.77, 0, 0.18, 1), background 0.9s ease;
      will-change: transform;
    }
    .auth-root.show-register .auth-left { transform: translateX(100%); }

    /* Ambient blobs */
    .auth-left::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 55% 45% at 85% 10%,  rgba(74,144,226,0.16) 0%,  transparent 55%),
        radial-gradient(ellipse 45% 40% at 10% 90%,  rgba(95,191,159,0.16) 0%,  transparent 50%),
        radial-gradient(ellipse 35% 35% at 50% 50%,  rgba(74,144,226,0.07) 0%,  transparent 60%);
      pointer-events: none;
      z-index: 0;
      animation: orbDrift 14s ease-in-out infinite alternate;
    }
    @keyframes orbDrift {
      0%   { transform: translate(0,0) scale(1); }
      33%  { transform: translate(6px,-10px) scale(1.02); }
      66%  { transform: translate(-5px,7px) scale(0.98); }
      100% { transform: translate(3px,-5px) scale(1.01); }
    }

    /* Bottom glow */
    .auth-left::after {
      content: '';
      position: absolute;
      bottom: -50px; left: 50%;
      transform: translateX(-50%);
      width: 320px; height: 180px;
      background: radial-gradient(ellipse, rgba(95,191,159,0.22) 0%, transparent 70%);
      pointer-events: none;
      z-index: 1;
      animation: bloomPulse 5s ease-in-out infinite;
    }
    @keyframes bloomPulse {
      0%,100% { opacity:.7; transform: translateX(-50%) scale(1); }
      50%      { opacity:1;  transform: translateX(-50%) scale(1.08); }
    }

    /* Left panel inner content */
    .auth-left__inner {
      position: relative;
      z-index: 2;
      padding: 48px 44px;
      width: 100%; height: 100%;
      max-width: 440px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
    }

    /* ── Form zone fills the whole viewport; cards live in the un-covered half ── */
    .auth-right {
      position: absolute;
      inset: 0;
      height: 100vh;
      overflow: hidden;
      background: #F9F7F2;
      z-index: 1;
    }

    /* ── Two form cards pinned to left or right half, swap via opacity ── */
    .auth-form-card {
      position: absolute;
      top: 0;
      width: 50%;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px 32px;
      overflow-y: auto;
      scrollbar-width: thin;
      opacity: 1;
      transition: opacity 0.6s ease 0.25s;
      will-change: opacity;
      pointer-events: auto;
    }

    /* Login sits in the RIGHT half (panel covers the left by default) */
    .auth-form-card--login    { right: 0; }
    /* Register sits in the LEFT half (panel will slide right to reveal it) */
    .auth-form-card--register { left: 0;  opacity: 0; pointer-events: none; transition-delay: 0s; }

    .auth-root.show-register .auth-form-card--login    { opacity: 0; pointer-events: none; transition-delay: 0s; }
    .auth-root.show-register .auth-form-card--register { opacity: 1; pointer-events: auto; transition-delay: 0.35s; }

    @media (prefers-reduced-motion: reduce) {
      .auth-left      { transition: none !important; }
      .auth-form-card { transition: opacity 0.2s linear !important; }
    }

    /* ── Botanical panel: subtle accent shift on register ── */
    .auth-root.show-register .auth-left {
      background: linear-gradient(160deg, #EDF7F2 0%, #E8F0F9 45%, #EEF7EE 100%);
    }

    /* ── Brand block ── */
    .auth-brand-block {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 10px;
    }
    .auth-brand-block img {
      width: 90px; height: auto;
      display: block;
      filter: drop-shadow(0 4px 16px rgba(74,144,226,0.25));
      animation: logoBreath 4.5s ease-in-out infinite;
      will-change: transform, filter;
    }
    @keyframes logoBreath {
      0%,100% { transform: translateY(0) scale(1);    filter: drop-shadow(0 4px 14px rgba(74,144,226,.22)); }
      50%      { transform: translateY(-7px) scale(1.03); filter: drop-shadow(0 8px 24px rgba(74,144,226,.38)); }
    }
    .auth-brand-name {
      font-size: 26px; font-weight: 800;
      color: #2C3E50;
      letter-spacing: -0.3px; line-height: 1;
    }
    .auth-brand-name em { font-style: italic; color: #4A90E2; }
    .auth-brand-tagline { font-size: 12px; color: #7F8C8D; font-weight: 500; margin: 0; letter-spacing: .3px; }

    /* ── Botanical SVG ── */
    .auth-botanical {
      flex: 1;
      display: flex; align-items: center; justify-content: center;
      width: 100%;
      position: relative;
      margin: 12px 0;
    }
    .auth-botanical svg { width: 100%; max-width: 310px; height: auto; overflow: visible; }

    /* Stem draw */
    .stem-path {
      stroke-dasharray: 500; stroke-dashoffset: 500;
      animation: drawStem 2s cubic-bezier(.4,0,.2,1) forwards;
    }
    .stem-path:nth-child(2) { animation-delay: .3s; }
    .stem-path:nth-child(3) { animation-delay: .6s; }
    .stem-path:nth-child(4) { animation-delay: .75s; }
    .stem-path:nth-child(5) { animation-delay: .85s; }
    @keyframes drawStem { to { stroke-dashoffset: 0; } }

    /* Leaves */
    .leaf-shape {
      transform-origin: center bottom;
      opacity: 0; transform: scale(0) rotate(-30deg);
      animation: leafUnfurl .8s cubic-bezier(.34,1.56,.64,1) forwards;
    }
    .leaf-1{animation-delay:.9s}.leaf-2{animation-delay:1.05s}.leaf-3{animation-delay:1.2s}
    .leaf-4{animation-delay:1.35s}.leaf-5{animation-delay:1.5s}.leaf-6{animation-delay:1.65s}.leaf-7{animation-delay:1.8s}
    @keyframes leafUnfurl {
      0%  { opacity:0; transform:scale(0) rotate(-40deg); }
      60% { opacity:1; }
      100%{ opacity:1; transform:scale(1) rotate(0); }
    }

    /* Petals */
    .petal { transform-origin:50% 100%; opacity:0; animation:petalBloom .6s cubic-bezier(.34,1.2,.64,1) forwards; }
    .petal:nth-child(1){animation-delay:2.1s}.petal:nth-child(2){animation-delay:2.2s}
    .petal:nth-child(3){animation-delay:2.3s}.petal:nth-child(4){animation-delay:2.4s}
    .petal:nth-child(5){animation-delay:2.5s}.petal:nth-child(6){animation-delay:2.6s}
    @keyframes petalBloom { 0%{opacity:0;transform:scale(0)} 100%{opacity:1;transform:scale(1)} }

    /* Sway */
    .plant-group { animation:plantSway 6s ease-in-out infinite; transform-origin:50% 100%; }
    @keyframes plantSway { 0%,100%{transform:rotate(0)} 25%{transform:rotate(1deg)} 75%{transform:rotate(-.8deg)} }

    /* Spores */
    .spore { animation:sporeFloat linear infinite; opacity:0; }
    .spore:nth-child(1){animation-duration:8s;animation-delay:2.6s}
    .spore:nth-child(2){animation-duration:11s;animation-delay:3.3s}
    .spore:nth-child(3){animation-duration:9s;animation-delay:4.1s}
    .spore:nth-child(4){animation-duration:13s;animation-delay:2.9s}
    .spore:nth-child(5){animation-duration:7s;animation-delay:5.1s}
    @keyframes sporeFloat {
      0%  { opacity:0;   transform:translateY(0) scale(.5); }
      15% { opacity:.7; }
      85% { opacity:.4; }
      100%{ opacity:0;   transform:translateY(-150px) translateX(var(--dx,20px)) scale(1.2); }
    }

    /* ── Metrics bar ── */
    .auth-metrics {
      width: 100%;
      display: flex; align-items: center;
      background: rgba(255,255,255,0.75);
      border: 1px solid rgba(74,144,226,0.12);
      border-radius: 16px; padding: 18px 0;
      backdrop-filter: blur(10px);
      box-shadow: 0 2px 16px rgba(74,144,226,0.08);
    }
    .auth-metric { flex:1; text-align:center; }
    .auth-metric__value { display:block; font-size:20px; font-weight:800; letter-spacing:-.5px; line-height:1; color:#4A90E2; }
    .auth-metric:nth-child(3) .auth-metric__value { color:#5FBF9F; }
    .auth-metric:nth-child(5) .auth-metric__value { color:#2563EB; }
    .auth-metric__label { display:block; font-size:9px; color:#95A5A6; font-weight:700; margin-top:5px; text-transform:uppercase; letter-spacing:1px; }
    .auth-metric__sep { width:1px; height:28px; background:#E0E0E0; flex-shrink:0; }

    /* ── Card inner ── */
    .auth-card {
      background: #fff;
      border-radius: 18px;
      padding: 26px 30px;
      width: 100%; max-width: 400px;
      border: 1px solid #EAEAEA;
      box-shadow:
        0 0 0 1px rgba(0,0,0,.03),
        0 4px 20px rgba(0,0,0,.06),
        0 20px 50px rgba(74,144,226,.07);
    }
    .auth-card--wide { max-width: 500px; padding: 22px 30px 20px; }
    .auth-form-card--login > .auth-card { margin: auto 0; }
    .auth-form-card--register > .auth-card { margin: auto 0; }

    .auth-card__header { margin-bottom: 16px; }
    .auth-card__header h2 { font-size:22px; font-weight:800; color:#2C3E50; letter-spacing:-.4px; margin:0 0 3px; line-height:1.15; }
    .auth-card__header h2 em { font-style:italic; color:#4A90E2; }
    .auth-card__header p { font-size:12px; color:#7F8C8D; margin:0; font-weight:500; }

    /* ── Fields ── */
    .auth-field { margin-bottom: 12px; }
    .auth-field label { display:block; font-size:10px; font-weight:700; color:#2C3E50; margin-bottom:4px; text-transform:uppercase; letter-spacing:.6px; }

    .auth-input-wrap { position:relative; display:flex; align-items:center; }
    .auth-input-icon { position:absolute; left:14px; color:#b0bec5; pointer-events:none; flex-shrink:0; transition:color .2s; }

    .auth-input {
      width:100%; background:#F8F9FA;
      border: 1.5px solid #DEE2E6;
      border-radius: 10px;
      padding: 10px 12px 10px 38px;
      font-size:13px; font-family:'Nunito','Segoe UI',sans-serif;
      font-weight:500; color:#2C3E50;
      transition: border-color .2s, box-shadow .2s, background .2s, transform .18s;
      outline: none;
    }
    .auth-input::placeholder { color:#95A5A6; font-weight:400; }
    .auth-input:hover { border-color:#c8d6e5; }
    .auth-input:focus {
      border-color:#4A90E2; background:#fff;
      box-shadow: 0 0 0 3px rgba(74,144,226,.12);
      transform: translateY(-1px);
    }
    .auth-input-wrap:focus-within .auth-input-icon { color:#4A90E2; }
    .auth-field .auth-input:not(.auth-input-wrap .auth-input) { padding-left:14px; }

    .auth-input--pwd { padding-right: 44px; }
    .auth-pwd-toggle {
      position:absolute; right:8px; top:50%; transform:translateY(-50%);
      width:32px; height:32px; display:flex; align-items:center; justify-content:center;
      background:transparent; border:0; border-radius:8px;
      color:#95A5A6; cursor:pointer; padding:0;
      transition: color .15s, background .15s;
    }
    .auth-pwd-toggle:hover { color:#4A90E2; background:rgba(74,144,226,.08); }
    .auth-pwd-toggle:focus-visible { outline:none; box-shadow:0 0 0 3px rgba(74,144,226,.25); color:#4A90E2; }
    .auth-pwd-toggle:active { transform:translateY(-50%) scale(.92); }
    .auth-pwd-toggle[aria-pressed="true"] { color:#4A90E2; }

    .auth-options { display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; }
    .auth-checkbox { display:flex; align-items:center; gap:7px; font-size:13px; color:#7F8C8D; cursor:pointer; user-select:none; font-weight:500; }
    .auth-checkbox input[type="checkbox"] { width:15px; height:15px; accent-color:#4A90E2; cursor:pointer; }
    .auth-link { font-size:13px; color:#4A90E2; font-weight:600; text-decoration:none; transition:color .15s; }
    .auth-link:hover { color:#2563EB; }

    /* ── Buttons ── */
    .auth-btn {
      width:100%; background:linear-gradient(135deg,#4A90E2 0%,#2563EB 100%);
      color:#fff; border:none; border-radius:10px;
      padding:11px 22px; font-size:14px; font-weight:700;
      font-family:'Nunito','Segoe UI',sans-serif;
      cursor:pointer; transition:all .2s;
      box-shadow:0 4px 16px rgba(74,144,226,.3);
      display:flex; align-items:center; justify-content:center; gap:8px;
      position:relative; overflow:hidden;
    }
    .auth-btn::before {
      content:''; position:absolute; inset:0;
      background:linear-gradient(135deg,rgba(255,255,255,.1) 0%,transparent 60%);
      pointer-events:none;
    }
    .auth-btn:hover { background:linear-gradient(135deg,#5aa0ec 0%,#4A90E2 100%); box-shadow:0 6px 24px rgba(74,144,226,.4); transform:translateY(-1px); }
    .auth-btn:active { transform:translateY(1px); box-shadow:0 2px 8px rgba(74,144,226,.2); }

    .auth-btn--google {
      display:flex; align-items:center; justify-content:center; gap:10px;
      width:100%; padding:12px 20px; background:#fff; border:1.5px solid #E0E8F0;
      border-radius:12px; color:#2C3E50; font-family:'Nunito','Segoe UI',sans-serif;
      font-size:14px; font-weight:600; text-decoration:none; cursor:pointer;
      transition:background .2s,box-shadow .2s,border-color .2s; margin-top:12px;
    }
    .auth-btn--google:hover { background:#F4F8FF; border-color:#C5DDF8; box-shadow:0 2px 10px rgba(74,144,226,.10); color:#2C3E50; text-decoration:none; }

    /* ── Divider ── */
    .auth-divider { position:relative; text-align:center; margin:14px 0 10px; }
    .auth-divider::before { content:''; position:absolute; top:50%; left:0; right:0; height:1px; background:#E0E0E0; }
    .auth-divider span { position:relative; background:#fff; padding:0 14px; font-size:11px; color:#95A5A6; font-weight:600; text-transform:uppercase; letter-spacing:.8px; }

    .auth-footer { text-align:center; font-size:13px; color:#7F8C8D; margin:0; font-weight:500; }
    .auth-footer a { color:#4A90E2; font-weight:700; text-decoration:none; transition:color .15s; }
    .auth-footer a:hover { color:#2563EB; }

    /* Flash error */
    .auth-card .flash-error { background:#fef2f2; border-left:3px solid #ef4444; color:#b91c1c; padding:12px 16px; border-radius:9px; margin-bottom:20px; font-weight:600; font-size:13px; }

    /* ── Role selector ── */
    .auth-role-selector { display:flex; gap:10px; }
    .auth-role {
      flex:1; display:flex; align-items:center; justify-content:center; gap:9px;
      padding:13px 12px; border:1.5px solid #DEE2E6; border-radius:11px;
      background:#F8F9FA; cursor:pointer; transition:all .2s;
      color:#7F8C8D; font-size:13px; font-weight:600;
      font-family:'Nunito','Segoe UI',sans-serif;
      transform-style:preserve-3d;
    }
    .auth-role:hover { border-color:#a8c8f0; color:#4A90E2; background:rgba(74,144,226,.05); }
    .auth-role.selected { border-color:#4A90E2; background:rgba(74,144,226,.08); color:#4A90E2; box-shadow:0 0 0 3px rgba(74,144,226,.1); }
    .auth-role svg { flex-shrink:0; }

    /* Form errors */
    .auth-field .form-error-message,
    .auth-card  .form-error-message { font-size:12px; color:#ef4444; font-weight:600; margin-top:4px; }
    .auth-field select.auth-input { appearance:none; cursor:pointer; }

    /* Password strength */
    .password-strength-container { height:4px; background:#E0E0E0; border-radius:2px; overflow:hidden; margin-top:8px; }
    .password-strength-bar { height:100%; width:0%; transition:width .35s cubic-bezier(0.22,1,0.36,1), background-color .35s ease; border-radius:2px; }
    .password-feedback { display:flex; align-items:center; gap:6px; font-size:11px; margin-top:6px; min-height:16px; font-weight:600; letter-spacing:.02em; }
    .password-feedback svg { flex-shrink:0; width:12px; height:12px; }
    .password-feedback .pf-label { letter-spacing:.06em; text-transform:uppercase; font-weight:700; font-size:10px; }
    .password-feedback .pf-hint { color:#7F8C8D; font-weight:500; text-transform:none; letter-spacing:0; font-size:11px; }

    /* Input glow on focus */
    .auth-input:focus { animation: inputGlow 2s ease-in-out infinite; }
    @keyframes inputGlow {
      0%,100%{ box-shadow:0 0 0 3px rgba(74,180,100,.12),0 0 20px rgba(74,180,100,.06); }
      50%    { box-shadow:0 0 0 3px rgba(74,180,100,.22),0 0 30px rgba(74,180,100,.12); }
    }

    /* ── Entrance animation (login card on first load) ── */
    body.auth-ready .auth-form-card--login .auth-card {
      animation: cardReveal .7s cubic-bezier(.22,1,.36,1) .1s both;
    }
    @keyframes cardReveal {
      from { opacity:0; transform:translateY(22px) scale(.98); }
      to   { opacity:1; transform:none; }
    }

    /* ── Responsive ── */
    @media (max-width:960px) {
      .auth-left { display:none; }
      .auth-form-card { width:100%; left:0; right:0; padding:24px 20px; }
      .auth-form-card--register { opacity:0; }
      .auth-root.show-register .auth-form-card--login { opacity:0; }
      .auth-root.show-register .auth-form-card--register { opacity:1; }
    }
    @media (max-width:480px) {
      .auth-card { padding:24px 16px; }
      .auth-card__header h2 { font-size:24px; }
      .auth-role-selector { flex-direction:column; }
    }

    @media (prefers-reduced-motion:reduce) {
      .auth-form-card, .auth-left { transition:none !important; }
      .stem-path, .leaf-shape, .petal, .spore, .plant-group,
      .auth-brand-block img, .auth-form-card--login .auth-card { animation:none !important; }
      .auth-input:focus { animation:none; }
      .auth-role:hover,.auth-role.selected { transform:none !important; }
    }
    </style>
{% endblock %}

{% block body %}
<div class="auth-root" id="authRoot">

  {# ════════════════════════════════════════════
     LEFT — Botanical panel (fixed, shared)
  ════════════════════════════════════════════ #}
  <div class="auth-left">
    <div class="auth-left__inner">

      <div class="auth-brand-block">
        <img src="{{ asset('images/mindbloom_logo.png') }}" alt="MindBloom">
        <div class="auth-brand-name">Mind<em>Bloom</em></div>
        <p class="auth-brand-tagline">Plateforme de bien-être mental</p>
      </div>

      <div class="auth-botanical">
        <svg viewBox="0 0 300 320" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <radialGradient id="lgGlow" cx="50%" cy="50%" r="50%">
              <stop offset="0%"   stop-color="#A8CEED" stop-opacity="0.4"/>
              <stop offset="100%" stop-color="#4A90E2" stop-opacity="0"/>
            </radialGradient>
            <linearGradient id="lgStem" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%"   stop-color="#5FBF9F"/>
              <stop offset="100%" stop-color="#3a9478"/>
            </linearGradient>
            <linearGradient id="lgLeaf1" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%"   stop-color="#6FCFB0"/>
              <stop offset="100%" stop-color="#4DAE8E"/>
            </linearGradient>
            <linearGradient id="lgLeaf2" x1="1" y1="0" x2="0" y2="1">
              <stop offset="0%"   stop-color="#74B8E8"/>
              <stop offset="100%" stop-color="#4A90E2"/>
            </linearGradient>
            <linearGradient id="lgPetal" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%"   stop-color="#C5DFF8" stop-opacity="0.95"/>
              <stop offset="100%" stop-color="#9ED8C7" stop-opacity="0.8"/>
            </linearGradient>
            <filter id="lgGlowF"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
            <filter id="lgSoftF"><feGaussianBlur stdDeviation="5" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          </defs>
          <ellipse cx="150" cy="290" rx="90" ry="28" fill="url(#lgGlow)" opacity="0.5"/>
          <g class="plant-group">
            <path class="stem-path" d="M150 300 C150 280 148 260 150 240 C152 220 148 200 152 180 C156 160 150 140 150 120" stroke="url(#lgStem)" stroke-width="3" stroke-linecap="round"/>
            <path class="stem-path" d="M150 220 C140 210 125 205 110 195 C95 185 82 180 70 168" stroke="url(#lgStem)" stroke-width="2" stroke-linecap="round"/>
            <path class="stem-path" d="M152 190 C162 180 175 175 190 165 C205 155 215 150 228 140" stroke="url(#lgStem)" stroke-width="2" stroke-linecap="round"/>
            <path class="stem-path" d="M150 155 C138 147 122 142 108 132 C94 122 84 118 72 108" stroke="url(#lgStem)" stroke-width="1.5" stroke-linecap="round"/>
            <ellipse class="leaf-shape leaf-1" cx="68" cy="165" rx="32" ry="14" fill="url(#lgLeaf1)" transform="rotate(-35 68 165)" filter="url(#lgGlowF)"/>
            <ellipse class="leaf-shape leaf-2" cx="55" cy="148" rx="22" ry="10" fill="url(#lgLeaf2)" transform="rotate(-50 55 148)" opacity="0.85"/>
            <ellipse class="leaf-shape leaf-3" cx="80" cy="178" rx="18" ry="8"  fill="url(#lgLeaf1)" transform="rotate(-20 80 178)" opacity="0.7"/>
