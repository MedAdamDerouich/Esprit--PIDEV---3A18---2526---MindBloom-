{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js"></script>
<script>
(function () {
    'use strict';

    if (typeof THREE === 'undefined') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var canvas  = document.getElementById('hero-canvas');
    var section = document.querySelector('.ptdash-hero');
    if (!canvas || !section) return;

    /* ── Renderer ── */
    var renderer = new THREE.WebGLRenderer({
        canvas: canvas, alpha: true, antialias: true, powerPreference: 'low-power'
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    var scene  = new THREE.Scene();
    var camera = new THREE.PerspectiveCamera(60, 1, 0.1, 100);
    camera.position.set(0, 0, 8);

    /* ── Particles — logo palette ── */
    var COUNT = 140;
    var COLORS = [
        new THREE.Color(0x00C2C7), // cyan
        new THREE.Color(0x4ECB71), // green
        new THREE.Color(0xF5C842), // yellow
        new THREE.Color(0xF47B20), // orange
        new THREE.Color(0xE63F8C), // pink
        new THREE.Color(0x9B59B6), // purple
        new THREE.Color(0x1B3A6B), // navy
    ];
    var FW = 16, FH = 10, FD = 6;

    var geo = new THREE.BufferGeometry();
    var pos = new Float32Array(COUNT * 3);
    var col = new Float32Array(COUNT * 3);
    var spd = new Float32Array(COUNT);
    var pha = new Float32Array(COUNT);
    var amp = new Float32Array(COUNT);
    var bx  = new Float32Array(COUNT);

    for (var i = 0; i < COUNT; i++) {
        var x = (Math.random() - 0.5) * FW;
        var y = (Math.random() - 0.5) * FH;
        var z = (Math.random() - 0.5) * FD;
        pos[i*3] = x; pos[i*3+1] = y; pos[i*3+2] = z;
        bx[i]  = x;
        spd[i] = 0.004 + Math.random() * 0.008;
        pha[i] = Math.random() * Math.PI * 2;
        amp[i] = 0.15 + Math.random() * 0.35;
        var c = COLORS[Math.floor(Math.random() * COLORS.length)];
        col[i*3] = c.r; col[i*3+1] = c.g; col[i*3+2] = c.b;
    }

    geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    geo.setAttribute('color',    new THREE.BufferAttribute(col, 3));

    /* Sprite */
    var sc = document.createElement('canvas');
    sc.width = sc.height = 64;
    var ctx = sc.getContext('2d');
    var grd = ctx.createRadialGradient(32,32,0,32,32,32);
    grd.addColorStop(0,   'rgba(255,255,255,1)');
    grd.addColorStop(0.35,'rgba(255,255,255,0.7)');
    grd.addColorStop(1,   'rgba(255,255,255,0)');
    ctx.fillStyle = grd;
    ctx.fillRect(0,0,64,64);
    var sprite = new THREE.CanvasTexture(sc);

    var mat = new THREE.PointsMaterial({
        size: 0.18, map: sprite, vertexColors: true,
        transparent: true, opacity: 0.72,
        depthWrite: false, blending: THREE.AdditiveBlending
    });
    scene.add(new THREE.Points(geo, mat));

    /* ── Mouse parallax ── */
    var pTarget = {x:0,y:0}, pCurr = {x:0,y:0};
    section.addEventListener('mousemove', function(e) {
        var r = section.getBoundingClientRect();
        pTarget.x =  (((e.clientX-r.left)/r.width)*2-1) * 0.6;
        pTarget.y = -(((e.clientY-r.top)/r.height)*2-1) * 0.6;
    });
    section.addEventListener('mouseleave', function() { pTarget.x=0; pTarget.y=0; });

    /* ── Resize ── */
    function onResize() {
        var w = section.clientWidth, h = section.clientHeight;
        renderer.setSize(w,h,false);
        camera.aspect = w/h;
        camera.updateProjectionMatrix();
    }
    onResize();
    var ro = new ResizeObserver(onResize);
    ro.observe(section);

    /* ── Animate ── */
    var clock = new THREE.Clock();
    var rafId = null;

    function animate() {
        rafId = requestAnimationFrame(animate);
        var t = clock.getElapsedTime();
        pCurr.x += (pTarget.x - pCurr.x) * 0.04;
        pCurr.y += (pTarget.y - pCurr.y) * 0.04;
        camera.position.x = pCurr.x;
        camera.position.y = pCurr.y;

        var p = geo.attributes.position;
        for (var i = 0; i < COUNT; i++) {
            p.array[i*3+1] += spd[i];
            p.array[i*3]    = bx[i] + Math.sin(t*0.5 + pha[i]) * amp[i];
            if (p.array[i*3+1] > FH/2+0.5) {
                p.array[i*3+1] = -FH/2-0.5;
                var nx = (Math.random()-0.5)*FW;
                p.array[i*3] = nx; bx[i] = nx;
            }
        }
        p.needsUpdate = true;
        renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('pagehide', function() {
        if (rafId) cancelAnimationFrame(rafId);
        ro.disconnect(); renderer.dispose(); geo.dispose(); mat.dispose(); sprite.dispose();
    });
})();
</script>

<script>
(function () {
    'use strict';

    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.body.classList.add('anim-ready');

    if (reducedMotion) {
        document.querySelectorAll('.ptdash-badge,.ptdash-title,.ptdash-desc,.ptdash-cta-wrap,' +
            '.ptdash-services-title,.ptdash-services-sub').forEach(function(el) {
            el.style.opacity = '1'; el.style.transform = 'none';
        });
        document.querySelectorAll('.ptdash-card-wrap,.ptdash-stat').forEach(function(el) {
            el.style.opacity = '1'; el.style.transform = 'none';
        });
        return;
    }

    /* ════════════════════════════════════════════════════════════════
       Stats — animated counters with staggered entrance
    ════════════════════════════════════════════════════════════════ */
    function easeOutCubic(t) { return 1 - Math.pow(1-t, 3); }

    function formatCounter(value, fmt) {
        var n = Math.floor(value);
        switch (fmt) {
            case 'N+':    return n + '+';
            case 'Nk+':   return n + 'k+';
            case 'N/7':   return n + '/7';
            case 'N.X/5':
                var tenths = Math.floor(value);
                return Math.floor(tenths/10) + '.' + (tenths%10) + '/5';
            default: return String(n);
        }
    }

    function animateCounter(el) {
        var target = parseFloat(el.getAttribute('data-target')) || 0;
        var fmt    = el.getAttribute('data-format') || 'N';
        var dur    = 1500, start = null;
        function step(ts) {
            if (!start) start = ts;
            var p = Math.min((ts-start)/dur, 1);
            el.textContent = formatCounter(easeOutCubic(p) * target, fmt);
            if (p < 1) requestAnimationFrame(step);
            else el.textContent = formatCounter(target, fmt);
        }
        requestAnimationFrame(step);
    }

    /* Stats entrance + counter trigger */
    var statsBar = document.getElementById('stats-bar');
    var statItems = document.querySelectorAll('.ptdash-stat');

    if (statsBar && 'IntersectionObserver' in window) {
        var statsObs = new IntersectionObserver(function(entries, obs) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                    obs.unobserve(entry.target);
                    statItems.forEach(function(el, i) {
                        setTimeout(function() {
                            el.style.transition = 'opacity 0.6s cubic-bezier(0.22,1,0.36,1), transform 0.6s cubic-bezier(0.22,1,0.36,1)';
                            el.style.opacity = '1';
                            el.style.transform = 'translateY(0)';
                        }, i * 120);
                    });
                    document.querySelectorAll('.stat-counter').forEach(animateCounter);
                }
            });
        }, { threshold: 0.4 });
        statsObs.observe(statsBar);
    } else {
        statItems.forEach(function(el) { el.style.opacity='1'; el.style.transform='none'; });
        document.querySelectorAll('.stat-counter').forEach(function(el) {
            el.textContent = formatCounter(parseFloat(el.getAttribute('data-target'))||0, el.getAttribute('data-format')||'N');
        });
    }

    /* ════════════════════════════════════════════════════════════════
       Services section title entrance
    ════════════════════════════════════════════════════════════════ */
    var svcTitle = document.querySelector('.ptdash-services-title');
    var svcSub   = document.querySelector('.ptdash-services-sub');

    if (svcTitle && 'IntersectionObserver' in window) {
        var titleObs = new IntersectionObserver(function(entries, obs) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                    obs.unobserve(entry.target);
                    svcTitle.style.transition = 'opacity 0.7s cubic-bezier(0.22,1,0.36,1), transform 0.7s cubic-bezier(0.22,1,0.36,1)';
                    svcTitle.style.opacity = '1';
                    svcTitle.style.transform = 'translateY(0)';
                    setTimeout(function() {
                        if (svcSub) {
                            svcSub.style.transition = 'opacity 0.7s cubic-bezier(0.22,1,0.36,1), transform 0.7s cubic-bezier(0.22,1,0.36,1)';
                            svcSub.style.opacity = '1';
                            svcSub.style.transform = 'translateY(0)';
                        }
                    }, 120);
                }
            });
        }, { threshold: 0.3 });
        titleObs.observe(svcTitle);
    }

    /* ════════════════════════════════════════════════════════════════
       Service cards — 3D tilt + staggered entrance
    ════════════════════════════════════════════════════════════════ */
    var MAX_TILT = 14;
    var MAX_LIFT = 18;
    var cards = document.querySelectorAll('[data-tilt]');

    cards.forEach(function(card) {
        var wrap = card.closest('.ptdash-card-wrap');
        if (!wrap) return;

        wrap.addEventListener('mousemove', function(e) {
            var r  = card.getBoundingClientRect();
            var dx = ((e.clientX - r.left) / r.width)  * 2 - 1;
            var dy = ((e.clientY - r.top)  / r.height) * 2 - 1;
            var rx = -dy * MAX_TILT;
            var ry =  dx * MAX_TILT;
            card.style.transition = 'transform 0.08s ease-out, box-shadow 0.15s ease';
            card.style.transform  =
                'perspective(800px) rotateX(' + rx + 'deg) rotateY(' + ry + 'deg) translateZ(' + MAX_LIFT + 'px)';
        });

        wrap.addEventListener('mouseleave', function() {
            card.style.transition = 'transform 0.55s cubic-bezier(0.22,1,0.36,1), box-shadow 0.4s ease';
            card.style.transform  = 'perspective(800px) rotateX(0deg) rotateY(0deg) translateZ(0)';
        });

        /* Press feedback */
        wrap.addEventListener('mousedown', function() {
            card.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) translateZ(4px) scale(0.97)';
        });
        wrap.addEventListener('mouseup', function() {
            card.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) translateZ(' + MAX_LIFT + 'px)';
        });
    });

    /* Staggered entrance via IntersectionObserver */
    var cardWraps = document.querySelectorAll('.ptdash-card-wrap');

    if ('IntersectionObserver' in window) {
        var cardObs = new IntersectionObserver(function(entries, obs) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                    var el = entry.target;
                    var idx = Array.prototype.indexOf.call(cardWraps, el);
                    obs.unobserve(el);
                    setTimeout(function() {
                        el.style.transition =
                            'opacity 0.6s cubic-bezier(0.22,1,0.36,1), ' +
                            'transform 0.6s cubic-bezier(0.22,1,0.36,1)';
                        el.style.opacity = '1';
                        el.style.transform = 'translateY(0) scale(1)';
                    }, idx * 100);
                }
            });
        }, { threshold: 0.15 });
        cardWraps.forEach(function(el) { cardObs.observe(el); });
    } else {
        cardWraps.forEach(function(el) { el.style.opacity='1'; el.style.transform='none'; });
    }

})();
</script>
{% endblock %}
