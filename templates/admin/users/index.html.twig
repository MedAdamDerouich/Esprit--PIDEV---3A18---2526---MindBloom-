{% extends 'base.html.twig' %}
{% block title %}Utilisateurs — MindBloom{% endblock %}

{% block stylesheets %}
<style>
@keyframes fadeUp {
    from { opacity:0; transform:translateY(16px); }
    to   { opacity:1; transform:translateY(0); }
}

/* Header */
.page-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 20px;
    border-bottom: 1px solid #EFEFEF;
    margin-bottom: 24px;
}
.page-header-bar h1 {
    font-size: 20px;
    font-weight: 700;
    color: #1a1a2e;
    margin: 0 0 3px;
}
.page-header-bar p {
    font-size: 12px;
    color: #aaa;
    margin: 0;
}
.btn-new {
    padding: 10px 20px;
    background: #4A90E2;
    color: white;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s;
}
.btn-new:hover { background: #357abd; color: white; }

/* Filters bar */
.filters-bar {
    background: white;
    border: 1px solid #EFEFEF;
    border-radius: 10px;
    padding: 14px 18px;
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 24px;
    flex-wrap: wrap;
}
.filters-bar input[type=text] {
    flex: 1;
    min-width: 200px;
    border: 1px solid #E8E8E8;
    border-radius: 7px;
    padding: 8px 14px;
    font-size: 13px;
    color: #333;
    outline: none;
    transition: border-color 0.2s;
}
.filters-bar input[type=text]:focus { border-color: #4A90E2; }
.filters-bar select {
    border: 1px solid #E8E8E8;
    border-radius: 7px;
    padding: 8px 12px;
    font-size: 13px;
    color: #555;
    background: white;
    outline: none;
    cursor: pointer;
}
.filters-bar select:focus { border-color: #4A90E2; }

/* Cards grid */
.users-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 18px;
}

/* User card */
.user-card {
    background: white;
    border: 1px solid #EFEFEF;
    border-radius: 12px;
    padding: 22px 20px 18px;
    display: flex;
    flex-direction: column;
    gap: 0;
    animation: fadeUp 0.35s ease both;
    transition: box-shadow 0.2s, transform 0.15s;
    position: relative;
}
.user-card:hover {
    box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    transform: translateY(-3px);
}

/* Status dot top-right */
.card-status-dot {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
}
.dot-active    { background: #2ecc71; }
.dot-suspended { background: #e74c3c; }
.dot-inactive  { background: #bbb; }

/* Avatar + name */
.card-top {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
}
.card-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #EDF2F7;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 700;
    color: #4A90E2;
    flex-shrink: 0;
    overflow: hidden;
}
.card-avatar img { width:100%; height:100%; object-fit:cover; }
.card-name  { font-size: 14px; font-weight: 700; color: #1a1a2e; }
.card-username { font-size: 11px; color: #bbb; margin-top: 1px; }

/* Info rows */
.card-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 0;
    border-top: 1px solid #F5F5F5;
    border-bottom: 1px solid #F5F5F5;
    margin-bottom: 14px;
}
.card-info-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #888;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.card-info-row span.icon { font-size: 13px; flex-shrink: 0; }

/* Role + actions */
.card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}

.role-pill {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
}
.role-patient    { background: #eafaf5; color: #5FBF9F; }
.role-psy        { background: #eaf2fb; color: #4A90E2; }
.role-admin      { background: #fdecea; color: #e74c3c; }

.card-actions { display: flex; gap: 6px; }
.btn-edit {
    padding: 5px 12px;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    font-size: 12px;
    color: #555;
    text-decoration: none;
    background: white;
    transition: border-color 0.15s, color 0.15s;
}
.btn-edit:hover { border-color: #4A90E2; color: #4A90E2; }
.btn-toggle {
    padding: 5px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: opacity 0.15s;
}
.btn-toggle:hover { opacity: 0.8; }
.btn-toggle.suspend { background: #fdecea; color: #e74c3c; }
.btn-toggle.activate { background: #eafaf5; color: #27ae60; }

/* No results */
.no-results {
    grid-column: 1/-1;
    text-align: center;
    padding: 60px 0;
    color: #ccc;
    font-size: 14px;
}
</style>
{% endblock %}

{% block body %}
<div class="d-flex">
    {{ include('admin/_sidebar.html.twig') }}

    <div class="admin-content" style="flex:1;">

        {# Header #}
        <div class="page-header-bar">
            <div>
                <h1>Utilisateurs</h1>
                <p>{{ users|length }} compte{{ users|length > 1 ? 's' : '' }} enregistré{{ users|length > 1 ? 's' : '' }}</p>
            </div>
            <a href="{{ path('app_admin_user_new') }}" class="btn-new">+ Nouvel utilisateur</a>
        </div>

        {# Filters #}
        <div class="filters-bar">
            <input type="text" id="searchInput" placeholder="Rechercher par nom, email, username…"
                   oninput="filterCards()">
            <select id="roleFilter" onchange="filterCards()">
                <option value="">Tous les rôles</option>
                <option value="ROLE_PATIENT">Patient</option>
                <option value="ROLE_PSYCHOLOGUE">Psychologue</option>
                <option value="ROLE_ADMIN">Admin</option>
            </select>
            <select id="statusFilter" onchange="filterCards()">
                <option value="">Tous les statuts</option>
                <option value="ACTIVE">Actif</option>
                <option value="SUSPENDED">Suspendu</option>
            </select>
        </div>

        {# Cards grid #}
        <div class="users-grid" id="usersGrid">

            {% for user in users %}
            <div class="user-card"
                 data-role="{{ user.roles|join(',') }}"
                 data-status="{{ user.status }}"
                 data-search="{{ (user.fullName ~ ' ' ~ user.email ~ ' ' ~ user.username)|lower }}"
                 style="animation-delay: {{ loop.index0 * 0.04 }}s;">

                {# Status dot #}
                <div class="card-status-dot {{ user.status == 'ACTIVE' ? 'dot-active' : 'dot-suspended' }}"
                     title="{{ user.status == 'ACTIVE' ? 'Actif' : 'Suspendu' }}"></div>

                {# Avatar + name #}
                <div class="card-top">
                    <div class="card-avatar">
                        {% if user.profileImage %}
                            <img src="{{ asset('uploads/profiles/' ~ user.profileImage) }}" alt="">
                        {% else %}
                            {{ user.fullName|first|upper }}
                        {% endif %}
                    </div>
                    <div>
                        <div class="card-name">{{ user.fullName }}</div>
                        <div class="card-username">@{{ user.username }}</div>
                    </div>
                </div>

                {# Info #}
                <div class="card-info">
                    <div class="card-info-row">
                        <span class="icon">✉</span>
                        <span>{{ user.email }}</span>
                    </div>
                    <div class="card-info-row">
                        <span class="icon">📞</span>
                        <span>{{ user.phone ?? 'Non renseigné' }}</span>
                    </div>
                    <div class="card-info-row">
                        <span class="icon">📅</span>
                        <span>Inscrit le {{ user.createdAt ? user.createdAt|date('d/m/Y') : '—' }}</span>
                    </div>
                </div>

                {# Footer #}
                <div class="card-footer">
                    {% if 'ROLE_ADMIN' in user.roles %}
                        <span class="role-pill role-admin">Admin</span>
                    {% elseif 'ROLE_PSYCHOLOGUE' in user.roles %}
                        <span class="role-pill role-psy">Psychologue</span>
                    {% else %}
                        <span class="role-pill role-patient">Patient</span>
                    {% endif %}

                    <div class="card-actions">
                        <a href="{{ path('app_admin_user_edit', {id: user.id}) }}" class="btn-edit">
                            Modifier
                        </a>
                        <form method="post" action="{{ path('app_admin_user_toggle', {id: user.id}) }}">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('toggle-user-' ~ user.id) }}">
                            <button type="submit"
                                    class="btn-toggle {{ user.status == 'ACTIVE' ? 'suspend' : 'activate' }}">
                                {{ user.status == 'ACTIVE' ? 'Suspendre' : 'Activer' }}
                            </button>
                        </form>
                    </div>
                </div>

            </div>
            {% else %}
            <div class="no-results">Aucun utilisateur trouvé.</div>
            {% endfor %}

        </div>

    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
function filterCards() {
    const search = document.getElementById('searchInput').value.toLowerCase();
    const role   = document.getElementById('roleFilter').value;
    const status = document.getElementById('statusFilter').value;

    document.querySelectorAll('#usersGrid .user-card').forEach(card => {
        const matchSearch = !search || card.dataset.search.includes(search);
        const matchRole   = !role   || card.dataset.role.includes(role);
        const matchStatus = !status || card.dataset.status === status;
        card.style.display = (matchSearch && matchRole && matchStatus) ? '' : 'none';
    });
}
</script>
{% endblock %}
