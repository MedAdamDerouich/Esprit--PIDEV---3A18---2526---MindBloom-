{% extends 'base.html.twig' %}
{% block title %}Événements — MindBloom{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
body.dark-mode .patient-event-page {
    background: linear-gradient(175deg,#0F1117 0%,#121826 45%,#101A18 100%) !important;
}
body.dark-mode .patient-event-page [style*="background:#fff"],
body.dark-mode .patient-event-page [style*="background:white"],
body.dark-mode .patient-event-page [style*="background: #fff"],
body.dark-mode .patient-event-page [style*="background: white"],
body.dark-mode .patient-event-page [style*="background: rgb(255, 255, 255)"] {
    background: #161A26 !important;
    border-color: #252B3E !important;
    box-shadow: 0 12px 28px rgba(0,0,0,0.45) !important;
}
body.dark-mode .patient-event-page .event-card {
    background: #161A26 !important;
    border-color: #252B3E !important;
}
body.dark-mode .patient-event-page .event-card:hover {
    background: #1A1F2E !important;
}
body.dark-mode .patient-event-page [style*="background:#F0F6FF"],
body.dark-mode .patient-event-page [style*="background:#EEF4FF"],
body.dark-mode .patient-event-page [style*="background:#E8F5F0"],
body.dark-mode .patient-event-page [style*="background:#F8F9FA"] {
    background: #1A1F2E !important;
}
body.dark-mode .patient-event-page [style*="color:#1B3A6B"],
body.dark-mode .patient-event-page [style*="color:#2C3E50"],
body.dark-mode .patient-event-page [style*="color:#2D3748"] {
    color: #E8EAF0 !important;
}
body.dark-mode .patient-event-page [style*="color:#7F8C8D"],
body.dark-mode .patient-event-page [style*="color:#95A5A6"],
body.dark-mode .patient-event-page [style*="color:#55606e"] {
    color: #A8B0C4 !important;
}
body.dark-mode .patient-event-page a[style*="background:#fff"],
body.dark-mode .patient-event-page a[style*="background:white"] {
    background: #1E2333 !important;
    color: #D8DCE8 !important;
    border-color: #252B3E !important;
}
body.dark-mode .patient-event-page .pagination .page-item .page-link {
    background: #1E2333 !important;
    border-color: #2A3147 !important;
    color: #D8DCE8 !important;
}
body.dark-mode .patient-event-page .pagination .page-item.active .page-link {
    background: linear-gradient(135deg,#00C2C7,#4ECB71) !important;
    color: #fff !important;
    border-color: #00C2C7 !important;
}
.navigation { display:flex; justify-content:center; margin-top:32px; }
.pagination { display:flex; align-items:center; gap:8px; list-style:none; padding:0; margin:0; }
.pagination .page-item .page-link { display:flex; align-items:center; justify-content:center; width:40px; height:40px; border-radius:10px; background:#fff; border:1.5px solid #E0E8F8; color:#2C3E50; font-weight:700; font-size:14px; text-decoration:none; transition:all .2s; }
.pagination .page-item .page-link:hover { background:#00C2C7; color:#fff; border-color:#00C2C7; }
.pagination .page-item.active .page-link { background:linear-gradient(135deg,#00C2C7,#4ECB71); color:#fff; border-color:#00C2C7; box-shadow:0 4px 12px rgba(0,194,199,0.3); }
.pagination .page-item.disabled .page-link { opacity:.4; cursor:not-allowed; }
</style>
{% endblock %}

{% block body %}
<div class="patient-event-page" style="background:linear-gradient(175deg,#F0F6FF 0%,#E8F4F8 45%,#EEF5F0 100%); min-height:calc(100vh - 70px); padding:40px 20px;">
<div style="max-width:1200px; margin:0 auto;">

    {# ── Hero ── #}
    <div style="text-align:center; margin-bottom:40px;">
        <div style="display:inline-flex;align-items:center;gap:10px;background:rgba(0,194,199,0.10);border:1px solid rgba(0,194,199,0.20);border-radius:50px;padding:6px 18px;font-size:12px;font-weight:700;color:#008c91;letter-spacing:.5px;text-transform:uppercase;margin-bottom:16px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            {{ total }} événement{{ total > 1 ? 's' : '' }} disponible{{ total > 1 ? 's' : '' }}
        </div>
        <h1 style="font-size:36px;font-weight:900;color:#1B3A6B;margin:0 0 10px;letter-spacing:-.5px;">Événements <span style="background:linear-gradient(135deg,#00C2C7,#4ECB71);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">MindBloom</span></h1>
        <p style="font-size:15px;color:#7F8C8D;max-width:500px;margin:0 auto;">Participez à nos événements bien-être et rejoignez notre communauté.</p>
    </div>

    {# ── Top bar ── #}
    <div style="display:flex;justify-content:flex-end;margin-bottom:24px;">
        <a href="{{ path('app_patient_event_my_participations') }}" style="display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,#00C2C7,#4ECB71);color:#fff;border-radius:12px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;box-shadow:0 4px 14px rgba(0,194,199,0.3);transition:transform .2s,box-shadow .2s;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 20px rgba(0,194,199,0.4)'" onmouseout="this.style.transform='';this.style.boxShadow='0 4px 14px rgba(0,194,199,0.3)'">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            Mes Participations
        </a>
    </div>

    {# ── Flash messages ── #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div style="background:{{ label=='success' ? '#eafaf1' : '#fef2f2' }};border-left:4px solid {{ label=='success' ? '#4ECB71' : '#ef4444' }};color:{{ label=='success' ? '#1e8449' : '#b91c1c' }};padding:12px 16px;border-radius:10px;margin-bottom:16px;font-weight:600;font-size:13px;">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {# ── Grid ── #}
    {% if events.totalItemCount > 0 %}
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:24px;margin-bottom:40px;">
        {% for event in events %}
        <div class="event-card" style="background:#fff;border-radius:18px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.06);border:1px solid rgba(0,0,0,0.04);transition:transform .25s cubic-bezier(0.34,1.56,0.64,1),box-shadow .25s;" onmouseover="this.style.transform='translateY(-6px)';this.style.boxShadow='0 12px 36px rgba(0,194,199,0.14)'" onmouseout="this.style.transform='';this.style.boxShadow='0 4px 20px rgba(0,0,0,0.06)'">

            {# Image #}
            {% if event.photo %}
                <div style="height:180px;overflow:hidden;">
                    <img src="{{ asset('uploads/events/' ~ event.photo) }}" alt="{{ event.titre }}" style="width:100%;height:100%;object-fit:cover;transition:transform .4s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform=''">
                </div>
            {% else %}
                <div style="height:180px;background:linear-gradient(135deg,#EEF4FF,#E8F5F0);display:flex;align-items:center;justify-content:center;">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#00C2C7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity=".4"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
            {% endif %}

            {# Body #}
            <div style="padding:20px;">
                {# Badge prix #}
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
                    <span style="background:{{ event.isGratuit ? 'rgba(78,203,113,0.12)' : 'rgba(0,194,199,0.10)' }};color:{{ event.isGratuit ? '#27ae60' : '#00C2C7' }};font-size:11px;font-weight:800;padding:4px 10px;border-radius:20px;letter-spacing:.3px;">
                        {{ event.isGratuit ? 'GRATUIT' : event.prix ~ ' DT' }}
                    </span>
                    <span style="font-size:11px;color:#95A5A6;font-weight:600;">
                        {{ event.countParticipants }}/{{ event.capaciteMax ?? '∞' }} participants
                    </span>
                </div>

                <h3 style="font-size:16px;font-weight:800;color:#1B3A6B;margin:0 0 10px;line-height:1.3;">{{ event.titre }}</h3>

                {% if event.description %}
                    <p style="font-size:13px;color:#7F8C8D;line-height:1.6;margin:0 0 14px;">{{ event.description|length > 90 ? event.description|slice(0,90) ~ '…' : event.description }}</p>
                {% endif %}

                {# Meta #}
                <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:16px;">
                    <div style="display:flex;align-items:center;gap:7px;font-size:12px;color:#55606e;">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#00C2C7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        {{ event.dateDebut|date('d/m/Y à H:i') }}
                    </div>
                    <div style="display:flex;align-items:center;gap:7px;font-size:12px;color:#55606e;">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#00C2C7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        {{ event.lieu ?? 'Lieu non précisé' }}
                    </div>
                </div>

                <a href="{{ path('app_patient_event_show', {id: event.id}) }}" style="display:block;text-align:center;background:linear-gradient(135deg,#00C2C7,#4ECB71);color:#fff;border-radius:10px;padding:10px;font-size:13px;font-weight:700;text-decoration:none;transition:opacity .2s;" onmouseover="this.style.opacity='.88'" onmouseout="this.style.opacity='1'">
                    Voir les détails →
                </a>
            </div>
        </div>
        {% endfor %}
    </div>

    {# ── Pagination ── #}
    <div class="navigation" style="display:flex;justify-content:center;margin-top:32px;">
        {{ knp_pagination_render(events) }}
    </div>

    {% else %}
    {# ── Empty state ── #}
    <div style="text-align:center;padding:80px 20px;background:#fff;border-radius:20px;box-shadow:0 4px 20px rgba(0,0,0,0.05);">
        <div style="width:80px;height:80px;background:rgba(0,194,199,0.08);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#00C2C7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <h4 style="font-size:20px;font-weight:800;color:#1B3A6B;margin:0 0 8px;">Aucun événement disponible</h4>
        <p style="color:#7F8C8D;font-size:14px;margin:0;">Les prochains événements apparaîtront ici. Revenez bientôt !</p>
    </div>
    {% endif %}

</div>
</div>
{% endblock %}
