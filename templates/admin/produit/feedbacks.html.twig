{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des avis - {{ produit.nom }}{% endblock %}

{% block admin_header %}Gestion des avis pour "{{ produit.nom }}"{% endblock %}

{% block admin_content %}
<div class="mb-4">
    <a href="{{ path('app_admin_produit_index') }}" class="btn btn-link text-muted p-0 text-decoration-none">
        <i class="bi bi-arrow-left me-1"></i> Retour aux produits
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 border-0">Client</th>
                        <th class="py-3 border-0">Note</th>
                        <th class="py-3 border-0">Sentiment IA</th>
                        <th class="py-3 border-0">Commentaire</th>
                        <th class="py-3 border-0">Date</th>
                        <th class="py-3 border-0 pe-4 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for feedbackData in feedbacks %}
                        {% set feedback = feedbackData.entity %}
                        {% set sentiment = feedbackData.sentiment %}
                        <tr>
                            <td class="ps-4 py-4 border-0">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 12px;">
                                        {{ feedback.user ? (feedback.user.fullName|first|upper) : '?' }}
                                    </div>
                                    <div>
                                        <h6 class="mb-0 small fw-bold">{{ feedback.user ? feedback.user.fullName : 'Utilisateur supprimé' }}</h6>
                                    </div>
                                </div>
                            </td>
                            <td class="py-4 border-0">
                                <div class="text-warning">
                                    {% for i in 1..5 %}
                                        <i class="bi bi-star{{ i <= feedback.note ? '-fill' : '' }}"></i>
                                    {% endfor %}
                                </div>
                            </td>
                            <td class="py-4 border-0">
                                <span class="badge rounded-pill {% if sentiment.label == 'positive' %}bg-success{% elseif sentiment.label == 'negative' %}bg-danger{% else %}bg-secondary{% endif %} bg-opacity-10 {% if sentiment.label == 'positive' %}text-success{% elseif sentiment.label == 'negative' %}text-danger{% else %}text-secondary{% endif %} px-3 py-2">
                                    {{ sentiment.getEmoji }} {{ sentiment.label|capitalize }} ({{ sentiment.score }}%)
                                </span>
                            </td>
                            <td class="py-4 border-0 small text-muted">
                                {{ feedback.commentaire|slice(0, 50) }}{{ feedback.commentaire|length > 50 ? '...' : '' }}
                            </td>
                            <td class="py-4 border-0 small text-muted">
                                {{ feedback.dateFeedback|date('d/m/Y H:i') }}
                            </td>
                            <td class="pe-4 py-4 border-0 text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    {# Bouton Voir #}
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#viewComment{{ feedback.id }}">
                                        <i class="bi bi-eye me-1"></i> Voir
                                    </button>

                                    {# Formulaire Supprimer #}
                                    <form id="admin-feedback-delete-form-{{ feedback.id }}" action="{{ path('app_admin_feedback_delete', {'id': feedback.id}) }}" method="post">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_feedback' ~ feedback.id) }}">
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 js-open-admin-feedback-delete" data-feedback-id="{{ feedback.id }}">
                                            <i class="bi bi-trash me-1"></i> Supprimer
                                        </button>
                                    </form>
                                </div>

                                {# Modal pour voir le commentaire #}
                                <div class="modal fade" id="viewComment{{ feedback.id }}" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow rounded-4">
                                            <div class="modal-header border-0 pb-0">
                                                <h5 class="modal-title fw-bold">Avis de {{ feedback.user ? feedback.user.fullName : 'Utilisateur' }}</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body text-start p-4">
                                                <div class="mb-3 text-warning">
                                                    {% for i in 1..5 %}
                                                        <i class="bi bi-star{{ i <= feedback.note ? '-fill' : '' }}"></i>
                                                    {% endfor %}
                                                    <span class="ms-2 text-muted small">({{ feedback.note }}/5)</span>
                                                </div>
                                                <div class="p-3 bg-light rounded-4 text-dark shadow-sm">
                                                    {{ feedback.commentaire|nl2br }}
                                                </div>
                                                <div class="mt-3 small text-muted">
                                                    <i class="bi bi-calendar3 me-1"></i> Déposé le {{ feedback.dateFeedback|date('d/m/Y à H:i') }}
                                                </div>
                                            </div>
                                            <div class="modal-footer border-0 pt-0">
                                                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Fermer</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                Aucun avis déposé pour ce produit.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="adminFeedbackDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-body text-center p-4">
                <h6 class="fw-bold mb-2">Supprimer ce feedback ?</h6>
                <p class="text-muted small mb-4">Cette action est définitive.</p>
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Annuler</button>
                    <button type="button" class="btn btn-danger rounded-pill px-4" id="adminFeedbackDeleteConfirmBtn">Supprimer</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const modalElement = document.getElementById('adminFeedbackDeleteModal');
    const confirmButton = document.getElementById('adminFeedbackDeleteConfirmBtn');
    const deleteButtons = document.querySelectorAll('.js-open-admin-feedback-delete');
    let activeForm = null;

    if (!modalElement || !confirmButton || deleteButtons.length === 0) {
        return;
    }

    deleteButtons.forEach(function(button) {
        button.addEventListener('click', function() {
            const feedbackId = this.dataset.feedbackId;
            activeForm = document.getElementById('admin-feedback-delete-form-' + feedbackId);
            bootstrap.Modal.getOrCreateInstance(modalElement).show();
        });
    });

    confirmButton.addEventListener('click', function() {
        if (activeForm) {
            activeForm.submit();
        }
    });
});
</script>
{% endblock %}
