{% extends 'base.html.twig' %}
{% block title %}Espace Psychologue — MindBloom{% endblock %}

{% block body %}

{# ── HEADER — gradient #6FBF9B → #4A90E2 ── #}
<header style="background:linear-gradient(to right,#6FBF9B,#4A90E2);height:70px;
               padding:0 20px;display:flex;align-items:center;gap:15px;">

    <img src="{{ asset('images/mindbloom_logo.png') }}" alt="MindBloom"
         style="height:60px;width:auto;object-fit:contain;flex-shrink:0;">

    <span style="font-size:20px;font-weight:700;color:white;">MindBloom — Espace Psychologue</span>

    <div style="flex:1;"></div>

    {# Name + settings button #}
    <div style="display:flex;align-items:center;gap:10px;">
        <span style="font-size:14px;font-weight:700;color:white;">
            Bonjour, Dr. {{ app.user.fullName|split(' ')|last }}
        </span>
        <a href="{{ path('app_profile') }}"
           style="width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,0.2);
                  display:flex;align-items:center;justify-content:center;
                  font-size:18px;text-decoration:none;color:white;flex-shrink:0;"
           title="Modifier mon profil">⚙</a>
    </div>

    <div style="width:1px;height:30px;background:rgba(255,255,255,0.3);margin:0 5px;"></div>

    <a href="{{ path('app_logout') }}"
       style="padding:8px 15px;font-size:13px;font-weight:700;color:white;
              border:1px solid rgba(255,255,255,0.5);border-radius:20px;
              text-decoration:none;background:transparent;">
        Déconnexion
    </a>
</header>

{# ── CENTER ── #}
<div style="background:#F5F3EF;min-height:calc(100vh - 70px);
            display:flex;flex-direction:column;align-items:center;
            padding-top:40px;gap:30px;">

    <span style="font-size:36px;font-weight:700;color:#2C3E50;">Bienvenue sur MindBloom</span>

    <span style="font-size:16px;color:#8E8E8E;">
        Gérez votre activité de psychologue en toute sérénité.
    </span>

    {# 2×2 cards grid #}
    <div style="display:grid;grid-template-columns:330px 330px;gap:30px;">

        {# Card 1 — Cabinet #}
        <a href="{{ path('app_cabinet') }}" style="text-decoration:none; color:inherit; display:block;">
            <div style="background:white;border-radius:15px;padding:20px;height:100%;min-height:150px;
                        box-shadow:0 4px 10px rgba(0,0,0,0.08);cursor:pointer;
                        display:flex;flex-direction:column;gap:15px;box-sizing:border-box;">
                <div style="display:flex;align-items:center;gap:12px;">
                    <div style="width:40px;height:40px;background:rgba(111,191,155,0.15);
                                 border-radius:10px;display:flex;align-items:center;
                                 justify-content:center;font-size:18px;flex-shrink:0;">🏢</div>
                    <span style="font-size:18px;font-weight:700;color:#2C3E50;">Gérer mon Cabinet</span>
                </div>
                <span style="color:#8E8E8E;font-size:14px;line-height:1.5;">
                    Ajouter ou modifier les informations de votre cabinet
                </span>
            </div>
        </a>

        {# Card 2 — Créneaux #}
        <div style="background:white;border-radius:15px;padding:20px;min-height:150px;
                    box-shadow:0 4px 10px rgba(0,0,0,0.08);cursor:pointer;
                    display:flex;flex-direction:column;gap:15px;">
            <div style="display:flex;align-items:center;gap:12px;">
                <div style="width:40px;height:40px;background:rgba(111,191,155,0.15);
                             border-radius:10px;display:flex;align-items:center;
                             justify-content:center;font-size:18px;flex-shrink:0;">📅</div>
                <span style="font-size:18px;font-weight:700;color:#2C3E50;">Gérer mes Créneaux</span>
            </div>
            <span style="color:#8E8E8E;font-size:14px;line-height:1.5;">
                Planifier et organiser vos disponibilités
            </span>
        </div>

        {# Card 3 — Réservations #}
        <div style="background:white;border-radius:15px;padding:20px;min-height:150px;
                    box-shadow:0 4px 10px rgba(0,0,0,0.08);cursor:pointer;
                    display:flex;flex-direction:column;gap:15px;">
            <div style="display:flex;align-items:center;gap:12px;">
                <div style="width:40px;height:40px;background:rgba(111,191,155,0.15);
                             border-radius:10px;display:flex;align-items:center;
                             justify-content:center;font-size:18px;flex-shrink:0;">📋</div>
                <span style="font-size:18px;font-weight:700;color:#2C3E50;">Voir mes Réservations</span>
            </div>
            <span style="color:#8E8E8E;font-size:14px;line-height:1.5;">
                Consulter les rendez-vous à venir
            </span>
        </div>

        {# Card 4 — Tests #}
        <div style="background:white;border-radius:15px;padding:20px;min-height:150px;
                    box-shadow:0 4px 10px rgba(0,0,0,0.08);cursor:pointer;
                    display:flex;flex-direction:column;gap:15px;">
            <div style="display:flex;align-items:center;gap:12px;">
                <div style="width:40px;height:40px;background:rgba(111,191,155,0.15);
                             border-radius:10px;display:flex;align-items:center;
                             justify-content:center;font-size:18px;flex-shrink:0;">📝</div>
                <span style="font-size:18px;font-weight:700;color:#2C3E50;">Gérer Tests Autoévaluation</span>
            </div>
            <span style="color:#8E8E8E;font-size:14px;line-height:1.5;">
                Créer et gérer vos tests pour patients
            </span>
        </div>

    </div>
</div>

{% endblock %}
