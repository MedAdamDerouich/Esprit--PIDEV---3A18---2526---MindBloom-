                    </div>

                    <div class="col-md-6">
                        <div class="auth-field" style="margin-bottom:0;">
                            <label>Date de naissance <span style="color:#f87171;">*</span></label>
                            {{ form_widget(registrationForm.dateOfBirth, {
                                'attr': {'class': 'auth-input'}
                            }) }}
                            {{ form_errors(registrationForm.dateOfBirth) }}
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="auth-field" style="margin-bottom:0;">
                            <label>Adresse</label>
                            {{ form_widget(registrationForm.address, {
                                'attr': {'class': 'auth-input', 'placeholder': 'Votre adresse'}
                            }) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="auth-field" style="margin-bottom:0;">
                            <label>Mot de passe <span style="color:#f87171;">*</span></label>
