{% extends 'base.html.twig' %}

{% block title %}Mes Réservations — MindBloom{% endblock %}

{% block body %}


<div style="background:#FAFAF8; min-height:calc(100vh - 80px); padding:40px 0; display:flex; flex-direction:column; align-items:center;">
    
    <!-- TITRE ET FILTRAGE -->
    <div style="text-align:center; margin-bottom:30px;">
        <h1 style="margin:0; font-size:28px; font-weight:bold; color:#333333; display:inline-block;">Mes </h1>
        <h1 style="margin:0; font-size:28px; font-weight:bold; color:#4A90E2; display:inline-block;">Réservations</h1>
        <p style="color:#777777; font-size:14px; margin-top:10px;">Retrouvez l'ensemble de vos rendez-vous.</p>

        <!-- BOUTONS DE FILTRAGE -->
        <div style="display:flex; justify-content:center; gap:10px; margin-top:20px;" id="filterButtons">
            <button class="filter-btn active" data-filter="tous" style="background:#4A90E2; color:white; border:none; border-radius:20px; font-size:13px; padding:8px 20px; cursor:pointer; transition:0.2s;">Tous</button>
            <button class="filter-btn" data-filter="passees" style="background:#E0E0E0; color:#333333; border:none; border-radius:20px; font-size:13px; padding:8px 20px; cursor:pointer; transition:0.2s;">Passés</button>
            <button class="filter-btn" data-filter="confirmes" style="background:#E0E0E0; color:#333333; border:none; border-radius:20px; font-size:13px; padding:8px 20px; cursor:pointer; transition:0.2s;">Confirmés</button>
            <button class="filter-btn" data-filter="annules" style="background:#E0E0E0; color:#333333; border:none; border-radius:20px; font-size:13px; padding:8px 20px; cursor:pointer; transition:0.2s;">Annulés</button>
        </div>
    </div>

    <!-- CUSTOM MODAL OVERLAY -->
    <div id="customModalOverlay" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center; backdrop-filter:blur(3px);">
        <div style="background:white; border-radius:20px; padding:30px; width:400px; text-align:center; box-shadow:0 25px 50px rgba(0,0,0,0.15); transform:scale(0.9); opacity:0; transition:all 0.3s; animation: modalPop 0.3s forwards;">
            
            <style>
                @keyframes modalPop {
                    to { transform:scale(1); opacity:1; }
                }
            </style>
            
            <!-- Icons -->
            <div id="modalIconWarning" style="display:none; font-size:45px; margin-bottom:10px;">⚠️</div>
            <div id="modalIconError" style="display:none; font-size:45px; margin-bottom:10px;">❌</div>
            <div id="modalIconSuccess" style="display:none; font-size:45px; margin-bottom:10px;">✅</div>
            
            <h3 id="modalTitle" style="color:#2D3748; margin-top:0; font-weight:bold; font-size:22px;">Confirmation</h3>
            <p id="modalMessage" style="color:#718096; font-size:15px; line-height:1.5; margin-bottom:25px;">Message ici</p>
            
            <div style="display:flex; justify-content:center; gap:15px;">
                <button type="button" id="modalBtnCancel" style="display:none; background:#E2E8F0; color:#4A5568; border:none; padding:12px 25px; border-radius:12px; font-size:14px; font-weight:bold; cursor:pointer; transition:background 0.2s;" onmouseover="this.style.background='#CBD5E0'" onmouseout="this.style.background='#E2E8F0'">Annuler</button>
                <button type="button" id="modalBtnConfirm" style="background:#4A90E2; color:white; border:none; padding:12px 25px; border-radius:12px; font-size:14px; font-weight:bold; cursor:pointer; transition:background 0.2s;" onmouseover="this.style.background='#3182CE'" onmouseout="this.style.background='#4A90E2'">Compris</button>
            </div>
        </div>
    </div>
    <!-- LISTE DES RESERVATIONS -->
    <div id="reservationsContainer" style="display:flex; flex-direction:column; gap:20px; width:100%; max-width:850px;">
        {% if reservations is empty %}
            <div style="text-align:center; color:#999; font-size:16px; padding:50px;">
                Aucune réservation trouvée.
            </div>
        {% else %}
            {% set now = date() %}
            {% for r in reservations %}
                
                {% set dateCreneau = r.creneau.dateCreneau|date('Y-m-d') %}
                {% set today = now|date('Y-m-d') %}
                {% set timeCreneau = r.creneau.heureDebut|date('H:i') %}
                {% set currTime = now|date('H:i') %}

                {% set isPast = (dateCreneau < today) or (dateCreneau == today and timeCreneau < currTime) %}
                
                {% set statusCat = 'tous ' %}
                {% if isPast %}
                    {% set statusCat = statusCat ~ 'passees ' %}
                {% elseif r.status.value == 'Confirmé' %}
                    {% set statusCat = statusCat ~ 'confirmes ' %}
                {% else %}
                    {% set statusCat = statusCat ~ 'annules ' %}
                {% endif %}

                <div class="reservation-card {{ statusCat }}" style="background:white; border-radius:10px; box-shadow:0 4px 8px rgba(0,0,0,0.05); padding:10px 15px; display:flex; align-items:center; gap:15px; transition:transform 0.2s;">
                    
                    {# Photo Psychologue #}
                    <div style="width:60px; height:60px; border-radius:50%; background:#E2E8F0; overflow:hidden; flex-shrink:0;">
                        {% if r.creneau.cabinet.psychologue and r.creneau.cabinet.psychologue.profileImage %}
                            <img src="{{ asset('uploads/profiles/' ~ r.creneau.cabinet.psychologue.profileImage) }}" style="width:100%; height:100%; object-fit:cover;" />
                        {% else %}
                            <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:22px; color:rgba(74,144,226,0.3);">👤</div>
                        {% endif %}
                    </div>

                    {# Infos #}
                    <div style="flex:1; display:flex; flex-direction:column; gap:4px;">
                        
                        {# Header info #}
                        <div style="display:flex; align-items:center; gap:10px;">
                            <span style="font-size:16px; font-weight:bold; color:#333;">Dr. {{ r.creneau.cabinet.psychologue.fullName|default('Inconnu') }}</span>
                            
                            {% if isPast %}
                                <span style="font-size:11px; color:#666; background:#E0E0E0; padding:2px 8px; border-radius:10px;">📅 Passée</span>
                            {% elseif r.status.value == 'Confirmé' %}
                                <span style="font-size:11px; color:#5FBF9F; background:#E8F5E9; padding:2px 8px; border-radius:10px;">Confirmé</span>
                            {% else %}
                                <span style="font-size:11px; color:#FF4D4D; background:#FFE5E5; padding:2px 8px; border-radius:10px;">Annulé</span>
                            {% endif %}
                        </div>

                        {# Details #}
                        <span style="color:#888; font-size:13px;">{{ r.creneau.cabinet.specialite|default('Spécialité non définie') }}</span>
                        <span style="color:#666; font-size:12px;">🏥 {{ r.creneau.cabinet.adresse|default('Adresse non définie') }}</span>
                        <span id="distance-{{ r.idReservation }}"
      data-adresse="{{ r.creneau.cabinet.adresse|e('html_attr') }}"
      style="font-size:12px; color:#A0AEC0; display:none;">
</span>
                        {# Date & Heure #}
                        <div style="display:flex; gap:8px; margin-top:2px;">
                            <span style="background:#F0F7FF; color:#4A90E2; padding:3px 8px; border-radius:5px; font-size:12px;">📅 {{ r.creneau.dateCreneau|date('d/m/Y') }}</span>
                            <span style="background:#F0F7FF; color:#4A90E2; padding:3px 8px; border-radius:5px; font-size:12px;">🕒 {{ r.creneau.heureDebut|date('H:i') }}</span>
                        </div>
                    </div>

                    {# Actions #}
                    <div style="display:flex; align-items:center; gap:6px;">
                        
                        {# Boutons Toggle (Reconfirmer/Annuler) - seulement si ce n'est pas passé #}
                        {% if not isPast %}
                            <form action="{{ path('app_patient_reservations_toggle', {id: r.idReservation}) }}" method="post" style="margin:0;">
                                {% if r.status.value == 'Confirmé' %}
                                    <button type="button" class="btn-confirm-action" 
                                            data-title="Confirmation d'annulation"
                                            data-confirm="Êtes-vous sûr de vouloir annuler cette réservation ? Le créneau deviendra disponible pour d'autres patients." 
                                            data-btn="Oui, annuler"
                                            data-color="#FF4D4D"
                                            style="background:#FF4D4D; color:white; border-radius:8px; font-weight:600; font-size:12px; padding:6px 12px; border:none; cursor:pointer; min-width:85px; transition:0.2s;" onmouseover="this.style.opacity=0.8" onmouseout="this.style.opacity=1">Annuler</button>
                                {% else %}
                                    {% if r.creneau.isDisponible %}
                                        <button type="button" class="btn-confirm-action" 
                                                data-title="Reprise de rendez-vous"
                                                data-confirm="Voulez-vous reconfirmer ce créneau ? Assurez-vous d'être disponible." 
                                                data-btn="Oui, reconfirmer"
                                                data-color="#5FBF9F"
                                                style="background:#5FBF9F; color:white; border-radius:8px; font-weight:600; font-size:12px; padding:6px 12px; border:none; cursor:pointer; min-width:85px; transition:0.2s;" onmouseover="this.style.opacity=0.8" onmouseout="this.style.opacity=1">Reconfirmer</button>
                                    {% else %}
                                        <button type="button" onclick="window.showConfirmation(document.getElementById('delete-form-{{ r.idReservation }}'), 'Créneau indisponible', 'Désolé, ce créneau a déjà été réservé par un autre patient.\n\nVoulez-vous le supprimer de vos réservations ?', 'Oui, supprimer', '#FF4D4D')" 
                                                style="background:#5FBF9F; color:white; border-radius:8px; font-weight:600; font-size:12px; padding:6px 12px; border:none; cursor:pointer; min-width:85px; transition:0.2s;" onmouseover="this.style.opacity=0.8" onmouseout="this.style.opacity=1">Reconfirmer</button>
                                    {% endif %}
                                {% endif %}
                            </form>
                        {% endif %}

                        {# Bouton Supprimer (Corbeille) - seulement si annulé #}
                        {% if r.status.value == 'Annulé' %}
                            <form id="delete-form-{{ r.idReservation }}" action="{{ path('app_patient_reservations_delete', {id: r.idReservation}) }}" method="post" style="margin:0;" title="Supprimer de l'historique">
                                <button type="button" class="btn-confirm-action" 
                                        data-title="Suppression définitive"
                                        data-confirm="Voulez-vous supprimer définitivement cette réservation de vos réservations  ?" 
                                        data-btn="Oui, supprimer"
                                        data-color="#EF4444"
                                        style="background:transparent; color:#EF4444; border-radius:5px; display:flex; align-items:center; justify-content:center; width:26px; height:26px; border:1px solid #EF4444; cursor:pointer; transition:0.2s;" onmouseover="this.style.background='#FFE5E5'" onmouseout="this.style.background='transparent'">
                                    <span style="font-size:14px; font-weight:bold; pointer-events:none;">✕</span>
                                </button>
                            </form>
                        {% endif %}

                    </div>

                </div>
            {% endfor %}
        {% endif %}
    </div>
</div>

<style>
    .reservation-card:hover {
        transform: scale(1.02);
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    
    // --- FILTRAGE DES CATEGORIES ---
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.reservation-card');

    const countTotal = cards.length;
    let countPassees = 0;
    let countConfirmes = 0;
    let countAnnules = 0;

    cards.forEach(card => {
        if (card.classList.contains('passees')) countPassees++;
        if (card.classList.contains('confirmes')) countConfirmes++;
        if (card.classList.contains('annules')) countAnnules++;
    });

    document.querySelector('[data-filter="tous"]').innerText = `Tous (${countTotal})`;
    document.querySelector('[data-filter="passees"]').innerText = `Passés (${countPassees})`;
    document.querySelector('[data-filter="confirmes"]').innerText = `Confirmés (${countConfirmes})`;
    document.querySelector('[data-filter="annules"]').innerText = `Annulés (${countAnnules})`;

    filterBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            filterBtns.forEach(b => {
                b.style.background = '#E0E0E0';
                b.style.color = '#333333';
                b.classList.remove('active');
            });
            this.style.background = '#4A90E2';
            this.style.color = 'white';
            this.classList.add('active');

            const filter = this.getAttribute('data-filter');
            cards.forEach(card => {
                if (filter === 'tous') {
                    card.style.display = 'flex';
                } else {
                    card.style.display = card.classList.contains(filter) ? 'flex' : 'none';
                }
            });
        });
    });

    // --- MODAL & MESSAGES CONFIGURATION ---
    const customModal = document.getElementById('customModalOverlay');
    const modalTitle = document.getElementById('modalTitle');
    const modalMessage = document.getElementById('modalMessage');
    const btnCancel = document.getElementById('modalBtnCancel');
    const btnConfirm = document.getElementById('modalBtnConfirm');
    const iconWarning = document.getElementById('modalIconWarning');
    const iconError = document.getElementById('modalIconError');
    const iconSuccess = document.getElementById('modalIconSuccess');
    
    let pendingFormSubmit = null;

    function showConfirmation(formElement, title, message, btnText, color) {
        iconWarning.style.display = 'block';
        iconError.style.display = 'none';
        iconSuccess.style.display = 'none';
        
        modalTitle.innerText = title;
        modalMessage.innerText = message;
        
        btnCancel.style.display = 'block';
        btnConfirm.innerText = btnText;
        btnConfirm.style.background = color;
        
        // Darken color slightly on hover by adjusting opacity styling inline
        btnConfirm.onmouseover = () => btnConfirm.style.opacity = '0.8';
        btnConfirm.onmouseout = () => btnConfirm.style.opacity = '1';
        
        pendingFormSubmit = formElement;
        customModal.style.display = 'flex';
    }

    function showAlert(title, message, type) {
        iconWarning.style.display = type === 'warning' ? 'block' : 'none';
        iconError.style.display = type === 'error' ? 'block' : 'none';
        iconSuccess.style.display = type === 'success' ? 'block' : 'none';
        
        modalTitle.innerText = title;
        modalMessage.innerText = message;
        
        btnCancel.style.display = 'none';
        btnConfirm.innerText = 'Compris';
        
        if (type === 'error') {
            btnConfirm.style.background = '#FF4D4D';
        } else if (type === 'success') {
            btnConfirm.style.background = '#5FBF9F';
        } else {
            btnConfirm.style.background = '#4A90E2';
        }
        
        btnConfirm.onmouseover = () => btnConfirm.style.opacity = '0.8';
        btnConfirm.onmouseout = () => btnConfirm.style.opacity = '1';
        
        pendingFormSubmit = null;
        customModal.style.display = 'flex';
    }
    
    // Expose to global scope for inline onclick usage
    window.showAlert = showAlert;
    window.showConfirmation = showConfirmation;

    btnCancel.addEventListener('click', () => {
        customModal.style.display = 'none';
        pendingFormSubmit = null;
    });

    btnConfirm.addEventListener('click', () => {
        if (pendingFormSubmit) {
            pendingFormSubmit.submit();
        } else {
            customModal.style.display = 'none';
        }
    });

    // Hijack the data-confirm actions natively from buttons
    document.querySelectorAll('.btn-confirm-action').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const formObj = this.closest('form');
            const cTitle = this.getAttribute('data-title') || 'Confirmation';
            const cMsg = this.getAttribute('data-confirm');
            const cBtn = this.getAttribute('data-btn') || 'Oui';
            const cCol = this.getAttribute('data-color') || '#FF4D4D';
            
            showConfirmation(formObj, cTitle, cMsg, cBtn, cCol);
        });
    });

    // Server Flashes Display
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            {% if label == 'error' %}
                showAlert('Erreur de réservation', '{{ message|e('js') }}', 'error');
            {% elseif label == 'success' %}
                showAlert('Action réussie', '{{ message|e('js') }}', 'success');
            {% else %}
                showAlert('Information', '{{ message|e('js') }}', 'warning');
            {% endif %}
        {% endfor %}
    {% endfor %}
});


// --- GÉOLOCALISATION & DISTANCE ---
function haversineDistance(lat1, lng1, lat2, lng2) {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLng = (lng2 - lng1) * Math.PI / 180;
    const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
              Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
              Math.sin(dLng/2) * Math.sin(dLng/2);
    return Math.round(6371 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a)) * 10) / 10;
}

async function geocodeAdresse(adresse) {
    const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(adresse)}&limit=1`;
    try {
        const response = await fetch(url);
        const data = await response.json();
        if (data && data.length > 0) {
            return { lat: parseFloat(data[0].lat), lng: parseFloat(data[0].lon) };
        }
    } catch (e) {}
    return null;
}

async function calculateDistances(userLat, userLng) {
    const distanceSpans = document.querySelectorAll('[id^="distance-"]');
    for (const span of distanceSpans) {
        const adresse = span.getAttribute('data-adresse');
        const coords = await geocodeAdresse(adresse);
        if (coords) {
            const dist = haversineDistance(userLat, userLng, coords.lat, coords.lng);
            span.textContent = `📍 ${dist} km de vous`;
            span.style.display = 'inline';
        }
    }
}

if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(
        function(position) {
            calculateDistances(position.coords.latitude, position.coords.longitude);
        },
        function() {
            calculateDistances(36.8065, 10.1815);
        }
    );
} else {
    calculateDistances(36.8065, 10.1815);
}

</script>
{% endblock %}
