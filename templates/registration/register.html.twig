                  <g class="plant-group">
                    {# Two stems — symmetrical #}
                    <path class="stem-path" d="M150 305 C150 285 145 260 148 240 C151 220 147 200 150 175 C153 150 148 130 150 110"
                          stroke="url(#rStemGrad)" stroke-width="3.5" stroke-linecap="round"/>
                    <path class="stem-path" d="M150 230 C136 218 118 210 100 198 C82 186 68 178 56 164"
                          stroke="url(#rStemGrad)" stroke-width="2.5" stroke-linecap="round"/>
                    <path class="stem-path" d="M150 210 C164 198 182 192 200 180 C218 168 232 160 244 148"
                          stroke="url(#rStemGrad)" stroke-width="2.5" stroke-linecap="round"/>
                    <path class="stem-path" d="M149 162 C135 152 116 145 98 133 C80 121 68 113 56 100"
