{% extends 'admin/base.html.twig' %}

{% block title %}Analyse Marketing - MindBloom Admin{% endblock %}

{% block admin_header %}
    <div class="d-flex align-items-center justify-content-between w-100">
        <div>
            <i class="bi bi-brain me-2"></i> Analyse Marketing IA (Groq)
        </div>
        <a href="{{ path('app_admin_produit_index') }}" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Retour aux produits
        </a>
    </div>
{% endblock %}

{% block admin_content %}
<div class="container-fluid py-4">
    <!-- Analysis Meta -->
    <div class="alert alert-info border-0 shadow-sm rounded-4 d-flex align-items-center mb-4">
        <div class="bg-info bg-opacity-10 p-3 rounded-3 me-3 text-info">
            <i class="bi bi-info-circle-fill fs-4"></i>
        </div>
        <div>
            <h6 class="mb-1 fw-bold">Rapport d'Analyse Intelligente</h6>
            <p class="mb-0 small">Cette analyse se base sur les <strong>{{ totalFeedbacks }}</strong> derniers avis clients pour identifier les tendances et les points d'amélioration.</p>
        </div>
    </div>

    <!-- KPI Row -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4">
                <h6 class="text-muted text-uppercase small fw-bold mb-2">Note Moyenne</h6>
                <div class="d-flex align-items-center justify-content-center">
                    <h2 class="mb-0 fw-bold text-warning">{{ avgNote }}</h2>
                    <span class="ms-2 fs-4 text-warning">/ 5</span>
                </div>
                <div class="mt-2 text-warning">
                    {% for i in 1..5 %}
                        <i class="bi bi-star{{ i <= avgNote ? '-fill' : (i - 0.5 <= avgNote ? '-half' : '') }}"></i>
                    {% endfor %}
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4">
                <h6 class="text-muted text-uppercase small fw-bold mb-2">Satisfaction Globale</h6>
                {% set sent = analysis.sentimentScore|default({'positif': 0, 'neutre': 0, 'negatif': 0}) %}
                {% set totalSent = sent.positif + sent.neutre + sent.negatif %}
                {% set satRate = totalSent > 0 ? (sent.positif / totalSent * 100)|round : 0 %}
                <h2 class="mb-0 fw-bold text-success">{{ satRate }}%</h2>
                <div class="progress mt-3" style="height: 8px;">
                    <div class="progress-bar bg-success" style="width: {{ satRate }}%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4">
                <h6 class="text-muted text-uppercase small fw-bold mb-2">Tendance Sentiments</h6>
                <div class="d-flex justify-content-around mt-2">
                    <div>
                        <div class="fw-bold text-success">{{ sent.positif }}</div>
                        <div class="small text-muted">Positifs</div>
                    </div>
                    <div>
                        <div class="fw-bold text-secondary">{{ sent.neutre }}</div>
                        <div class="small text-muted">Neutres</div>
                    </div>
                    <div>
                        <div class="fw-bold text-danger">{{ sent.negatif }}</div>
                        <div class="small text-muted">Négatifs</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Horizontal Bars: Points Forts & Problèmes -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h5 class="card-title mb-0 fw-bold text-success"><i class="bi bi-check-circle-fill me-2"></i>Points Forts Dominants</h5>
                </div>
                <div class="card-body px-4 pb-4">
                    {% for theme, count in analysis.pointsForts|default({}) %}
                        <div class="mb-4">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-bold">{{ theme }}</span>
                                <span class="text-muted small">{{ count }} mentions</span>
                            </div>
                            <div class="progress" style="height: 12px; background-color: #f0f7f0;">
                                {% set pcent = totalFeedbacks > 0 ? (count / totalFeedbacks * 100) : 0 %}
                                <div class="progress-bar bg-success rounded-pill" style="width: {{ pcent }}%"></div>
                            </div>
                        </div>
                    {% else %}
                        <p class="text-muted text-center py-4">Pas de données suffisantes.</p>
                    {% endfor %}
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h5 class="card-title mb-0 fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Problèmes Récurrents</h5>
                </div>
                <div class="card-body px-4 pb-4">
                    {% for theme, count in analysis.problemes|default({}) %}
                        <div class="mb-4">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-bold">{{ theme }}</span>
                                <span class="text-muted small">{{ count }} mentions</span>
                            </div>
                            <div class="progress" style="height: 12px; background-color: #fdf2f2;">
                                {% set pcent = totalFeedbacks > 0 ? (count / totalFeedbacks * 100) : 0 %}
                                <div class="progress-bar bg-danger rounded-pill" style="width: {{ pcent }}%"></div>
                            </div>
                        </div>
                    {% else %}
                        <p class="text-muted text-center py-4">Félicitations ! Aucun problème récurrent majeur détecté.</p>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- Synthèse IA & Pie Chart -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary text-white overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <i class="bi bi-quote position-absolute top-0 end-0 opacity-25" style="font-size: 60px; transform: translate(-10px, 10px);"></i>
                    <h5 class="fw-bold mb-3">Synthèse IA Groq</h5>
                    <p class="mb-0" style="font-size: 15px; line-height: 1.6; font-style: italic;">
                        "{{ analysis.synthèse|default('En attente de plus de données pour générer une synthèse pertinente.') }}"
                    </p>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 py-3 px-4 text-center">
                    <h5 class="card-title mb-0 fw-bold">Répartition Sentiments</h5>
                </div>
                <div class="card-body p-4">
                    <canvas id="sentimentPie" style="height: 250px;"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const ctxPie = document.getElementById('sentimentPie').getContext('2d');
    new Chart(ctxPie, {
        type: 'pie',
        data: {
            labels: ['Positifs', 'Neutres', 'Négatifs'],
            datasets: [{
                data: [{{ sent.positif }}, {{ sent.neutre }}, {{ sent.negatif }}],
                backgroundColor: ['#28a745', '#6c757d', '#dc3545'],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });
});
</script>
{% endblock %}
