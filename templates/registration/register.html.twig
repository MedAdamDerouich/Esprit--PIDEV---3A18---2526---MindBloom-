            </p>
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function selectRole(role, el) {
    document.querySelectorAll('.auth-role').forEach(function(o) { o.classList.remove('selected'); });
    el.classList.add('selected');
    var roleField = document.getElementById('roleInput')
        || document.querySelector('input[name="registration_form[roles]"]');
    if (roleField) roleField.value = role;
}

document.addEventListener('DOMContentLoaded', function () {
    var passwordField = document.querySelector('input[name="registration_form[plainPassword][first]"]');
    var confirmField  = document.querySelector('input[name="registration_form[plainPassword][second]"]');
    var strengthBar   = document.getElementById('password-strength-bar');
    var strengthText  = document.getElementById('password-strength-text');
    var matchText     = document.getElementById('password-match-text');

    function checkStrength(p) {
        var s = 0, c = {
            len: p.length >= 8, lower: /[a-z]/.test(p),
            upper: /[A-Z]/.test(p), num: /\d/.test(p),
            special: /[!@#$%^&*(),.?":{}|<>]/.test(p), long: p.length >= 12
        };
        Object.values(c).forEach(function(v) { if (v) s++; });
        return { score: s, checks: c };
    }

    function updateStrength(p) {
        if (!strengthBar || !strengthText) return;
        if (!p) { strengthBar.style.width = '0%'; strengthText.textContent = ''; return; }
        var r = checkStrength(p);
        var width, color, label;
        if (r.score <= 2)      { width='33%';  color='#f87171'; label='Faible'; }
        else if (r.score <= 4) { width='66%';  color='#fb923c'; label='Moyen'; }
        else                   { width='100%'; color='#4ab464'; label='Fort ✓'; }
        strengthBar.style.width = width;
        strengthBar.style.backgroundColor = color;
        strengthText.style.color = color;
        var tips = [];
        if (!r.checks.len)     tips.push('8+ caractères');
        if (!r.checks.upper)   tips.push('majuscule');
        if (!r.checks.num)     tips.push('chiffre');
        if (!r.checks.special) tips.push('caractère spécial');
        strengthText.textContent = label + (tips.length && r.score < 5 ? ' — Manque: ' + tips.slice(0,2).join(', ') : '');
    }

    function checkMatch() {
        if (!passwordField || !confirmField || !matchText) return;
        if (!confirmField.value) { matchText.textContent = ''; return; }
        if (passwordField.value === confirmField.value) {
            matchText.textContent = '✓ Les mots de passe correspondent';
            matchText.style.color = '#4ab464';
        } else {
            matchText.textContent = '✗ Les mots de passe ne correspondent pas';
            matchText.style.color = '#f87171';
        }
    }

    if (passwordField) {
        passwordField.addEventListener('input', function () { updateStrength(this.value); checkMatch(); });
    }
    if (confirmField) {
        confirmField.addEventListener('input', checkMatch);
    }
});
</script>

<script>
(function () {
    'use strict';
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.body.classList.add('auth-ready');
    if (reduced) return;

    /* Card 3D tilt (gentler for wider card) */
    var card = document.querySelector('.auth-card');
    if (card) {
        card.addEventListener('mousemove', function (e) {
            var r = card.getBoundingClientRect();
            var nx = ((e.clientX - r.left) / r.width)  * 2 - 1;
            var ny = ((e.clientY - r.top)  / r.height) * 2 - 1;
            card.style.transition = 'transform 0.08s ease-out, box-shadow 0.15s';
            card.style.transform  = 'perspective(1100px) rotateX(' + (-ny * 2.5) + 'deg) rotateY(' + (nx * 2.5) + 'deg)';
        });
        card.addEventListener('mouseleave', function () {
            card.style.transition = 'transform 0.5s cubic-bezier(0.22,1,0.36,1), box-shadow 0.3s';
            card.style.transform  = 'perspective(1100px) rotateX(0deg) rotateY(0deg)';
        });
    }

    /* Botanical parallax */
    var leftPanel = document.querySelector('.auth-panel-left');
    var plantGrp  = document.querySelector('.plant-group');
    if (leftPanel && plantGrp) {
        leftPanel.addEventListener('mousemove', function (e) {
            var r = leftPanel.getBoundingClientRect();
            var nx = ((e.clientX - r.left) / r.width)  * 2 - 1;
            var ny = ((e.clientY - r.top)  / r.height) * 2 - 1;
            plantGrp.style.transform  = 'rotate(' + (nx * 2.5) + 'deg) translateY(' + (ny * -8) + 'px)';
            plantGrp.style.transition = 'transform 0.3s ease-out';
        });
        leftPanel.addEventListener('mouseleave', function () {
            plantGrp.style.transform  = '';
            plantGrp.style.transition = 'transform 0.8s cubic-bezier(0.22,1,0.36,1)';
        });
    }

    /* Input icon brightens when filled */
    document.querySelectorAll('.auth-input').forEach(function (input) {
        input.addEventListener('input', function () {
            var icon = this.parentElement.querySelector('.auth-input-icon');
            if (icon) icon.style.color = this.value.length > 0 ? 'rgba(74,180,100,0.8)' : 'rgba(74,180,100,0.4)';
        });
    });
})();
</script>
{% endblock %}
