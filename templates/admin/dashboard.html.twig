{% extends 'base.html.twig' %}
{% block title %}Tableau de bord — MindBloom{% endblock %}

{% block stylesheets %}
<style>
/* ── Top bar ── */
.dash-topbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 1px solid #EFEFEF;
}
.dash-topbar h1 {
    font-size: 22px;
    font-weight: 700;
    color: #1a1a2e;
    margin: 0 0 4px;
}
.dash-topbar .date {
    font-size: 12px;
    color: #aaa;
    font-weight: 400;
}
.dash-topbar .admin-info {
    display: flex;
    align-items: center;
    gap: 10px;
}
.dash-topbar .admin-info .name {
    font-size: 13px;
    font-weight: 600;
    color: #333;
    text-align: right;
}
.dash-topbar .admin-info .role {
    font-size: 11px;
    color: #aaa;
    text-align: right;
}

/* ── Numbers strip ── */
.numbers-strip {
    display: flex;
    background: white;
    border: 1px solid #EFEFEF;
    border-radius: 10px;
    margin-bottom: 28px;
    overflow: hidden;
}
.num-block {
    flex: 1;
    padding: 22px 28px;
    border-right: 1px solid #F3F3F3;
}
.num-block:last-child { border-right: none; }
.num-block .n {
    font-size: 32px;
    font-weight: 800;
    color: #1a1a2e;
    line-height: 1;
    margin-bottom: 6px;
}
.num-block .l {
    font-size: 12px;
    color: #999;
}
.num-block .n.green  { color: #27ae60; }
.num-block .n.blue   { color: #4A90E2; }
.num-block .n.teal   { color: #5FBF9F; }
.num-block .n.orange { color: #E67E22; }

/* ── Module stat cards ── */
.module-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 28px;
}
.mod-card {
    background: white;
    border: 1px solid #EFEFEF;
    border-radius: 12px;
    padding: 20px 22px;
    display: flex;
    align-items: center;
    gap: 16px;
    transition: box-shadow 0.2s, transform 0.2s;
    text-decoration: none;
}
.mod-card:hover {
    box-shadow: 0 6px 20px rgba(0,0,0,0.07);
    transform: translateY(-2px);
}
.mod-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
}
.mod-body .mod-count {
    font-size: 26px;
    font-weight: 800;
    color: #1a1a2e;
    line-height: 1;
    margin-bottom: 4px;
}
.mod-body .mod-label {
    font-size: 12px;
    color: #999;
    font-weight: 500;
}

/* ── Middle columns ── */
.mid-right {
    background: white;
    border: 1px solid #EFEFEF;
    border-radius: 10px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

/* ── Role bars ── */
.role-bar-row { display: flex; flex-direction: column; gap: 4px; }
.role-bar-row .rb-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
}
.role-bar-row .rb-name { font-size: 13px; color: #444; font-weight: 500; }
.role-bar-row .rb-count { font-size: 13px; font-weight: 700; color: #1a1a2e; }
.role-bar-track {
    height: 6px;
    background: #F3F3F3;
    border-radius: 10px;
    overflow: hidden;
}
.role-bar-fill {
    height: 100%;
    border-radius: 10px;
    transition: width 1s ease;
}

/* ── Recent users table ── */
.recent-wrap {
    background: white;
    border: 1px solid #EFEFEF;
    border-radius: 10px;
    overflow: hidden;
    margin-top: 28px;
}
.recent-wrap .rw-header {
    padding: 16px 24px;
    border-bottom: 1px solid #F3F3F3;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.recent-wrap .rw-header h6 {
    font-size: 13px;
    font-weight: 600;
    color: #333;
    margin: 0;
}
.recent-wrap .rw-header a {
    font-size: 12px;
    color: #4A90E2;
    text-decoration: none;
}
.rw-table { width: 100%; border-collapse: collapse; }
.rw-table thead th {
    padding: 10px 24px;
    font-size: 11px;
    font-weight: 600;
    color: #bbb;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: #FAFAFA;
    border-bottom: 1px solid #F3F3F3;
    text-align: left;
}
.rw-table tbody td {
    padding: 14px 24px;
    font-size: 13px;
    color: #444;
    border-bottom: 1px solid #F9F9F9;
    vertical-align: middle;
}
.rw-table tbody tr:last-child td { border-bottom: none; }
.rw-table tbody tr:hover td { background: #FAFCFF; }
.rw-table tbody tr.clickable-row { cursor: pointer; }
.rw-table tbody tr.clickable-row:focus td { background: #FAFCFF; }

.u-name { font-weight: 600; color: #1a1a2e; font-size: 13px; }
.u-username { font-size: 11px; color: #bbb; }

/* status pill — simple text, no bold background */
.pill {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
}
.pill-green  { background: #eafaf1; color: #27ae60; }
.pill-grey   { background: #F3F3F3; color: #999; }
.pill-blue   { background: #eaf2fb; color: #4A90E2; }
.pill-teal   { background: #eafaf5; color: #5FBF9F; }
.pill-red    { background: #fdecea; color: #e74c3c; }

.edit-link {
    font-size: 12px;
    color: #4A90E2;
    text-decoration: none;
    padding: 4px 12px;
    border: 1px solid #d4e8f7;
    border-radius: 6px;
}
.edit-link:hover { background: #eaf2fb; }
</style>
{% endblock %}

{% block body %}
<div class="d-flex">
    {{ include('admin/_sidebar.html.twig') }}

    <div class="admin-content" style="flex:1;">

        {# Top bar #}
        <div class="dash-topbar">
            <div>
                <h1>Tableau de bord</h1>
                <span class="date">{{ "now"|date("d/m/Y") }}</span>
            </div>
            <div class="admin-info">
                <div>
                    <div class="name">{{ app.user.fullName }}</div>
                    <div class="role">Administrateur</div>
                </div>
                <div class="mb-avatar" style="width:38px;height:38px;font-size:14px;">
                    {% if app.user.profileImage %}
                        <img src="{{ asset('uploads/profiles/' ~ app.user.profileImage) }}" alt="">
                    {% else %}
                        {{ app.user.fullName|first|upper }}
                    {% endif %}
                </div>
            </div>
        </div>

        {# Numbers strip #}
        <div class="numbers-strip">
            <div class="num-block">
                <div class="n">{{ stats.users }}</div>
                <div class="l">Utilisateurs au total</div>
            </div>
            <div class="num-block">
                <div class="n green">{{ stats.active }}</div>
                <div class="l">Comptes actifs</div>
            </div>
            <div class="num-block">
                <div class="n blue">{{ stats.psychologues }}</div>
                <div class="l">Psychologues</div>
            </div>
            <div class="num-block">
                <div class="n teal">{{ stats.cabinets ?? 0 }}</div>
                <div class="l">Cabinets</div>
            </div>
            <div class="num-block">
                <div class="n orange">{{ stats.revenue }} DT</div>
                <div class="l">Total en wallets</div>
            </div>
        </div>

        {# Module stat cards grid #}
        <div class="module-grid">

            <a href="{{ path('app_admin_produit_index') }}" class="mod-card">
                <div class="mod-icon" style="background:#FFF3E0;"><i class="bi bi-bag"></i></div>
                <div class="mod-body">
                    <div class="mod-count" style="color:#E67E22;">{{ stats.produits }}</div>
                    <div class="mod-label">Produits</div>
                </div>
            </a>

            <a href="#" class="mod-card">
                <div class="mod-icon" style="background:#E8F5E9;"><i class="bi bi-calendar-event"></i></div>
                <div class="mod-body">
                    <div class="mod-count" style="color:#27ae60;">{{ stats.evenements }}</div>
                    <div class="mod-label">Événements</div>
                </div>
            </a>

            <a href="{{ path('app_admin_cabinets') }}" class="mod-card">
                <div class="mod-icon" style="background:#E3F2FD;"><i class="bi bi-hospital"></i></div>
                <div class="mod-body">
                    <div class="mod-count" style="color:#4A90E2;">{{ stats.cabinets }}</div>
                    <div class="mod-label">Cabinets</div>
                </div>
            </a>

            <a href="{{ path('app_admin_order_index') }}" class="mod-card">
                <div class="mod-icon" style="background:#F3E5F5;"><i class="bi bi-box-seam"></i></div>
                <div class="mod-body">
                    <div class="mod-count" style="color:#8E44AD;">{{ stats.commandes }}</div>
                    <div class="mod-label">Commandes</div>
                </div>
            </a>

            <a href="#" class="mod-card">
                <div class="mod-icon" style="background:#E0F7FA;"><i class="bi bi-clipboard-data"></i></div>
                <div class="mod-body">
                    <div class="mod-count" style="color:#00ACC1;">{{ stats.tests }}</div>
                    <div class="mod-label">Tests</div>
                </div>
            </a>

            <a href="{{ path('app_admin_wallets') }}" class="mod-card">
                <div class="mod-icon" style="background:#E8F5E9;"><i class="bi bi-wallet2"></i></div>
                <div class="mod-body">
                    <div class="mod-count" style="color:#5FBF9F;">{{ stats.revenue }}</div>
                    <div class="mod-label">DT en wallets</div>
                </div>
            </a>

            <a href="{{ path('app_admin_cabinets') }}" class="mod-card">
                <div class="mod-icon" style="background:#FFF8E1;"><i class="bi bi-calendar-check"></i></div>
                <div class="mod-body">
                    <div class="mod-count" style="color:#F39C12;">{{ stats.reservations }}</div>
                    <div class="mod-label">Réservations</div>
                </div>
            </a>

            <a href="{{ path('app_admin_users') }}" class="mod-card">
                <div class="mod-icon" style="background:#FDECEA;"><i class="bi bi-people"></i></div>
                <div class="mod-body">
                    <div class="mod-count" style="color:#E74C3C;">{{ stats.suspended }}</div>
                    <div class="mod-label">Comptes suspendus</div>
                </div>
            </a>

        </div>

        {# Role breakdown — full width #}
        <div class="mid-right mb-3" style="flex-direction:row;align-items:center;gap:32px;padding:20px 28px;">
            <div style="font-size:13px;font-weight:600;color:#333;white-space:nowrap;min-width:90px;">
                Répartition<br><span style="font-size:11px;color:#bbb;font-weight:400;">par rôle</span>
            </div>

            {% set total = stats.users > 0 ? stats.users : 1 %}

            <div style="flex:1;">
                <div class="rb-top mb-1">
                    <span class="rb-name">Patients</span>
                    <span class="rb-count">{{ stats.patients }}</span>
                </div>
                <div class="role-bar-track">
                    <div class="role-bar-fill" style="width:{{ ((stats.patients/total)*100)|round }}%;background:#5FBF9F;"></div>
                </div>
            </div>

            <div style="flex:1;">
                <div class="rb-top mb-1">
                    <span class="rb-name">Psychologues</span>
                    <span class="rb-count">{{ stats.psychologues }}</span>
                </div>
                <div class="role-bar-track">
                    <div class="role-bar-fill" style="width:{{ ((stats.psychologues/total)*100)|round }}%;background:#4A90E2;"></div>
                </div>
            </div>

            <div style="flex:1;">
                <div class="rb-top mb-1">
                    <span class="rb-name">Admins</span>
                    <span class="rb-count">{{ stats.admins }}</span>
                </div>
                <div class="role-bar-track">
                    <div class="role-bar-fill" style="width:{{ ((stats.admins/total)*100)|round }}%;background:#E67E22;"></div>
                </div>
            </div>

            <div style="border-left:1px solid #F3F3F3;padding-left:28px;flex-shrink:0;">
                <a href="{{ path('app_admin_users') }}"
                   style="display:block;padding:10px 20px;background:#4A90E2;color:white;
                          border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;
                          text-align:center;white-space:nowrap;">
                    Voir tous les utilisateurs
                </a>
            </div>
        </div>

        {# Recent users #}
        <div class="recent-wrap">
            <div class="rw-header">
                <h6>Derniers inscrits</h6>
                <a href="{{ path('app_admin_users') }}">Voir tous →</a>
            </div>
            <table class="rw-table">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th>Statut</th>
                        <th>Inscrit le</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in recentUsers ?? [] %}
                    <tr class="clickable-row"
                        onclick="window.location='{{ path('app_admin_user_show', {id: user.id}) }}'"
                        tabindex="0"
                        onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();window.location='{{ path('app_admin_user_show', {id: user.id}) }}';}">
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="mb-avatar" style="width:32px;height:32px;font-size:12px;flex-shrink:0;">
                                    {% if user.profileImage %}
                                        <img src="{{ asset('uploads/profiles/' ~ user.profileImage) }}" alt="">
                                    {% else %}
                                        {{ user.fullName|first|upper }}
                                    {% endif %}
                                </div>
                                <div>
                                    <div class="u-name">{{ user.fullName }}</div>
                                    <div class="u-username">@{{ user.username }}</div>
                                </div>
                            </div>
                        </td>
                        <td style="color:#999;">{{ user.email }}</td>
                        <td>
                            {% if 'ROLE_ADMIN' in user.roles %}
                                <span class="pill pill-red">Admin</span>
                            {% elseif 'ROLE_PSYCHOLOGUE' in user.roles %}
                                <span class="pill pill-blue">Psychologue</span>
                            {% else %}
                                <span class="pill pill-teal">Patient</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if user.status == 'ACTIVE' %}
                                <span class="pill pill-green">Actif</span>
                            {% else %}
                                <span class="pill pill-grey">Suspendu</span>
                            {% endif %}
                        </td>
                        <td style="color:#bbb;font-size:12px;">
                            {{ user.createdAt ? user.createdAt|date('d/m/Y') : '—' }}
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="5" style="text-align:center;color:#ccc;padding:32px;font-size:13px;">
                            Aucun utilisateur pour le moment.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </div>
</div>
{% endblock %}

{% block javascripts %}{% endblock %}
