{% extends 'base.html.twig' %}
{% block title %}Mon Wallet — MindBloom{% endblock %}

{% block body %}

<div style="padding:30px 40px;background:var(--bg-warm);min-height:calc(100vh - 70px);">

    <div class="mb-page-header">
        <h1><i class="bi bi-wallet2" style="margin-right:10px;"></i>Mon Wallet</h1>
        <p>Gérez votre solde et vos transactions</p>
    </div>

    <div class="row g-4">

        {# Balance Card #}
        <div class="col-md-6">
            <div class="wallet-balance-card mb-4" style="margin-bottom:0 !important;">
                <div class="balance-label">Solde disponible</div>
                <div class="balance-amount">
                    {{ wallet.balance|number_format(2, '.', ' ') }} <small style="font-size:22px;">DT</small>
                </div>
                <div class="balance-status">
                    {% if wallet.status == 'ACTIVE' %}
                        <i class="bi bi-shield-check" style="color:#4ade80;margin-right:5px;"></i>Wallet actif
                    {% else %}
                        <i class="bi bi-slash-circle" style="color:#f87171;margin-right:5px;"></i>Wallet suspendu
                    {% endif %}
                </div>
                {% if wallet.lastRechargeDate %}
                <div style="margin-top:12px;font-size:12px;opacity:0.7;">
                    <i class="bi bi-clock-history" style="margin-right:4px;"></i>
                    Dernière recharge : {{ wallet.lastRechargeDate|date('d/m/Y à H:i') }}
                </div>
                {% endif %}
            </div>
        </div>

        {# Recharge form — collapsible, side-by-side with balance #}
        {% if wallet.status == 'ACTIVE' %}
        <div class="col-md-6">
            <div class="mb-card">
                <button type="button" id="rechargeToggle"
                        onclick="toggleSection('rechargeBody','rechargeToggle')"
                        style="width:100%;display:flex;align-items:center;justify-content:space-between;
                               background:transparent;border:none;padding:0;cursor:pointer;">
                    <h6 style="font-weight:700;margin:0;">
                        <i class="bi bi-lightning-charge-fill" style="color:#f59e0b;margin-right:6px;"></i>Recharger le wallet
                    </h6>
                    <i class="bi bi-chevron-down toggle-caret" style="font-size:16px;color:var(--text-mid);transition:transform .25s ease;"></i>
                </button>

                <div id="rechargeBody" style="display:none;margin-top:16px;">

                {# Quick amount buttons #}
                <div class="d-flex gap-2 mb-3 flex-wrap">
                    {% for amount in [10, 25, 50, 100] %}
                    <button type="button" class="btn-mb-outline"
                            style="padding:8px 16px;font-size:13px;"
                            onclick="setAmount({{ amount }})">
                        {{ amount }} DT
                    </button>
                    {% endfor %}
                </div>

                <form method="post" action="{{ path('app_wallet_recharge') }}" id="rechargeForm" novalidate>
                    <input type="hidden" name="_token" value="{{ csrf_token('wallet-recharge') }}">

                    {# Amount #}
                    <div class="mb-form-group">
                        <label>Montant (DT)</label>
                        <div class="mb-input-icon-wrap">
                            <span class="input-icon"><i class="bi bi-currency-exchange"></i></span>
                            <input type="number" name="amount" id="amountInput" class="mb-input"
                                   min="2" max="10000" step="0.01" placeholder="Ex: 50.00" required>
                        </div>
                    </div>

                    {# Card separator #}
                    <div style="display:flex;align-items:center;gap:10px;margin:18px 0 14px;">
                        <div style="flex:1;height:1px;background:var(--border-soft);"></div>
                        <span style="font-size:11px;color:var(--text-mid);font-weight:700;letter-spacing:.08em;text-transform:uppercase;">
                            <i class="bi bi-credit-card-2-front" style="margin-right:5px;font-size:13px;"></i>Informations carte
                        </span>
                        <div style="flex:1;height:1px;background:var(--border-soft);"></div>
                    </div>

                    {# Cardholder name #}
                    <div class="mb-form-group">
                        <label for="card_name">Titulaire de la carte</label>
                        <div class="mb-input-icon-wrap">
                            <span class="input-icon"><i class="bi bi-person"></i></span>
                            <input type="text" name="card_name" id="card_name" class="mb-input"
                                   placeholder="Prénom NOM" autocomplete="cc-name" required>
                        </div>
                        <div class="field-error" id="err_name"></div>
                    </div>

                    {# Card number + brand #}
                    <div class="mb-form-group">
                        <label for="card_number">Numéro de carte</label>
                        <div class="mb-input-icon-wrap" style="position:relative;">
                            <span class="input-icon"><i class="bi bi-credit-card"></i></span>
                            <input type="text" name="card_number" id="card_number" class="mb-input"
                                   placeholder="0000 0000 0000 0000" maxlength="19"
                                   inputmode="numeric" autocomplete="cc-number" required
                                   style="padding-right:64px;">
                            <span id="cardBrand" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);transition:opacity .2s;opacity:0.25;line-height:1;">
                                <i class="bi bi-credit-card-2-back" style="font-size:20px;color:var(--text-mid);"></i>
                            </span>
                        </div>
                        <div class="field-error" id="err_number"></div>
                    </div>

                    {# Expiry + CVC on same row #}
                    <div class="row g-2">
                        <div class="col-7">
                            <div class="mb-form-group">
                                <label for="card_expiry">Expiration</label>
                                <div class="mb-input-icon-wrap">
                                    <span class="input-icon"><i class="bi bi-calendar3"></i></span>
                                    <input type="text" name="card_expiry" id="card_expiry" class="mb-input"
                                           placeholder="MM/AA" maxlength="5"
                                           inputmode="numeric" autocomplete="cc-exp" required>
                                </div>
                                <div class="field-error" id="err_expiry"></div>
                            </div>
                        </div>
                        <div class="col-5">
                            <div class="mb-form-group">
                                <label for="card_cvc">CVC</label>
                                <div class="mb-input-icon-wrap">
                                    <span class="input-icon"><i class="bi bi-shield-lock"></i></span>
                                    <input type="text" name="card_cvc" id="card_cvc" class="mb-input"
                                           placeholder="123" maxlength="3"
                                           inputmode="numeric" autocomplete="cc-csc" required>
                                </div>
                                <div class="field-error" id="err_cvc"></div>
                            </div>
                        </div>
                    </div>

                    <div id="formError" style="display:none;color:#e74c3c;font-size:13px;margin-bottom:10px;padding:10px 12px;background:rgba(231,76,60,.08);border-radius:8px;border-left:3px solid #e74c3c;"></div>

                    <button type="submit" class="btn-mb-teal w-100" style="padding:12px;margin-top:6px;">
                        <i class="bi bi-lock-fill" style="margin-right:7px;"></i>Payer &amp; Recharger
                    </button>

                    <div style="text-align:center;margin-top:10px;font-size:11px;color:var(--text-mid);">
                        <i class="bi bi-shield-check" style="margin-right:4px;"></i>Paiement sécurisé via Stripe · Mode test
                    </div>
                </form>
                </div>{# /rechargeBody #}
            </div>
        </div>
        {% endif %}

        {# AI Budget Coach — Smart Categorizer #}
        <div class="col-12">
            <div class="mb-card" id="aiCoachCard"
                 style="background:linear-gradient(135deg,#f0fafa 0%,#e8f4f8 100%);border:1.5px solid #b2dde8;">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span style="font-size:24px;">🧠</span>
                        <div>
                            <h6 style="font-weight:700;margin:0;color:#1B3A6B;">Coach Budgétaire IA</h6>
                            <div style="font-size:12px;color:#4a6a82;">Analyse intelligente de vos dépenses ce mois-ci</div>
                        </div>
                    </div>
                    <button id="btnCoach" type="button"
                            style="display:flex;align-items:center;gap:8px;padding:10px 20px;border:none;border-radius:10px;background:linear-gradient(135deg,#00C2C7 0%,#4ECB71 100%);color:#fff;font-weight:700;cursor:pointer;font-size:13px;box-shadow:0 4px 14px rgba(0,194,199,.35);transition:transform .2s;">
                        <i class="bi bi-magic"></i> Lancer l'analyse
                    </button>
                </div>

                <div id="coachLoading" style="display:none;padding:24px;text-align:center;color:#008c91;font-size:14px;">
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    &nbsp;Catégorisation de vos transactions par IA…
                </div>

                <div id="coachError" style="display:none;margin-top:14px;padding:12px 14px;background:rgba(231,76,60,.08);border-left:3px solid #e74c3c;border-radius:8px;color:#c0392b;font-size:13px;"></div>

                <div id="coachResult" style="display:none;margin-top:18px;">
                    {# Top stat strip — with hover tooltips #}
                    <div class="row g-3 mb-3">
                        <div class="col-md-3 col-6">
                            <div class="coach-stat" data-tip="Montant total dépensé depuis le 1er du mois (hors recharges)."
                                 style="background:#fff;border-radius:10px;padding:14px;border:1px solid #e1ecf4;position:relative;cursor:help;">
                                <div style="display:flex;align-items:center;justify-content:space-between;">
                                    <div style="font-size:11px;color:#7a8a9a;text-transform:uppercase;letter-spacing:.06em;font-weight:700;">Dépensé ce mois</div>
                                    <i class="bi bi-info-circle" style="color:#b8c2d0;font-size:13px;"></i>
                                </div>
                                <div id="coachSpent" style="font-size:20px;font-weight:800;color:#1B3A6B;margin-top:4px;">— DT</div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="coach-stat" data-tip="Total des fonds ajoutés à votre wallet ce mois-ci via recharge carte."
                                 style="background:#fff;border-radius:10px;padding:14px;border:1px solid #e1ecf4;position:relative;cursor:help;">
                                <div style="display:flex;align-items:center;justify-content:space-between;">
                                    <div style="font-size:11px;color:#7a8a9a;text-transform:uppercase;letter-spacing:.06em;font-weight:700;">Rechargé</div>
                                    <i class="bi bi-info-circle" style="color:#b8c2d0;font-size:13px;"></i>
                                </div>
                                <div id="coachRecharged" style="font-size:20px;font-weight:800;color:#4ECB71;margin-top:4px;">— DT</div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="coach-stat" data-tip="Catégorie sur laquelle vous avez le plus dépensé (classée par l'IA à partir des descriptions)."
                                 style="background:#fff;border-radius:10px;padding:14px;border:1px solid #e1ecf4;position:relative;cursor:help;">
                                <div style="display:flex;align-items:center;justify-content:space-between;">
                                    <div style="font-size:11px;color:#7a8a9a;text-transform:uppercase;letter-spacing:.06em;font-weight:700;">Top catégorie</div>
                                    <i class="bi bi-info-circle" style="color:#b8c2d0;font-size:13px;"></i>
                                </div>
                                <div id="coachTopCat" style="font-size:16px;font-weight:800;color:#1B3A6B;margin-top:4px;">—</div>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="coach-stat" data-tip="Note globale sur 100 évaluée par l'IA : équilibre recharges/dépenses, diversification des catégories et régularité."
                                 style="background:#fff;border-radius:10px;padding:14px;border:1px solid #e1ecf4;position:relative;cursor:help;">
                                <div style="display:flex;align-items:center;justify-content:space-between;">
                                    <div style="font-size:11px;color:#7a8a9a;text-transform:uppercase;letter-spacing:.06em;font-weight:700;">Score santé</div>
                                    <i class="bi bi-info-circle" style="color:#b8c2d0;font-size:13px;"></i>
                                </div>
                                <div style="display:flex;align-items:center;gap:8px;margin-top:4px;">
                                    <div id="coachScore" style="font-size:20px;font-weight:800;color:#1B3A6B;">—</div>
                                    <div style="flex:1;height:6px;background:#e1ecf4;border-radius:3px;overflow:hidden;">
                                        <div id="coachScoreBar" style="height:100%;width:0%;background:linear-gradient(90deg,#00C2C7,#4ECB71);transition:width .6s ease;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Chart + legend #}
                    <div class="row g-3">
                        <div class="col-md-5">
                            <div style="background:#fff;border-radius:12px;padding:18px;border:1px solid #e1ecf4;display:flex;align-items:center;justify-content:center;min-height:260px;">
                                <svg id="coachChart" viewBox="-110 -110 220 220" width="220" height="220" style="overflow:visible;"></svg>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <div style="background:#fff;border-radius:12px;padding:18px;border:1px solid #e1ecf4;height:100%;">
                                <div style="font-size:13px;font-weight:700;color:#1B3A6B;margin-bottom:12px;">Répartition</div>
                                <div id="coachLegend"></div>
                            </div>
                        </div>
                    </div>

                    {# Summary + recommendations #}
                    <div class="row g-3 mt-1">
                        <div class="col-md-5">
                            <div style="background:#fff;border-radius:12px;padding:18px;border:1px solid #e1ecf4;border-left:4px solid #00C2C7;height:100%;">
                                <div style="font-size:12px;font-weight:700;color:#008c91;text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px;">
                                    <i class="bi bi-chat-heart"></i> Résumé du mois
                                </div>
                                <div id="coachSummary" style="font-size:14px;line-height:1.7;color:#1B3A6B;"></div>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <div style="background:#fff;border-radius:12px;padding:18px;border:1px solid #e1ecf4;border-left:4px solid #4ECB71;height:100%;">
                                <div style="font-size:12px;font-weight:700;color:#2ea255;text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px;">
                                    <i class="bi bi-lightbulb-fill"></i> Recommandations personnalisées
                                </div>
                                <ul id="coachRecs" style="margin:0;padding-left:0;list-style:none;"></ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Transaction History — collapsible, full width #}
        <div class="col-12">
            <div class="mb-card">

                {# Header with toggle #}
                <button type="button" id="txToggle"
                        onclick="toggleSection('txBody','txToggle')"
                        style="width:100%;display:flex;align-items:center;justify-content:space-between;
                               background:transparent;border:none;padding:0;cursor:pointer;">
                    <h6 style="font-weight:700;margin:0;">
                        <i class="bi bi-clock-history" style="margin-right:7px;color:var(--teal-mid);"></i>Voir les transactions
                    </h6>
                    <div style="display:flex;align-items:center;gap:10px;">
                        <span class="mb-badge mb-badge-gray" id="txCount">{{ transactions|length }} opération(s)</span>
                        <i class="bi bi-chevron-down toggle-caret" style="font-size:16px;color:var(--text-mid);transition:transform .25s ease;"></i>
                    </div>
                </button>

                <div id="txBody" style="display:none;margin-top:16px;">

                {# ── Search + filter bar ── #}
                {% if transactions is not empty %}
                <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
                    {# Text search #}
                    <div style="flex:1;min-width:160px;position:relative;">
                        <i class="bi bi-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--text-mid);font-size:13px;pointer-events:none;"></i>
                        <input type="text" id="txSearch" placeholder="Rechercher..."
                               style="width:100%;padding:8px 10px 8px 32px;border:1.5px solid var(--border-soft);border-radius:8px;font-size:13px;outline:none;background:var(--bg-warm);"
                               oninput="filterTx()">
                    </div>
                    {# Type filter #}
                    <select id="txType" onchange="filterTx()"
                            style="padding:8px 12px;border:1.5px solid var(--border-soft);border-radius:8px;font-size:13px;background:var(--bg-warm);cursor:pointer;outline:none;">
                        <option value="">Tous les types</option>
                        <option value="RECHARGE">Rechargements</option>
                        <option value="PAYMENT">Paiements</option>
                        <option value="WITHDRAWAL">Retraits</option>
                    </select>
                </div>
                {% endif %}

                {# Transaction list #}
                {% if transactions is empty %}
                    <div style="text-align:center;padding:40px;color:var(--text-mid);">
                        <i class="bi bi-inbox" style="font-size:48px;display:block;margin-bottom:12px;opacity:0.4;"></i>
                        <p>Aucune transaction pour le moment</p>
                    </div>
                {% else %}
                    <div id="txList">
                    {% for tx in transactions %}
                    <div class="transaction-row tx-item"
                         data-type="{{ tx.type }}"
                         data-desc="{{ (tx.description ?? tx.type)|lower }}"
                         data-date="{{ tx.transactionDate|date('d/m/Y') }}">
                        <div class="transaction-icon {{ tx.type == 'RECHARGE' ? 'credit' : 'debit' }}">
                            {% if tx.type == 'RECHARGE' %}
                                <i class="bi bi-arrow-down-circle-fill"></i>
                            {% elseif tx.type == 'PAYMENT' %}
                                <i class="bi bi-bag-check-fill"></i>
                            {% else %}
                                <i class="bi bi-arrow-up-circle-fill"></i>
                            {% endif %}
                        </div>
                        <div class="flex-fill" style="min-width:0;">
                            {% set desc = tx.description ?? tx.type %}
                            {% if tx.type == 'PAYMENT' and '|' in desc %}
                                {# ── Detailed order breakdown ── #}
                                {% set parts = desc|split(' | ') %}
                                {# First part: "Commande N article(s)" #}
                                <div class="tx-desc" style="font-weight:700;margin-bottom:4px;">
                                    <i class="bi bi-bag-check" style="margin-right:5px;color:#008c91;"></i>{{ parts[0] }}
                                </div>
                                {# Product lines (everything between first and last 3 parts) #}
                                {% set totalParts = parts|length %}
                                {% for i in 1..(totalParts - 4) %}
                                    {% set line = parts[i] %}
                                    <div style="font-size:12px;color:var(--text-mid);padding:2px 0 2px 18px;border-left:2px solid #e0e7ef;margin-left:4px;margin-bottom:1px;">
                                        <i class="bi bi-dot" style="font-size:14px;vertical-align:middle;"></i>{{ line }}
                                    </div>
                                {% endfor %}
                                {# TVA + shipping + total #}
                                <div style="display:flex;gap:10px;margin-top:5px;padding-top:5px;border-top:1px dashed #e0e7ef;flex-wrap:wrap;">
                                    <span style="font-size:11px;color:var(--text-mid);">
                                        <i class="bi bi-percent" style="margin-right:2px;"></i>{{ parts[totalParts - 3] }}
                                    </span>
                                    <span style="font-size:11px;color:var(--text-mid);">
                                        <i class="bi bi-truck" style="margin-right:2px;"></i>{{ parts[totalParts - 2] }}
                                    </span>
                                    <span style="font-size:11px;font-weight:700;color:#1B3A6B;">
                                        <i class="bi bi-receipt" style="margin-right:2px;"></i>{{ parts[totalParts - 1] }}
                                    </span>
                                </div>
                            {% else %}
                                <div class="tx-desc">{{ desc }}</div>
                            {% endif %}
                            <div class="tx-date" style="margin-top:4px;">
                                <i class="bi bi-clock" style="margin-right:3px;font-size:10px;"></i>
                                {{ tx.transactionDate|date('d/m/Y à H:i') }}
                            </div>
                        </div>
                        <div class="tx-amount {{ tx.type == 'RECHARGE' ? 'credit' : 'debit' }}" style="white-space:nowrap;align-self:flex-start;">
                            {{ tx.type == 'RECHARGE' ? '+' : '-' }}{{ tx.amount|number_format(2, '.', ' ') }} DT
                        </div>
                    </div>
                    {% endfor %}
                    </div>
                    <div id="txEmpty" style="display:none;text-align:center;padding:30px;color:var(--text-mid);">
                        <i class="bi bi-funnel" style="font-size:32px;display:block;margin-bottom:8px;opacity:0.4;"></i>
                        <p style="font-size:14px;">Aucun résultat pour ce filtre</p>
                    </div>
                {% endif %}

                </div>{# /txBody #}
            </div>
        </div>

    </div>
</div>
{% endblock %}

{% block javascripts %}
<style>
.field-error { color: #e74c3c; font-size: 12px; margin-top: 4px; min-height: 16px; }

/* Coach stat hover tooltips */
.coach-stat { transition: transform .2s ease, box-shadow .2s ease; }
.coach-stat:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(27,58,107,0.12);
}
.coach-stat::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: #1B3A6B;
    color: #fff;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.45;
    padding: 9px 12px;
    border-radius: 8px;
    white-space: normal;
    width: max-content;
    max-width: 260px;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    transition: opacity .18s ease, transform .18s ease;
    z-index: 50;
}
.coach-stat::before {
    content: '';
    position: absolute;
    bottom: calc(100% + 2px);
    left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: #1B3A6B;
    opacity: 0;
    pointer-events: none;
    transition: opacity .18s ease;
    z-index: 50;
}
.coach-stat:hover::after {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
}
.coach-stat:hover::before { opacity: 1; }
body.dark-mode .coach-stat::after {
    background: #252B3E;
    color: #E8EAF0;
    box-shadow: 0 8px 24px rgba(0,0,0,0.5);
}
body.dark-mode .coach-stat::before { border-top-color: #252B3E; }
.mb-input.is-invalid { border-color: #e74c3c !important; background: rgba(231,76,60,.04); }
.mb-input.is-valid   { border-color: #27ae60 !important; }

/* ══════════════════════════════════════════
   DARK MODE — Wallet page
   ══════════════════════════════════════════ */
body.dark-mode .wallet-balance-card {
    background: linear-gradient(135deg, #152B22 0%, #1A3529 100%) !important;
    color: #E8EAF0 !important;
    border: 1px solid #1E4434 !important;
}
body.dark-mode .wallet-balance-card .balance-label,
body.dark-mode .wallet-balance-card .balance-status {
    color: #A8B0C4 !important;
}
body.dark-mode .wallet-balance-card .balance-amount {
    color: #5FBF9F !important;
}

body.dark-mode .mb-page-header h1 {
    color: #E8EAF0 !important;
}
body.dark-mode .mb-card {
    background: #161A26 !important;
    color: #D8DCE8 !important;
    border-color: #252B3E !important;
    box-shadow: 0 10px 28px rgba(0,0,0,0.45) !important;
}
body.dark-mode .mb-card h6,
body.dark-mode .mb-card h5,
body.dark-mode .mb-card h4 {
    color: #E8EAF0 !important;
}

/* AI Coach panel */
body.dark-mode #aiCoachCard {
    background: linear-gradient(135deg,#0E2630 0%,#102A38 100%) !important;
    border-color: #1E4A5C !important;
    color: #D8DCE8 !important;
}
body.dark-mode #aiCoachCard h6 { color: #5EDDE1 !important; }
body.dark-mode #aiCoachCard > div:first-child > div > div > div:last-child { color: #A8B0C4 !important; }

/* Inner white cards inside the coach become dark */
body.dark-mode #aiCoachCard #coachResult > div > div > div,
body.dark-mode #aiCoachCard #coachResult > div > div > div > div {
    background: #161A26 !important;
