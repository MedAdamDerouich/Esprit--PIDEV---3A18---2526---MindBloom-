{% extends 'base.html.twig' %}
{% block title %}Boutique MindBloom{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
body.dark-mode .produit-page {
    background: linear-gradient(175deg,#0F1117 0%,#121826 45%,#101A18 100%) !important;
}
body.dark-mode .produit-page [style*="background:#fff"],
body.dark-mode .produit-page [style*="background:#fff;"],
body.dark-mode .produit-page [style*="background: #fff"],
body.dark-mode .produit-page [style*="background:white"],
body.dark-mode .produit-page [style*="background: white"],
body.dark-mode .produit-page [style*="background: rgb(255, 255, 255)"] {
    background: #161A26 !important;
    border-color: #252B3E !important;
    box-shadow: 0 12px 28px rgba(0,0,0,0.45) !important;
}
body.dark-mode .produit-page .product-item {
    background: #161A26 !important;
    border-color: #252B3E !important;
}
body.dark-mode .produit-page .product-item:hover {
    background: #1A1F2E !important;
}
body.dark-mode .produit-page [style*="background:linear-gradient(135deg,#EEF4FF,#E8F5F0)"] {
    background: #1A1F2E !important;
}
body.dark-mode .produit-page [style*="color:#1B3A6B"],
body.dark-mode .produit-page [style*="color:#2C3E50"] {
    color: #E8EAF0 !important;
}
body.dark-mode .produit-page [style*="color:#7F8C8D"],
body.dark-mode .produit-page [style*="color:#95A5A6"] {
    color: #7A8299 !important;
}
body.dark-mode .produit-page .pagination .page-item .page-link {
    background: #1E2333 !important;
    border-color: #2A3147 !important;
    color: #D8DCE8 !important;
}
body.dark-mode .produit-page #liveSearchInput,
body.dark-mode .produit-page #liveSortSelect {
    background: #1A1F2E !important;
    color: #E8EAF0 !important;
    border-color: #2A3147 !important;
}
</style>
{% endblock %}

{% block body %}
<div class="produit-page" style="background:linear-gradient(175deg,#F0F6FF 0%,#E8F4F8 45%,#EEF5F0 100%); min-height:calc(100vh - 70px); padding:40px 20px;">
<div style="max-width:1200px; margin:0 auto;">

    {# ── Hero ── #}
    <div style="text-align:center; margin-bottom:40px;">
        <h1 style="font-size:36px;font-weight:900;color:#1B3A6B;margin:0 0 10px;letter-spacing:-.5px;">Boutique <span style="background:linear-gradient(135deg,#00C2C7,#4ECB71);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">MindBloom</span></h1>
        <p style="font-size:15px;color:#7F8C8D;max-width:560px;margin:0 auto;">Une sélection de produits naturels et d'articles de bien-être pour vous accompagner sereinement.</p>
    </div>

    {# ── Search & Sort ── #}
    <div style="background:#fff;border-radius:16px;padding:16px 20px;box-shadow:0 2px 12px rgba(0,0,0,0.05);margin-bottom:32px;display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
        <div style="flex:1;min-width:220px;position:relative;">
            <svg style="position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#95A5A6;" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="liveSearchInput" placeholder="Rechercher un produit..." style="width:100%;padding:10px 12px 10px 38px;border:1.5px solid #E0E8F8;border-radius:10px;font-size:13px;outline:none;font-family:inherit;color:#2C3E50;transition:border-color .2s;" onfocus="this.style.borderColor='#4A90E2'" onblur="this.style.borderColor='#E0E8F8'">
        </div>
        <select id="liveSortSelect" style="padding:10px 14px;border:1.5px solid #E0E8F8;border-radius:10px;font-size:13px;font-weight:600;color:#2C3E50;outline:none;background:#fff;cursor:pointer;font-family:inherit;transition:border-color .2s;" onfocus="this.style.borderColor='#4A90E2'" onblur="this.style.borderColor='#E0E8F8'">
            <option value="default">Trier par défaut</option>
            <option value="prix_asc">Prix : Croissant</option>
            <option value="prix_desc">Prix : Décroissant</option>
        </select>
    </div>
    <div id="searchValidationMessage" style="display:none;color:#ef4444;font-size:12px;font-weight:700;text-align:center;margin:-20px 0 16px;"></div>
    <div id="searchNoResults" style="display:none;color:#7F8C8D;font-size:13px;text-align:center;margin:-20px 0 16px;">Aucun produit trouvé pour cette recherche.</div>

    {# ── Grid ── #}
    <div id="productGrid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:24px;margin-bottom:40px;">
        {% for produit in pagination %}
        <div class="col product-item" data-price="{{ produit.prix }}" style="background:#fff;border-radius:18px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.06);border:1px solid rgba(0,0,0,0.04);display:flex;flex-direction:column;cursor:pointer;transition:transform .25s cubic-bezier(0.34,1.56,0.64,1),box-shadow .25s;" onclick="window.location.href='{{ path('app_produit_show', {'id': produit.id}) }}'" onmouseover="this.style.transform='translateY(-6px)';this.style.boxShadow='0 12px 36px rgba(0,194,199,0.15)'" onmouseout="this.style.transform='';this.style.boxShadow='0 4px 20px rgba(0,0,0,0.06)'">

            {# Image #}
            <div style="height:200px;overflow:hidden;position:relative;">
                {% if produit.image %}
                    <img src="{{ asset('uploads/produits/' ~ produit.image) }}" alt="{{ produit.nom }}" style="width:100%;height:100%;object-fit:cover;transition:transform .4s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform=''">
                {% else %}
                    <div style="width:100%;height:100%;background:linear-gradient(135deg,#EEF4FF,#E8F5F0);display:flex;align-items:center;justify-content:center;">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#4A90E2" stroke-width="1.2" opacity=".3" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    </div>
                {% endif %}
                {# Price chip #}
                <div style="position:absolute;top:12px;right:12px;background:rgba(27,58,107,0.85);color:#fff;padding:5px 12px;border-radius:20px;font-size:13px;font-weight:700;backdrop-filter:blur(4px);">
                    {{ produit.prix|number_format(2, ',', ' ') }} DT
                </div>
                {% if produit.quantite <= 5 and produit.quantite > 0 %}
                <div style="position:absolute;top:12px;left:12px;background:rgba(245,197,66,0.9);color:#7a5000;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:800;">
                    Stock faible
                </div>
                {% endif %}
            </div>

            {# Body #}
            <div style="padding:18px 20px;flex:1;display:flex;flex-direction:column;gap:10px;">
                <h2 class="product-title" style="font-size:16px;font-weight:800;color:#1B3A6B;margin:0;line-height:1.3;">{{ produit.nom }}</h2>

                {# Stars #}
                <div style="display:flex;align-items:center;gap:6px;">
                    <div style="color:#FFB300;font-size:13px;">
                        {% set avg = produit.averageRating %}
                        {% for i in 1..5 %}
                            <i class="bi bi-star{{ i <= avg ? '-fill' : (i - 0.5 <= avg ? '-half' : '') }}"></i>
                        {% endfor %}
                    </div>
                    <span style="font-size:12px;color:#95A5A6;">({{ produit.feedbacks|length }})</span>
                </div>

                <p class="product-description" style="font-size:13px;color:#7F8C8D;line-height:1.6;margin:0;flex:1;">{{ produit.description|slice(0,80) }}…</p>

                {# Stock #}
                <div style="font-size:12px;font-weight:700;">
                    {% if produit.quantite > 0 %}
                        <span style="color:#27ae60;display:flex;align-items:center;gap:5px;"><i class="bi bi-check-circle-fill"></i> En stock</span>
                    {% else %}
                        <span style="color:#ef4444;display:flex;align-items:center;gap:5px;"><i class="bi bi-x-circle-fill"></i> Rupture de stock</span>
                    {% endif %}
                </div>
            </div>

            {# Action #}
            <div style="padding:0 20px 18px;" onclick="event.stopPropagation();">
                <form action="{{ path('app_cart_add', {'id': produit.id}) }}" method="post">
                    <button type="submit" style="width:100%;padding:10px;background:{{ produit.quantite > 0 ? 'linear-gradient(135deg,#00C2C7,#4ECB71)' : '#e2e8f0' }};color:{{ produit.quantite > 0 ? '#fff' : '#94a3b8' }};border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:{{ produit.quantite > 0 ? 'pointer' : 'not-allowed' }};transition:opacity .2s;" {{ produit.quantite == 0 ? 'disabled' : '' }} onmouseover="if(!this.disabled)this.style.opacity='.88'" onmouseout="this.style.opacity='1'">
                        {{ produit.quantite > 0 ? 'Ajouter au panier' : 'Rupture de stock' }}
                    </button>
                </form>
            </div>
        </div>
        {% else %}
        <div style="grid-column:1/-1;text-align:center;padding:80px 20px;background:#fff;border-radius:20px;">
            <p style="color:#7F8C8D;font-size:15px;">Aucun produit disponible pour le moment.</p>
        </div>
        {% endfor %}
    </div>

    {# ── KnpPaginator ── #}
    <div style="display:flex;justify-content:center;">
        {{ knp_pagination_render(pagination) }}
    </div>

</div>
</div>

<style>
.knp-paginator, .pagination { display:flex;gap:6px;list-style:none;padding:0;margin:0;justify-content:center; }
.pagination .page-item .page-link { display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:10px;background:#fff;border:1.5px solid #E0E8F8;color:#2C3E50;font-weight:600;font-size:14px;text-decoration:none;transition:all .2s; }
.pagination .page-item .page-link:hover { background:#00C2C7;color:#fff;border-color:#00C2C7; }
.pagination .page-item.active .page-link { background:linear-gradient(135deg,#00C2C7,#4ECB71);color:#fff;border-color:#00C2C7;box-shadow:0 4px 12px rgba(0,194,199,0.3); }
.pagination .page-item.disabled .page-link { opacity:.4;cursor:not-allowed; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('liveSearchInput');
    const sortSelect  = document.getElementById('liveSortSelect');
    const productGrid = document.getElementById('productGrid');
    const validationMsg = document.getElementById('searchValidationMessage');
    const noResults     = document.getElementById('searchNoResults');

    if (searchInput) searchInput.value = "{{ searchTerm ?? '' }}";

    let originalItems = Array.from(productGrid.querySelectorAll('.product-item'));

    function applyFilters() {
        const raw = searchInput ? searchInput.value : '';
        const forbidden = /[<>{}]/;
        if (forbidden.test(raw)) { validationMsg.textContent = "Caractères spéciaux non autorisés."; validationMsg.style.display='block'; return; }
        if (raw.length > 50)     { validationMsg.textContent = "Recherche limitée à 50 caractères."; validationMsg.style.display='block'; return; }
        validationMsg.style.display = 'none';

        const q = raw.toLowerCase().trim();
        const sort = sortSelect ? sortSelect.value : 'default';
        let sorted = [...originalItems];
        if (sort === 'prix_asc')  sorted.sort((a,b) => parseFloat(a.dataset.price) - parseFloat(b.dataset.price));
        if (sort === 'prix_desc') sorted.sort((a,b) => parseFloat(b.dataset.price) - parseFloat(a.dataset.price));

        let visible = 0;
        sorted.forEach(col => {
            const title = col.querySelector('.product-title')?.textContent.toLowerCase() ?? '';
            const desc  = col.querySelector('.product-description')?.textContent.toLowerCase() ?? '';
            const show  = !q || title.includes(q) || desc.includes(q);
            col.style.display = show ? '' : 'none';
            if (show) visible++;
            productGrid.appendChild(col);
        });
        noResults.style.display = (originalItems.length > 0 && visible === 0 && q) ? 'block' : 'none';
    }

    if (searchInput) searchInput.addEventListener('input', applyFilters);
    if (sortSelect)  sortSelect.addEventListener('change', applyFilters);
});
</script>
{% endblock %}
