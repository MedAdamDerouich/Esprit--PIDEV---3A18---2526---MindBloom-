<script>
/* ── Orb mouse parallax ── */
(function() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var orbs = [
        { el: document.getElementById('orb1'), depth: 0.018 },
        { el: document.getElementById('orb2'), depth: -0.012 },
        { el: document.getElementById('orb3'), depth: 0.022 },
        { el: document.getElementById('orb4'), depth: -0.016 },
    ];
    var mx = 0, my = 0, cx = 0, cy = 0;
    window.addEventListener('mousemove', function(e) {
        mx = (e.clientX / window.innerWidth  - 0.5) * 2;
        my = (e.clientY / window.innerHeight - 0.5) * 2;
    });
    (function tick() {
        cx += (mx - cx) * 0.06;
        cy += (my - cy) * 0.06;
        orbs.forEach(function(o) {
            if (!o.el) return;
            var tx = cx * window.innerWidth  * o.depth;
            var ty = cy * window.innerHeight * o.depth;
            o.el.style.setProperty('--px', tx + 'px');
            o.el.style.setProperty('--py', ty + 'px');
        });
        requestAnimationFrame(tick);
    })();
})();
</script>

<script>
(function () {
    'use strict';

    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.body.classList.add('anim-ready');

    if (reducedMotion) {
        document.querySelectorAll('.ptdash-badge,.ptdash-title,.ptdash-desc,.ptdash-cta-wrap,' +
            '.ptdash-services-title,.ptdash-services-sub').forEach(function(el) {
            el.style.opacity = '1'; el.style.transform = 'none';
        });
        document.querySelectorAll('.ptdash-card-wrap,.ptdash-stat').forEach(function(el) {
            el.style.opacity = '1'; el.style.transform = 'none';
        });
        return;
    }

    /* ════════════════════════════════════════════════════════════════
       Stats — animated counters with staggered entrance
    ════════════════════════════════════════════════════════════════ */
    function easeOutCubic(t) { return 1 - Math.pow(1-t, 3); }

    function formatCounter(value, fmt) {
        var n = Math.floor(value);
        switch (fmt) {
            case 'N+':    return n + '+';
            case 'Nk+':   return n + 'k+';
            case 'N/7':   return n + '/7';
            case 'N.X/5':
                var tenths = Math.floor(value);
                return Math.floor(tenths/10) + '.' + (tenths%10) + '/5';
            default: return String(n);
        }
    }

    function animateCounter(el) {
        var target = parseFloat(el.getAttribute('data-target')) || 0;
        var fmt    = el.getAttribute('data-format') || 'N';
        var dur    = 1500, start = null;
        function step(ts) {
            if (!start) start = ts;
            var p = Math.min((ts-start)/dur, 1);
            el.textContent = formatCounter(easeOutCubic(p) * target, fmt);
            if (p < 1) requestAnimationFrame(step);
            else el.textContent = formatCounter(target, fmt);
        }
        requestAnimationFrame(step);
    }

    /* Stats entrance + counter trigger */
    var statsBar = document.getElementById('stats-bar');
    var statItems = document.querySelectorAll('.ptdash-stat');

    if (statsBar && 'IntersectionObserver' in window) {
        var statsObs = new IntersectionObserver(function(entries, obs) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                    obs.unobserve(entry.target);
                    statItems.forEach(function(el, i) {
                        setTimeout(function() {
                            el.style.transition = 'opacity 0.6s cubic-bezier(0.22,1,0.36,1), transform 0.6s cubic-bezier(0.22,1,0.36,1)';
                            el.style.opacity = '1';
                            el.style.transform = 'translateY(0)';
                        }, i * 120);
                    });
                    document.querySelectorAll('.stat-counter').forEach(animateCounter);
                }
            });
        }, { threshold: 0.4 });
        statsObs.observe(statsBar);
    } else {
        statItems.forEach(function(el) { el.style.opacity='1'; el.style.transform='none'; });
        document.querySelectorAll('.stat-counter').forEach(function(el) {
            el.textContent = formatCounter(parseFloat(el.getAttribute('data-target'))||0, el.getAttribute('data-format')||'N');
        });
    }

    /* ════════════════════════════════════════════════════════════════
       Services section title entrance
    ════════════════════════════════════════════════════════════════ */
    var svcTitle = document.querySelector('.ptdash-services-title');
    var svcSub   = document.querySelector('.ptdash-services-sub');

    if (svcTitle && 'IntersectionObserver' in window) {
        var titleObs = new IntersectionObserver(function(entries, obs) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                    obs.unobserve(entry.target);
                    svcTitle.style.transition = 'opacity 0.7s cubic-bezier(0.22,1,0.36,1), transform 0.7s cubic-bezier(0.22,1,0.36,1)';
                    svcTitle.style.opacity = '1';
                    svcTitle.style.transform = 'translateY(0)';
                    setTimeout(function() {
                        if (svcSub) {
                            svcSub.style.transition = 'opacity 0.7s cubic-bezier(0.22,1,0.36,1), transform 0.7s cubic-bezier(0.22,1,0.36,1)';
                            svcSub.style.opacity = '1';
                            svcSub.style.transform = 'translateY(0)';
                        }
                    }, 120);
                }
            });
        }, { threshold: 0.3 });
        titleObs.observe(svcTitle);
    }

    /* ════════════════════════════════════════════════════════════════
       Service cards — 3D tilt + staggered entrance
    ════════════════════════════════════════════════════════════════ */
    var MAX_TILT = 14;
    var MAX_LIFT = 18;
    var cards = document.querySelectorAll('[data-tilt]');

    cards.forEach(function(card) {
        var wrap = card.closest('.ptdash-card-wrap');
        if (!wrap) return;

        wrap.addEventListener('mousemove', function(e) {
            var r  = card.getBoundingClientRect();
            var dx = ((e.clientX - r.left) / r.width)  * 2 - 1;
            var dy = ((e.clientY - r.top)  / r.height) * 2 - 1;
            var rx = -dy * MAX_TILT;
            var ry =  dx * MAX_TILT;
            card.style.transition = 'transform 0.08s ease-out, box-shadow 0.15s ease';
            card.style.transform  =
                'perspective(800px) rotateX(' + rx + 'deg) rotateY(' + ry + 'deg) translateZ(' + MAX_LIFT + 'px)';
        });

        wrap.addEventListener('mouseleave', function() {
            card.style.transition = 'transform 0.55s cubic-bezier(0.22,1,0.36,1), box-shadow 0.4s ease';
            card.style.transform  = 'perspective(800px) rotateX(0deg) rotateY(0deg) translateZ(0)';
        });

        /* Press feedback */
        wrap.addEventListener('mousedown', function() {
            card.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) translateZ(4px) scale(0.97)';
        });
        wrap.addEventListener('mouseup', function() {
            card.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) translateZ(' + MAX_LIFT + 'px)';
        });
    });

    /* Staggered entrance via IntersectionObserver */
    var cardWraps = document.querySelectorAll('.ptdash-card-wrap');

    if ('IntersectionObserver' in window) {
        var cardObs = new IntersectionObserver(function(entries, obs) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                    var el = entry.target;
                    var idx = Array.prototype.indexOf.call(cardWraps, el);
                    obs.unobserve(el);
                    setTimeout(function() {
                        el.style.transition =
                            'opacity 0.6s cubic-bezier(0.22,1,0.36,1), ' +
                            'transform 0.6s cubic-bezier(0.22,1,0.36,1)';
                        el.style.opacity = '1';
                        el.style.transform = 'translateY(0) scale(1)';
                    }, idx * 100);
                }
            });
        }, { threshold: 0.15 });
        cardWraps.forEach(function(el) { cardObs.observe(el); });
    } else {
        cardWraps.forEach(function(el) { el.style.opacity='1'; el.style.transform='none'; });
    }

    /* ════════════════════════════════════════════════════════════════
       CTA rotator — cycles Wallet → Produits → Tests → Rendez-vous
    ════════════════════════════════════════════════════════════════ */
    var rotator = document.getElementById('ctaRotator');
    if (rotator) {
        var slides = rotator.querySelectorAll('.cta-slide');
        var dots   = rotator.querySelectorAll('.cta-dot');
        var bar    = rotator.querySelector('.cta-progress-bar');
        var idx = 0, DURATION = 5000, tickMs = 50, elapsed = 0, timer = null;

        function applyTheme(slide) {
            rotator.style.background = slide.dataset.grad;
            rotator.style.boxShadow  = '0 20px 50px ' + slide.dataset.glow;
        }
        function go(next) {
            if (next === idx) return;
            var current = slides[idx];
            var target  = slides[next];
            current.classList.add('is-leaving');
            current.classList.remove('is-active');
            setTimeout(function() { current.classList.remove('is-leaving'); }, 560);
            target.classList.add('is-active');
            dots[idx].classList.remove('is-active');
            dots[next].classList.add('is-active');
            applyTheme(target);
            idx = next;
            elapsed = 0;
        }
        function tick() {
            elapsed += tickMs;
            bar.style.width = Math.min(100, (elapsed / DURATION) * 100) + '%';
            if (elapsed >= DURATION) {
                go((idx + 1) % slides.length);
                bar.style.width = '0%';
            }
        }
        function start() { if (!timer) timer = setInterval(tick, tickMs); }
        function stop()  { clearInterval(timer); timer = null; }

        applyTheme(slides[0]);
        dots.forEach(function(d) {
            d.addEventListener('click', function() {
                go(parseInt(d.dataset.idx, 10));
                bar.style.width = '0%';
            });
        });
        rotator.addEventListener('mouseenter', stop);
        rotator.addEventListener('mouseleave', start);
        start();
    }

    /* ════════════════════════════════════════════════════════════════
       Scroll-reveal for How-it-works steps + CTA banner (staggered)
    ════════════════════════════════════════════════════════════════ */
    var revealEls = document.querySelectorAll('[data-reveal]');
    if (revealEls.length && 'IntersectionObserver' in window) {
        var revealObs = new IntersectionObserver(function(entries, obs) {
            entries.forEach(function(entry, i) {
                if (!entry.isIntersecting) return;
                var el = entry.target;
                var siblings = el.parentElement.querySelectorAll('[data-reveal]');
                var idx = Array.prototype.indexOf.call(siblings, el);
                setTimeout(function() { el.classList.add('reveal'); }, Math.max(0, idx) * 140);
                obs.unobserve(el);
            });
        }, { threshold: 0.2 });
        revealEls.forEach(function(el) { revealObs.observe(el); });
    } else {
        revealEls.forEach(function(el) { el.classList.add('reveal'); });
    }

})();
</script>
