{% extends 'base.html.twig' %}
{% block title %}{{ event.titre }} — MindBloom{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
body.dark-mode .patient-event-page {
    background: #0F1117 !important;
}
body.dark-mode .patient-event-page [style*="background:#F5F3EF"] {
    background: #0F1117 !important;
}
body.dark-mode .patient-event-page [style*="background:#fff"],
body.dark-mode .patient-event-page [style*="background:white"],
body.dark-mode .patient-event-page [style*="background: #fff"],
body.dark-mode .patient-event-page [style*="background: white"],
body.dark-mode .patient-event-page [style*="background: rgb(255, 255, 255)"] {
    background: #161A26 !important;
    border-color: #252B3E !important;
    box-shadow: 0 12px 28px rgba(0,0,0,0.45) !important;
}
body.dark-mode .patient-event-page [style*="background:#F0F6FF"],
body.dark-mode .patient-event-page [style*="background:#F8F9FA"] {
    background: #1A1F2E !important;
}
body.dark-mode .patient-event-page [style*="color:#1B3A6B"],
body.dark-mode .patient-event-page [style*="color:#2C3E50"],
body.dark-mode .patient-event-page [style*="color:#2D3748"] {
    color: #E8EAF0 !important;
}
body.dark-mode .patient-event-page [style*="color:#7F8C8D"],
body.dark-mode .patient-event-page [style*="color:#95A5A6"],
body.dark-mode .patient-event-page [style*="color:#55606e"] {
    color: #A8B0C4 !important;
}
body.dark-mode .patient-event-page a[style*="background:#fff"],
body.dark-mode .patient-event-page a[style*="background:white"] {
    background: #1E2333 !important;
    color: #D8DCE8 !important;
    border-color: #252B3E !important;
}
</style>
{% endblock %}

{% block body %}
<div class="patient-event-page" style="background:#F5F3EF; min-height:calc(100vh - 70px); padding:40px 20px;">
<div style="max-width:1000px; margin:0 auto;">

    {# Back #}
    <a href="{{ path('app_patient_event_index') }}" style="display:inline-flex;align-items:center;gap:7px;color:#4A90E2;font-size:13px;font-weight:700;text-decoration:none;margin-bottom:28px;transition:gap .2s;" onmouseover="this.style.gap='10px'" onmouseout="this.style.gap='7px'">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Retour aux événements
    </a>

    {# Flash #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div style="background:{{ label=='success' ? '#eafaf1' : (label=='warning' ? '#fffbeb' : '#fef2f2') }};border-left:4px solid {{ label=='success' ? '#4ECB71' : (label=='warning' ? '#f59e0b' : '#ef4444') }};color:{{ label=='success' ? '#1e8449' : (label=='warning' ? '#92400e' : '#b91c1c') }};padding:12px 16px;border-radius:10px;margin-bottom:16px;font-weight:600;font-size:13px;">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <div style="display:grid;grid-template-columns:1fr 320px;gap:24px;align-items:start;">

        {# ── Left: event details ── #}
        <div style="background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.06);border:1px solid rgba(0,0,0,0.04);">
            {% if event.photo %}
                <img src="{{ asset('uploads/events/' ~ event.photo) }}" alt="{{ event.titre }}" style="width:100%;height:280px;object-fit:cover;">
            {% else %}
                <div style="height:200px;background:linear-gradient(135deg,#EEF4FF 0%,#E8F5F0 100%);display:flex;align-items:center;justify-content:center;">
                    <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#4A90E2" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" opacity=".35"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
            {% endif %}

            <div style="padding:28px;">
                <h1 style="font-size:26px;font-weight:900;color:#1B3A6B;margin:0 0 18px;letter-spacing:-.4px;line-height:1.2;">{{ event.titre }}</h1>

                <div style="display:flex;flex-wrap:wrap;gap:12px;margin-bottom:22px;">
                    <div style="display:flex;align-items:center;gap:7px;background:#F0F6FF;border-radius:8px;padding:8px 12px;font-size:13px;color:#2563EB;font-weight:600;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        {{ event.dateDebut|date('d/m/Y à H:i') }}
                    </div>
                    <div style="display:flex;align-items:center;gap:7px;background:#F0F6FF;border-radius:8px;padding:8px 12px;font-size:13px;color:#2563EB;font-weight:600;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        {{ event.lieu }}
                    </div>
                    {% if event.organisateur %}
                    <div style="display:flex;align-items:center;gap:7px;background:#F0F6FF;border-radius:8px;padding:8px 12px;font-size:13px;color:#2563EB;font-weight:600;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        {{ event.organisateur }}
                    </div>
                    {% endif %}
                </div>

                {% if event.description %}
                <div style="border-top:1px solid #F0F4FA;padding-top:20px;">
                    <h3 style="font-size:14px;font-weight:800;color:#1B3A6B;text-transform:uppercase;letter-spacing:.5px;margin:0 0 12px;">Description</h3>
                    <p style="font-size:14px;color:#55606e;line-height:1.8;margin:0;">{{ event.description }}</p>
                </div>
                {% endif %}
            </div>
        </div>

        {# ── Right: registration card ── #}
        <div style="background:#fff;border-radius:20px;padding:24px;box-shadow:0 4px 20px rgba(0,0,0,0.06);border:1px solid rgba(0,0,0,0.04);position:sticky;top:24px;">

            {# Price #}
            <div style="text-align:center;margin-bottom:20px;padding-bottom:20px;border-bottom:1px solid #F0F4FA;">
                <div style="font-size:32px;font-weight:900;color:{{ event.isGratuit ? '#27ae60' : '#4A90E2' }};">
                    {{ event.isGratuit ? 'Gratuit' : event.prix ~ ' DT' }}
                </div>
                <div style="font-size:12px;color:#95A5A6;font-weight:600;margin-top:4px;">par participant</div>
            </div>

            {# Stats #}
            <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:22px;">
                <div style="display:flex;justify-content:space-between;align-items:center;font-size:13px;">
                    <span style="color:#7F8C8D;font-weight:500;">Capacité</span>
                    <span style="color:#2C3E50;font-weight:700;">{{ event.capaciteMax ?? 'Illimitée' }}</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;font-size:13px;">
                    <span style="color:#7F8C8D;font-weight:500;">Participants</span>
                    <span style="color:#2C3E50;font-weight:700;">{{ participantsCount }}</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;font-size:13px;">
                    <span style="color:#7F8C8D;font-weight:500;">Places restantes</span>
                    <span style="color:{{ event.getPlacesRestantes is defined and event.getPlacesRestantes < 5 ? '#ef4444' : '#27ae60' }};font-weight:700;">{{ event.getPlacesRestantes ?? 'Illimité' }}</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;font-size:13px;">
                    <span style="color:#7F8C8D;font-weight:500;">Statut</span>
                    <span style="background:{{ event.statut == 'actif' ? 'rgba(78,203,113,0.12)' : 'rgba(149,165,166,0.12)' }};color:{{ event.statut == 'actif' ? '#27ae60' : '#7F8C8D' }};font-size:11px;font-weight:800;padding:3px 10px;border-radius:20px;letter-spacing:.3px;">
                        {{ event.statut|upper }}
                    </span>
                </div>
            </div>

            {# Action button #}
            {% if isRegistered %}
                <div style="width:100%;padding:13px;font-size:14px;background:rgba(78,203,113,0.1);color:#27ae60;border-radius:12px;font-weight:700;text-align:center;border:1.5px solid rgba(78,203,113,0.3);">
                    ✅ Vous êtes déjà inscrit
                </div>
            {% elseif event.dateDebut < date() %}
                <div style="width:100%;padding:13px;font-size:14px;background:#F8F9FA;color:#7F8C8D;border-radius:12px;font-weight:700;text-align:center;border:1.5px solid #E0E0E0;">
                    ⏳ Événement déjà passé
                </div>
            {% elseif not event.isPlacesDisponibles %}
                <div style="width:100%;padding:13px;font-size:14px;background:rgba(239,68,68,0.08);color:#ef4444;border-radius:12px;font-weight:700;text-align:center;border:1.5px solid rgba(239,68,68,0.2);">
                    ⚠️ Complet — Places épuisées
                </div>
            {% elseif event.statut != 'actif' %}
                <div style="width:100%;padding:13px;font-size:14px;background:#F8F9FA;color:#7F8C8D;border-radius:12px;font-weight:700;text-align:center;border:1.5px solid #E0E0E0;">
                    Événement {{ event.statut }}
                </div>
            {% else %}
                <form method="post" action="{{ path('app_patient_event_participate', {id: event.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('participate' ~ event.id) }}">
                    <button type="submit" style="width:100%;padding:13px;font-size:14px;background:linear-gradient(135deg,#4A90E2,#2563EB);color:#fff;border:none;border-radius:12px;font-weight:700;cursor:pointer;box-shadow:0 4px 14px rgba(74,144,226,0.35);transition:transform .2s,box-shadow .2s;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 20px rgba(74,144,226,0.45)'" onmouseout="this.style.transform='';this.style.boxShadow='0 4px 14px rgba(74,144,226,0.35)'">
                        S'inscrire maintenant →
                    </button>
                </form>
            {% endif %}
        </div>

    </div>
</div>
</div>
{% endblock %}
