{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des commandes - MindBloom Admin{% endblock %}

{% block admin_header %}Gestion des commandes{% endblock %}

{% block admin_content %}
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 border-start border-success border-5">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 text-success p-2 rounded-3 me-3">
                            <i class="bi bi-currency-dollar fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-0 small fw-bold text-uppercase">Chiffre d'Affaires Total</h6>
                            <h4 class="mb-0 fw-bold">{{ totalValue|number_format(2, ',', ' ') }} <small>DT</small></h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-5 text-end d-flex align-items-center justify-content-end gap-2">
            <form action="{{ path('app_admin_order_index') }}" method="GET" class="d-flex gap-2">
                <input type="text" name="q" class="form-control rounded-pill px-3 shadow-sm" placeholder="ID, Patient ou Email..." value="{{ q }}">
                <button type="submit" class="btn btn-outline-primary rounded-circle"><i class="bi bi-search"></i></button>
            </form>
            <a href="{{ path('app_admin_order_customers') }}" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-people-fill me-1"></i> Dépenses par Patient
            </a>
        </div>
    </div>

    <!-- TABS Navigation -->
    <ul class="nav nav-pills mb-4 gap-2" id="orderTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4 shadow-sm" id="pending-tab" data-bs-toggle="pill" data-bs-target="#pending" type="button" role="tab" aria-controls="pending" aria-selected="true">
                <i class="bi bi-clock-history me-1"></i> En attente
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 shadow-sm" id="shipped-tab" data-bs-toggle="pill" data-bs-target="#shipped" type="button" role="tab" aria-controls="shipped" aria-selected="false">
                <i class="bi bi-truck me-1"></i> Expédiées
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 shadow-sm" id="all-tab" data-bs-toggle="pill" data-bs-target="#all" type="button" role="tab" aria-controls="all" aria-selected="false">
                <i class="bi bi-list-check me-1"></i> Toutes les commandes
            </button>
        </li>
    </ul>

    <!-- TABS Content -->
    <div class="tab-content" id="orderTabContent">
        <div class="tab-pane fade show active" id="pending" role="tabpanel" aria-labelledby="pending-tab">
            {{ include('admin/order/_table.html.twig', {'factures': factures|filter(f => f.statutLivraison == 'NON_ENVOYE')}) }}
        </div>
        <div class="tab-pane fade" id="shipped" role="tabpanel" aria-labelledby="shipped-tab">
            {{ include('admin/order/_table.html.twig', {'factures': factures|filter(f => f.statutLivraison == 'ENVOYE')}) }}
        </div>
        <div class="tab-pane fade" id="all" role="tabpanel" aria-labelledby="all-tab">
            {{ include('admin/order/_table.html.twig', {'factures': factures}) }}
        </div>
    </div>

<style>
.nav-pills .nav-link {
    color: #6C757D;
    background: #FFF;
    border: 1px solid #DEE2E6;
}
.nav-pills .nav-link.active {
    background-color: var(--primary, #4A90E2) !important;
    color: white;
    border-color: var(--primary, #4A90E2);
}
.btn-white:hover {
    background-color: #f8f9fa !important;
}
</style>
{% endblock %}
