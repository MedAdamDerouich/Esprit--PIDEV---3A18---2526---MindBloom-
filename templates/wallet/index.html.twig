    border-color: #252B3E !important;
}
body.dark-mode #coachLegend span[style*="color:#1B3A6B"] { color: #E8EAF0 !important; }
body.dark-mode #coachLegend span[style*="color:#7a8a9a"] { color: #7A8299 !important; }

/* Summary + recommendations text */
body.dark-mode #coachSummary { color: #D8DCE8 !important; }
body.dark-mode #coachRecs li  { color: #D8DCE8 !important; }

/* Loading + center text */
body.dark-mode #coachLoading { color: #5EDDE1 !important; }
body.dark-mode #coachChart text[y="-6"]  { fill: #7A8299 !important; }
body.dark-mode #coachChart text[y="14"]  { fill: #E8EAF0 !important; }

/* Error banner */
