{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Produits - MindBloomAdmin{% endblock %}

{% block admin_header %}Catalogue des Produits{% endblock %}

{% block admin_content %}
    <!-- Statistics Row -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-primary border-5">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-3">
                            <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3">
                                <i class="bi bi-box-seam fs-4"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small fw-bold text-uppercase">Total Produits</h6>
                            <h4 class="mb-0 fw-bold">{{ stats.total }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-danger border-5">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-3">
                            <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-3">
                                <i class="bi bi-exclamation-octagon fs-4"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small fw-bold text-uppercase">Rupture de Stock</h6>
                            <h4 class="mb-0 fw-bold">{{ stats.outOfStock }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-warning border-5">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-3">
                            <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-3">
                                <i class="bi bi-graph-down fs-4"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small fw-bold text-uppercase">Stock Faible (< 10)</h6>
                            <h4 class="mb-0 fw-bold">{{ stats.lowStock }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-success border-5">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-3">
                            <div class="bg-success bg-opacity-10 text-success p-3 rounded-3">
                                <i class="bi bi-cash-coin fs-4"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small fw-bold text-uppercase">Valeur du Stock</h6>
                            <h4 class="mb-0 fw-bold">{{ stats.totalValue|number_format(2, ',', ' ') }} <small>DT</small></h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <p class="text-muted mb-0">Gérez votre inventaire et vos stocks.</p>
        </div>
        <div class="col-md-9 text-end d-inline-flex gap-2 mb-0 align-items-center flex-wrap justify-content-end">
            <div class="search-sort-wrapper">
                <form action="{{ path('app_admin_produit_index') }}" method="GET" class="m-0 p-0" id="adminSortForm">
                    <select name="tri" class="premium-select form-select" onchange="document.getElementById('adminSortForm').submit()">
                        <option value="default" {% if tri is defined and tri == 'default' %}selected{% endif %}>Trier par défaut</option>
                        <option value="prix_asc" {% if tri is defined and tri == 'prix_asc' %}selected{% endif %}>Prix : Croissant</option>
                        <option value="prix_desc" {% if tri is defined and tri == 'prix_desc' %}selected{% endif %}>Prix : Décroissant</option>
                    </select>
                </form>
                
                <input type="text" id="liveAdminSearch" class="premium-input form-control" placeholder="Recherche en direct...">
                <button class="premium-icon-btn" type="button"><i class="bi bi-search"></i></button>
            </div>
            
            <a href="{{ path('app_admin_produit_new') }}" class="btn btn-success px-4 shadow-sm rounded-pill ms-2" style="height: 40px; display: flex; align-items: center;">
                <i class="bi bi-plus-circle me-1"></i> Nouveau Produit
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-uppercase small font-weight-bold text-muted">
                        <tr>
                            <th class="ps-4 py-3 border-0">Produit</th>
                            <th class="py-3 border-0">Stock</th>
                            <th class="py-3 border-0">Prix</th>
                            <th class="py-3 border-0 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="adminProductTableBody">
                    {% for produit in produits %}
                        <tr class="admin-product-row">
                            <td class="ps-4 py-4 border-0">
                                <div class="d-flex align-items-center">
                                    {% if produit.image %}
                                        <img src="{{ asset('uploads/produits/' ~ produit.image) }}" alt="{{ produit.nom }}" class="rounded-3 me-3" style="width: 50px; height: 50px; object-fit: cover;">
                                    {% else %}
                                        <div class="bg-light rounded-3 me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                            <i class="bi bi-box text-muted"></i>
                                        </div>
                                    {% endif %}
                                    <div>
                                        <h6 class="mb-0 fw-bold product-title">{{ produit.nom }}</h6>
                                        <small class="text-muted text-truncate d-inline-block product-desc" style="max-width: 200px;">{{ produit.description|slice(0, 50) }}...</small>
                                    </div>
                                </div>
                            </td>
                            <td class="border-0">
                                <span class="badge {{ produit.quantite > 10 ? 'bg-success-subtle text-success' : (produit.quantite > 0 ? 'bg-warning-subtle text-warning' : 'bg-danger-subtle text-danger') }} px-2 py-1 rounded-pill">
                                    {{ produit.quantite }} en stock
                                </span>
                            </td>
                            <td class="fw-bold text-dark border-0">
                                {{ produit.prix|number_format(2, ',', ' ') }} DT
                            </td>
                            <td class="text-center pe-4 border-0">
                                <div class="btn-group shadow-sm rounded-pill overflow-hidden border">
                                    <a href="{{ path('app_admin_produit_feedbacks', {'id': produit.id}) }}" class="btn btn-sm btn-white bg-white border-0 py-2 px-3" title="Gérer les avis">
                                        <i class="bi bi-chat-left-dots text-info"></i>
                                    </a>
                                    <a href="{{ path('app_admin_produit_edit', {'id': produit.id}) }}" class="btn btn-sm btn-white bg-white border-0 border-start py-2 px-3" title="Modifier">
                                        <i class="bi bi-pencil-square text-primary"></i>
                                    </a>
                                    <form action="{{ path('app_admin_produit_delete', {'id': produit.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce produit ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
                                        <button class="btn btn-sm btn-white bg-white border-0 border-start py-2 px-3" title="Supprimer">
                                            <i class="bi bi-trash text-danger"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="py-5 text-center text-muted border-0"> Aucun produit trouvé dans le catalogue. </td>
                        </tr>
                    {% endfor %}
                        <tr id="adminNoResults" style="display:none;">
                            <td colspan="4" class="py-5 text-center text-muted border-0"> Aucun produit ne correspond à votre recherche en direct. </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

<style>
.bg-success-subtle { background-color: #d1e7dd; }
.bg-warning-subtle { background-color: #fff3cd; }
.bg-danger-subtle { background-color: #f8d7da; }
.btn-white:hover { background-color: #f8f9fa !important; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('liveAdminSearch');
    const tableBody = document.getElementById('adminProductTableBody');
    const rows = tableBody.querySelectorAll('.admin-product-row');
    const noResultsRow = document.getElementById('adminNoResults');

    if (!searchInput) return;

    searchInput.addEventListener('input', function() {
        let searchQuery = this.value.toLowerCase().trim();
        let visibleCount = 0;

        rows.forEach(row => {
            const titleEl = row.querySelector('.product-title');
            const descEl = row.querySelector('.product-desc');
            
            let titleText = titleEl ? titleEl.textContent.toLowerCase() : '';
            let descText = descEl ? descEl.textContent.toLowerCase() : '';

            if (titleText.includes(searchQuery) || descText.includes(searchQuery)) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        if (visibleCount === 0 && searchQuery !== '') {
            noResultsRow.style.display = '';
        } else {
            noResultsRow.style.display = 'none';
        }
    });
});
</script>
{% endblock %}
