                  <circle class="spore" cx="128" cy="268" r="1.5" fill="#6dbf84" style="--dx: 18px"/>
                  <circle class="spore" cx="180" cy="255" r="2"   fill="#c8b4f0" style="--dx: -30px"/>
                  <circle class="spore" cx="115" cy="225" r="1.5" fill="#c8f0d8" style="--dx: 22px"/>

