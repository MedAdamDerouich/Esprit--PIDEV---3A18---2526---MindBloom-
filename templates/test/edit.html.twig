{% extends 'base.html.twig' %}

{% block title %}Modifier {{ test.nomTest }} — MindBloom{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
body.dark-mode .test-page {
    background: #0F1117 !important;
}
body.dark-mode .test-page [style*="background:#F5F3EF"],
body.dark-mode .test-page [style*="background:#FAFAF8"] {
    background: #0F1117 !important;
}
body.dark-mode .test-page [style*="background: white"],
body.dark-mode .test-page [style*="background:white"] {
    background: #161A26 !important;
    border-color: #252B3E !important;
    box-shadow: 0 12px 28px rgba(0,0,0,0.45) !important;
}
body.dark-mode .test-page [style*="background:#FCF3CF"] {
    background: #2C2A1D !important;
}
body.dark-mode .test-page [style*="color: #2C3E50"],
body.dark-mode .test-page [style*="color:#2C3E50"] {
    color: #E8EAF0 !important;
}
body.dark-mode .test-page [style*="color: #7F8C8D"],
body.dark-mode .test-page [style*="color:#7F8C8D"] {
    color: #7A8299 !important;
}
body.dark-mode .test-page a[style*="color: #7F8C8D"] {
    color: #AEB5C8 !important;
}
</style>
{% endblock %}

{% block body %}
<div class="test-page" style="background:#F5F3EF; min-height: calc(100vh - 85px); padding: 50px;">
    <div style="max-width: 800px; margin: 0 auto;">
        
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <a href="{{ path('app_test_manage') }}" style="color: #7F8C8D; text-decoration: none; font-size: 14px; font-weight: 500;">
                ← Retour à mes tests
            </a>
            
            <div style="background: white; border-radius: 12px; padding: 5px; display: inline-block;">
                {{ include('test/_delete_form.html.twig') }}
            </div>
        </div>

        <div style="background: white; border-radius: 20px; padding: 40px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); margin-bottom: 30px;">
            <div style="text-align: center; margin-bottom: 30px;">
                <span style="display:inline-block;background:#FCF3CF;color:#F39C12;border-radius:20px;padding:6px 15px;font-size:13px;margin-bottom:15px;font-weight:700;">
                    ✏️ Modification
                </span>
                <h1 style="font-size: 32px; font-weight: 800; color: #2C3E50;">{{ test.nomTest }}</h1>
                <p style="color: #7F8C8D; margin-top: 10px;">Modifiez les paramètres de ce test.</p>
            </div>

            {{ include('test/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>
    </div>
</div>
{% endblock %}