{% extends 'base.html.twig' %}
{% block title %}Cabinets disponibles — MindBloom{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
body.dark-mode .patient-rdv-page { background: linear-gradient(175deg,#0F1117 0%,#121826 45%,#101A18 100%) !important; }
body.dark-mode .patient-rdv-page [style*="background:white"],
body.dark-mode .patient-rdv-page [style*="background:#fff"],
body.dark-mode .patient-rdv-page [style*="background: white"],
body.dark-mode .patient-rdv-page [style*="background: #fff"],
body.dark-mode .patient-rdv-page [style*="background: rgb(255, 255, 255)"] {
    background: #161A26 !important; border-color: #252B3E !important;
    box-shadow: 0 12px 28px rgba(0,0,0,0.45) !important;
}
body.dark-mode .patient-rdv-page [style*="background:#F0F6FF"],
body.dark-mode .patient-rdv-page [style*="background:#EEF4FF"],
body.dark-mode .patient-rdv-page [style*="background:#E8F5F0"],
body.dark-mode .patient-rdv-page [style*="background: rgb(240, 246, 255)"] { background: #1A1F2E !important; }
body.dark-mode .patient-rdv-page [style*="color:#1B3A6B"],
body.dark-mode .patient-rdv-page [style*="color:#2C3E50"] { color: #E8EAF0 !important; }
body.dark-mode .patient-rdv-page [style*="color:#7F8C8D"],
body.dark-mode .patient-rdv-page [style*="color:#55606e"] { color: #7A8299 !important; }
body.dark-mode .patient-rdv-page #searchField { color: #E8EAF0 !important; background: #161A26 !important; border-color: #252B3E !important; }
body.dark-mode .patient-rdv-page #dateFilterPill { background: #1A1F2E !important; border-color: #252B3E !important; }
body.dark-mode .patient-rdv-page .maps-btn {
    background: #1E2333 !important;
    color: #D8DCE8 !important;
    border: 1px solid #252B3E !important;
}
body.dark-mode .patient-rdv-page .maps-btn:hover {
    background: #00C2C7 !important;
    color: #fff !important;
}
body.dark-mode .maps-mode-btn {
    background: #1E2333 !important;
    color: #D8DCE8 !important;
    border: 1px solid #252B3E !important;
}
body.dark-mode .maps-mode-btn.active-map-mode {
    background: #00C2C7 !important;
    color: #fff !important;
    border-color: #00C2C7 !important;
}
body.dark-mode #mapsModalOverlay > div,
body.dark-mode #mapsModalOverlay [style*="background:white"],
body.dark-mode #mapsModalOverlay [style*="background: white"],
body.dark-mode #mapsModalOverlay [style*="background: rgb(255, 255, 255)"] { background: #161A26 !important; border-color: #252B3E !important; }
body.dark-mode .pagination .page a,
body.dark-mode .pagination .current,
body.dark-mode .pagination .next a,
body.dark-mode .pagination .previous a { background: #1E2333 !important; color: #D8DCE8 !important; border-color: #252B3E !important; }

.has-creneaux {
    background-color: rgba(0,194,199,0.15) !important;
    border-color: rgba(0,194,199,0.3) !important;
    font-weight: bold;
    color: #00C2C7 !important;
}
.navigation { display:flex; justify-content:center; margin-top:32px; }
.pagination { display:flex; align-items:center; gap:8px; list-style:none; padding:0; margin:0; }
.pagination .first, .pagination .last { display:none; }
.pagination .page a, .pagination .current { display:flex; align-items:center; justify-content:center; width:40px; height:40px; background:white; color:#2C3E50; border-radius:10px; text-decoration:none; font-weight:700; font-size:14px; border:1.5px solid #E0E8F8; transition:all .2s; }
.pagination .page a:hover { background:#00C2C7; color:white; border-color:#00C2C7; }
.pagination .current { background:linear-gradient(135deg,#00C2C7,#4ECB71); color:white; border-color:#00C2C7; box-shadow:0 4px 12px rgba(0,194,199,0.3); }
.pagination .next a, .pagination .previous a { display:flex; align-items:center; justify-content:center; width:40px; height:40px; background:white; color:#00C2C7; border-radius:10px; text-decoration:none; font-weight:700; font-size:16px; border:1.5px solid #E0E8F8; transition:all .2s; }
.pagination .next a:hover, .pagination .previous a:hover { background:#00C2C7; color:white; border-color:#00C2C7; }
.pagination .disabled { display:none; }
</style>
{% endblock %}

{% block body %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://npmcdn.com/flatpickr/dist/l10n/fr.js"></script>

<div class="patient-rdv-page" style="background:linear-gradient(175deg,#F0F6FF 0%,#E8F4F8 45%,#EEF5F0 100%); min-height:calc(100vh - 80px); padding:40px 20px;">
<div style="max-width:1200px; margin:0 auto;">

    {# ── Hero ── #}
    <div style="text-align:center; margin-bottom:40px;">
        <div style="display:inline-flex;align-items:center;gap:10px;background:rgba(0,194,199,0.10);border:1px solid rgba(0,194,199,0.20);border-radius:50px;padding:6px 18px;font-size:12px;font-weight:700;color:#008c91;letter-spacing:.5px;text-transform:uppercase;margin-bottom:16px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            Professionnels disponibles
        </div>
        <h1 style="font-size:36px;font-weight:900;color:#1B3A6B;margin:0 0 10px;letter-spacing:-.5px;">Prenez rendez-vous avec un <span style="background:linear-gradient(135deg,#00C2C7,#4ECB71);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">professionnel</span></h1>
        <p style="font-size:15px;color:#7F8C8D;max-width:520px;margin:0 auto;">Trouvez le psychologue qui vous convient et réservez votre consultation en quelques clics.</p>
    </div>

    {# ── Search & Date filter ── #}
    <div style="background:white;border-radius:16px;padding:16px 20px;box-shadow:0 2px 12px rgba(0,0,0,0.05);margin-bottom:32px;display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
        <div style="flex:1;min-width:220px;position:relative;">
            <svg style="position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#95A5A6;" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="searchField" placeholder="Rechercher par cabinet, professionnel ou spécialité..." value="{{ search }}" style="width:100%;padding:10px 12px 10px 38px;border:1.5px solid #E0E8F8;border-radius:10px;font-size:13px;outline:none;color:#2C3E50;transition:border-color .2s;" onfocus="this.style.borderColor='#00C2C7'" onblur="this.style.borderColor='#E0E8F8'">
        </div>
        <div id="dateFilterPill" style="display:flex;align-items:center;gap:8px;background:white;border:1.5px solid #E0E8F8;padding:9px 16px;border-radius:10px;cursor:pointer;transition:border-color .2s;position:relative;" onmouseover="this.style.borderColor='#00C2C7'" onmouseout="this.style.borderColor='#E0E8F8'">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#00C2C7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span id="dateLabel" style="font-size:13px;font-weight:600;color:#2C3E50;">Filtrer par date</span>
            <input type="date" id="dateInput" style="position:absolute;opacity:0;pointer-events:none;width:1px;height:1px;">
        </div>
        <button id="clearDateBtn" style="display:none;background:none;border:none;color:#95A5A6;cursor:pointer;font-size:18px;line-height:1;padding:0 4px;transition:color .2s;" onmouseover="this.style.color='#ef4444'" onmouseout="this.style.color='#95A5A6'" title="Réinitialiser">✕</button>
    </div>

    {# ── Grid ── #}
    <div id="cardsContainer" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:24px;margin-bottom:8px;">

        {% if cabinets is empty %}
            <div style="grid-column:1/-1;text-align:center;padding:80px 20px;background:white;border-radius:20px;box-shadow:0 4px 20px rgba(0,0,0,0.05);">
                <div style="width:80px;height:80px;background:rgba(0,194,199,0.08);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#00C2C7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
                <h4 style="font-size:20px;font-weight:800;color:#1B3A6B;margin:0 0 8px;">Aucun cabinet disponible</h4>
                <p style="color:#7F8C8D;font-size:14px;margin:0;">Revenez bientôt pour découvrir nos professionnels.</p>
            </div>
        {% else %}
            {% for cabinet in cabinets %}
            <div class="psychologist-card" data-nom="{{ cabinet.nomCabinet|lower }}" data-specialite="{{ cabinet.specialite|lower }}"
                 style="background:white;border-radius:18px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.06);border:1px solid rgba(0,0,0,0.04);display:flex;flex-direction:column;transition:transform .25s cubic-bezier(0.34,1.56,0.64,1),box-shadow .25s;"
                 onmouseover="this.style.transform='translateY(-6px)';this.style.boxShadow='0 12px 36px rgba(0,194,199,0.14)'"
                 onmouseout="this.style.transform='';this.style.boxShadow='0 4px 20px rgba(0,0,0,0.06)'">

                {# Photo #}
                <div style="height:180px;overflow:hidden;background:linear-gradient(135deg,#EEF4FF,#E8F5F0);">
                    {% if cabinet.psychologue and cabinet.psychologue.profileImage %}
                        <img src="{{ asset('uploads/profiles/' ~ cabinet.psychologue.profileImage) }}" alt="{{ cabinet.nomCabinet }}" style="width:100%;height:100%;object-fit:cover;transition:transform .4s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform=''">
                    {% else %}
                        <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
                            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#00C2C7" stroke-width="1.2" opacity=".3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </div>
                    {% endif %}
                </div>

                {# Body #}
                <div style="padding:20px;flex:1;display:flex;flex-direction:column;gap:12px;">
                    <div>
                        <h3 style="font-size:16px;font-weight:800;color:#1B3A6B;margin:0 0 4px;line-height:1.3;">{{ cabinet.nomCabinet }}</h3>
                        <span style="font-size:13px;font-weight:700;color:#008c91;">{% if cabinet.psychologue %}Dr. {{ cabinet.psychologue.fullName }}{% else %}Sans Nom{% endif %}</span>
                    </div>

                    <div style="display:flex;flex-direction:column;gap:5px;">
                        <span style="display:flex;align-items:center;gap:6px;font-size:12px;color:#7F8C8D;">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#00C2C7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                            {{ cabinet.specialite }}
                        </span>
                        <span style="display:flex;align-items:center;gap:6px;font-size:12px;color:#7F8C8D;">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#00C2C7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            {{ cabinet.adresse }}
                        </span>
                    </div>

                    <div style="display:flex;gap:8px;margin-top:auto;">
                        <button class="maps-btn" onclick="openMapsModal('{{ cabinet.adresse|e('js') }}', '{{ cabinet.nomCabinet|e('js') }}')"
                            style="display:inline-flex;align-items:center;gap:5px;background:rgba(0,194,199,0.10);color:#008c91;border:none;border-radius:9px;font-weight:700;padding:8px 14px;font-size:12px;cursor:pointer;transition:all .2s;"
                            onmouseover="this.style.background='#00C2C7';this.style.color='#fff'"
                            onmouseout="this.style.background='rgba(0,194,199,0.10)';this.style.color='#008c91'">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            Maps
                        </button>
                        <a href="{{ path('app_patient_cabinet_reserver', {id: cabinet.idCabinet}) }}" class="open-modal-creneau"
                            style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;background:linear-gradient(135deg,#00C2C7,#4ECB71);color:white;border-radius:10px;font-size:13px;font-weight:700;text-decoration:none;padding:9px 0;transition:opacity .2s;box-shadow:0 4px 14px rgba(0,194,199,0.3);"
                            onmouseover="this.style.opacity='.88'" onmouseout="this.style.opacity='1'">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            Prendre rendez-vous
                        </a>
                    </div>
                </div>
            </div>
            {% endfor %}
        {% endif %}
    </div>

    {# ── Pagination ── #}
    <div class="navigation">
        {{ knp_pagination_render(cabinets) }}
    </div>

</div>
</div>

{# ── Modal Créneaux ── #}
<div id="reservationModalOverlay" style="display:none;position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center;flex-direction:column;backdrop-filter:blur(4px);">
    <div id="modalSpinner" style="display:none;color:white;font-size:15px;font-weight:700;margin-bottom:16px;background:rgba(0,0,0,0.4);padding:10px 20px;border-radius:10px;">Chargement…</div>
    <div id="modalContentWrapper" style="position:relative;"></div>
</div>

{# ── Modal Maps ── #}
<div id="mapsModalOverlay" style="display:none;position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,0.5);z-index:99999;align-items:center;justify-content:center;backdrop-filter:blur(4px);">
    <div style="background:white;border-radius:20px;width:90%;max-width:900px;overflow:hidden;box-shadow:0 25px 50px rgba(0,0,0,0.2);">
        <div style="padding:16px 24px;display:flex;align-items:center;justify-content:space-between;border-bottom:1.5px solid #E0E8F8;">
            <span id="mapsModalTitle" style="font-size:16px;font-weight:800;color:#1B3A6B;display:flex;align-items:center;gap:8px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#00C2C7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <span id="mapsModalName">Localisation</span>
            </span>
            <button onclick="closeMapsModal()" style="background:none;border:none;font-size:20px;cursor:pointer;color:#7F8C8D;line-height:1;">✕</button>
        </div>
        <div style="padding:10px 24px;display:flex;gap:8px;border-bottom:1px solid #E0E8F8;">
            <button onclick="switchMode('place')" id="btn-place" class="maps-mode-btn active-map-mode" style="background:#00C2C7;color:white;border:none;border-radius:20px;padding:6px 16px;font-size:12px;font-weight:700;cursor:pointer;transition:all .2s;">Lieu</button>
            <button onclick="switchMode('directions')" id="btn-directions" class="maps-mode-btn" style="background:#F0F6FF;color:#00C2C7;border:none;border-radius:20px;padding:6px 16px;font-size:12px;font-weight:700;cursor:pointer;transition:all .2s;">Itinéraire</button>
        </div>
        <iframe id="mapsIframe" width="100%" height="480" style="border:none;display:block;" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" src=""></iframe>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {

    // --- RECHERCHE ---
    const searchField = document.getElementById('searchField');
    if (searchField) {
        function debounce(func, timeout=500) {
            let timer;
            return (...args) => { clearTimeout(timer); timer = setTimeout(() => func.apply(this, args), timeout); };
        }
        const triggerSearch = debounce(query => {
            const url = new URL(window.location.href);
            query ? url.searchParams.set('search', query) : url.searchParams.delete('search');
            url.searchParams.set('page', 1);
            window.location.href = url.toString();
        });
        searchField.addEventListener('input', e => triggerSearch(e.target.value.trim()));
        searchField.addEventListener('keypress', function(e) {
            if (e.key !== 'Enter') return;
            const url = new URL(window.location.href);
            e.target.value.trim() ? url.searchParams.set('search', e.target.value.trim()) : url.searchParams.delete('search');
            url.searchParams.set('page', 1);
            window.location.href = url.toString();
        });
        if (new URLSearchParams(window.location.search).has('search')) {
            searchField.focus(); const v = searchField.value; searchField.value=''; searchField.value=v;
        }
    }

    // --- MODAL CRÉNEAUX ---
    const overlay = document.getElementById('reservationModalOverlay');
    const content = document.getElementById('modalContentWrapper');
    const spinner = document.getElementById('modalSpinner');

    overlay.addEventListener('click', function(e) {
        if (e.target === overlay) {
            overlay.style.display = 'none';
            content.innerHTML = '';
            if (typeof window.resetDateFilter === 'function') window.resetDateFilter();
        }
    });

    document.querySelectorAll('.open-modal-creneau').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const url = this.href;
            overlay.style.display = 'flex';
            spinner.style.display = 'block';
            content.innerHTML = '';
            fetch(url)
                .then(r => r.text())
                .then(html => {
                    const doc = new DOMParser().parseFromString(html, 'text/html');
                    const modalUI = doc.querySelector('div[style*="width:450px"]');
                    if (modalUI) {
                        content.appendChild(modalUI);
                        doc.querySelectorAll('script').forEach(s => { const ns = document.createElement('script'); ns.text = s.text; document.body.appendChild(ns); });
                        const closeBtn = modalUI.querySelector('a[title="Fermer"]');
                        if (closeBtn) closeBtn.addEventListener('click', ev => { ev.preventDefault(); overlay.style.display='none'; content.innerHTML=''; });
                    } else { window.location.href = url; }
                })
                .catch(() => window.location.href = url)
                .finally(() => spinner.style.display = 'none');
        });
    });

    // --- FILTRE DATE ---
    const dateFilterPill = document.getElementById('dateFilterPill');
    const dateInput      = document.getElementById('dateInput');
    const dateLabel      = document.getElementById('dateLabel');
    const availableDates = {{ availableDates|default([])|json_encode|raw }};

    if (dateFilterPill && dateInput) {
        flatpickr.localize(flatpickr.l10ns.fr);
        const fp = flatpickr(dateInput, {
            dateFormat: 'Y-m-d',
            minDate: 'today',
            onDayCreate: function(dObj, dStr, fp, dayElem) {
                const d = dayElem.dateObj;
                const key = [d.getFullYear(), String(d.getMonth()+1).padStart(2,'0'), String(d.getDate()).padStart(2,'0')].join('-');
                if (availableDates.includes(key)) dayElem.classList.add('has-creneaux');
            },
            onChange: function(selectedDates, dateStr) {
                if (!dateStr) return;
                dateLabel.textContent = selectedDates[0].toLocaleDateString('fr-FR', {weekday:'long',day:'numeric',month:'long',year:'numeric'});
                document.getElementById('clearDateBtn').style.display = 'block';
                overlay.style.display = 'flex';
                spinner.style.display = 'block';
                content.innerHTML = '';
                fetch('/patient/availability/' + dateStr)
                    .then(r => r.text())
                    .then(html => {
                        content.innerHTML = html;
                        content.querySelectorAll('script').forEach(s => { const ns = document.createElement('script'); ns.text = s.text; document.body.appendChild(ns); });
                    })
                    .catch(() => overlay.style.display = 'none')
                    .finally(() => spinner.style.display = 'none');
            }
        });
        window.resetDateFilter = function() { fp.clear(); dateLabel.textContent = 'Filtrer par date'; document.getElementById('clearDateBtn').style.display = 'none'; };
        dateFilterPill.addEventListener('click', () => fp.open());
        document.getElementById('clearDateBtn').addEventListener('click', () => window.resetDateFilter());
    }
});

// --- GOOGLE MAPS ---
const GOOGLE_MAPS_KEY = "{{ googleMapsApiKey }}";
let currentAdresse = '';

function openMapsModal(adresse, nomCabinet) {
    currentAdresse = adresse;
    document.getElementById('mapsModalName').textContent = nomCabinet;
    document.getElementById('mapsModalOverlay').style.display = 'flex';
    switchMode('place');
}
function switchMode(mode) {
    const iframe = document.getElementById('mapsIframe');
    const encoded = encodeURIComponent(currentAdresse);
    const isDarkMode = document.body.classList.contains('dark-mode');

    ['place','directions'].forEach(m => {
        const b = document.getElementById('btn-'+m);
        if (b) {
            b.classList.remove('active-map-mode');
            b.style.background = isDarkMode ? '#1E2333' : '#F0F6FF';
            b.style.color = isDarkMode ? '#D8DCE8' : '#008c91';
            b.style.borderColor = isDarkMode ? '#252B3E' : 'transparent';
        }
    });
    const ab = document.getElementById('btn-'+mode);
    if (ab) {
        ab.classList.add('active-map-mode');
        ab.style.background = '#00C2C7';
        ab.style.color = 'white';
        ab.style.borderColor = '#00C2C7';
    }
    if (mode === 'place') {
        iframe.src = `https://www.google.com/maps/embed/v1/place?key=${GOOGLE_MAPS_KEY}&q=${encoded}&language=fr`;
    } else {
        const fallback = () => iframe.src = `https://www.google.com/maps/embed/v1/directions?key=${GOOGLE_MAPS_KEY}&origin=Tunis,Tunisia&destination=${encoded}&language=fr&mode=driving`;
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                p => iframe.src = `https://www.google.com/maps/embed/v1/directions?key=${GOOGLE_MAPS_KEY}&origin=${p.coords.latitude},${p.coords.longitude}&destination=${encoded}&language=fr&mode=driving`,
                fallback
            );
        } else { fallback(); }
    }
}
function closeMapsModal() {
    document.getElementById('mapsModalOverlay').style.display = 'none';
    document.getElementById('mapsIframe').src = '';
}
document.getElementById('mapsModalOverlay').addEventListener('click', function(e) {
    if (e.target === this) closeMapsModal();
});
</script>
{% endblock %}
