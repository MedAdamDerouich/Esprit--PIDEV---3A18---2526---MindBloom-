{% extends 'base.html.twig' %}
{% block title %}Inscription — MindBloom{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/auth.css') }}">
{% endblock %}

{% block body %}
<div class="auth-page">

    {# ── LEFT PANEL ── #}
    <div class="auth-panel-left">
        <div class="auth-panel-left__content">

            <div class="auth-brand-block">
                <div class="auth-brand-icon">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
                        <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                        <line x1="9" y1="9" x2="9.01" y2="9"/>
                        <line x1="15" y1="9" x2="15.01" y2="9"/>
                    </svg>
                </div>
                <div>
                    <h1 class="auth-brand-name">MindBloom</h1>
                    <p class="auth-brand-tagline">Rejoignez notre communauté</p>
                </div>
            </div>

            <div class="auth-feature-list">
                <div class="auth-feature">
                    <div class="auth-feature__icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                            <polyline points="22 4 12 14.01 9 11.01"/>
                        </svg>
                    </div>
                    <div>
                        <h4>Inscription gratuite</h4>
                        <p>Créez votre compte en moins de 2 minutes</p>
                    </div>
                </div>

                <div class="auth-feature">
                    <div class="auth-feature__icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                    </div>
                    <div>
                        <h4>Données sécurisées</h4>
                        <p>Vos informations personnelles sont protégées</p>
                    </div>
                </div>

                <div class="auth-feature">
                    <div class="auth-feature__icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                        </svg>
                    </div>
                    <div>
                        <h4>Accompagnement continu</h4>
                        <p>Un suivi personnalisé tout au long de votre parcours</p>
                    </div>
                </div>
            </div>

            <div class="auth-metrics">
                <div class="auth-metric">
                    <span class="auth-metric__value">500+</span>
                    <span class="auth-metric__label">Patients</span>
                </div>
                <div class="auth-metric__sep"></div>
                <div class="auth-metric">
                    <span class="auth-metric__value">50+</span>
                    <span class="auth-metric__label">Psychologues</span>
                </div>
                <div class="auth-metric__sep"></div>
                <div class="auth-metric">
                    <span class="auth-metric__value">98%</span>
                    <span class="auth-metric__label">Satisfaction</span>
                </div>
            </div>

        </div>
    </div>

    {# ── RIGHT PANEL ── #}
    <div class="auth-panel-right" style="padding:30px 40px;">
        <div class="auth-card auth-card--wide">

            <div class="auth-card__header">
                <h2>Créer un compte</h2>
                <p>Rejoignez MindBloom et prenez soin de vous</p>
            </div>

            {# Role selector #}
            <div class="auth-field">
                <label>Je suis un(e)</label>
                <div class="auth-role-selector" id="roleSelector">
                    <div class="auth-role selected" onclick="selectRole('ROLE_PATIENT', this)">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                        <span>Patient</span>
                    </div>
                    <div class="auth-role" onclick="selectRole('ROLE_PSYCHOLOGUE', this)">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                        </svg>
                        <span>Psychologue</span>
                    </div>
                </div>
            </div>

            {{ form_errors(registrationForm) }}

            {{ form_start(registrationForm, {action: path('app_register'), method: 'post', attr: {class: 'auth-form'}}) }}
                {{ form_widget(registrationForm.roles, {attr: {id: 'roleInput'}}) }}

                <div class="row g-3">
                    <div class="col-12">
                        <div class="auth-field" style="margin-bottom:0;">
                            <label>Nom complet</label>
                            <div class="auth-input-wrap">
                                <svg class="auth-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                                {{ form_widget(registrationForm.fullName, {
                                    'attr': {'class': 'auth-input', 'placeholder': 'Prénom Nom'}
                                }) }}
                            </div>
                            {{ form_errors(registrationForm.fullName) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="auth-field" style="margin-bottom:0;">
                            <label>Nom d'utilisateur</label>
                            {{ form_widget(registrationForm.username, {
                                'attr': {'class': 'auth-input', 'placeholder': 'username'}
                            }) }}
                            {{ form_errors(registrationForm.username) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="auth-field" style="margin-bottom:0;">
                            <label>Email</label>
                            {{ form_widget(registrationForm.email, {
                                'attr': {'class': 'auth-input', 'placeholder': 'email@exemple.com'}
                            }) }}
                            {{ form_errors(registrationForm.email) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="auth-field" style="margin-bottom:0;">
                            <label>Téléphone</label>
                            {{ form_widget(registrationForm.phone, {
                                'attr': {'class': 'auth-input', 'placeholder': '+213...'}
                            }) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="auth-field" style="margin-bottom:0;">
                            <label>Date de naissance</label>
                            {{ form_widget(registrationForm.dateOfBirth, {
                                'attr': {'class': 'auth-input'}
                            }) }}
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="auth-field" style="margin-bottom:0;">
                            <label>Adresse</label>
                            {{ form_widget(registrationForm.address, {
                                'attr': {'class': 'auth-input', 'placeholder': 'Votre adresse'}
                            }) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="auth-field" style="margin-bottom:0;">
                            <label>Mot de passe</label>
                            {{ form_widget(registrationForm.plainPassword.first, {
                                'attr': {'class': 'auth-input', 'placeholder': 'Min. 8 caractères'}
                            }) }}
                            {{ form_errors(registrationForm.plainPassword) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="auth-field" style="margin-bottom:0;">
                            <label>Confirmer</label>
                            {{ form_widget(registrationForm.plainPassword.second, {
                                'attr': {'class': 'auth-input', 'placeholder': 'Confirmez le mot de passe'}
                            }) }}
                        </div>
                    </div>
                </div>

                <button type="submit" class="auth-btn" style="margin-top:24px;">
                    Créer mon compte
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                        <polyline points="12 5 19 12 12 19"/>
                    </svg>
                </button>
            {{ form_end(registrationForm) }}

            <div class="auth-divider">
                <span>ou</span>
            </div>

            <p class="auth-footer">
                Déjà inscrit ?
                <a href="{{ path('app_login') }}">Se connecter</a>
            </p>
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
<script>
function selectRole(role, el) {
    document.querySelectorAll('.auth-role').forEach(o => o.classList.remove('selected'));
    el.classList.add('selected');
    document.getElementById('roleInput').value = role;
}
</script>
{% endblock %}
