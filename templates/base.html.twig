<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}MindBloom{% endblock %}</title>
    <link rel="icon" type="image/png" href="{{ asset('images/mindbloom_logo.png') }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="{{ asset('css/mindbloom.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="flash-{{ label == 'success' ? 'success' : (label == 'error' ? 'error' : 'info') }}"
             style="position:fixed;top:20px;right:20px;z-index:9999;min-width:300px;max-width:420px;border-radius:10px;">
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}

{% block navbar %}
{% if app.user %}
    {{ include('inc/_navbar.html.twig') }}
{% endif %}
{% endblock %}

{% block body %}{% endblock %}

{# ── Logout confirmation modal ── #}
<style>
/* Modal box entrance */
#logoutModalBox {
    transform: scale(0.9) translateY(20px);
    opacity: 0;
    transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s ease;
}
#logoutModal.modal-visible #logoutModalBox {
    transform: scale(1) translateY(0);
    opacity: 1;
}

/* ── 3D Door (pure HTML divs, NOT SVG) ── */
.door-scene {
    width: 90px;
    height: 100px;
    margin: 0 auto 20px;
    position: relative;
}

/* Frame (visible behind the door when it opens) */
.door-frame {
    position: absolute;
    top: 4px;
    left: 10px;
    right: 10px;
    bottom: 8px;
    background: #C4956A;
    border-radius: 5px 5px 2px 2px;
    border: 2.5px solid #A0724A;
    box-sizing: border-box;
    overflow: hidden;
}

/* Dark interior visible when door opens */
.door-frame-inner {
    position: absolute;
    inset: 3px;
    background: #2C2018;
    border-radius: 3px 3px 0 0;
}

/* Floor */
.door-floor {
    position: absolute;
    bottom: 0;
    left: 4px;
    right: 4px;
    height: 6px;
    background: #A0724A;
    border-radius: 2px;
}

/* 3D perspective wrapper */
.door-perspective {
    position: absolute;
    top: 7px;
    left: 13px;
    right: 13px;
    bottom: 11px;
    perspective: 350px;
}

/* The actual door panel that swings */
.door-panel {
    position: absolute;
    inset: 0;
    transform-origin: left center;
    transform: rotateY(0deg);
    transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    transform-style: preserve-3d;
    background: linear-gradient(160deg, #F2DDB8 0%, #E4C68E 100%);
    border-radius: 3px;
    border: 1.5px solid #C49858;
    box-shadow: 1px 0 4px rgba(0,0,0,0.15);
    box-sizing: border-box;
}

/* Door opens when .door-open is added */
#logoutModal.door-open .door-panel {
    transform: rotateY(-72deg);
    box-shadow: 6px 2px 12px rgba(0,0,0,0.35);
}

/* Panel inset decorations */
.door-inset {
    position: absolute;
    border: 1.5px solid #C8A670;
    border-radius: 2px;
    background: rgba(200,166,112,0.08);
}
.door-inset.top-l    { top: 6px;  left: 5px; width: 24px; height: 28px; }
.door-inset.top-r    { top: 6px;  right: 5px; width: 24px; height: 28px; }
.door-inset.bottom-l { top: 38px; left: 5px; width: 24px; height: 24px; }
.door-inset.bottom-r { top: 38px; right: 5px; width: 24px; height: 24px; }

/* Doorknob */
.door-knob {
    position: absolute;
    right: 7px;
    top: 50%;
    transform: translateY(-50%);
    width: 8px;
    height: 8px;
    background: radial-gradient(circle at 35% 35%, #E8C840, #B08A20);
    border-radius: 50%;
    border: 1px solid #9A7618;
    box-shadow: 1px 1px 3px rgba(0,0,0,0.2);
}
</style>

<div id="logoutModal" style="display:none;position:fixed;inset:0;z-index:99999;
     background:rgba(0,0,0,0.45);align-items:center;justify-content:center;">
    <div id="logoutModalBox" style="background:white;border-radius:16px;padding:36px 32px;width:380px;
                box-shadow:0 20px 60px rgba(0,0,0,0.2);text-align:center;">

        {# ── 3D Door — pure HTML/CSS, starts closed ── #}
        <div class="door-scene">
            <div class="door-frame">
                <div class="door-frame-inner"></div>
            </div>
            <div class="door-floor"></div>
            <div class="door-perspective">
                <div class="door-panel">
                    <div class="door-inset top-l"></div>
                    <div class="door-inset top-r"></div>
                    <div class="door-inset bottom-l"></div>
                    <div class="door-inset bottom-r"></div>
                    <div class="door-knob"></div>
                </div>
            </div>
        </div>

        <h3 style="font-size:20px;font-weight:700;color:#2C3E50;margin-bottom:8px;">
            Déconnexion
        </h3>
        <p style="font-size:14px;color:#8E8E8E;margin-bottom:28px;line-height:1.6;">
            Êtes-vous sûr de vouloir vous déconnecter de votre espace MindBloom ?
        </p>
        <div style="display:flex;gap:12px;justify-content:center;">
            <button onclick="closeLogoutModal()"
                    style="flex:1;padding:12px;border:1.5px solid #E0E0E0;border-radius:10px;
                           background:white;color:#2C3E50;font-size:14px;font-weight:600;cursor:pointer;">
                Annuler
            </button>
            <button onclick="confirmLogout()"
                    style="flex:1;padding:12px;background:#e74c3c;border:none;border-radius:10px;
                           color:white;font-size:14px;font-weight:600;cursor:pointer;">
                Se déconnecter
            </button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
<script>
    const logoutUrl = "{{ path('app_logout') }}";
    const logoutModal = document.getElementById('logoutModal');
    const logoutModalBox = document.getElementById('logoutModalBox');

    function openLogoutModal() {
        // Reset: door closed, modal hidden
        logoutModal.classList.remove('door-open', 'modal-visible');
        logoutModal.style.display = 'flex';
        // Trigger entrance animation on next frame
        requestAnimationFrame(() => requestAnimationFrame(() => {
            logoutModal.classList.add('modal-visible');
        }));
    }

    function closeLogoutModal() {
        logoutModal.classList.remove('modal-visible', 'door-open');
        setTimeout(() => { logoutModal.style.display = 'none'; }, 400);
    }

    function confirmLogout() {
        // Swing the door open, wait for the animation, then redirect
        logoutModal.classList.add('door-open');
        setTimeout(() => { window.location.href = logoutUrl; }, 900);
    }

    document.querySelectorAll('a[href="' + logoutUrl + '"]:not([data-logout-confirm])').forEach(link => {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            openLogoutModal();
        });
    });

    logoutModal.addEventListener('click', function(e) {
        if (e.target === logoutModal) closeLogoutModal();
    });

    // Flash auto-hide
    setTimeout(() => {
        document.querySelectorAll('.flash-success,.flash-error,.flash-info').forEach(el => {
            el.style.transition = 'opacity 0.5s';
            el.style.opacity = '0';
            setTimeout(() => el.remove(), 500);
        });
    }, 4000);
</script>
</body>
</html>
