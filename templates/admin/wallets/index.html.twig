{% extends 'base.html.twig' %}
{% block title %}Wallets — MindBloom Admin{% endblock %}

{% block body %}
<div class="d-flex">
    {{ include('admin/_sidebar.html.twig') }}

    <div class="admin-content" style="flex:1;">
        <div class="mb-page-header">
            <h1>💰 Wallets</h1>
            <p>Gérez les portefeuilles des utilisateurs</p>
        </div>

        <div class="mb-card" style="padding:0;overflow:hidden;">
            <table class="mb-table">
                <thead>
                    <tr>
                        <th>Utilisateur</th>
                        <th>Email</th>
                        <th>Solde</th>
                        <th>Dernière recharge</th>
                        <th>Statut</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for wallet in wallets %}
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="mb-avatar" style="width:34px;height:34px;font-size:13px;">
                                    {{ wallet.user.fullName|first|upper }}
                                </div>
                                <span style="font-weight:600;">{{ wallet.user.fullName }}</span>
                            </div>
                        </td>
                        <td style="color:var(--text-mid);">{{ wallet.user.email }}</td>
                        <td style="font-weight:700;color:var(--text-dark);">
                            {{ wallet.balance|number_format(2, '.', ' ') }} DT
                        </td>
                        <td style="color:var(--text-mid);font-size:13px;">
                            {{ wallet.lastRechargeDate ? wallet.lastRechargeDate|date('d/m/Y') : '—' }}
                        </td>
                        <td>
                            {% if wallet.status == 'ACTIVE' %}
                                <span class="mb-badge mb-badge-green">● Actif</span>
                            {% else %}
                                <span class="mb-badge mb-badge-gray">● Inactif</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="d-flex gap-2 justify-content-end">
                                <a href="{{ path('app_admin_wallets', {wallet: wallet.id}) }}"
                                   class="btn-mb-outline"
                                   style="padding:6px 12px;font-size:12px;border-radius:8px;text-decoration:none;">
                                    Voir transactions
                                </a>
                                <form method="post"
                                      action="{{ path('app_admin_wallet_toggle', {id: wallet.id}) }}">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('toggle-wallet-' ~ wallet.id) }}">
                                    <input type="hidden" name="selected_wallet_id"
                                           value="{{ selectedWallet ? selectedWallet.id : '' }}">
                                    <button type="submit"
                                            class="{{ wallet.status == 'ACTIVE' ? 'btn-mb-danger' : 'btn-mb-teal' }}"
                                            style="padding:6px 12px;font-size:12px;border-radius:8px;">
                                        {{ wallet.status == 'ACTIVE' ? '🚫 Désactiver' : '✅ Activer' }}
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" style="text-align:center;color:var(--text-mid);padding:40px;">
                            Aucun wallet trouvé
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mb-card mt-4">
            {% if selectedWallet %}
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 style="margin:0;font-weight:700;">
                        Transactions de {{ selectedWallet.user.fullName }}
                    </h5>
                    <span class="mb-badge mb-badge-gray">{{ selectedTransactions|length }} opération(s)</span>
                </div>

                {% if selectedTransactions is empty %}
                    <div style="text-align:center;padding:24px;color:var(--text-mid);">
                        Aucune transaction pour ce wallet.
                    </div>
                {% else %}
                    <table class="mb-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Description</th>
                                <th style="text-align:right;">Montant</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for tx in selectedTransactions %}
                                <tr>
                                    <td style="color:var(--text-mid);font-size:13px;">
                                        {{ tx.transactionDate|date('d/m/Y à H:i') }}
                                    </td>
                                    <td>
                                        <span class="mb-badge {{ tx.type == 'RECHARGE' ? 'mb-badge-teal' : 'mb-badge-gray' }}">
                                            {{ tx.type }}
                                        </span>
                                    </td>
                                    <td style="color:var(--text-mid);">
                                        {{ tx.description ?? '—' }}
                                    </td>
                                    <td style="text-align:right;font-weight:700;color:var(--text-dark);">
                                        {{ tx.type == 'RECHARGE' ? '+' : '-' }}{{ tx.amount|number_format(2, '.', ' ') }} DT
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            {% else %}
                <div style="text-align:center;padding:24px;color:var(--text-mid);">
                    Sélectionnez un wallet pour afficher ses transactions.
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
