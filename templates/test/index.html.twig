{% extends 'base.html.twig' %}

{% block title %}Tests Psychologiques — MindBloom{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
body.dark-mode .test-page {
    background: linear-gradient(175deg,#0F1117 0%,#121826 45%,#101A18 100%) !important;
}
body.dark-mode .test-page [style*="background: white"],
body.dark-mode .test-page [style*="background:white"] {
    background: #161A26 !important;
    border-color: #252B3E !important;
    box-shadow: 0 12px 28px rgba(0,0,0,0.45) !important;
}
body.dark-mode .test-page [style*="background:#E8F1FC"],
body.dark-mode .test-page [style*="background:#F4F6F6"],
body.dark-mode .test-page [style*="background:#EEF4FF"],
body.dark-mode .test-page [style*="background:#EDF9F5"] {
    background: #1A1F2E !important;
}
body.dark-mode .test-page [style*="color:#1B3A6B"],
body.dark-mode .test-page [style*="color: #1B3A6B"],
body.dark-mode .test-page [style*="color:#2C3E50"],
body.dark-mode .test-page [style*="color: #2C3E50"] {
    color: #E8EAF0 !important;
}
body.dark-mode .test-page [style*="color:#7F8C8D"],
body.dark-mode .test-page [style*="color:#95A5A6"],
body.dark-mode .test-page [style*="color: #BDC3C7"],
body.dark-mode .test-page [style*="color:#55606e"] {
    color: #7A8299 !important;
}
body.dark-mode .test-page input,
body.dark-mode .test-page select {
    background: #1A1F2E !important;
    color: #E8EAF0 !important;
    border-color: #2A3147 !important;
}
body.dark-mode .test-page .test-card {
    background: #161A26 !important;
    border-color: #252B3E !important;
    box-shadow: 0 12px 28px rgba(0,0,0,0.45) !important;
}
body.dark-mode .test-page .test-card:hover {
    box-shadow: 0 16px 36px rgba(0,0,0,0.5) !important;
}
body.dark-mode .test-page .test-card hr {
    border-top-color: #2A3147 !important;
}
body.dark-mode .test-page .pagination li a,
body.dark-mode .test-page .pagination li span {
    background: #1E2333 !important;
    color: #D8DCE8 !important;
    border-color: #252B3E !important;
    box-shadow: none !important;
}
body.dark-mode .test-page .pagination li.active span {
    background: linear-gradient(135deg, #00C2C7, #4ECB71) !important;
    color: #fff !important;
    border-color: #00C2C7 !important;
}
body.dark-mode .test-page .pagination li a:hover {
    background: #00C2C7 !important;
    color: #fff !important;
    border-color: #00C2C7 !important;
}
body.dark-mode .test-page .pagination li.disabled span {
    background: #1A1F2E !important;
    color: #7A8299 !important;
    border-color: #252B3E !important;
}
</style>
{% endblock %}

{% block body %}
<style>
    @keyframes fadeUpPage {
        0% { opacity: 0; transform: translateY(20px); }
        100% { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeUp {
        0% { opacity: 0; transform: translateY(10px); }
        100% { opacity: 1; transform: translateY(0); }
    }
    .animate-entry {
        opacity: 0;
        animation: fadeUpPage 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .test-card {
        background: white;
        border-radius: 18px;
        padding: 28px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        border: 1px solid rgba(0,0,0,0.04);
        transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.35s ease;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .test-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 36px rgba(0,194,199,0.14);
    }
    .navigation { margin-top: 40px; }
    .pagination {
        display: flex;
        justify-content: center;
        gap: 8px;
        list-style: none;
        padding: 0;
    }
    .pagination li a, .pagination li span {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px; height: 40px;
        border-radius: 50%;
        background: white;
        color: #00C2C7;
        text-decoration: none;
        font-weight: 700;
        font-size: 14px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        transition: all 0.25s ease;
        border: 1.5px solid #E0E8F8;
    }
    .pagination li.active span {
        background: linear-gradient(135deg, #00C2C7, #4ECB71);
        color: white;
        border-color: transparent;
        box-shadow: 0 4px 12px rgba(0,194,199,0.35);
    }
    .pagination li a:hover {
        background: #F0F6FF;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0,194,199,0.15);
        border-color: #00C2C7;
    }
    .pagination li.disabled span {
        color: #BDC3C7;
        background: #FAFAFA;
        cursor: not-allowed;
        border-color: #EBEBEB;
    }
</style>

<div class="animate-entry test-page" style="background:linear-gradient(175deg,#F0F6FF 0%,#E8F4F8 45%,#EEF5F0 100%); min-height:calc(100vh - 80px); padding:40px 20px; animation-delay:0s;">
    <div style="max-width:1200px; margin:0 auto;">

        {# ── Hero ── #}
        <div class="animate-entry" style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:36px;flex-wrap:wrap;gap:16px; animation-delay:0.05s;">
            <div>
                <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(0,194,199,0.10);color:#008c91;border-radius:20px;padding:6px 14px;font-size:12px;font-weight:700;margin-bottom:12px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/></svg>
                    Évaluation Personnalisée
                </div>
                <h1 style="font-size:32px;font-weight:900;color:#1B3A6B;margin:0 0 8px;letter-spacing:-.5px;">Tests <span style="background:linear-gradient(135deg,#00C2C7,#4ECB71);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">Psychologiques</span></h1>
                <p style="font-size:14px;color:#7F8C8D;margin:0;max-width:480px;line-height:1.6;">Découvrez nos tests validés scientifiquement pour mieux comprendre vos émotions, votre personnalité et votre bien-être mental.</p>
            </div>
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:10px;flex-shrink:0;">
                {% if is_granted('ROLE_PSYCHOLOGUE') %}
                    <a href="{{ path('app_test_new') }}" style="display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,#00C2C7,#4ECB71);color:white;border-radius:22px;padding:10px 22px;font-size:13px;font-weight:700;text-decoration:none;box-shadow:0 4px 14px rgba(0,194,199,0.35);transition:all .2s;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 20px rgba(0,194,199,0.45)'" onmouseout="this.style.transform='none';this.style.boxShadow='0 4px 14px rgba(0,194,199,0.35)'">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        Créer un test
                    </a>
                {% endif %}
                {% if app.user and app.user.role == 'PATIENT' %}
                    <a href="{{ path('app_resultat_test_mes_resultats') }}" style="display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,#00C2C7,#4ECB71);color:white;border-radius:22px;padding:10px 22px;font-size:13px;font-weight:700;text-decoration:none;box-shadow:0 4px 14px rgba(0,194,199,0.35);transition:all .2s;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 20px rgba(0,194,199,0.45)'" onmouseout="this.style.transform='none';this.style.boxShadow='0 4px 14px rgba(0,194,199,0.35)'">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                        Mes résultats
                    </a>
                {% endif %}
            </div>
        </div>

        {# ── Search & Filter ── #}
        <div class="animate-entry" style="background:white;border-radius:16px;box-shadow:0 4px 20px rgba(0,0,0,0.06);border:1px solid rgba(0,0,0,0.04);padding:18px 24px;margin-bottom:32px;display:flex;gap:16px;align-items:center;flex-wrap:wrap; animation-delay:0.1s;">
            <div style="flex:2;min-width:200px;position:relative;">
                <svg style="position:absolute;left:14px;top:50%;transform:translateY(-50%);pointer-events:none;" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#95A5A6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" id="searchInput" placeholder="Rechercher un test (ex: Humeur, Personnalité...)"
                       style="width:100%;padding:11px 15px 11px 42px;border:1.5px solid #E0E8F8;border-radius:10px;font-size:14px;outline:none;transition:border-color .2s;box-sizing:border-box;"
                       onfocus="this.style.borderColor='#00C2C7'" onblur="this.style.borderColor='#E0E8F8'">
            </div>
            <div style="flex:1;min-width:180px;">
                <select id="categoryFilter" style="width:100%;padding:11px 15px;border:1.5px solid #E0E8F8;border-radius:10px;font-size:14px;outline:none;background:white;cursor:pointer;transition:border-color .2s;" onfocus="this.style.borderColor='#00C2C7'" onblur="this.style.borderColor='#E0E8F8'">
                    <option value="all">Toutes les catégories</option>
                    {% set categories = [] %}
                    {% for test in tests %}
                        {% if test.categorie not in categories %}
                            {% set categories = categories|merge([test.categorie]) %}
                            <option value="{{ test.categorie|lower }}">{{ test.categorie }}</option>
                        {% endif %}
                    {% endfor %}
                </select>
            </div>
        </div>

        {# ── Cards Grid ── #}
        <div id="testContainer" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:24px;margin-bottom:40px;">

            <div id="noResults" style="display:none;grid-column:1/-1;text-align:center;padding:60px 20px;background:white;border-radius:18px;box-shadow:0 4px 20px rgba(0,0,0,0.06);">
                <div style="width:64px;height:64px;background:rgba(0,194,199,0.08);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#00C2C7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                </div>
                <h4 style="font-size:18px;font-weight:700;color:#1B3A6B;margin:0 0 8px;">Aucun test ne correspond à votre recherche</h4>
                <p style="color:#7F8C8D;font-size:14px;margin:0;">Essayez un autre mot-clé ou modifiez la catégorie.</p>
            </div>

            {% for test in tests %}
                <div class="test-card animate-entry" data-title="{{ test.nomTest|lower }}" data-category="{{ test.categorie|lower }}"
                     style="animation-delay:{{ 0.15 + (loop.index0 * 0.07) }}s;">

                    {# Top accent bar #}
                    <div style="position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#00C2C7,#4ECB71);border-radius:18px 18px 0 0;"></div>

                    {# Category + Duration #}
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;margin-top:8px;">
                        <span style="background:#EEF4FF;color:#00C2C7;padding:5px 12px;border-radius:20px;font-size:12px;font-weight:700;">{{ test.categorie }}</span>
                        <div style="display:inline-flex;align-items:center;gap:5px;color:#7F8C8D;font-size:12px;font-weight:600;">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            {{ test.duree }} min
                        </div>
                    </div>

                    {# Title #}
                    <h3 style="font-size:19px;font-weight:800;color:#1B3A6B;margin:0 0 10px;line-height:1.3;">{{ test.nomTest }}</h3>

                    {# Description #}
                    <p style="color:#7F8C8D;font-size:13px;margin:0 0 20px;line-height:1.6;flex:1;">
                        Évaluez votre état actuel et identifiez les pistes de développement personnel avec ce test spécifique.
                    </p>

                    <hr style="border:none;border-top:1px solid #F0F4FA;margin:0 0 16px;">

                    {# Footer #}
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <span style="font-size:11px;color:#BDC3C7;display:inline-flex;align-items:center;gap:4px;">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            {{ test.dateTest ? test.dateTest|date('d/m/Y') : '' }}
                        </span>
                        <div style="display:flex;gap:8px;align-items:center;">
                            {% if is_granted('ROLE_PSYCHOLOGUE') %}
                                <a href="{{ path('app_test_edit', {'id': test.id}) }}" style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:8px;background:#FFF8EC;color:#F39C12;text-decoration:none;transition:background .2s;" title="Modifier" onmouseover="this.style.background='#FDECD0'" onmouseout="this.style.background='#FFF8EC'">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </a>
                                {{ include('test/_delete_form.html.twig', {'test': test}) }}
                            {% endif %}
                            <a href="{{ path('app_test_show', {'id': test.id}) }}" style="display:inline-flex;align-items:center;gap:6px;background:linear-gradient(135deg,#00C2C7,#4ECB71);color:white;border-radius:10px;padding:9px 16px;font-size:13px;font-weight:700;text-decoration:none;box-shadow:0 3px 10px rgba(0,194,199,0.3);transition:all .2s;" onmouseover="this.style.transform='translateY(-1px)';this.style.boxShadow='0 6px 16px rgba(0,194,199,0.4)'" onmouseout="this.style.transform='none';this.style.boxShadow='0 3px 10px rgba(0,194,199,0.3)'">
                                {% if is_granted('ROLE_PSYCHOLOGUE') %}
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    Voir le test
                                {% else %}
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                    Passer le test
                                {% endif %}
                            </a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div style="grid-column:1/-1;text-align:center;padding:60px 20px;background:white;border-radius:18px;box-shadow:0 4px 20px rgba(0,0,0,0.06);">
                    <div style="width:64px;height:64px;background:rgba(0,194,199,0.08);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#00C2C7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/></svg>
                    </div>
                    <h4 style="font-size:18px;font-weight:700;color:#1B3A6B;margin:0 0 8px;">Aucun test disponible</h4>
                    <p style="color:#7F8C8D;font-size:14px;margin:0;">Revenez plus tard pour découvrir nos nouveaux tests psychologiques.</p>
                </div>
            {% endfor %}
        </div>

        {# ── Pagination ── #}
        <div class="navigation animate-entry" style="display:flex;justify-content:center;margin-top:20px;animation-delay:0.8s;">
            {{ knp_pagination_render(tests) }}
        </div>

    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('searchInput');
    const categoryFilter = document.getElementById('categoryFilter');
    const cards = document.querySelectorAll('.test-card');
    const noResults = document.getElementById('noResults');

    function filterTests() {
        const searchTerm = searchInput.value.toLowerCase().trim();
        const categorySelect = categoryFilter.value;
        let visibleCount = 0;

        cards.forEach(card => {
            const title = card.getAttribute('data-title');
            const category = card.getAttribute('data-category');
            const matchesSearch = title.includes(searchTerm);
            const matchesCategory = categorySelect === 'all' || category === categorySelect;

            if (matchesSearch && matchesCategory) {
                card.style.display = 'flex';
                card.style.animation = 'fadeUp 0.3s ease-out forwards';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        noResults.style.display = (visibleCount === 0 && cards.length > 0) ? 'block' : 'none';
    }

    if (searchInput) searchInput.addEventListener('input', filterTests);
    if (categoryFilter) categoryFilter.addEventListener('change', filterTests);
});
</script>
{% endblock %}
