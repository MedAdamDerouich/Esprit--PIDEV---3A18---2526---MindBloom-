{# Main Patient Navbar - Used by base.html.twig #}
{% if is_granted('ROLE_PATIENT') %}
<header style="background:white;height:70px;padding:0 50px;display:flex;align-items:center;
               gap:30px;box-shadow:0 5px 10px rgba(0,0,0,0.05);position:sticky;top:0;z-index:1000;">

    {# Logo + brand name - Clickable to return home #}
    <a href="{{ path('app_patient_dashboard') }}" style="display:flex;align-items:center;gap:10px;flex-shrink:0;text-decoration:none;">
        <img src="{{ asset('images/mindbloom_logo.png') }}" alt="MindBloom"
             style="height:45px;width:45px;object-fit:contain;">
        <span style="font-size:22px;font-weight:800;color:#2C3E50;">MindBloom</span>
    </a>

    {# Navigation links — centered (Accueil removed) #}
    <nav style="flex:1;display:flex;justify-content:center;gap:25px;align-items:center;">
        <a href="{{ path('app_produit_index') }}" 
           style="font-size:14px;color:#2C3E50;text-decoration:none;{{ app.request.attributes.get('_route') starts with 'app_produit' ? 'font-weight:700;color:#4A90E2;border-bottom:2px solid #4A90E2;' : '' }}">Produits</a>
        
        <a href="{{ path('app_patient_cabinets_index') }}" 
           style="font-size:14px;color:#2C3E50;text-decoration:none;{{ app.request.attributes.get('_route') == 'app_patient_cabinets_index' ? 'font-weight:700;color:#4A90E2;border-bottom:2px solid #4A90E2;' : '' }}">Rendez-vous</a>
        
        <a href="{{ path('app_test_index') }}" 
           style="font-size:14px;color:#2C3E50;text-decoration:none;{{ app.request.attributes.get('_route') == 'app_test_index' ? 'font-weight:700;color:#4A90E2;border-bottom:2px solid #4A90E2;' : '' }}">Tests</a>
        <a href="{{ path('app_patient_event_index') }}" 
           style="font-size:14px;color:#2C3E50;text-decoration:none;{{ app.request.attributes.get('_route') starts with 'app_patient_event' ? 'font-weight:700;color:#4A90E2;border-bottom:2px solid #4A90E2;' : '' }}">Événements</a>
        
        <a href="{{ path('app_patient_reservations') }}" 
           style="font-size:14px;color:#2C3E50;text-decoration:none;{{ app.request.attributes.get('_route') == 'app_patient_reservations' ? 'font-weight:700;color:#4A90E2;border-bottom:2px solid #4A90E2;' : '' }}">Mes Réservations</a>
    </nav>

    {# Right actions #}
    <div style="display:flex;align-items:center;gap:15px;flex-shrink:0;">

        {# Factures #}
        <a href="{{ path('app_order_history') }}" 
           style="background:#f4f4f4;border:none;border-radius:10px;padding:8px 12px;
                  font-size:18px;cursor:pointer;line-height:1;text-decoration:none;" title="Mes Factures">🧾</a>

        {# Cart #}
        <a href="{{ path('app_cart_index') }}" 
           style="background:#f4f4f4;border:none;border-radius:10px;padding:8px 12px;
                  font-size:18px;cursor:pointer;line-height:1;text-decoration:none;" title="Mon Panier">🛒</a>

        {# Wallet badge #}
        <div style="display:flex;align-items:center;gap:6px;background:#EDF9F5;
                    border-radius:20px;padding:6px 12px;">
            <span style="font-size:15px;">💳</span>
            <span style="font-size:13px;font-weight:700;color:#5FBF9F;">{{ app.user.solde|default('0.00') }} TND</span>
            <a href="{{ path('app_wallet') }}"
               style="background:#5FBF9F;color:white;border-radius:15px;padding:4px 10px;
                      text-decoration:none;font-size:11px;font-weight:700;line-height:1;">+</a>
        </div>

        {# Profile pill #}
        <div style="display:flex;align-items:center;gap:8px;background:#F8F9FA;
                    border-radius:25px;padding:4px 12px 4px 6px;">
            <div style="width:34px;height:34px;border-radius:50%;border:2px solid #4A90E2;
                        background:white;display:flex;align-items:center;justify-content:center;
                        overflow:hidden;flex-shrink:0;">
                {% if app.user.profileImage %}
                    <img src="{{ asset('uploads/profiles/' ~ app.user.profileImage) }}"
                         style="width:100%;height:100%;object-fit:cover;" alt="">
                {% else %}
                    <span style="font-size:16px;color:#4A90E2;">👤</span>
                {% endif %}
            </div>
            <span style="font-size:12px;font-weight:700;color:#2C3E50;">{{ app.user.fullName|split(' ')|first }}</span>
        </div>

        {# Modifier button #}
        <a href="{{ path('app_profile') }}"
           style="background:#4A90E2;color:white;border-radius:20px;padding:7px 15px;
                  font-size:11px;font-weight:600;text-decoration:none;">Modifier</a>

        {# Déconnexion #}
        <a href="{{ path('app_logout') }}"
           style="background:#e74c3c;color:white;border-radius:20px;padding:7px 15px;
                  font-size:11px;font-weight:600;text-decoration:none;">Déconnexion</a>
    </div>
</header>
{% elseif is_granted('ROLE_ADMIN') %}
    {# Admin Navbar logic... #}
{% endif %}
