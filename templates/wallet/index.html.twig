/* Transaction list container / rows */
body.dark-mode .transaction-row,
body.dark-mode .tx-row,
body.dark-mode .mb-card .list-group-item {
    background: #1A1F2E !important;
    color: #D8DCE8 !important;
    border-color: #252B3E !important;
}
body.dark-mode .transaction-row:hover,
body.dark-mode .tx-row:hover {
    background: #1E2333 !important;
}

/* Empty state */
body.dark-mode #txEmpty {
    color: #6A7385 !important;
}

/* Error banner already red — just dim background */
