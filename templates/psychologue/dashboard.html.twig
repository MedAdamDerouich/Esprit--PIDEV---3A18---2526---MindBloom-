                    Ajouter ou modifier les informations de votre cabinet
                </span>
                <div class="psydash-arrow">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                    </svg>
                </div>
            </div>
        </a>

        {# Card 2 — Créneaux #}
        <a href="{{ path('app_creneau_index') }}" class="psydash-card-wrap">
            <div class="psydash-card" data-tilt>
                <div style="display:flex;align-items:center;gap:14px;">
                    <div class="psydash-icon">📅</div>
                    <span class="psydash-card-title">Gérer mes Créneaux</span>
                </div>
                <span class="psydash-card-desc">
                    Planifier et organiser vos disponibilités
                </span>
                <div class="psydash-arrow">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                    </svg>
                </div>
            </div>
        </a>

        {# Card 3 — Réservations #}
        <a href="{{ path('app_reservation_index') }}" class="psydash-card-wrap">
            <div class="psydash-card" data-tilt>
                <div style="display:flex;align-items:center;gap:14px;">
                    <div class="psydash-icon">📋</div>
                    <span class="psydash-card-title">Voir mes Réservations</span>
                </div>
                <span class="psydash-card-desc">
                    Consulter les rendez-vous à venir
                </span>
                <div class="psydash-arrow">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                    </svg>
                </div>
            </div>
        </a>

        {# Card 4 — Tests #}
        <a href="{{ path('app_test_manage') }}" class="psydash-card-wrap">
            <div class="psydash-card" data-tilt>
                <div style="display:flex;align-items:center;gap:14px;">
                    <div class="psydash-icon">📝</div>
                    <span class="psydash-card-title">Gérer Tests Autoévaluation</span>
                </div>
                <span class="psydash-card-desc">
                    Créer et gérer vos tests pour patients
                </span>
                <div class="psydash-arrow">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                    </svg>
                </div>
            </div>
        </a>

    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function () {
    /* 3D tilt engine — runs on every [data-tilt] card */
    var MAX_TILT = 12; // degrees
    var MAX_LIFT = 18; // px translateZ

    document.querySelectorAll('[data-tilt]').forEach(function (card) {
        var wrap = card.parentElement;

        wrap.addEventListener('mousemove', function (e) {
            var r   = card.getBoundingClientRect();
            var cx  = r.left + r.width  / 2;
            var cy  = r.top  + r.height / 2;
            var dx  = (e.clientX - cx) / (r.width  / 2); // -1 … +1
            var dy  = (e.clientY - cy) / (r.height / 2); // -1 … +1

            var rotX = -dy * MAX_TILT;
            var rotY =  dx * MAX_TILT;

            card.style.transition = 'transform 0.08s ease-out, box-shadow 0.15s ease';
            card.style.transform  =
                'perspective(800px)' +
                ' rotateX(' + rotX + 'deg)' +
                ' rotateY(' + rotY + 'deg)' +
                ' translateZ(' + MAX_LIFT + 'px)';
        });

        wrap.addEventListener('mouseleave', function () {
            card.style.transition = 'transform 0.55s cubic-bezier(0.22,1,0.36,1), box-shadow 0.4s ease';
            card.style.transform  = 'perspective(800px) rotateX(0deg) rotateY(0deg) translateZ(0)';
        });

        /* Click ripple feedback */
        wrap.addEventListener('mousedown', function () {
            card.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) translateZ(4px) scale(0.97)';
        });
        wrap.addEventListener('mouseup', function () {
            card.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) translateZ(' + MAX_LIFT + 'px)';
        });
    });
})();
</script>
{% endblock %}
