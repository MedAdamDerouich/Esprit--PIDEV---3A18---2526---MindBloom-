{% extends 'base.html.twig' %}

{% block title %}ResultatTest index{% endblock %}

{% block body %}
    <h1>ResultatTest index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for entity in resultat_tests %}
            <tr>
                <td>{{ entity.id }}</td>
                <td>
                    <a href="{{ path('app_resultat_test_show', {'id': entity.id}) }}">show</a>
                    <a href="{{ path('app_resultat_test_edit', {'id': entity.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="2">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_resultat_test_new') }}">Create new</a>
{% endblock %}