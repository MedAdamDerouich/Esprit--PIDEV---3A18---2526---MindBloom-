{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Produits - MindBloom Admin{% endblock %}

{% block admin_header %}
    <div class="d-flex align-items-center justify-content-between w-100">
        <span>Catalogue des Produits</span>
        {% if lowStockCount > 0 %}
            <div class="position-relative cursor-pointer ms-3 animate__animated animate__swing animate__infinite" 
                 style="cursor: pointer;" onclick="openStockAlerts()" id="stockNotificationIcon">
                <i class="bi bi-bell-fill text-danger fs-3"></i>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light" style="font-size: 0.7rem;">
                    {{ lowStockCount }}
                </span>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block admin_content %}
    <!-- Statistics Row -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-primary border-5">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-3">
                            <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3">
                                <i class="bi bi-box-seam fs-4"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small fw-bold text-uppercase">Total Produits</h6>
                            <h4 class="mb-0 fw-bold">{{ stats.total }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-danger border-5">
                <div class="card-body" style="cursor: pointer;" onclick="openStockAlerts()">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-3">
                            <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-3">
                                <i class="bi bi-exclamation-octagon fs-4"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small fw-bold text-uppercase">Rupture de Stock</h6>
                            <h4 class="mb-0 fw-bold">{{ stats.outOfStock }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-warning border-5">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-3">
                            <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-3">
                                <i class="bi bi-graph-down fs-4"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small fw-bold text-uppercase">Alertes Stock</h6>
                            <h4 class="mb-0 fw-bold">{{ lowStockCount }}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-success border-5">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0 me-3">
                            <div class="bg-success bg-opacity-10 text-success p-3 rounded-3">
                                <i class="bi bi-cash-coin fs-4"></i>
                            </div>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small fw-bold text-uppercase">Valeur du Stock</h6>
                            <h4 class="mb-0 fw-bold">{{ stats.totalValue|number_format(2, ',', ' ') }} <small>DT</small></h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4 align-items-center">
        <div class="col-md-3">
            <p class="text-muted mb-0">Gestion de l'inventaire et des stocks.</p>
        </div>
        <div class="col-md-9 text-end d-flex gap-2 justify-content-end align-items-center flex-wrap">
            <div class="search-sort-wrapper d-flex gap-2">
                <form action="{{ path('app_admin_produit_index') }}" method="GET" class="m-0" id="adminSortForm">
                    <select name="tri" class="form-select rounded-pill shadow-sm border-0 px-3" style="height: 40px;" onchange="document.getElementById('adminSortForm').submit()">
                        <option value="default" {% if tri is defined and tri == 'default' %}selected{% endif %}>Trier par défaut</option>
                        <option value="prix_asc" {% if tri is defined and tri == 'prix_asc' %}selected{% endif %}>Prix : Croissant</option>
                        <option value="prix_desc" {% if tri is defined and tri == 'prix_desc' %}selected{% endif %}>Prix : Décroissant</option>
                    </select>
                </form>
                <div class="position-relative">
                    <input type="text" id="liveAdminSearch" class="form-control rounded-pill shadow-sm border-0 px-4" style="height: 40px; width: 250px;" placeholder="Rechercher...">
                    <i class="bi bi-search position-absolute top-50 end-0 translate-middle-y me-3 text-muted"></i>
                </div>
            </div>
            <a href="{{ path('app_admin_produit_new') }}" class="btn btn-success px-4 shadow-sm rounded-pill">
                <i class="bi bi-plus-circle me-1"></i> Nouveau Produit
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-uppercase small fw-bold text-muted">
                        <tr>
                            <th class="ps-4 py-3 border-0">Produit</th>
                            <th class="py-3 border-0 text-center">Stock</th>
                            <th class="py-3 border-0">Prix</th>
                            <th class="py-3 border-0 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="adminProductTableBody">
                    {% for produit in pagination %}
                        <tr class="admin-product-row">
                            <td class="ps-4 py-4 border-0">
                                <div class="d-flex align-items-center">
                                    {% if produit.image %}
                                        <img src="{{ asset('uploads/produits/' ~ produit.image) }}" alt="{{ produit.nom }}" class="rounded-3 me-3 shadow-sm" style="width: 50px; height: 50px; object-fit: cover;">
                                    {% else %}
                                        <div class="bg-light rounded-3 me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                            <i class="bi bi-image text-muted"></i>
                                        </div>
                                    {% endif %}
                                    <div>
                                        <h6 class="mb-0 fw-bold product-title">{{ produit.nom }}</h6>
                                        <small class="text-muted product-desc">{{ produit.description|slice(0, 40) }}...</small>
                                    </div>
                                </div>
                            </td>
                            <td class="text-center border-0">
                                <span class="badge {% if produit.quantite <= produit.stockSeuil %}bg-danger{% elseif produit.quantite <= (produit.stockSeuil * 1.5) %}bg-warning text-dark{% else %}bg-success{% endif %} px-3 py-2 rounded-pill shadow-sm" style="min-width: 80px;">
                                    {{ produit.quantite }} restants
                                </span>
                            </td>
                            <td class="fw-bold text-dark border-0">
                                {{ produit.prix|number_format(2, ',', ' ') }} DT
                            </td>
                            <td class="text-center pe-4 border-0">
                                <div class="btn-group shadow-sm rounded-pill overflow-hidden border">
                                    <a href="{{ path('app_admin_produit_feedbacks', {'id': produit.id}) }}" class="btn btn-sm btn-white bg-white border-0 py-2 px-3" title="Gérer les avis">
                                        <i class="bi bi-chat-left-dots text-info"></i>
                                    </a>
                                    <a href="{{ path('app_admin_produit_edit', {'id': produit.id}) }}" class="btn btn-sm btn-white bg-white border-0 border-start py-2 px-3" title="Modifier">
                                        <i class="bi bi-pencil-square text-primary"></i>
                                    </a>
                                    <form action="{{ path('app_admin_produit_delete', {'id': produit.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce produit ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
                                        <button class="btn btn-sm btn-white bg-white border-0 border-start py-2 px-3" title="Supprimer">
                                            <i class="bi bi-trash text-danger"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="py-5 text-center text-muted border-0"> Aucun produit trouvé. </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-center mt-4">
        {{ knp_pagination_render(pagination) }}
    </div>

    <!-- Stock Alert Modal -->
    <div class="modal fade" id="stockAlertModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-bottom-0 pt-4 px-4 bg-danger bg-opacity-10">
                    <h5 class="modal-title fw-bold text-danger d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-3"></i> Ruptures & Alertes Stock
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 pt-2">
                    <p class="text-muted small mb-3">Produits nécessitant une attention immédiate.</p>
                    <div class="list-group list-group-flush">
                        {% for item in lowStockItems %}
                            <div class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 py-3 border-bottom">
                                <div class="d-flex align-items-center">
                                    <div class="bg-light p-2 rounded-2 me-3" style="width: 45px; height: 45px; display: flex; align-items: center; justify-content: center;">
                                        <i class="bi bi-box-seam text-secondary fs-5"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold small">{{ item.nom }}</div>
                                        <div class="text-danger fw-bold" style="font-size: 11px;">
                                            {{ item.quantite }} en stock (Seuil: {{ item.stockSeuil }})
                                        </div>
                                    </div>
                                </div>
                                <a href="{{ path('app_admin_produit_edit', {'id': item.id}) }}" class="btn btn-sm btn-outline-primary rounded-pill">
                                    <i class="bi bi-plus-lg"></i>
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="modal-footer border-top-0 pb-4 px-4 bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Fermer</button>
                    <button type="button" class="btn btn-danger rounded-pill px-4 fw-bold" onclick="loadStockAiAnalysisFromProduit()">
                        <i class="bi bi-robot me-1"></i> Analyse IA Gemini
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- AI Analysis Modal -->
    <div class="modal fade" id="stockAiModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom-0 pt-4 px-4 bg-warning bg-opacity-10">
                    <h5 class="modal-title fw-bold d-flex align-items-center">
                        <i class="bi bi-lightning-stars-fill text-warning me-2 fs-3"></i> Intelligence Artificielle MindBloom
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 pt-0">
                    <div id="stock-ai-modal-content" class="lh-lg text-dark">
                        <!-- Content loaded via JS -->
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0 pb-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Fermer</button>
                </div>
            </div>
        </div>
    </div>

<style>
.bg-success-subtle { background-color: #d1e7dd; }
.bg-warning-subtle { background-color: #fff3cd; }
.bg-danger-subtle { background-color: #f8d7da; }
.btn-white:hover { background-color: #f8f9fa !important; }
.animate__swing { animation-duration: 2s; }
.cursor-pointer { cursor: pointer; }
</style>

<script>
function openStockAlerts() {
    const modalElement = document.getElementById('stockAlertModal');
    if (modalElement) {
        const modal = new bootstrap.Modal(modalElement);
        modal.show();
    }
}

function loadStockAiAnalysisFromProduit() {
    const alertModalEl = document.getElementById('stockAlertModal');
    const alertModal = bootstrap.Modal.getInstance(alertModalEl);
    if(alertModal) alertModal.hide();

    const modalContent = document.getElementById('stock-ai-modal-content');
    const aiModalEl = document.getElementById('stockAiModal');
    const aiModal = new bootstrap.Modal(aiModalEl);
    
    modalContent.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-warning" role="status"></div><p class="mt-3 text-muted">L\'IA analyse vos stocks et priorise les approvisionnements...</p></div>';
    aiModal.show();

    fetch("{{ path('app_admin_stock_ai') }}")
        .then(response => response.text())
        .then(data => {
            modalContent.innerHTML = '<div class="animate__animated animate__fadeIn p-3">' + data.replace(/\n/g, '<br>') + '</div>';
        })
        .catch(err => {
            modalContent.innerHTML = '<div class="alert alert-danger">Erreur lors de l\'analyse des stocks.</div>';
        });
}

document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('liveAdminSearch');
    const tableBody = document.getElementById('adminProductTableBody');
    if (!searchInput || !tableBody) return;

    const rows = tableBody.querySelectorAll('.admin-product-row');

    searchInput.addEventListener('input', function() {
        let searchQuery = this.value.toLowerCase().trim();
        rows.forEach(row => {
            const titleText = row.querySelector('.product-title').textContent.toLowerCase();
            const descText = row.querySelector('.product-desc').textContent.toLowerCase();

            if (titleText.includes(searchQuery) || descText.includes(searchQuery)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });
});
</script>
{% endblock %}
