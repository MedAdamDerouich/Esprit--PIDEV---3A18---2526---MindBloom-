{% extends 'base.html.twig' %}
{% block title %}Gestion du Créneau — Espace Psychologue{% endblock %}

{% block body %}
<header style="background:linear-gradient(to right,#6FBF9B,#4A90E2);height:70px; padding:0 20px; display:flex; align-items:center; gap:15px;">
    <img src="{{ asset('images/mindbloom_logo.png') }}" alt="MindBloom" style="height:50px; object-fit:contain;">
    <span style="font-size:18px; font-weight:700; color:white;">🍃 MindBloom — Espace Psychologue</span>
    <div style="flex:1;"></div>
    <span style="font-size:14px; font-weight:700; color:white;">Bonjour, {{ app.user.fullName }}</span>
    <div style="width:1px;height:30px;background:rgba(255,255,255,0.3);margin:0 5px;"></div>
    <a href="{{ path('app_logout') }}" style="padding:6px 12px;font-size:12px;color:white;border:1px solid rgba(255,255,255,0.5);border-radius:15px;text-decoration:none;">Déconnexion</a>
</header>

<div style="background:#F5F3EF; min-height:calc(100vh - 70px); padding:20px 40px; display:flex; flex-direction:column; gap:20px; align-items:center;">
    
    <div style="width:100%; max-width:500px;">
        {{ form_errors(form) }}
        {% for message in app.flashes('error') %}
            <div style="background: #fdeaea; color: #d32f2f; padding: 8px 12px; border-radius: 6px; margin-bottom:8px; font-weight:bold;">
                {{ message }}
            </div>
        {% endfor %}
    </div>

    {{ form_start(form, {'attr': {'style':'width:100%; display:flex; flex-direction:column; gap:15px;'}}) }}
        
        <!-- Header Carte -->
        <div style="width:100%; max-width:500px; height:90px; background:linear-gradient(to right, #6FBF9B, #4A90E2); border-radius:12px; padding:0 20px; display:flex; align-items:center;">
            <div>
                <span style="color:white; font-size:20px; font-weight:bold;">Gestion du Créneau</span><br>
                <span style="color:white; font-size:12px; opacity:0.9;">Planifiez vos disponibilités</span>
            </div>
            <div style="flex:1;"></div>
            <button type="submit" style="background:white; color:#6FBF9B; border-radius:20px; padding:8px 20px; border:none; font-size:12px; font-weight:bold; cursor:pointer;">💾 Enregistrer</button>
        </div>

        <!-- Champs -->
        <div style="display:flex; flex-direction:column; gap:15px; width:100%; max-width:500px;">
            
            <!-- Jour -->
            <div style="background:white; border-radius:12px; padding:15px; box-shadow:0 2px 6px rgba(0,0,0,0.05);">
                <label style="font-size:11px; font-weight:bold; color:#8E8E8E;">Jour de la semaine</label>
                {{ form_widget(form.jour, {'attr': {'style':'width:100%; padding:8px; font-size:13px; border:1px solid #E0E0E0; border-radius:5px;'}}) }}
            </div>

            <!-- Date -->
            <div style="background:white; border-radius:12px; padding:15px; box-shadow:0 2px 6px rgba(0,0,0,0.05);">
                <label style="font-size:11px; font-weight:bold; color:#8E8E8E;">Date spécifique</label>
                {{ form_widget(form.dateCreneau, {'attr': {'min': 'now'|date('Y-m-d'), 'style':'width:100%; padding:8px; font-size:13px; border:1px solid #E0E0E0; border-radius:5px;'}}) }}
            </div>

            <!-- Heure & Durée côte à côte -->
            <div style="display:flex; gap:10px;">
                <div style="flex:1; background:white; border-radius:12px; padding:15px; box-shadow:0 2px 6px rgba(0,0,0,0.05);">
                    <label style="font-size:11px; font-weight:bold; color:#8E8E8E;">Heure de début</label>
                    {{ form_widget(form.heureDebut, {'attr': {'style':'width:100%; padding:8px; font-size:13px; border:1px solid #E0E0E0; border-radius:5px;'}}) }}
                </div>
                <div style="width:120px; background:white; border-radius:12px; padding:15px; box-shadow:0 2px 6px rgba(0,0,0,0.05);">
                    <label style="font-size:11px; font-weight:bold; color:#8E8E8E;">Durée (min)</label>
                    {{ form_widget(form.dureeMinutes, {'attr': {'placeholder':'30', 'style':'width:100%; padding:8px; font-size:13px; border:1px solid #E0E0E0; border-radius:5px;'}}) }}
                </div>
            </div>

            <!-- Disponibilité -->
            <div style="background:white; border-radius:12px; padding:15px; box-shadow:0 2px 6px rgba(0,0,0,0.05); display:flex; align-items:center; gap:8px;">
                {{ form_widget(form.disponible, {'attr': {'style':'width:16px; height:16px; accent-color:#6FBF9B; cursor:pointer;'}}) }}
                <label for="{{ form.disponible.vars.id }}" style="font-size:13px; color:#2C3E50;">Disponible immédiatement</label>
            </div>
        </div>

        <!-- Bouton Annuler -->
        <div style="width:100%; max-width:500px; display:flex; justify-content:flex-start;">
            <button type="button" onclick="window.history.back();" style="background:#95A5A6; border:none; border-radius:15px; color:white; font-size:13px; font-weight:bold; padding:6px 15px; cursor:pointer;">
                ← Annuler
            </button>
        </div>

    {{ form_end(form) }}
</div>
{% endblock %}