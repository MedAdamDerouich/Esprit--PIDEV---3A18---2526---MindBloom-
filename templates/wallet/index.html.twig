    background: rgba(231,76,60,.15) !important;
    color: #F59493 !important;
}

/* Page wrapper bg (inline var(--bg-warm)) */
body.dark-mode > div[style*="var(--bg-warm)"],
body.dark-mode .container > div[style*="var(--bg-warm)"] {
